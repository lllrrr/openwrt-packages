// chfs 后端接口
// 提供配置读取、状态探测、服务控制与内核管理能力。
// 由 rpcd-mod-ucode 加载, 前端通过 ubus 对象 'luci.chfs' 调用。

'use strict';

import { cursor } from 'uci';
import { readfile, stat, popen, open, unlink } from 'fs';

const UCI_PACKAGE = 'chfs';
const GEN_INI = '/var/etc/chfs.ini';
const PROG = '/usr/bin/chfs';
const INIT_SCRIPT = '/etc/init.d/chfs';
const RC_LINK = '/etc/rc.d/S95chfs';

const VALID_ACTIONS = [ 'start', 'stop', 'restart', 'reload', 'enable', 'disable' ];
const WEBDAV_OK_CODES = [ '200', '207', '301', '302', '401', '403', '405' ];

// ---------------------------------------------------------------------------
// 基础工具
// ---------------------------------------------------------------------------

// 将字符串安全地包进 POSIX shell 单引号。所有拼接进 popen() 的变量都必须先过这里。
function shq(s) {
	let out = "'";
	s = '' + (s ?? '');

	for (let i = 0; i < length(s); i++) {
		let c = substr(s, i, 1);
		if (c === "'")
			out += "'\\''";
		else
			out += c;
	}

	return out + "'";
}

// 仅允许安全文件名, 避免路径穿越、隐藏文件与 shell 选项注入
function safe_name(name) {
	name = '' + (name ?? '');

	if (name === '' || substr(name, 0, 1) === '.' || substr(name, 0, 1) === '-')
		return false;

	if (match(name, /^[0-9A-Za-z._-]+$/) == null)
		return false;

	if (match(name, /\.\./) != null)
		return false;

	return true;
}

// 把 UCI/ini 中的端口值规范化为数字, 非法返回 0
function to_port(v) {
	let s = '' + (v ?? '');

	if (match(s, /^[0-9]+$/) == null)
		return 0;

	let n = +s;
	return (n >= 1 && n <= 65535) ? n : 0;
}

function service_enabled() {
	let uci = cursor();
	uci.load(UCI_PACKAGE);
	return (uci.get(UCI_PACKAGE, 'main', 'enabled') ?? '0') === '1';
}

// 运行中的 ini 端口与 HTTPS 状态。用于状态探测, 避免配置改了但没重启时误报。
function ini_port() {
	if (stat(GEN_INI) == null)
		return null;

	let content = readfile(GEN_INI) ?? '';
	let m = match(content, /(^|\n)port=([0-9]+)/);

	if (m == null)
		return null;

	let n = +m[2];
	return (n >= 1 && n <= 65535) ? n : null;
}

function ini_https() {
	if (stat(GEN_INI) == null)
		return false;

	let content = readfile(GEN_INI) ?? '';

	return (match(content, /(^|\n)ssl\.cert=/) != null &&
	        match(content, /(^|\n)ssl\.key=/) != null);
}

// ---------------------------------------------------------------------------
// 架构与 ELF
// ---------------------------------------------------------------------------

// 设备架构 -> 内核资产文件名后缀
// 与 chfs/Makefile 的 CHFS_ARCH 映射表保持一致。
function detect_arch() {
	let p = popen('uname -m 2>/dev/null');
	let m = trim('' + (p.read('all') ?? ''));
	p.close();

	// uname -m 的取值 -> 资产命名
	//   aarch64 -> arm64     x86_64 -> amd64
	let map = {
		'aarch64':   { kernel: 'arm64', elf_machine: 183, arch: 'aarch64' },
		'x86_64':    { kernel: 'amd64', elf_machine: 62,  arch: 'x86_64' },
		'armv7l':    { kernel: 'arm',   elf_machine: 40,  arch: 'arm' },
		'armv6l':    { kernel: 'arm',   elf_machine: 40,  arch: 'arm' },
		'armv8l':    { kernel: 'arm',   elf_machine: 40,  arch: 'arm' },
		'mips':      { kernel: 'mips',  elf_machine: 8,   arch: 'mips' },
		'mipsel':    { kernel: 'mipsle', elf_machine: 8,  arch: 'mipsel' },
		'mips64':    { kernel: 'mips64', elf_machine: 8,  arch: 'mips64' },
		'mips64el':  { kernel: 'mips64le', elf_machine: 8, arch: 'mips64el' },
		'i686':      { kernel: '386',   elf_machine: 3,   arch: 'i386' },
		'i386':      { kernel: '386',   elf_machine: 3,   arch: 'i386' }
	};

	return map[m] ?? { kernel: '', elf_machine: -1, arch: m };
}

// 读取 ELF 头的 e_machine 字段。
// ELF 头布局: 偏移 18 为 e_machine, 2 字节, 字节序由偏移 5 的 EI_DATA 决定。
// 返回 -1 表示不是 ELF 或读取失败。
//
// 注意: fs.open 读取返回的是 string, 需用全局 ord(str, idx) 取字节值,
//       不能用 s[idx] 下标访问 (ucode 中该写法返回 null)。
function elf_machine(path) {
	let fd = open(path, 'r');
	if (fd == null)
		return -1;

	// 读取前 20 字节足以覆盖 ELF 魔数 + EI_CLASS/EI_DATA + e_machine
	let head = fd.read(20);
	fd.close();

	if (head == null || length(head) < 20)
		return -1;

	// 魔数校验: 7f 45 4c 46
	if (ord(head, 0) != 0x7f || ord(head, 1) != 0x45 ||
	    ord(head, 2) != 0x4c || ord(head, 3) != 0x46)
		return -1;

	let ei_class = ord(head, 4);
	let ei_data = ord(head, 5);

	if ((ei_class != 1 && ei_class != 2) || (ei_data != 1 && ei_data != 2))
		return -1;

	// EI_DATA: 1 小端, 2 大端
	if (ei_data == 2)
		return (ord(head, 18) * 256) + ord(head, 19);

	return ord(head, 18) + (ord(head, 19) * 256);
}

// 计算文件 sha256, 走 sha256sum 而非自行实现, 避免算法实现引入误差
function file_sha256(path) {
	if (stat(path) == null)
		return '';

	let p = popen('sha256sum ' + shq(path) + ' 2>/dev/null');
	let out = trim('' + (p.read('all') ?? ''));
	p.close();

	let sp = split(out, ' ');
	return (sp != null && length(sp) > 0) ? sp[0] : '';
}

// ---------------------------------------------------------------------------
// HTTP 传输辅助
//
// 设备实际环境差异 (ImmortalWrt SNAPSHOT 实测):
//   /usr/bin/wget -> /bin/uclient-fetch   BusyBox 风格, **不支持 -S**,
//                                          支持 -s/--spider、-T/--timeout
//   /usr/bin/curl   完整版, 支持 -s -I -o -w --max-time
//
// 统一走 curl 取状态码; curl 缺失时退回 uclient-fetch 的 spider 模式,
// 以退出码判定可达性 (无法区分 404 与 200, 仅作连通性判断)。
// ---------------------------------------------------------------------------

function detect_fetcher() {
	let p = popen('command -v curl 2>/dev/null');
	let c = trim('' + (p.read('all') ?? ''));
	p.close();
	if (c !== '')
		return 'curl';

	p = popen('command -v uclient-fetch 2>/dev/null');
	let u = trim('' + (p.read('all') ?? ''));
	p.close();
	if (u !== '')
		return 'uclient';

	return '';
}

function http_probe(url, timeout_sec) {
	let fetcher = detect_fetcher();
	let out = { code: 'timeout', available: false };

	if (fetcher === 'curl') {
		// -I 只取响应头; GitHub Release 资产会 302 跳到 Azure Blob,
		// 需要 -L 跟随重定向才能拿到最终 200。
		let cmd = 'curl -s -I -L -o /dev/null -w "%{http_code}" --max-time ' +
		          (+timeout_sec) + ' ' + shq(url) + ' 2>/dev/null';
		let p = popen(cmd);
		let code = trim('' + (p.read('all') ?? ''));
		p.close();

		out.code = (code !== '') ? code : 'timeout';
		out.available = (code === '200' || code === '301' || code === '302');
		return out;
	}

	if (fetcher === 'uclient') {
		let cmd = 'uclient-fetch -s -T ' + (+timeout_sec) + ' ' + shq(url) + ' >/dev/null 2>&1';
		let p = popen(cmd);
		p.read('all');
		let rc = p.close();

		if (rc == 0) {
			out.code = '200';
			out.available = true;
		}
		return out;
	}

	return out;
}

// 读取 /proc/net/tcp{,6} 判断端口是否处于 LISTEN 状态。
// 比 netstat 少一个外部依赖, 且不受 netstat 输出格式差异影响。
function port_listening(port) {
	let want = sprintf('%04X', +port);
	let checked = false;

	for (let f in [ '/proc/net/tcp', '/proc/net/tcp6' ]) {
		let content = readfile(f);
		if (content == null)
			continue;

		checked = true;

		for (let line in split(content, '\n')) {
			let m = match(line, /^[ \t]*[0-9]+:[ \t]+[0-9A-Fa-f]+:([0-9A-Fa-f]{4})[ \t]+[0-9A-Fa-f]+:[0-9A-Fa-f]{4}[ \t]+0A[ \t]/);

			if (m != null && m[1] == want)
				return true;
		}
	}

	if (!checked) {
		// 极少数环境没有 /proc/net/tcp, 退回 netstat
		let p = popen('netstat -ltn 2>/dev/null | grep -c ":' + (+port) + ' "');
		let cnt = trim('' + (p.read('all') ?? '0'));
		p.close();

		return ((+cnt) > 0);
	}

	return false;
}

// ---------------------------------------------------------------------------
// 服务状态
// ---------------------------------------------------------------------------

function service_status() {
	// 判定运行状态不能用 pgrep -f "<进程路径>".
	// pgrep -f 匹配整条 command line, 而执行 pgrep 的那条 sh -c 命令自身也包含
	// 该字符串, 于是 pgrep 总能匹配到自己并返回 0.
	// 改用 pidof chfs: 它按 /proc/<pid>/comm 精确匹配进程名, 不会自匹配.
	let p0 = popen('pidof chfs 2>/dev/null | head -n1');
	let pid = trim('' + (p0.read('all') ?? ''));
	p0.close();

	let running = (pid !== '');
	let st = { running };

	if (running) {
		st.pid = pid;

		if (match(pid, /^[0-9]+$/)) {
			let p2 = popen('awk \'/VmRSS/{print $2}\' /proc/' + pid + '/status 2>/dev/null');
			let rss = trim('' + (p2.read('all') ?? ''));
			p2.close();

			if (rss !== '')
				// ucode 的字符串没有 .format() 方法, 必须用 printf 系列函数格式化.
				st.mem_mb = sprintf('%.1f', (+rss) / 1024);
		}
	}

	let uci = cursor();
	uci.load(UCI_PACKAGE);

	st.enabled = (uci.get(UCI_PACKAGE, 'main', 'enabled') ?? '0') === '1';
	st.port = uci.get(UCI_PACKAGE, 'main', 'port') ?? '8080';

	// 实际开机是否启动 = rc.d 链接存在且 UCI 开关为启用
	st.autostart = st.enabled && (stat(RC_LINK) != null);

	let bst = stat(PROG);
	st.binary_ok = (bst != null);

	let ist = stat(GEN_INI);
	st.ini_exists = (ist != null);

	// 当前真实生效的端口/协议取自 ini, 与 UCI 可能不同 (改过但未重启).
	if (st.ini_exists) {
		let ip = ini_port();

		if (ip != null) {
			st.ini_port = ip;

			if ('' + ip != st.port)
				st.port_mismatch = true;
		}

		st.ini_https = ini_https();
	}

	return st;
}

// ---------------------------------------------------------------------------
// 配置读取 (只读, 且对密码打码)
// ---------------------------------------------------------------------------

function read_ini() {
	if (stat(GEN_INI) == null)
		return { ok: false, msg: '配置文件尚未生成, 请先启动一次服务' };

	let content = readfile(GEN_INI) ?? '';
	let lines = [];

	for (let line in split(content, '\n')) {
		// 状态页用于排查配置, 不应把账户明文口令回传给浏览器
		if (match(line, /^[ \t]*password[ \t]*=/))
			line = 'password=********';

		push(lines, line);
	}

	return { ok: true, content: join('\n', lines) };
}

// ---------------------------------------------------------------------------
// 服务控制
// ---------------------------------------------------------------------------

function init_action(action) {
	if (!(action in VALID_ACTIONS))
		return { ok: false, msg: '不支持的操作: ' + action };

	// 未启用时 start 什么都不会做, 直接返回明确原因。
	// restart 仍允许执行: 用户可能刚把 enabled 改为 0, 需要借此停止旧进程。
	if (action === 'start' && !service_enabled())
		return { ok: false, msg: '服务未启用, 请先在服务设置中勾选「启用服务」并保存' };

	let res = popen(INIT_SCRIPT + ' ' + action + ' 2>&1');
	let out = res.read('all') ?? '';
	let code = res.close();

	if (code != 0)
		return { ok: false, msg: trim('' + out) || ('操作失败, 退出码 ' + code) };

	return { ok: true, output: trim('' + out) };
}

// ---------------------------------------------------------------------------
// 连通性探测
// ---------------------------------------------------------------------------

function probe_listen() {
	let port = ini_port();

	if (port == null) {
		let uci = cursor();
		uci.load(UCI_PACKAGE);
		port = to_port(uci.get(UCI_PACKAGE, 'main', 'port') ?? '8080');
	}

	if (port === 0)
		return { port: 0, listening: false, msg: '端口配置非法' };

	return { port: port, listening: port_listening(port) };
}

// 探测 WebDAV 端点
// chfs 的 WebDAV 与 HTTP 共用端口, 路径固定为 /webdav, 无独立开关
// 返回码语义: 207 Multi-Status 为 WebDAV 正常响应 ;
//             401/403 表示端点存在但需认证或受限 ;
//             000 表示连接失败
function probe_webdav() {
	let uci = cursor();
	uci.load(UCI_PACKAGE);

	let port = ini_port();

	if (port == null)
		port = to_port(uci.get(UCI_PACKAGE, 'main', 'port') ?? '8080');

	// 优先使用运行中的 ini 判断协议, 未运行时退回 UCI 配置
	let scheme;
	if (stat(GEN_INI) != null) {
		scheme = ini_https() ? 'https' : 'http';
	}
	else {
		let cert = uci.get(UCI_PACKAGE, 'main', 'ssl_cert') ?? '';
		let key = uci.get(UCI_PACKAGE, 'main', 'ssl_key') ?? '';
		scheme = (cert !== '' && key !== '') ? 'https' : 'http';
	}

	if (port === 0)
		return {
			available: false,
			http_code: '',
			scheme,
			port: 0,
			url: '',
			msg: '端口配置非法, 无法探测'
		};

	let out = {
		available: false,
		http_code: '',
		scheme,
		port,
		url: scheme + '://<host>:' + port + '/webdav'
	};

	if (detect_fetcher() !== 'curl') {
		out.msg = '未安装 curl, 无法执行 WebDAV PROPFIND 探测';
		return out;
	}

	let url = scheme + '://127.0.0.1:' + port + '/webdav';
	let cmd = 'curl -s -o /dev/null -w "%{http_code}" -k --max-time 5 ' +
	          '-X PROPFIND -H "Depth: 0" ' + shq(url) + ' 2>/dev/null';

	let res = popen(cmd);
	let code = trim('' + (res.read('all') ?? ''));
	res.close();

	out.http_code = code;
	out.available = (code in WEBDAV_OK_CODES);

	if (!out.available) {
		if (code === '000' || code === '')
			out.msg = '无法连接, 请确认服务已启动且端口正确';
		else
			out.msg = 'WebDAV 端点返回异常状态码 ' + code;
	}
	else if (code === '401' || code === '403') {
		out.msg = '端点存在, 需使用有效账户认证后访问';
	}
	else {
		out.msg = 'WebDAV 端点响应正常';
	}

	if (scheme === 'https')
		out.tip = 'WebDAV 客户端通常不信任自签名证书, 建议使用受信任证书';

	return out;
}

// ---------------------------------------------------------------------------
// 内核管理
//
// 背景:
//   chfs 上游只发布预编译二进制, 且 iscute.cn 的 TLS 证书已过期、站点可用性
//   不可控。本插件随包分发入库的内核, 但存在三种需要替换内核的场景:
//     1. 目标架构 (如 mipsle / armv7) 未随包提供
//     2. 上游发布新版本, 不想等插件重新打包
//     3. 随包内核被裁剪或损坏, 需要恢复
//
// 因此提供两条补充路径:
//   A. 一键下载 —— 从本仓库 (GitHub) 下载对应架构内核。下载后必须与内置
//      SHA256 比对, 只有完全一致才允许进入待安装区。
//   B. 手动上传 —— 用户自行取得内核文件后在网页上传。
//
// 安全边界 (重要):
//   1. 下载 URL 必须匹配白名单前缀, 且拒绝空白/引号等可用于 shell 拼接的字符。
//   2. 文件一律先落到专用待安装目录, 不直接覆盖运行中的内核。
//   3. 安装前校验: ELF 魔数、e_machine 与当前设备架构匹配、文件非空、大小合理。
//   4. 安装前自动备份现有内核, 便于回滚。
//   5. 所有拼进 shell 的路径都经过 shq() 转义。
// ---------------------------------------------------------------------------

const UPLOAD_DIR = '/etc/luci-uploads/chfs';
const BACKUP_DIR = '/etc/chfs/kernel-backup';
const KERNEL_VERSION = '3.1';

// 预置内核的 SHA256 基准值。与 chfs/bin/SHA256SUMS 保持一致;
// 一键下载在落盘前会用这里的值做完整性校验。
const KERNEL_SHA256 = {
	'amd64': '763a557c7b6916a496639a715cd8d6ff1dbb6c15b73bed060a705797d434c6a6',
	'arm64': '78ed31c12b7f1c9679867d5cc9051cc1174740bb88b939eaf32b14436b6d3e53'
};

// 允许下载的 URL 前缀白名单。
// 用户可在界面上切换主源与镜像源, 但两者都必须命中此列表。
const ALLOWED_URL_PREFIXES = [
	'https://github.com/LianXia233/luci-app-chfs/releases/download/',
	'https://github.com/LianXia233/luci-app-chfs/releases/latest/download/',
	'https://raw.githubusercontent.com/LianXia233/luci-app-chfs/',
	'https://gh.acg2.mom/https://raw.githubusercontent.com/LianXia233/luci-app-chfs/',
	'https://gh.acg2.mom/https://github.com/LianXia233/luci-app-chfs/',
	'https://gh-proxy.com/https://raw.githubusercontent.com/LianXia233/luci-app-chfs/',
	'https://ghfast.top/https://raw.githubusercontent.com/LianXia233/luci-app-chfs/'
];

// 当前运行内核的信息: 是否存在 / 大小 / sha256 / 架构 / 校验状态
function kernel_info() {
	let out = { ok: true };
	let arch = detect_arch();

	out.device_arch = arch.arch;
	out.kernel_name = arch.kernel;
	out.elf_machine_want = arch.elf_machine;
	out.expected_sha256 = KERNEL_SHA256[arch.kernel] ?? '';

	let st = stat(PROG);
	if (st == null) {
		out.exists = false;
		out.msg = '未找到 ' + PROG + ', 请安装 chfs 包或上传内核';
		return out;
	}

	out.exists = true;
	out.path = PROG;
	out.size = st.size;

	let m = elf_machine(PROG);
	out.elf_machine = m;
	out.arch_match = (m == arch.elf_machine);
	out.sha256 = file_sha256(PROG);
	out.verified = (out.expected_sha256 !== '' && out.sha256 === out.expected_sha256);

	// 读取真实版本; 架构不匹配时不执行, 失败/异常输出时退回随包版本
	out.version = KERNEL_VERSION;

	if (out.arch_match) {
		let vp = popen(shq(PROG) + ' -version 2>&1');
		let ver = trim('' + (vp.read('all') ?? ''));
		vp.close();

		if (ver !== '' && length(ver) < 64)
			out.version = ver;
	}

	return out;
}

// 探测下载源可达性: 对每个候选源发起 HEAD 请求, 返回状态码与内置校验值
function kernel_sources() {
	let arch = detect_arch();
	let expected = KERNEL_SHA256[arch.kernel] ?? '';
	let out = { ok: true, kernel: arch.kernel, expected_sha256: expected, sources: [] };

	if (arch.kernel === '') {
		out.ok = false;
		out.msg = '无法识别设备架构, 请改用手动上传';
		return out;
	}

	out.fetcher = detect_fetcher();
	if (out.fetcher === '') {
		out.ok = false;
		out.msg = '设备上未找到 curl 或 uclient-fetch, 无法在线下载, 请使用手动上传';
		return out;
	}

	if (expected === '') {
		out.ok = false;
		out.msg = '该架构没有内置校验值, 为防止下载到错误文件, 请使用手动上传';
		return out;
	}

	// 资产名沿用上游命名习惯, 便于与上游产物对照
	let fname = 'chfs-linux-' + arch.kernel + '-' + KERNEL_VERSION;

	// Raw 路径不受 Release 是否已发布影响, 作为兜底始终列出。
	let raw_url = 'https://raw.githubusercontent.com/LianXia233/luci-app-chfs/main/chfs/bin/' + arch.kernel + '/chfs';

	let cands = [
		{ id: 'github-release', name: 'GitHub Release (官方)',
		  url: 'https://github.com/LianXia233/luci-app-chfs/releases/latest/download/' + fname },
		{ id: 'gh-acg2', name: 'gh.acg2.mom 镜像',
		  url: 'https://gh.acg2.mom/https://github.com/LianXia233/luci-app-chfs/releases/latest/download/' + fname },
		{ id: 'gh-proxy', name: 'gh-proxy.com 镜像',
		  url: 'https://gh-proxy.com/https://github.com/LianXia233/luci-app-chfs/releases/latest/download/' + fname },
		{ id: 'ghfast', name: 'ghfast.top 镜像',
		  url: 'https://ghfast.top/https://github.com/LianXia233/luci-app-chfs/releases/latest/download/' + fname },
		{ id: 'raw', name: 'GitHub Raw',
		  url: raw_url },
		{ id: 'raw-mirror', name: 'Raw 镜像 (gh.acg2.mom)',
		  url: 'https://gh.acg2.mom/' + raw_url }
	];

	for (let c in cands) {
		let r = http_probe(c.url, 5);

		c.available = r.available;
		c.http_code = r.code;
		c.sha256 = expected;

		// 探测结果回传 URL 供用户核对; 不暴露任何凭据。
		push(out.sources, c);
	}

	return out;
}

// 从白名单 URL 下载内核到 UPLOAD_DIR, 并强制校验内置 SHA256
function kernel_download(url) {
	if (url === null || '' + url === '')
		return { ok: false, msg: '下载地址不能为空' };

	url = '' + url;

	// 除了前缀白名单, 再拒绝空白/引号等容易被误用的字符
	if (match(url, /[\s"']/))
		return { ok: false, msg: '下载地址包含非法字符' };

	let allowed = false;
	for (let pre in ALLOWED_URL_PREFIXES) {
		if (substr(url, 0, length(pre)) === pre) {
			allowed = true;
			break;
		}
	}

	if (!allowed)
		return { ok: false, msg: '下载地址不在允许列表内, 仅支持从本仓库下载' };

	let arch = detect_arch();
	let expected = KERNEL_SHA256[arch.kernel] ?? '';

	if (expected === '')
		return { ok: false, msg: '当前架构没有内置校验值, 请使用手动上传' };

	let mk = popen('mkdir -p ' + shq(UPLOAD_DIR) + ' && chmod 700 ' + shq(UPLOAD_DIR) + ' 2>/dev/null');
	mk.read('all');
	mk.close();

	let target = UPLOAD_DIR + '/chfs-upload';

	// 下载前清理旧的同名产物, 避免失败时残留半截文件
	unlink(target);

	let fetcher = detect_fetcher();

	if (fetcher === '')
		return { ok: false, msg: '设备上未找到 curl 或 uclient-fetch, 无法下载, 请使用手动上传' };

	let cmd;
	if (fetcher === 'curl')
		cmd = 'curl -L -s -o ' + shq(target) + ' --max-filesize 67108864 --max-time 180 ' +
		      shq(url) + ' 2>&1';
	else
		cmd = 'uclient-fetch -q -T 180 -O ' + shq(target) + ' ' + shq(url) + ' 2>&1';

	let p = popen(cmd);
	let out = '' + (p.read('all') ?? '');
	let code = p.close();

	if (code != 0) {
		unlink(target);

		return { ok: false, msg: '下载失败 (退出码 ' + code + ')' + (trim(out) !== '' ? ': ' + trim(out) : '') };
	}

	let st = stat(target);
	if (st == null || st.size == 0 || st.type !== 'file') {
		unlink(target);
		return { ok: false, msg: '下载得到的文件为空或不是普通文件' };
	}

	if (st.size > 64 * 1024 * 1024) {
		unlink(target);
		return { ok: false, msg: '文件过大 (' + st.size + ' 字节), 超出合理范围' };
	}

	let m = elf_machine(target);
	if (m < 0) {
		unlink(target);
		return { ok: false, msg: '下载内容不是有效的 ELF 可执行文件, 可能被网络劫持或返回了错误页面', size: st.size };
	}

	let sum = file_sha256(target);
	if (sum !== expected) {
		unlink(target);

		return {
			ok: false,
			msg: 'SHA256 校验失败, 文件已删除。期望 ' + expected + ', 实际 ' + sum,
			sha256: sum,
			expected_sha256: expected
		};
	}

	return {
		ok: true,
		path: target,
		size: st.size,
		sha256: sum,
		expected_sha256: expected,
		verified: true,
		elf_machine: m,
		arch_match: (m == arch.elf_machine),
		device_arch: arch.arch,
		msg: '下载完成并通过 SHA256 校验, 可点击「安装」写入 ' + PROG
	};
}

// 列出 UPLOAD_DIR 中待安装的候选文件
function kernel_pending() {
	let out = { ok: true, files: [] };

	// 兼容从旧版本升级、尚未执行新版 uci-defaults 的设备
	if (stat(UPLOAD_DIR) == null) {
		let mk = popen('mkdir -p ' + shq(UPLOAD_DIR) + ' && chmod 700 ' + shq(UPLOAD_DIR) + ' 2>/dev/null');
		mk.read('all');
		mk.close();
	}

	if (stat(UPLOAD_DIR) == null)
		return out;

	let p = popen('ls -1 ' + shq(UPLOAD_DIR) + ' 2>/dev/null');
	let txt = '' + (p.read('all') ?? '');
	p.close();

	let arch = detect_arch();
	let expected = KERNEL_SHA256[arch.kernel] ?? '';

	for (let name in split(txt, '\n')) {
		name = trim(name);
		if (!safe_name(name))
			continue;

		let full = UPLOAD_DIR + '/' + name;
		let st = stat(full);
		if (st == null || st.type !== 'file')
			continue;

		let m = elf_machine(full);
		let sum = file_sha256(full);

		push(out.files, {
			name: name,
			path: full,
			size: st.size,
			elf_machine: m,
			is_elf: (m >= 0),
			arch_match: (m == arch.elf_machine),
			sha256: sum,
			verified: (expected !== '' && sum === expected)
		});
	}

	return out;
}

// 替换内核文件, 并保证 chfs 服务在动作结束后一定处于运行状态。
//
// 设计说明 (两次实测教训换来的):
//   1. 设备上**没有 install 命令** —— BusyBox 不含该 applet,
//      `install -m0755` 会得到退出码 127。
//   2. 不能依赖 `set -e`: 一旦中途失败就跳过后续的 start,
//      把服务遗留在停止状态 —— 这比"安装失败"本身更严重。
//   3. 也不能只靠 ucode 侧分步调用: ucode 的函数声明**顺序敏感**,
//      前向调用会触发 `access to undeclared variable` (实测),
//      异常直接冒泡出 rpcd, 同样让服务停在关闭状态。
//   故把整个动作收进一段 shell, 并用 `trap ... EXIT` 兜底:
//   无论脚本是正常结束、出错退出还是被信号打断, 服务都会被拉起。
//
// consume = true  -> 用 mv, 安装待安装文件 (消耗源文件)
// consume = false -> 用 cp, 还原备份 (保留备份文件)
//
// 返回 { ok, running, out }
function swap_kernel(from, to, consume) {
	let mover = 'cp';
	if (consume)
		mover = 'mv';

	let s = '';
	s += 'INIT=' + shq(INIT_SCRIPT) + '; ';
	s += 'FROM=' + shq(from) + '; ';
	s += 'TO=' + shq(to) + '; ';
	// 兜底: 任何退出路径都要把服务拉起来
	s += 'trap "$INIT start >/dev/null 2>&1" EXIT INT TERM; ';
	s += '$INIT stop >/dev/null 2>&1 || true; ';
	// 等进程真正退出, 避免替换仍被映射的可执行文件
	s += 'i=0; while [ $i -lt 10 ] && pidof chfs >/dev/null 2>&1; do sleep 1; i=$((i+1)); done; ';
	// 替换。mv 在同一分区是原子的 inode 替换
	s += 'if chmod 0755 "$FROM" && ' + mover + ' -f "$FROM" "$TO"; then echo SWAP_OK; ';
	s += 'else echo SWAP_FAIL; fi';

	let p = popen(s);
	let out = trim('' + (p.read('all') ?? ''));
	let code = p.close();

	// trap 已在本段 shell 退出时拉起服务, 给它时间完成启动
	popen('sleep 2').close();

	// 独立查询服务状态。
	// 这里刻意不调用其它自定义函数 —— ucode 的函数声明顺序敏感,
	// 跨函数调用是前两次故障的根源。
	let q = popen('pidof chfs 2>/dev/null');
	let pid = trim('' + (q.read('all') ?? ''));
	q.close();

	return {
		ok: (code == 0) && (match(out, /SWAP_OK/) != null),
		running: pid !== '',
		out: out
	};
}

// src 只允许是 UPLOAD_DIR 下的文件, 不接受任意路径。
function kernel_install(src) {
	if (src === null || '' + src === '')
		return { ok: false, msg: '未指定内核文件' };

	src = '' + src;

	// 路径必须落在 UPLOAD_DIR 内, 且文件名必须安全
	if (substr(src, 0, length(UPLOAD_DIR) + 1) !== UPLOAD_DIR + '/' ||
	    match(src, /\.\./))
		return { ok: false, msg: '非法的内核文件路径' };

	let base = substr(src, length(UPLOAD_DIR) + 1);
	if (!safe_name(base))
		return { ok: false, msg: '非法的内核文件名' };

	let st = stat(src);
	if (st == null || st.type !== 'file')
		return { ok: false, msg: '内核文件不存在: ' + src };

	if (st.size < 1024 * 100)
		return { ok: false, msg: '文件过小 (' + st.size + ' 字节), 不像是有效的内核' };

	if (st.size > 64 * 1024 * 1024)
		return { ok: false, msg: '文件过大 (' + st.size + ' 字节), 超出合理范围' };

	// 架构校验: 架构不符时直接运行会得到 "Exec format error"
	let arch = detect_arch();
	let m = elf_machine(src);

	if (m < 0)
		return { ok: false, msg: '不是有效的 ELF 可执行文件' };

	if (arch.elf_machine >= 0 && m != arch.elf_machine)
		return {
			ok: false,
			msg: '架构不匹配: 当前设备为 ' + arch.arch + ' (e_machine=' + arch.elf_machine +
			     '), 而该文件 e_machine=' + m + '。请确认下载了正确架构的内核'
		};

	// 备份现有内核。时间戳后缀, 保留多次。
	let bak = '';
	if (stat(PROG) != null) {
		let mk = popen('mkdir -p ' + shq(BACKUP_DIR) + ' 2>&1');
		mk.read('all');
		mk.close();

		let dp = popen('date +%Y%m%d-%H%M%S');
		let ts = trim('' + (dp.read('all') ?? ''));
		dp.close();

		if (ts !== '') {
			bak = BACKUP_DIR + '/chfs.' + ts;

			let cp = popen('cp -p ' + shq(PROG) + ' ' + shq(bak) + ' 2>&1');
			cp.read('all');
			let ccode = cp.close();

			if (ccode != 0)
				return {
					ok: false,
					msg: '备份现有内核失败, 已中止安装 (请检查 /etc/chfs 剩余空间)',
					backup: ''
				};
		}
	}

	let enabled = service_enabled();

	// 替换内核。swap_kernel 内部用 shell trap 兜底, 保证服务一定被拉起。
	let r = swap_kernel(src, PROG, true);

	// 替换本身失败: PROG 未被改动, 无需回滚
	if (!r.ok) {
		return {
			ok: false,
			msg: '安装失败, 原内核未被改动' + (r.out !== '' ? ': ' + r.out : '') +
			     (r.running ? '。服务已恢复运行'
			                : '。服务未能启动, 请手动检查'),
			backup: bak,
			rolled_back: false
		};
	}

	// 替换成功但服务起不来: 仅在服务本应启用时回滚。
	// 服务本来停用时, 安装成功但不拉起属于正常行为。
	if (!r.running && enabled) {
		let rolled = false;

		if (bak !== '')
			rolled = swap_kernel(bak, PROG, false).running;

		return {
			ok: false,
			msg: '新内核无法启动服务' + (rolled
				? ', 已回滚到备份内核并恢复运行'
				: (bak !== '' ? ', 回滚后服务仍未启动, 请手动检查' : ', 且无可用备份')),
			backup: bak,
			rolled_back: rolled
		};
	}

	let nst = stat(PROG);
	let nm = elf_machine(PROG);
	let msg = '内核已安装';

	if (r.running)
		msg += '并重启服务';
	else
		msg += '; 服务当前未启用或未运行, 启动后生效';

	return {
		ok: true,
		msg: msg,
		path: PROG,
		size: (nst != null ? nst.size : 0),
		sha256: file_sha256(PROG),
		elf_machine: nm,
		backup: bak,
		service_enabled: enabled,
		running: r.running,
		output: r.out
	};
}

// 列出内核备份
function kernel_backups() {
	let out = { ok: true, backups: [] };

	if (stat(BACKUP_DIR) == null)
		return out;

	let p = popen('ls -1t ' + shq(BACKUP_DIR) + '/chfs.* 2>/dev/null');
	let txt = '' + (p.read('all') ?? '');
	p.close();

	for (let f in split(txt, '\n')) {
		f = trim(f);
		if (f === '')
			continue;

		let st = stat(f);
		if (st == null || st.type !== 'file')
			continue;

		push(out.backups, {
			path: f,
			name: substr(f, length(BACKUP_DIR) + 1),
			size: st.size,
			sha256: file_sha256(f)
		});
	}

	return out;
}

// 把备份文件还原为内核。
// name 只接受 BACKUP_DIR 下的安全文件名, 用 basename 语义杜绝路径穿越。
function kernel_restore(name) {
	if (name === null || '' + name === '')
		return { ok: false, msg: '未指定备份文件' };

	name = '' + name;

	if (!safe_name(name))
		return { ok: false, msg: '非法的备份文件名' };

	let src = BACKUP_DIR + '/' + name;
	let st = stat(src);

	if (st == null || st.type !== 'file')
		return { ok: false, msg: '备份不存在: ' + name };

	// 备份文件也必须是合法 ELF, 防止被诱导安装垃圾内容
	if (elf_machine(src) < 0)
		return { ok: false, msg: '备份文件不是有效的 ELF 可执行文件' };

	let enabled = service_enabled();

	// 还原: consume=false 走 cp, 备份文件得以保留
	let r = swap_kernel(src, PROG, false);

	if (!r.ok)
		return { ok: false, msg: '回滚失败' + (r.out !== '' ? ': ' + r.out : '') };

	if (!r.running && enabled)
		return { ok: false, msg: '内核已还原但服务未能启动, 请手动检查' };

	let nst = stat(PROG);
	let note = r.running ? '' : '; 服务当前未启用或未运行, 启动后生效';

	return {
		ok: true,
		msg: '已回滚到 ' + name + note,
		path: PROG,
		size: (nst != null ? nst.size : 0),
		sha256: file_sha256(PROG),
		running: r.running,
		service_enabled: enabled
	};
}

// 删除 UPLOAD_DIR 中的某个待安装文件
function kernel_discard(name) {
	if (name === null || '' + name === '')
		return { ok: false, msg: '未指定文件' };

	name = '' + name;

	if (!safe_name(name))
		return { ok: false, msg: '非法的文件名' };

	let full = UPLOAD_DIR + '/' + name;
	let st = stat(full);

	if (st == null || st.type !== 'file')
		return { ok: false, msg: '文件不存在' };

	if (!unlink(full))
		return { ok: false, msg: '删除失败' };

	return { ok: true, msg: '已删除 ' + name };
}

// 删除某个内核备份。备份可能占满小容量闪存, 必须允许用户主动清理。
function kernel_backup_discard(name) {
	if (name === null || '' + name === '')
		return { ok: false, msg: '未指定备份文件' };

	name = '' + name;

	if (!safe_name(name))
		return { ok: false, msg: '非法的备份文件名' };

	let full = BACKUP_DIR + '/' + name;
	let st = stat(full);

	if (st == null || st.type !== 'file')
		return { ok: false, msg: '备份不存在: ' + name };

	if (!unlink(full))
		return { ok: false, msg: '删除失败' };

	return { ok: true, msg: '已删除备份 ' + name };
}

// ---------------------------------------------------------------------------
// ubus 对象声明
//
// 返回值必须是扁平的单键对象, 键名与文件名完全一致:
//   return { 'luci.chfs': methods };   // 文件名 luci.chfs -> ubus 对象 luci.chfs
// 写成嵌套的 { luci: { chfs: methods } } 不会注册成功.
//
// 另: 文件必须落在 /usr/share/rpcd/ucode/ 下且带可执行位, rpcd 才加载.
// ---------------------------------------------------------------------------

return {
	'luci.chfs': {
		init_action: {
			args: { action: '' },
			call: function(req) { return init_action(req.args.action); }
		},
		status: {
			call: function() { return service_status(); }
		},
		read_ini: {
			call: function() { return read_ini(); }
		},
		probe_listen: {
			call: function() { return probe_listen(); }
		},
		probe_webdav: {
			call: function() { return probe_webdav(); }
		},

		// --- 内核管理 ---
		kernel_info: {
			call: function() { return kernel_info(); }
		},
		kernel_sources: {
			call: function() { return kernel_sources(); }
		},
		kernel_pending: {
			call: function() { return kernel_pending(); }
		},
		kernel_backups: {
			call: function() { return kernel_backups(); }
		},
		kernel_download: {
			args: { url: '' },
			call: function(req) { return kernel_download(req.args.url); }
		},
		kernel_install: {
			args: { src: '' },
			call: function(req) { return kernel_install(req.args.src); }
		},
		kernel_restore: {
			args: { name: '' },
			call: function(req) { return kernel_restore(req.args.name); }
		},
		kernel_discard: {
			args: { name: '' },
			call: function(req) { return kernel_discard(req.args.name); }
		},
		kernel_backup_discard: {
			args: { name: '' },
			call: function(req) { return kernel_backup_discard(req.args.name); }
		}
	}
};
