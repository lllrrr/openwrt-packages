# chfs 配置文件
# 本文件由 LuCI 界面读写, 由 /etc/init.d/chfs 渲染为 chfs.ini 后启动服务.
#
# 注意: chfs 本体的命令行参数极少 (-path/-port/-file), 访问规则与账户权限
#       只能通过配置文件下发, 因此界面上的高级选项统一在此处落盘.

config chfs 'main'
	# 服务总开关
	option enabled '0'

	# HTTP 监听端口, 1-65535
	option port '8080'

	# 监听地址, 留空表示监听所有地址 (0.0.0.0)
	# 上游 chfs.ini 无对应键, 通过命令行 -addr 之外的绑定由防火墙控制
	option bind_addr ''

	# 共享根目录, 多个目录用 '|' 分隔
	# 目录名含空格时渲染阶段会自动加引号
	option path '/mnt/sda1'

	# 运行用户, 建议 non-root
	option run_as 'root'

	# IP 地址过滤 (白名单)
	# 语法: 单个地址 192.168.1.10 ; 网段 192.168.1.0/24 ; 多条目用 '|' 分隔
	# 留空表示不限制
	option allow ''

	# 是否启用全局匿名访问 (访客账户 guest)
	option anonymous '1'

	# 日志存放目录, 留空表示禁用日志
	option log_path ''

	# 页面标题
	option html_title 'chfs 文件共享'

	# 页面公告, 支持纯文本或反引号包裹的 HTML
	option html_notice ''

	# 图片缩略图预览
	option image_preview '0'

	# 下载目录策略: disable / leaf / enable
	option folder_download 'enable'

	# 会话超时, 单位分钟
	option session_timeout '30'

	# 文件删除模式: 1 系统回收站 / 2 chfs 专属回收站 / 3 真正删除
	option file_remove '1'

	# HTTPS 证书与私钥路径, 两者均填写才生效
	option ssl_cert ''
	option ssl_key ''

	# 是否将日志输出到系统日志 (procd stdout/stderr)
	option syslog '1'

	# WebDAV 说明:
	#   chfs 自 1.10 起默认支持 WebDAV, 与 HTTP 共用同一套访问规则和账户体系,
	#   访问地址固定为 <协议>://<主机>:<端口>/webdav, 上游未提供开关配置项,
	#   因此此处不设置"启用 WebDAV"选项, 避免产生无效开关。
	#   下列选项仅控制界面展示与连通性探测行为, 不影响服务端。
	option webdav_show '1'

# ---------------------------------------------------------------------------
# 账户配置, 每个 section 为一个账户
#   name        账户名, 访客账户固定为 guest 且不可删除
#   password    账户密码
#   rule_default 默认权限: none 禁止 / r 只读 / w 读写 / d 完全控制
#   rule_none   禁止访问的子目录, 多个用 '|' 分隔
#   rule_r      只读的子目录, 多个用 '|' 分隔
#   rule_w      读写的子目录, 多个用 '|' 分隔
#   rule_d      完全控制的子目录, 多个用 '|' 分隔
# ---------------------------------------------------------------------------

config account 'guest'
	option name 'guest'
	option password ''
	option rule_default 'r'
	option rule_none ''
	option rule_r ''
	option rule_w ''
	option rule_d ''

config account 'admin'
	option name 'admin'
	option password 'chfs'
	option rule_default 'd'
	option rule_none ''
	option rule_r ''
	option rule_w ''
	option rule_d ''
