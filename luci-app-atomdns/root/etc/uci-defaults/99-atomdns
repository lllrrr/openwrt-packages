#!/bin/sh
# UCI 默认值：仅在配置缺失时写入，避免覆盖用户改动
# 同时修正 rpcd 插件可执行位：git / GitHub API 推送可能把脚本权限压成 644，
# 而 rpcd 只加载带 owner 可执行位的插件（plugin.c 检查 S_IXUSR），否则 LuCI 的 ubus 方法不可用。

# uci-defaults 由 /etc/init.d/boot 以 source 方式执行，不依赖自身可执行位
RC=0

chmod 0755 /usr/libexec/rpcd/atomdns 2>/dev/null || {
	echo "99-atomdns: failed to set rpcd plugin executable bit" >&2
	RC=1
}

if ! uci -q get atomdns.main >/dev/null 2>&1; then
	uci set atomdns.main=atomdns || RC=1
	uci set atomdns.main.enabled='0' || RC=1
	uci set atomdns.main.dns_port='2053' || RC=1
	uci set atomdns.main.webui_port='9099' || RC=1
	uci set atomdns.main.config_dir='/etc/atomdns' || RC=1
	uci set atomdns.main.log_file='/tmp/atomdns.log' || RC=1
	uci commit atomdns || RC=1
fi

exit "$RC"
