{
	"luci-app-atomdns": {
		"description": "Grant read/write access to AtomDNS UCI and service status",
		"read": {
			"uci": ["atomdns"],
			"ubus": {
				"atomdns": ["status"]
			},
			"cgi-io": ["exec"]
		},
		"write": {
			"uci": ["atomdns"],
			"ubus": {
				"atomdns": ["restart"]
			}
		}
	}
}
