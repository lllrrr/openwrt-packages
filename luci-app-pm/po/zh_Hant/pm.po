msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Reboot"
msgstr "重啟"

msgid "PowerOff"
msgstr "關機"

msgid "Cancel"
msgstr "取消"

msgid "Are you sure?"
msgstr "您確定嗎？"

msgid "PowerManager"
msgstr "電源管理器"

msgid "Luci plugin that makes OpenWrt poweroff and reboot easy."
msgstr "一款讓OpenWrt的關機和重新開機更容易的Luci外掛"

msgid "Project Address"
msgstr "專案位址"

msgid "Do you want to reboot this system?"
msgstr "您要重新啟動此裝置嗎？"

msgid "Rebooting..."
msgstr "正在重新啟動..."

msgid "Waiting for device reconnect..."
msgstr "正在等待裝置重新連線..."

msgid "Reboot failed"
msgstr "重新啟動失敗"

msgid "Do you really want to shutdown the system? Problems may occur on unsupported devices."
msgstr "您真的要關機嗎？在不支援的裝置上可能會發生問題。"

msgid "Shutting down..."
msgstr "正在關機..."

msgid "The device is powering off..."
msgstr "裝置正在關機..."

msgid "PowerOff failed"
msgstr "關機失敗"

msgid "Warning: There are unsaved changes that will get lost on reboot!"
msgstr "警告：存在未保存的變更，重新啟動後將會丟失！"

msgid "Device unreachable! Still waiting for device..."
msgstr "裝置無法連線！仍在等待裝置重新連線..."

msgid "The device seems to have not powered off. It may not support poweroff."
msgstr "裝置似乎沒有關機，可能不支援關機功能。"
