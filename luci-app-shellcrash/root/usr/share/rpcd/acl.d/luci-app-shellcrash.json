{
	"luci-app-shellcrash": {
		"description": "Grant ShellCrash control, kernel parameter adjustment, panel deployment and config editing permissions",
		"read": {
			"file": {
				"/usr/libexec/luci-app-shellcrash/ctl.sh": [ "exec" ],
				"/usr/libexec/luci-app-shellcrash/ctl.sh *": [ "exec" ],
				"/usr/libexec/luci-app-shellcrash/dashboard.sh": [ "exec" ],
				"/usr/libexec/luci-app-shellcrash/dashboard.sh *": [ "exec" ],
				"/etc/ShellCrash/configs/ShellCrash.cfg": [ "read" ],
				"/etc/ShellCrash/configs/ShellCrash.cfg.bak": [ "read" ],
				"/etc/ShellCrash/configs/providers.cfg": [ "read" ],
				"/data/ShellCrash/configs/ShellCrash.cfg": [ "read" ],
				"/data/ShellCrash/configs/ShellCrash.cfg.bak": [ "read" ],
				"/tmp/ShellCrash/configs/ShellCrash.cfg": [ "read" ],
				"/tmp/ShellCrash/configs/ShellCrash.cfg.bak": [ "read" ]
			},
			"uci": [ "shellcrash" ]
		},
		"write": {
			"file": {
				"/usr/libexec/luci-app-shellcrash/ctl.sh": [ "exec" ],
				"/usr/libexec/luci-app-shellcrash/ctl.sh *": [ "exec" ],
				"/usr/libexec/luci-app-shellcrash/dashboard.sh": [ "exec" ],
				"/usr/libexec/luci-app-shellcrash/dashboard.sh *": [ "exec" ],
				"/etc/ShellCrash/configs/ShellCrash.cfg": [ "read", "write" ],
				"/etc/ShellCrash/configs/ShellCrash.cfg.bak": [ "read", "write" ],
				"/etc/ShellCrash/configs/providers.cfg": [ "read", "write" ],
				"/data/ShellCrash/configs/ShellCrash.cfg": [ "read", "write" ],
				"/data/ShellCrash/configs/ShellCrash.cfg.bak": [ "read", "write" ],
				"/tmp/ShellCrash/configs/ShellCrash.cfg": [ "read", "write" ],
				"/tmp/ShellCrash/configs/ShellCrash.cfg.bak": [ "read", "write" ],
				"/etc/config/shellcrash": [ "read", "write" ]
			},
			"uci": [ "shellcrash" ]
		}
	}
}
