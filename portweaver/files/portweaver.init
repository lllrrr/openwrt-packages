#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
PROG=/usr/bin/portweaver
LOG_PROC=/usr/bin/portweaver-log-processor

start_service() {
	local enabled log_enabled max_log_size max_log_files
	
	config_load portweaver 2>/dev/null
	config_get_bool enabled global enabled 1
	config_get_bool log_enabled global log_enabled 1
	config_get max_log_size global max_log_size 1024
	config_get max_log_files global max_log_files 3
	
	[ "$enabled" -eq 0 ] && return 0
	
	procd_open_instance
	
	if [ "$log_enabled" -eq 1 ] && [ -x "$LOG_PROC" ]; then
		procd_set_param command /bin/sh -c "$PROG 2>&1 | $LOG_PROC /tmp/portweaver.log $max_log_size $max_log_files"
	elif [ "$log_enabled" -eq 1 ]; then
		procd_set_param command /bin/sh -c "$PROG >> /tmp/portweaver.log 2>&1"
	else
		procd_set_param command $PROG
	fi
	
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger portweaver
}

reload_service() {
	restart
}
