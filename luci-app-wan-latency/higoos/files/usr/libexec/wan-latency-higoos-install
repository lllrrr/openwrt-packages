#!/bin/sh
set -eu

index=/www/higoros/index.html
asset=/www/higoros/higo-wan-latency-native.js
source=/usr/share/wan-latency/higoos/higo-wan-latency-native.js
tag='    <script defer src="/higo-wan-latency-native.js?v=1.3.0"></script>'

case "${1:-install}" in
  install)
    [ -f "$index" ] || { echo "HigoOS frontend not detected; integration skipped"; exit 0; }
    grep -q 'Hiveton HigoOS\|HigoOS' "$index" || { echo "HigoOS signature not found; integration skipped"; exit 0; }
    [ -f "$source" ] || { echo "HigoOS integration asset is missing" >&2; exit 1; }
    cp "$source" "$asset"
    chmod 644 "$asset"
    mkdir -p /www/higoros/wan-latency-native
    ln -sf /tmp/wan-latency-latest.json /www/higoros/wan-latency-native/latest.json
    [ -f "$index.wan-latency.bak" ] || cp -p "$index" "$index.wan-latency.bak"
    sed -i '/higo-wan-latency-.*\.js/d' "$index"
    sed -i "s#</head>#$tag\n  </head>#" "$index"
    rm -f /www/higoros/higo-wan-latency-menu.js \
      /www/higoros/higo-wan-latency-menu-v2.js \
      /www/higoros/higo-wan-latency-other-v3.js \
      /www/higoros/higo-wan-latency-native-v4.js
    echo "HigoOS WAN latency integration installed"
    ;;
  remove)
    if [ -f "$index" ]; then
      sed -i '/higo-wan-latency-.*\.js/d' "$index"
    fi
    rm -f "$asset" /www/higoros/higo-wan-latency-menu.js \
      /www/higoros/higo-wan-latency-menu-v2.js \
      /www/higoros/higo-wan-latency-other-v3.js \
      /www/higoros/higo-wan-latency-native-v4.js \
      /www/higoros/wan-latency-native/latest.json
    rmdir /www/higoros/wan-latency-native 2>/dev/null || true
    echo "HigoOS WAN latency integration removed"
    ;;
  *)
    echo "usage: $0 {install|remove}" >&2
    exit 2
    ;;
esac
