config gately 'gately'
	option enabled       '0'
	option port          '16680'
	option safe_url      ''
	option internet_access '0'
	option delay         '60'
	option configdir     '/etc/gately'
	option binpath       '/usr/bin/gately'
	option arch          'auto'
	option release_type  'stable'
	option respawn_threshold '3600'
	option respawn_timeout '30'
	option respawn_retry '5'
	option auto_update   '0'
	option update_interval '7'
	option update_time   '03:00'
	option update_cron   ''
	option github_mirror ''
	option installed_version ''
	option theme 'auto'
	option bg '1'
