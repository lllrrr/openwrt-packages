#: applications/luci-app-caddy/htdocs/luci-static/resources/view/caddy/basic.js:109
msgid "Caddy is a scalable server platform with automatic HTTPS, a fast and extensible multi-platform HTTP/1-2-3 web server."
msgstr "Caddy 是一個可擴展的伺服器平台，具有自動 HTTPS 功能的快速且可擴展的多平台 HTTP/1-2-3 Web 伺服器"

#: applications/luci-app-caddy/htdocs/luci-static/resources/view/caddy/basic.js:110
msgid "Project URL"
msgstr "專案網址"

#: applications/luci-app-caddy/htdocs/luci-static/resources/view/caddy/basic.js:111
msgid "Documentation"
msgstr "文件"

#: applications/luci-app-caddy/htdocs/luci-static/resources/view/caddy/basic.js:129
msgid "Basic Options"
msgstr "基本設定"

#: applications/luci-app-caddy/htdocs/luci-static/resources/view/caddy/basic.js:130
msgid "Advanced Options"
msgstr "進階選項"

#: applications/luci-app-caddy/htdocs/luci-static/resources/view/caddy/basic.js:131
msgid "WebDAV"
msgstr "WebDAV"

#: applications/luci-app-caddy/htdocs/luci-static/resources/view/caddy/basic.js:133
