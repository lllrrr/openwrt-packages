{
    "luci-app-devicemaster": {
        "description": "Grant access to DeviceMaster configuration, runtime cache and LuCI APIs",
        "read": {
            "uci": [ "devicemaster" ],
            "file": {
                "/tmp/devicemaster_device_cache": [ "read" ],
                "/tmp/dm_snapshot.json": [ "read" ]
            }
        },
        "write": {
            "uci": [ "devicemaster" ],
            "file": {
                "/tmp/devicemaster_device_cache": [ "write" ],
                "/tmp/dm_page_active": [ "write" ],
                "/tmp/dm_mode": [ "write" ]
            }
        }
    }
}
