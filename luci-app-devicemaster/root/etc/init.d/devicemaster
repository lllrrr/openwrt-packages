#!/bin/sh /etc/rc.common
# DeviceMaster Init Script
# Architecture: Event-driven + On-demand
# Copyright (C) 2024 OpenWrt-DeviceMaster Project

START=99
STOP=10
USE_PROCD=1

NAME="devicemaster"
EVENT_HANDLER="/usr/libexec/devicemaster/event_handler.sh"
UCI_INIT="/usr/libexec/devicemaster/uci_init.sh"

# Shared, idempotent UCI bootstrap (global/settings sections, template cleanup,
# built-in groups). Sourced here as well as from 90_devicemaster so the two
# entry points can never drift apart again.
[ -f "$UCI_INIT" ] && . "$UCI_INIT"

start_service() {
	# Create runtime directories
	mkdir -p /var/run/devicemaster
	mkdir -p /tmp/devicemaster
	# Home of the user-maintained OUI override table (oui_append.txt). Under
	# /etc so it survives a firmware upgrade.
	mkdir -p /etc/devicemaster

	# Publish the RAM-backed cross-node files at their public URLs (symlinks).
	dm_setup_web_links

	# Ensure scripts are executable (uci_init.sh is sourced, so it must exist
	# before the first dm_* call as well - hence the chmod happens first).
	chmod +x /usr/libexec/devicemaster/*.sh 2>/dev/null

	# Bootstrap UCI: global section, named settings section, prune empty
	# template stanzas left behind by older packages, create built-in groups.
	# Everything below is idempotent, so this is safe on every start.
	command -v dm_bootstrap_uci >/dev/null 2>&1 && dm_bootstrap_uci

	# Initialize session data from UCI (load into RAM, avoid Flash writes)
	init_session_json

	# Clean up old cache files (no longer needed)
	rm -f /tmp/devicemaster_device_cache /tmp/devicemaster_custom_cache

	# Sweep scratch files orphaned by a previous run that was SIGKILLed.
	# dnsmasq kills its --dhcp-script on timeout and SIGKILL cannot be trapped,
	# so event_handler.sh can leave /tmp/nlbw_proto_<pid>, /tmp/dm_http.<pid>
	# directories and score files behind. event_handler.sh reaps them on every
	# entry as well; this is the belt-and-braces pass for a cold boot, when a
	# PID from the previous boot may have been reused by an unrelated process.
	rm -rf /tmp/nlbw_proto_* /tmp/dm_http.* /tmp/dm_cleanup_seen.* \
	       /tmp/devicemaster_mdns_cache.* \
	       /tmp/devicemaster_vendor_score_* /tmp/devicemaster_type_score_* \
	       /tmp/devicemaster_debug_vendor_* /tmp/devicemaster_debug_type_* 2>/dev/null

	# Setup nftables chain for traffic control
	setup_nftables

	# Restore blocked devices from UCI config
	restore_blocked_devices

	# Configure DHCP script for automatic device registration
	setup_dhcp_script

	# Clean up duplicate dhcp host entries (caused by previous bug)
	cleanup_duplicate_hosts

	# NOTE: there is no ubus daemon instance - devicemasterd was removed as
	# dead code (it was never started and nothing called it).

	# Start device monitor (event-driven, dual mode idle/active)
	procd_open_instance "device_monitor"
	procd_set_param command /usr/libexec/devicemaster/device_monitor.sh
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-60} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Save runtime session data back to UCI before stopping
	flush_session_to_uci
	cleanup_nftables
}

# ============================================================
# Cross-node data file: real file in /tmp, public URL via symlink
# ============================================================
# /www sits on the overlay filesystem. snapshot_writer.lua (cron, every minute)
# used to write there directly, i.e. 1440 flash writes per node per day for
# data that is regenerated from scratch each cycle. That is directly against
# the flash-wear policy stated in /etc/cron.d/devicemaster ("Flush runtime
# session data from RAM to Flash every 12 hours - Avoids Flash wear").
#
# The real file now lives in /tmp (tmpfs) and this symlink keeps the
# /luci-static/resources/dm_snapshot.json URL working for the sub-node HTTP
# polling (curl in snapshot_writer.lua and devicemaster.lua fetch a peer's
# copy). uhttpd serves the target transparently - it open()s the path it is
# given. The target is seeded first so the symlink resolves immediately.
dm_setup_web_links() {
	local dir="/www/luci-static/resources"
	mkdir -p "$dir" 2>/dev/null

	[ -f /tmp/dm_snapshot.json ] || echo '{"_ts":0,"role":"master","dhcp_leases":{},"arp":{},"wifi_stations":{},"fdb_macs":{},"child_reports":{},"devices":{},"master_mac":"","master_ip":"","online_macs":{}}' > /tmp/dm_snapshot.json

	# Drop whatever is there: a real file left behind by an older package
	# (whose write frequency is exactly the problem being fixed) or a stale
	# symlink from a previous boot.
	rm -f "$dir/dm_snapshot.json" 2>/dev/null
	ln -sf /tmp/dm_snapshot.json "$dir/dm_snapshot.json" 2>/dev/null

	# An older package also published dm_sub_stations.json here. Nothing ever
	# read it (the real sub-node report is POSTed to /api/report_sub), it has
	# been removed from device_monitor.sh, and the leftover is cleared so it
	# cannot be mistaken for live data.
	rm -f "$dir/dm_sub_stations.json" 2>/dev/null

	if [ -r "$dir/dm_snapshot.json" ]; then
		logger -t devicemaster "Web links ready: $dir/dm_snapshot.json -> /tmp/dm_snapshot.json"
	else
		logger -t devicemaster "WARN: could not publish $dir/dm_snapshot.json (sub nodes will not see the master snapshot)"
	fi
}

# Full cleanup: called by uninstall.sh or opkg postrm
# Removes all residual configs, DHCP entries, and files
service_cleanup() {
	logger -t devicemaster "Running full cleanup..."

	# Stop and disable service
	stop 2>/dev/null
	disable 2>/dev/null

	# Remove nftables rules
	cleanup_nftables

	# Skip DHCP cleanup on mesh child nodes
	if ! is_mesh_child_node; then
		# Remove DHCP event handler reference
		local current=$(uci -q get dhcp.@dnsmasq[0].dhcpscript 2>/dev/null)
		if [ "$current" = "$EVENT_HANDLER" ]; then
			uci -q delete dhcp.@dnsmasq[0].dhcpscript
			uci -q commit dhcp
		fi

		# Remove all DHCP host entries created by DeviceMaster
		local idx=0
		while uci -q get "dhcp.@host[$idx]" >/dev/null 2>&1; do
			uci -q delete "dhcp.@host[$idx]" 2>/dev/null
		done
		uci -q commit dhcp 2>/dev/null
		/etc/init.d/dnsmasq restart 2>/dev/null
	fi

	# Remove UCI config
	rm -f /etc/config/devicemaster

	# Remove cron jobs
	rm -f /etc/cron.d/devicemaster

	# Remove runtime files
	rm -f /www/luci-static/resources/dm_snapshot.json
	rm -f /www/luci-static/resources/dm_sub_stations.json
	rm -rf /var/run/devicemaster /tmp/devicemaster
	rm -f /tmp/devicemaster_device_cache /tmp/devicemaster_custom_cache
	rm -f /tmp/devicemaster_uci_cache /tmp/devicemaster_oui_cache.txt
	rm -f /tmp/devicemaster_mdns_cache /tmp/devicemaster_nlbwmon_cache
	rm -f /tmp/oui_download_result.txt /tmp/oui_api_test_result.txt
	rm -f /tmp/oui.csv /tmp/nlbw_proto_*
	# Scratch artefacts from event_handler.sh (see dm_sweep_tmp_orphans there)
	rm -rf /tmp/dm_http.* /tmp/dm_cleanup_seen.* /tmp/devicemaster_mdns_cache.*
	rm -f /tmp/devicemaster_vendor_score_* /tmp/devicemaster_type_score_*
	rm -f /tmp/devicemaster_debug_vendor_* /tmp/devicemaster_debug_type_*

	# Remove ACL config
	rm -f /usr/share/rpcd/acl.d/luci-app-devicemaster.json

	# Remove uci-defaults script
	rm -f /etc/uci-defaults/90_devicemaster

	# Remove OUI database and caches
	rm -f /usr/share/devicemaster/oui.txt
	rm -f /usr/share/devicemaster/oui_cache.txt
	rmdir /usr/share/devicemaster 2>/dev/null

	# User-maintained OUI overrides live under /etc now (see oui_lookup.sh).
	rm -f /etc/devicemaster/oui_append.txt
	rmdir /etc/devicemaster 2>/dev/null

	# Remove plugin scripts
	rm -rf /usr/libexec/devicemaster

	# Remove LuCI files
	rm -f /usr/lib/lua/luci/controller/devicemaster.lua
	rm -f /usr/lib/lua/luci/model/cbi/devicemaster/settings.lua
	rm -rf /usr/lib/lua/luci/view/devicemaster
	rm -rf /htdocs/luci-static/resources/view/devicemaster
	rm -f /usr/lib/lua/luci/i18n/devicemaster.*.lmo

	logger -t devicemaster "Full cleanup complete"
}

# Check if this device is a mesh child node (not the main router)
# Mesh child nodes should not modify dhcp config
is_mesh_child_node() {
	# Check if wpad/wpad-mesh is running and this is a mesh station
	local mesh_mode=$(uci -q get wireless.mesh0 2>/dev/null || uci -q get wireless.mesh0_0 2>/dev/null)
	local dhcp_enabled=$(uci -q get dhcp.lan.ignore 2>/dev/null)
	
	# If mesh interface exists and dhcp is disabled (common in mesh child nodes), skip dhcp modifications
	if [ -n "$mesh_mode" ] && [ "$dhcp_enabled" = "1" ]; then
		logger -t devicemaster "Detected mesh child node, skipping dhcp configuration"
		return 0
	fi
	return 1
}

# Configure dnsmasq to call our event handler on DHCP lease changes
setup_dhcp_script() {
	[ ! -x "$EVENT_HANDLER" ] && return

	# If this is a mesh child node, ensure dhcpscript is NOT configured
	# This handles the case where device was previously a main router
	if is_mesh_child_node; then
		local current=$(uci -q get dhcp.@dnsmasq[0].dhcpscript 2>/dev/null)
		if [ "$current" = "$EVENT_HANDLER" ]; then
			uci -q delete dhcp.@dnsmasq[0].dhcpscript
			uci -q commit dhcp
			logger -t devicemaster "Removed DHCP event handler (mesh child node)"
		fi
		return
	fi

	# Check if dhcpscript is already configured
	local current=$(uci -q get dhcp.@dnsmasq[0].dhcpscript 2>/dev/null)
	if [ "$current" = "$EVENT_HANDLER" ]; then
		return
	fi

	# Set DHCP script
	uci -q set dhcp.@dnsmasq[0].dhcpscript="$EVENT_HANDLER"
	uci -q commit dhcp

	logger -t devicemaster "Configured DHCP event handler"
}

setup_nftables() {
	nft list table inet devicemaster 2>/dev/null && return 0

	nft add table inet devicemaster
	nft add chain inet devicemaster dm_block { type filter hook forward priority 0 \; }
	nft add chain inet devicemaster dm_block_input { type filter hook input priority 0 \; }
	nft add chain inet devicemaster dm_limit { type filter hook forward priority 1 \; }
	nft add set inet devicemaster blocked_macs { type ether_addr \; }
	nft add set inet devicemaster limited_macs { type ether_addr \; flags timeout \; }

	nft add rule inet devicemaster dm_block ether saddr @blocked_macs drop
	nft add rule inet devicemaster dm_block ether daddr @blocked_macs drop
	nft add rule inet devicemaster dm_block_input ether saddr @blocked_macs drop
	nft add rule inet devicemaster dm_block_input ether daddr @blocked_macs drop
}

# Does the anonymous device section #$1 exist?
#
# The scan loops below must test the *section*, not its mac: `[ -z "$mac" ] &&
# break` aborts the whole scan at an empty stanza, and older packages shipped
# exactly such a stanza at index 0 - so blocked devices were never restored and
# session data was never loaded from Flash. Empty stanzas are skipped instead.
device_section_exists() {
	uci -q get "devicemaster.@device[$1]" >/dev/null 2>&1
}

restore_blocked_devices() {
	local idx=0
	while device_section_exists "$idx"; do
		local mac=$(uci -q get "devicemaster.@device[$idx].mac" 2>/dev/null)
		if [ -z "$mac" ]; then
			idx=$((idx + 1))
			continue
		fi
		local blocked=$(uci -q get "devicemaster.@device[$idx].blocked" 2>/dev/null)
		if [ "$blocked" = "1" ]; then
			nft add element inet devicemaster blocked_macs { "$mac" } 2>/dev/null
			logger -t devicemaster "Restored block for $mac"
		fi
		idx=$((idx + 1))
	done
}

cleanup_nftables() {
	nft delete table inet devicemaster 2>/dev/null
}

# Ensure UCI settings section exists (lost on config re-creation).
# Superseded by dm_ensure_settings() in uci_init.sh - kept as a thin alias so
# that any external caller (old cron job, user script) does not break.
ensure_settings() {
	[ -f "$UCI_INIT" ] && . "$UCI_INIT"
	dm_ensure_settings
}

# Initialize session.json from UCI (runtime data → RAM)
# Called once at service start to avoid repeated Flash reads/writes
init_session_json() {
	local file="/var/run/devicemaster/session.json"
	[ -f "$file" ] && return  # Already exists from previous start

	local first=true
	echo '{"devices":{' > "$file"
	local idx=0
	while device_section_exists "$idx"; do
		local mac=$(uci -q get "devicemaster.@device[$idx].mac" 2>/dev/null)
		if [ -z "$mac" ]; then
			idx=$((idx + 1))
			continue
		fi

		[ "$first" = false ] && echo "," >> "$file"
		first=false

		local upper_mac=$(echo "$mac" | tr 'a-f' 'A-F')
		local first_seen=$(uci -q get "devicemaster.@device[$idx].first_seen" 2>/dev/null)
		local last_seen=$(uci -q get "devicemaster.@device[$idx].last_seen" 2>/dev/null)
		local total_time=$(uci -q get "devicemaster.@device[$idx].total_online_time" 2>/dev/null)
		local session_start=$(uci -q get "devicemaster.@device[$idx].current_session_start" 2>/dev/null)

		printf '"%s":{' "$upper_mac" >> "$file"
		local sep=""
		[ -n "$first_seen" ] && printf '%s"first_seen":%s' "$sep" "$first_seen" >> "$file" && sep=","
		[ -n "$last_seen" ] && printf '%s"last_seen":%s' "$sep" "$last_seen" >> "$file" && sep=","
		[ -n "$total_time" ] && printf '%s"total_online_time":%s' "$sep" "$total_time" >> "$file" && sep=","
		[ -n "$session_start" ] && printf '%s"current_session_start":%s' "$sep" "$session_start" >> "$file" && sep=","
		printf '}' >> "$file"

		idx=$((idx + 1))
	done
	echo '}}' >> "$file"

	logger -t devicemaster "Session data initialized for $idx devices"
}

# Flush session.json runtime data back to UCI (RAM → Flash)
# Called on service stop and every 12 hours via cron
flush_session_to_uci() {
	local lock="/var/run/devicemaster/flush.lock"
	[ -f "$lock" ] && return  # Already flushing
	touch "$lock"

	local file="/var/run/devicemaster/session.json"
	if [ ! -f "$file" ]; then
		rm -f "$lock"
		return
	fi

	local changed=0
	local idx=0
	while device_section_exists "$idx"; do
		local mac=$(uci -q get "devicemaster.@device[$idx].mac" 2>/dev/null)
		if [ -z "$mac" ]; then
			idx=$((idx + 1))
			continue
		fi

		local upper_mac=$(echo "$mac" | tr 'a-f' 'A-F')

		local first_seen=$(jsonfilter -i "$file" -e "@.devices[\"$upper_mac\"].first_seen" 2>/dev/null)
		local last_seen=$(jsonfilter -i "$file" -e "@.devices[\"$upper_mac\"].last_seen" 2>/dev/null)
		local total_time=$(jsonfilter -i "$file" -e "@.devices[\"$upper_mac\"].total_online_time" 2>/dev/null)
		local session_start=$(jsonfilter -i "$file" -e "@.devices[\"$upper_mac\"].current_session_start" 2>/dev/null)

		if [ -n "$first_seen" ]; then
			uci -q set "devicemaster.@device[$idx].first_seen=$first_seen"
			changed=1
		fi
		if [ -n "$last_seen" ]; then
			uci -q set "devicemaster.@device[$idx].last_seen=$last_seen"
			changed=1
		fi
		if [ -n "$total_time" ]; then
			uci -q set "devicemaster.@device[$idx].total_online_time=$total_time"
			changed=1
		fi
		if [ -n "$session_start" ]; then
			uci -q set "devicemaster.@device[$idx].current_session_start=$session_start"
			changed=1
		fi

		idx=$((idx + 1))
	done

	if [ "$changed" = "1" ]; then
		uci -q commit devicemaster
		logger -t devicemaster "Session data flushed to UCI ($idx devices)"
	fi

	rm -f "$lock"
}

# Remove duplicate dhcp host entries for the same MAC
# Previous bug in sync_to_dnsmasq created multiple entries per MAC
cleanup_duplicate_hosts() {
	# Skip on mesh child nodes
	is_mesh_child_node && return

	local changed=0
	# Collect all MACs that appear more than once
	local macs=$(uci -q show dhcp | grep '@host\[' | grep '\.mac=' | sed "s/.*mac='//;s/'//" | sort | uniq -d)
	[ -z "$macs" ] && return

	for mac in $macs; do
		local count=0
		local idx=0
		while uci -q get "dhcp.@host[$idx].mac" >/dev/null 2>&1; do
			local hm=$(uci -q get "dhcp.@host[$idx].mac")
			if [ "$hm" = "$mac" ]; then
				count=$((count + 1))
				if [ "$count" -gt 1 ]; then
					uci -q delete "dhcp.@host[$idx]"
					changed=1
					continue  # Don't increment idx after delete
				fi
			fi
			idx=$((idx + 1))
		done
	done

	if [ "$changed" = "1" ]; then
		uci -q commit dhcp
		logger -t devicemaster "Cleaned up duplicate dhcp host entries"
	fi
}

reload_service() {
	stop
	start
}

service_triggers() {
	# NOTE: Disabled to prevent unintended service restart on UCI config changes
	# procd_add_reload_trigger "devicemaster"
	:
}

# CLI: /etc/init.d/devicemaster flush_session
# Called by cron every 12 hours to persist runtime session data to Flash
flush_session() {
	flush_session_to_uci
}
