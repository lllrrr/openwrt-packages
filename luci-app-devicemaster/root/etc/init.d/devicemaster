#!/bin/sh /etc/rc.common
# DeviceMaster Init Script
# Architecture: Event-driven + On-demand
# Copyright (C) 2024 OpenWrt-DeviceMaster Project

START=99
STOP=10
USE_PROCD=1

NAME="devicemaster"
PROG="/usr/libexec/devicemaster/devicemasterd"
OUI_DB="/usr/share/devicemaster/oui.txt"
EVENT_HANDLER="/usr/libexec/devicemaster/event_handler.sh"

start_service() {
	# Create runtime directories
	mkdir -p /var/run/devicemaster
	mkdir -p /tmp/devicemaster

	# Clean up old cache files (no longer needed)
	rm -f /tmp/devicemaster_device_cache /tmp/devicemaster_custom_cache

	# Setup nftables chain for traffic control
	setup_nftables

	# Restore blocked devices from UCI config
	restore_blocked_devices

	# Ensure scripts are executable
	chmod +x /usr/libexec/devicemaster/sync_hostname.sh 2>/dev/null

	# Configure DHCP script for automatic device registration
	setup_dhcp_script

	# Clean up duplicate dhcp host entries (caused by previous bug)
	cleanup_duplicate_hosts

	# Start the main ubus daemon
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# Start traffic monitor
	procd_open_instance "traffic_monitor"
	procd_set_param command /usr/libexec/devicemaster/traffic_monitor.sh
	procd_set_param respawn
	procd_close_instance

	# Start device monitor (event-driven, no cache maintenance)
	procd_open_instance "device_monitor"
	procd_set_param command /usr/libexec/devicemaster/device_monitor.sh
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	cleanup_nftables
}

# Full cleanup: called by uninstall.sh or opkg postrm
# Removes all residual configs, DHCP entries, and files
service_cleanup() {
	logger -t devicemaster "Running full cleanup..."

	# Stop and disable service
	stop 2>/dev/null
	disable 2>/dev/null

	# Remove nftables rules
	cleanup_nftables

	# Remove DHCP event handler reference
	local current=$(uci -q get dhcp.@dnsmasq[0].dhcpscript 2>/dev/null)
	if [ "$current" = "$EVENT_HANDLER" ]; then
		uci -q delete dhcp.@dnsmasq[0].dhcpscript
		uci -q commit dhcp
	fi

	# Remove all DHCP host entries created by DeviceMaster
	local idx=0
	while uci -q get "dhcp.@host[$idx]" >/dev/null 2>&1; do
		uci -q delete "dhcp.@host[$idx]" 2>/dev/null
	done
	uci -q commit dhcp 2>/dev/null
	/etc/init.d/dnsmasq restart 2>/dev/null

	# Remove UCI config
	rm -f /etc/config/devicemaster

	# Remove cron jobs
	rm -f /etc/cron.d/devicemaster

	# Remove runtime files
	rm -rf /var/run/devicemaster /tmp/devicemaster
	rm -f /tmp/devicemaster_device_cache /tmp/devicemaster_custom_cache
	rm -f /tmp/devicemaster_uci_cache /tmp/devicemaster_oui_cache.txt
	rm -f /tmp/devicemaster_mdns_cache /tmp/devicemaster_nlbwmon_cache
	rm -f /tmp/oui_download_result.txt /tmp/oui_api_test_result.txt
	rm -f /tmp/oui.csv /tmp/nlbw_proto_*

	# Remove ACL config
	rm -f /usr/share/rpcd/acl.d/luci-app-devicemaster.json

	# Remove uci-defaults script
	rm -f /etc/uci-defaults/90_devicemaster

	# Remove OUI database and caches
	rm -f /usr/share/devicemaster/oui.txt
	rm -f /usr/share/devicemaster/oui_cache.txt
	rm -f /usr/share/devicemaster/oui_append.txt
	rmdir /usr/share/devicemaster 2>/dev/null

	# Remove plugin scripts
	rm -rf /usr/libexec/devicemaster

	# Remove LuCI files
	rm -f /usr/lib/lua/luci/controller/devicemaster.lua
	rm -f /usr/lib/lua/luci/model/cbi/devicemaster/settings.lua
	rm -rf /usr/lib/lua/luci/view/devicemaster
	rm -rf /htdocs/luci-static/resources/view/devicemaster
	rm -f /usr/lib/lua/luci/i18n/devicemaster.*.lmo

	logger -t devicemaster "Full cleanup complete"
}

# Configure dnsmasq to call our event handler on DHCP lease changes
setup_dhcp_script() {
	[ ! -x "$EVENT_HANDLER" ] && return

	# Check if dhcpscript is already configured
	local current=$(uci -q get dhcp.@dnsmasq[0].dhcpscript 2>/dev/null)
	if [ "$current" = "$EVENT_HANDLER" ]; then
		return
	fi

	# Set DHCP script
	uci -q set dhcp.@dnsmasq[0].dhcpscript="$EVENT_HANDLER"
	uci -q commit dhcp

	logger -t devicemaster "Configured DHCP event handler"
}

setup_nftables() {
	nft list table inet devicemaster 2>/dev/null && return 0

	nft add table inet devicemaster
	nft add chain inet devicemaster dm_block { type filter hook forward priority 0 \; }
	nft add chain inet devicemaster dm_block_input { type filter hook input priority 0 \; }
	nft add chain inet devicemaster dm_limit { type filter hook forward priority 1 \; }
	nft add set inet devicemaster blocked_macs { type ether_addr \; }
	nft add set inet devicemaster limited_macs { type ether_addr \; flags timeout \; }

	nft add rule inet devicemaster dm_block ether saddr @blocked_macs drop
	nft add rule inet devicemaster dm_block ether daddr @blocked_macs drop
	nft add rule inet devicemaster dm_block_input ether saddr @blocked_macs drop
	nft add rule inet devicemaster dm_block_input ether daddr @blocked_macs drop
}

restore_blocked_devices() {
	local idx=0
	while true; do
		local mac=$(uci -q get "devicemaster.@device[$idx].mac" 2>/dev/null)
		[ -z "$mac" ] && break
		local blocked=$(uci -q get "devicemaster.@device[$idx].blocked" 2>/dev/null)
		if [ "$blocked" = "1" ]; then
			nft add element inet devicemaster blocked_macs { "$mac" } 2>/dev/null
			logger -t devicemaster "Restored block for $mac"
		fi
		idx=$((idx + 1))
	done
}

cleanup_nftables() {
	nft delete table inet devicemaster 2>/dev/null
}

# Remove duplicate dhcp host entries for the same MAC
# Previous bug in sync_to_dnsmasq created multiple entries per MAC
cleanup_duplicate_hosts() {
	local changed=0
	# Collect all MACs that appear more than once
	local macs=$(uci -q show dhcp | grep '@host\[' | grep '\.mac=' | sed "s/.*mac='//;s/'//" | sort | uniq -d)
	[ -z "$macs" ] && return

	for mac in $macs; do
		local count=0
		local idx=0
		while uci -q get "dhcp.@host[$idx].mac" >/dev/null 2>&1; do
			local hm=$(uci -q get "dhcp.@host[$idx].mac")
			if [ "$hm" = "$mac" ]; then
				count=$((count + 1))
				if [ "$count" -gt 1 ]; then
					uci -q delete "dhcp.@host[$idx]"
					changed=1
					continue  # Don't increment idx after delete
				fi
			fi
			idx=$((idx + 1))
		done
	done

	if [ "$changed" = "1" ]; then
		uci -q commit dhcp
		logger -t devicemaster "Cleaned up duplicate dhcp host entries"
	fi
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "devicemaster"
}
