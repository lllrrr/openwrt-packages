#!/bin/sh
# UCI defaults for DeviceMaster - runs once after package install/upgrade.
#
# NOTE: the old version of this script guarded everything behind
#   [ ! -f /etc/config/devicemaster ] && { ... }
# /etc/config/devicemaster is *shipped by the package*, so on every real
# installation that condition is false and none of the bootstrap ever ran -
# most notably the four built-in device groups were never created.
#
# We now delegate to the shared, idempotent library which is also sourced by
# /etc/init.d/devicemaster, so first-boot and every-boot behave identically
# and cannot drift apart again.

UCI_INIT="/usr/libexec/devicemaster/uci_init.sh"

if [ -f "$UCI_INIT" ]; then
	. "$UCI_INIT"
	dm_bootstrap_uci
fi

# Remove duplicate ANONYMOUS settings sections (keep the named 'settings' one).
#
# This fixes installs that predate the named-section migration, but the old
# version of this block was destructive: it looped `while uci -q get
# devicemaster.@settings[0]; do uci delete devicemaster.@settings[0]; done`.
# @type[i] indexes ALL sections of that type - not just the anonymous ones - so
# @settings[0] resolves to the named 'settings' section itself, the loop deleted
# it, and the user's OUI settings were silently reset to the defaults on every
# package install/upgrade.
#
# Collecting the indices that `uci show` reports for the anonymous sections and
# deleting those (highest index first, so the remaining indices stay valid)
# leaves the named section untouched.
anon_settings=$(uci -q show devicemaster 2>/dev/null \
	| sed -n 's/^devicemaster\.@settings\[\([0-9]\+\)\]=.*/\1/p' | sort -rn)
if [ -n "$anon_settings" ]; then
	for idx in $anon_settings; do
		uci -q delete "devicemaster.@settings[$idx]"
	done
	uci -q commit devicemaster
fi

# Make scripts executable
chmod +x /usr/libexec/devicemaster/*.sh 2>/dev/null
chmod +x /etc/init.d/devicemaster 2>/dev/null

# Self-heal dhcp reservations BEFORE dnsmasq starts (boot is S10, dnsmasq S19).
# A sysupgrade-restored /etc/config/dhcp may contain the fatal "same IP for two
# MACs" pair; without this, dnsmasq refuses to start and no client gets an IP.
DHCP_GUARD="/usr/libexec/devicemaster/dhcp_guard.sh"
if [ -f "$DHCP_GUARD" ]; then
	. "$DHCP_GUARD"
	if dm_lock_acquire; then
		uci -q revert dhcp 2>/dev/null
		if ! dm_dhcp_backup; then
			logger -t devicemaster "boot self-heal: cannot back up /etc/config/dhcp; skipped" 2>/dev/null
			dm_lock_release
		else
			dm_dhcp_dedup_hosts
			_rc=$?
			dm_lock_release
			case "$_rc" in
				1) logger -t devicemaster "boot self-heal: duplicate dhcp host entries fixed" 2>/dev/null
				   dm_dhcp_backup_discard ;;
				2) logger -t devicemaster "boot self-heal: no valid dhcp config produced; previous file kept" 2>/dev/null ;;
				*) dm_dhcp_backup_discard ;;
			esac
		fi
	fi
else
	logger -t devicemaster "WARN: $DHCP_GUARD missing; dhcp self-heal skipped" 2>/dev/null
fi

# Enable the service
/etc/init.d/devicemaster enable 2>/dev/null

exit 0
