msgid "Tasks"
msgstr "任务管理"

msgid "Timed Tasks"
msgstr "定时任务"

msgid "Task"
msgstr "任务"

msgid "Startup Services"
msgstr "开机启动"

msgid "Grant access to the Tasks application"
msgstr "授予访问「任务管理」的权限"

msgid "Execution Log"
msgstr "执行日志"

msgid "Sunday"
msgstr "星期日"

msgid "Monday"
msgstr "星期一"

msgid "Tuesday"
msgstr "星期二"

msgid "Wednesday"
msgstr "星期三"

msgid "Thursday"
msgstr "星期四"

msgid "Friday"
msgstr "星期五"

msgid "Saturday"
msgstr "星期六"

msgid "Reboot"
msgstr "重启"

msgid "Restart network"
msgstr "重启网络"

msgid "Restart firewall"
msgstr "重启防火墙"

msgid "Clean temporary files"
msgstr "清理临时文件"

msgid "Free memory"
msgstr "释放内存"

msgid "Reboot now"
msgstr "立即重启"

msgid "Restart network now"
msgstr "立即重启网络"

msgid "Restart firewall now"
msgstr "立即重启防火墙"

msgid "Clean temporary files now"
msgstr "立即清理临时文件"

msgid "Free memory now"
msgstr "立即释放内存"

msgid "Enable"
msgstr "启用"

msgid "Run"
msgstr "执行频率"

msgid "Every day"
msgstr "每天"

msgid "Every week"
msgstr "每周"

msgid "Every month"
msgstr "每月"

msgid "Every hour"
msgstr "每小时"

msgid "Every few minutes"
msgstr "每隔几分钟"

msgid "Every few hours"
msgstr "每隔几小时"

msgid "Hour"
msgstr "小时"

msgid "Minute"
msgstr "分钟"

msgid "Day of the week"
msgstr "星期"

msgid "Monday to Friday"
msgstr "周一至周五"

msgid "Saturday and Sunday"
msgstr "周六和周日"

msgid "Day of the month"
msgstr "日期"

msgid "Number of minutes"
msgstr "间隔分钟数"

msgid "Number of hours"
msgstr "间隔小时数"

msgid "Choose what should happen and when. The application writes the needed cron entries for you, no command line or cron syntax required."
msgstr "选择要执行的操作和触发时间。本应用会自动生成所需的 cron 条目，无需输入命令或 cron 表达式。"

msgid "Scheduled reboot"
msgstr "定时重启"

msgid "Restart the device automatically. All connections are dropped for a short time."
msgstr "按设定时间自动重启设备。重启期间所有连接会短暂断开。"

msgid "Scheduled network restart"
msgstr "定时重启网络"

msgid "Restart the network service (for example to renew a DHCP lease or recover a stalled connection)."
msgstr "重新启动网络服务（例如续租 DHCP 或恢复卡住的连接）。"

msgid "Scheduled firewall restart"
msgstr "定时重启防火墙"

msgid "Reload the firewall rules. Existing connections are usually kept."
msgstr "重新加载防火墙规则，通常不会中断已有连接。"

msgid "Scheduled temporary file cleanup"
msgstr "定时清理临时文件"

msgid "/tmp lives in memory. Removing old files there frees RAM without touching any settings."
msgstr "/tmp 位于内存中。删除其中的旧文件可以释放内存，且不会更改任何设置。"

msgid "What to remove"
msgstr "清理范围"

msgid "Only known caches (safe)"
msgstr "仅清理已知缓存（安全）"

msgid "Caches and files older than the age below"
msgstr "清理缓存及超过以下时间的文件"

msgid "Remove files older than (minutes)"
msgstr "清理超过以下时间的文件（分钟）"

msgid "30 minutes"
msgstr "30 分钟"

msgid "1 hour"
msgstr "1 小时"

msgid "6 hours"
msgstr "6 小时"

msgid "1 day"
msgstr "1 天"

msgid "3 days"
msgstr "3 天"

msgid "7 days"
msgstr "7 天"

msgid "Scheduled memory cleanup"
msgstr "定时清理内存"

msgid "Releases cached file data from RAM. Safe to run at any time, but running it very often can slow the device down."
msgstr "将缓存的文件数据从内存中释放。随时可以安全执行，但执行过于频繁可能使设备变慢。"

msgid "Master switch"
msgstr "总开关"

msgid "When disabled, all scheduled tasks, startup entries and access control rules are skipped, but their settings are kept."
msgstr "关闭后，所有定时任务、开机启动项和上网控制规则都会跳过执行，但设置会保留。"

msgid "Enable scheduled tasks"
msgstr "启用定时任务"

msgid "Cron entries written by this application will appear here after saving."
msgstr "保存后，本应用生成的 cron 条目会显示在这里。"

msgid "The master switch is off, so no generated task will run."
msgstr "总开关已关闭，所有生成的定时任务都不会执行。"

msgid "No scheduled jobs yet. Enable a task below and click “Save & Apply”."
msgstr "暂无定时任务。请在下方启用一个任务，然后点击“保存并应用”。"

msgid "Running “%s”…"
msgstr "正在执行“%s”…"

msgid "Action completed: %s"
msgstr "操作完成：%s"

msgid "Action failed: %s (%s)"
msgstr "操作失败：%s（%s）"

msgid "unknown error"
msgstr "未知错误"

msgid "Confirm"
msgstr "确认"

msgid "Do you really want to run “%s” now?"
msgstr "确定要立即执行“%s”吗？"

msgid "The device reboots immediately and this page will become unreachable."
msgstr "设备将立即重启，此页面会暂时无法访问。"

msgid "Cancel"
msgstr "取消"

msgid "Run now"
msgstr "立即执行"

msgid "Run a task once, right now"
msgstr "立即执行一次"

msgid "Status"
msgstr "状态"

msgid "Enabled tasks"
msgstr "已启用任务"

msgid "Generated cron entries"
msgstr "已生成 cron 条目"

msgid "Refresh"
msgstr "刷新"

msgid "Show generated cron entries"
msgstr "查看已生成的 cron 条目"

msgid "Schedule applied. The generated cron entries are up to date."
msgstr "计划已应用，生成的 cron 条目已更新。"

msgid "Configuration was saved, but the schedule could not be rebuilt. Reboot the device to retry."
msgstr "配置已保存，但计划重建失败。请重启设备后重试。"

msgid "Choose what should start automatically after every boot. Select an existing service or type a command; no script or cron syntax is needed."
msgstr "选择每次开机后自动启动的内容。可以挑选系统服务，也可以直接填写命令，无需编写脚本或 cron 表达式。"

msgid "Startup entries"
msgstr "启动项"

msgid "Custom startup entry"
msgstr "自定义启动项"

msgid "Description"
msgstr "说明"

msgid "What to start"
msgstr "启动内容"

msgid "A system service"
msgstr "系统服务"

msgid "A custom command"
msgstr "自定义命令"

msgid "Service"
msgstr "服务"

msgid "-- Please choose a service --"
msgstr "-- 请选择服务 --"

msgid "Command"
msgstr "命令"

msgid "Wait before starting (seconds)"
msgstr "启动前等待（秒）"

msgid "Entries run as root a few seconds after boot. A service entry calls “/etc/init.d/<service> start”; it does not change whether that service starts on boot on its own."
msgstr "启动项会在开机数秒后以 root 身份运行。服务型启动项执行“/etc/init.d/<service> start”，不会改变该服务本身的开机自启状态。"

msgid "Startup entries applied. They will run on the next boot."
msgstr "启动项已应用，将在下次开机时运行。"

msgid "Configuration was saved, but the startup script could not be rebuilt. Reboot the device to retry."
msgstr "配置已保存，但启动脚本重建失败。请重启设备后重试。"

msgid "The log is empty. Scheduled and manually started tasks are recorded here."
msgstr "日志为空。定时执行和手动执行的任务都会记录在这里。"

msgid "%d line(s)"
msgstr "共 %d 行"

msgid "Delete all log entries? This cannot be undone."
msgstr "确定删除所有日志？此操作不可撤销。"

msgid "Clear log"
msgstr "清空日志"

msgid "Log cleared."
msgstr "日志已清空。"

msgid "Could not clear the log: %s"
msgstr "无法清空日志：%s"

msgid "Download"
msgstr "下载"

msgid "Newest first"
msgstr "最新在前"

msgid "Updates automatically every 5 seconds."
msgstr "每 5 秒自动更新。"

msgid "Internet Access Control"
msgstr "上网控制"

msgid "Block internet access for selected devices outside their allowed time window. A blocked device can still reach the router itself. The rule is checked every minute; no cron syntax or shell command is needed."
msgstr "在允许的时间段之外，禁止指定设备上网。被禁止的设备仍然可以访问路由器本身。规则每分钟检查一次，无需编写 cron 表达式或命令。"

msgid "Access control"
msgstr "上网控制"

msgid "When enabled, the devices below lose internet access outside their allowed window. Start and end are inclusive; if both are equal the whole day is allowed."
msgstr "启用后，下方设备在允许的时间段之外将无法上网。开始与结束时间均包含在内；两者相同时表示全天允许上网。"

msgid "Enable access control"
msgstr "启用上网控制"

msgid "Devices"
msgstr "设备"

msgid "New device"
msgstr "新设备"

msgid "For example: kids tablet"
msgstr "例如：孩子的平板"

msgid "MAC or IP address"
msgstr "MAC 或 IP 地址"

msgid "A MAC address is recommended: it also covers IPv6 and keeps working when DHCP assigns a new IP. An IPv4 address or subnet only blocks IPv4 traffic."
msgstr "建议使用 MAC 地址：它同时覆盖 IPv6，并且在 DHCP 重新分配 IP 后仍然有效。IPv4 地址或网段只会阻止 IPv4 流量。"

msgid "Enter a MAC address, an IPv4 address or an IPv4 subnet."
msgstr "请输入 MAC 地址、IPv4 地址或 IPv4 网段。"

msgid "Enter a MAC address, an IPv4 address or an IPv4 subnet (for example 192.168.1.0/24)."
msgstr "请输入 MAC 地址、IPv4 地址或 IPv4 网段（例如 192.168.1.0/24）。"

msgid "Mode"
msgstr "模式"

msgid "Allowed during the time window"
msgstr "在时间段内允许上网"

msgid "Blocked all the time"
msgstr "始终禁止上网"

msgid "Days"
msgstr "生效日期"

msgid "Start hour"
msgstr "开始小时"

msgid "Start minute"
msgstr "开始分钟"

msgid "End hour"
msgstr "结束小时"

msgid "End minute"
msgstr "结束分钟"

msgid "Access control is active."
msgstr "上网控制已生效。"

msgid "Access control is disabled."
msgstr "上网控制未启用。"

msgid "Access control could not be applied."
msgstr "上网控制规则应用失败。"

msgid "The tasks service is not running."
msgstr "任务管理服务未运行。"

msgid "Not applied yet. Save and apply the page to write the rules."
msgstr "尚未应用。请保存并应用本页以写入规则。"

msgid "Firewall backend: %s"
msgstr "防火墙后端：%s"

msgid "none"
msgstr "无"

msgid "Blocked devices: %s"
msgstr "已禁止设备：%s"

msgid "Last check: %s"
msgstr "最后检查：%s"

msgid "never"
msgstr "从未"

msgid "unknown host"
msgstr "未知主机"

msgid "No device is blocked right now."
msgstr "当前没有设备被禁止上网。"

msgid "The master switch is off, so access control will not run."
msgstr "总开关已关闭，上网控制不会运行。"

msgid "Access control applied. The firewall rules are up to date."
msgstr "上网控制已应用，防火墙规则已更新。"

msgid "Configuration was saved, but the access rules could not be rebuilt. Reboot the device to retry."
msgstr "配置已保存，但上网控制规则重建失败。请重启设备后重试。"

msgid "Turn WiFi on"
msgstr "开启WiFi"

msgid "Turn WiFi off"
msgstr "关闭WiFi"

msgid "Scheduled WiFi on"
msgstr "定时开启WiFi"

msgid "Scheduled WiFi off"
msgstr "定时关闭WiFi"

msgid "Turn all wireless radios on at the scheduled time. The setting is kept across reboots."
msgstr "按设定时间开启所有无线网络。该设置会在重启后保留。"

msgid "Turn all wireless radios off at the scheduled time. Wired devices and the router itself keep working. The setting is kept across reboots."
msgstr "按设定时间关闭所有无线网络。有线设备和路由器本身不受影响，该设置会在重启后保留。"
