#!/bin/sh /etc/rc.common
# luci-app-tasks: translate friendly UCI options into cron entries and a
# boot script. This is the only place where schedule logic lives.

START=99
STOP=10

. /usr/lib/tasks/common.sh

TASKS_ACTIONS="reboot network firewall cleantmp clearmem wifion wifioff"

# Make sure a cron daemon is actually running while jobs exist. Enabling the
# initscript does not touch existing crontab entries of other packages.
cron_reload() {
	[ -x /etc/init.d/cron ] || return 0

	if [ "$(tasks_cron_count)" -gt 0 ]; then
		/etc/init.d/cron enable >/dev/null 2>&1
		/etc/init.d/cron start >/dev/null 2>&1
	fi

	/etc/init.d/cron reload >/dev/null 2>&1
}

# Remove only the lines generated by this application.
remove_generated() {
	mkdir -p /etc/crontabs 2>/dev/null
	[ -f "$TASKS_CRON" ] || : >"$TASKS_CRON"
	sed -i "/$TASKS_MARK/d" "$TASKS_CRON" 2>/dev/null
	chmod 600 "$TASKS_CRON" 2>/dev/null
}

generate_cron() {
	local action mode hour minute weekday monthday imin ihour expr

	[ "$(tasks_cfg global enabled 1)" = "1" ] || return 0

	for action in $TASKS_ACTIONS; do
		[ "$(tasks_cfg "$action" enabled 0)" = "1" ] || continue

		mode=$(tasks_cfg "$action" mode daily)
		hour=$(tasks_int "$(tasks_cfg "$action" hour '')" 0 23 3)
		minute=$(tasks_int "$(tasks_cfg "$action" minute '')" 0 59 0)
		weekday=$(tasks_weekday "$(tasks_cfg "$action" weekday '*')")
		monthday=$(tasks_int "$(tasks_cfg "$action" monthday '')" 1 31 1)
		imin=$(tasks_int "$(tasks_cfg "$action" interval_minutes '')" 1 59 15)
		ihour=$(tasks_int "$(tasks_cfg "$action" interval_hours '')" 1 23 6)

		if ! expr=$(tasks_cron_expr "$mode" "$hour" "$minute" \
				"$weekday" "$monthday" "$imin" "$ihour"); then
			tasks_log init "skip $action: unknown mode '$mode'"
			continue
		fi

		printf '%s /usr/bin/tasks-handler run %s # %s:%s\n' \
			"$expr" "$action" "$TASKS_MARK" "$action" >>"$TASKS_CRON"
	done

	# Access control has to be re-evaluated every minute so devices are cut
	# off exactly when their allowed window ends.
	if [ "$(tasks_cfg global enabled 1)" = "1" ] &&
			[ "$(tasks_cfg access enabled 0)" = "1" ] &&
			tasks_access_has_devices; then
		printf '* * * * * /usr/bin/tasks-handler run access # %s:access\n' \
			"$TASKS_MARK" >>"$TASKS_CRON"
	fi
}

generate_startup() {
	local section delay

	mkdir -p "$TASKS_DIR" 2>/dev/null

	{
		printf '#!/bin/sh\n'
		printf '# generated by luci-app-tasks; do not edit\n'

		if [ "$(tasks_cfg global enabled 1)" = "1" ]; then
			for section in $(uci -q show "$TASKS_CONFIG" 2>/dev/null |
					sed -n "s/^$TASKS_CONFIG\.\([^.=]*\)=startup$/\1/p"); do
				tasks_valid_section "$section" || continue
				[ "$(tasks_cfg "$section" enabled 0)" = "1" ] || continue

				delay=$(tasks_int "$(tasks_cfg "$section" delay '')" 0 600 10)
				printf "(sleep %s && /usr/bin/tasks-handler startup '%s') &\n" \
					"$delay" "$section"
			done
		fi

		printf 'exit 0\n'
	} >"$TASKS_STARTUP"

	chmod +x "$TASKS_STARTUP" 2>/dev/null
}

regen() {
	remove_generated
	generate_cron
	generate_startup
	cron_reload
	/usr/bin/tasks-handler apply-access >>"$TASKS_LOG" 2>&1
}

start() {
	regen
	tasks_log init "service started, $(tasks_cron_count) cron job(s)"
}

stop() {
	remove_generated
	printf '#!/bin/sh\nexit 0\n' >"$TASKS_STARTUP"
	chmod +x "$TASKS_STARTUP" 2>/dev/null
	/usr/bin/tasks-handler stop-access >>"$TASKS_LOG" 2>&1
	cron_reload
	tasks_log init "service stopped, scheduled jobs removed"
}

restart() {
	regen
	tasks_log init "service restarted, $(tasks_cron_count) cron job(s)"
}

reload() {
	regen
	tasks_log init "configuration applied, $(tasks_cron_count) cron job(s)"
}

boot() {
	regen

	if grep -q 'tasks-handler startup' "$TASKS_STARTUP" 2>/dev/null; then
		tasks_log boot "running startup tasks"
		sh "$TASKS_STARTUP" >>"$TASKS_LOG" 2>&1 &
	fi
}
