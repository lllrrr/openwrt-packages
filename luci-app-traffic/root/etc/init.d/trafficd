#!/bin/sh /etc/rc.common
# trafficd - WAN traffic collector service

START=99
STOP=10
USE_PROCD=1

start_service() {
	local iface
	config_load traffic
	config_get iface main interface 'wan'

	mkdir -p /tmp/traffic /etc/traffic
	[ -f /etc/traffic/l3.dat ] || : > /etc/traffic/l3.dat
	[ -f /etc/traffic/l4.dat ] || : > /etc/traffic/l4.dat
	[ -f /etc/traffic/l5.dat ] || : > /etc/traffic/l5.dat

	procd_open_instance
	procd_set_param command /bin/sh /usr/sbin/trafficd.sh
	procd_set_param env IFACE="$iface"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger traffic
}
