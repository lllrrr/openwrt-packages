{
  "version": "1.0",
  "settings": {
    "min_ttl": 30,
    "bind_udp": "0.0.0.0:5353",
    "bind_tcp": "0.0.0.0:5353",
    "default_upstream": "223.5.5.5:53",
    "upstream_timeout_ms": 1500,
    "cache_capacity": 20000,
    "cache_max_ttl": 3600,
    "dashmap_shards": 0,
    "udp_pool_size": 64,
    "tcp_pool_size": 32,
    "flow_control_initial_permits": 800,
    "flow_control_min_permits": 200,
    "flow_control_max_permits": 1500,
    "flow_control_latency_threshold_ms": 150,
    "flow_control_adjustment_interval_secs": 10,
    "cache_background_refresh": true,
    "cache_refresh_threshold_percent": 10,
    "cache_refresh_min_ttl": 30,
    "serve_stale": true,
    "serve_stale_ttl": 30,
    "serve_stale_expire_ttl": 604800,
    "serve_stale_ttl_reset": true,
    "serve_stale_client_timeout_ms": 100
  },
  "pipeline_select": [
    {
      "pipeline": "domestic",
      "matchers": [
        {
          "type": "domain_suffix",
          "value": ".cn,.com.cn,.net.cn,.org.cn,.gov.cn,.edu.cn,.ac.cn"
        }
      ]
    },
    {
      "pipeline": "domestic",
      "matchers": [
        {
          "type": "domain_regex",
          "value": "(?i)(qq\\.com|weibo\\.com|baidu\\.com|aliyun\\.com|tencent\\.com|alibaba\\.com|jd\\.com|bilibili\\.com|163\\.com|sina\\.com)"
        }
      ]
    },
    {
      "pipeline": "domestic",
      "matchers": [
        {
          "type": "any"
        }
      ]
    }
  ],
  "pipelines": [
    {
      "id": "domestic",
      "rules": [
        {
          "name": "china-dns-primary",
          "matchers": [
            {
              "type": "any"
            }
          ],
          "actions": [
            {
              "type": "log",
              "level": "info"
            },
            {
              "type": "forward",
              "upstream": "223.5.5.5:53",
              "transport": "udp"
            }
          ],
          "response_actions_on_match": [
            {
              "type": "allow"
            }
          ]
        },
        {
          "name": "china-dns-backup",
          "matchers": [
            {
              "type": "any"
            }
          ],
          "actions": [
            {
              "type": "forward",
              "upstream": "114.114.114.114:53",
              "transport": "udp"
            }
          ],
          "response_actions_on_match": [
            {
              "type": "allow"
            }
          ]
        }
      ]
    }
  ]
}
