#!/bin/sh /etc/rc.common
# smartmwan procd 服务（零 Lua）
#
# 语义说明：
#   * 本服务**始终启动**守护进程；「是否接管路由」的开关在 UCI 的 global.enabled
#     （默认 0，首次安装不改变现有路由）。procd enabled 与插件语义因此不冲突；
#   * term_timeout 给足 30 秒：守护进程的 SIGTERM 处理要撤销自己的全部内核对象
#     （ip rule / 路由表 / inet smw 表），抢跑会留下「标记了却没有策略路由」的黑洞；
#   * 依赖 rpc.sock 就绪由 respawn + 守护进程自身 bind 保证，不额外设 depends。

START=99
USE_PROCD=1

EXTRA_COMMANDS="reload"
EXTRA_HELP="	reload	Re-read UCI config and reset debounce state (same as SIGHUP)"

reload() {
	[ -x /usr/bin/smartmwand ] || return 1
	start-stop-daemon -q -K -HUP -p /var/run/smartmwand.pid 2>/dev/null
	return 0
}

start_service() {
	[ -x /usr/bin/smartmwand ] || return 1

	procd_open_instance
	procd_set_param command /usr/bin/smartmwand --config /etc/config/smartmwan
	procd_set_param respawn
	# 阈值放宽：守护进程的失败模式是「退避后重试」，抢跑重启只会放大故障。
	procd_set_param respawn_threshold 3600
	procd_set_param respawn_timeout 5
	procd_set_param respawn_retry 5
	procd_set_param term_timeout 30
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/smartmwand.pid
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "smartmwan"
}

stop_service() {
	:
}
