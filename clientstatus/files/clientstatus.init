#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
CONF=clientstatus

CHAIN_NAME="clientstatus_block"
FW_NFT_FILE="/etc/clientstatus-firewall.nft"
FW_USER="/etc/firewall.user"

is_nft() {
	[ -x /usr/sbin/nft ] && nft list tables 2>/dev/null | grep -q 'inet fw4'
}

is_ipt() {
	[ -x /usr/sbin/iptables ] || [ -x /usr/bin/iptables ]
}

fw4_live() {
	nft list tables 2>/dev/null | grep -q 'inet fw4'
}

fw4_reload() {
	[ -x /etc/init.d/firewall ] || return 0
	/etc/init.d/firewall reload >/dev/null 2>&1
}

# ─── firewall4 (nft): declarative include ───────────────────────
# fw4 rebuilds its whole ruleset from UCI on every reload, so plain
# imperative nft commands are wiped whenever anything restarts the
# firewall. Instead we generate a static .nft snippet and register it
# as a firewall include, which fw4 embeds into the generated ruleset
# on every reload — the rules survive firewall restarts.

FW_MACS=""
_add_fw_mac() {
	[ -n "$1" ] && FW_MACS="$FW_MACS $1"
}

write_nft_include() {
	FW_MACS=""
	nft_elems=""
	config_list_foreach main blocked_mac _add_fw_mac
	{
		echo "table inet fw4 {"
		echo "	set blocked_macs {"
		echo "		type ether_addr"
		for mac in $FW_MACS; do
			nft_elems="${nft_elems:+$nft_elems, }$mac"
		done
		[ -n "$nft_elems" ] && echo "		elements = { $nft_elems }"
		echo "	}"
		echo "	chain $CHAIN_NAME {"
		echo "		type filter hook forward priority -1; policy accept;"
		echo "		ether saddr @blocked_macs drop"
		echo "	}"
		echo "}"
	} > "$FW_NFT_FILE"
	nft_elems=""
}

ensure_nft_include_uci() {
	[ "$(uci -q get firewall.clientstatus_block.type)" = "nftables" ] && return 0
	uci -q delete firewall.clientstatus_block
	uci set firewall.clientstatus_block='include'
	uci set firewall.clientstatus_block.type='nftables'
	uci set firewall.clientstatus_block.path="$FW_NFT_FILE"
	uci set firewall.clientstatus_block.position='ruleset-post'
	uci commit firewall
}

apply_fw_rules_nft() {
	write_nft_include
	ensure_nft_include_uci
	fw4_live && fw4_reload
	return 0
}

remove_fw_rules_nft() {
	# drop live rules first, in case the reload below does not happen
	nft delete chain inet fw4 "$CHAIN_NAME" 2>/dev/null
	nft delete set inet fw4 blocked_macs 2>/dev/null
	if [ -f "$FW_NFT_FILE" ] || [ "$(uci -q get firewall.clientstatus_block.type)" = "nftables" ]; then
		rm -f "$FW_NFT_FILE"
		uci -q delete firewall.clientstatus_block
		uci commit firewall
		fw4_live && fw4_reload
	fi
	return 0
}

# ─── firewall3 (iptables): managed /etc/firewall.user block ──────
# fw3 re-sources /etc/firewall.user on every start/reload, so a marked
# block in that file is replayed automatically after firewall restarts.

build_ipt_block() {
	FW_MACS=""
	config_list_foreach main blocked_mac _add_fw_mac
	echo "# >>> clientstatus block >>>"
	echo "iptables  -D FORWARD -j $CHAIN_NAME 2>/dev/null"
	echo "iptables  -F $CHAIN_NAME 2>/dev/null"
	echo "iptables  -X $CHAIN_NAME 2>/dev/null"
	echo "iptables  -N $CHAIN_NAME"
	echo "iptables  -I FORWARD 1 -j $CHAIN_NAME"
	echo "ip6tables -D FORWARD -j $CHAIN_NAME 2>/dev/null"
	echo "ip6tables -F $CHAIN_NAME 2>/dev/null"
	echo "ip6tables -X $CHAIN_NAME 2>/dev/null"
	echo "ip6tables -N $CHAIN_NAME"
	echo "ip6tables -I FORWARD 1 -j $CHAIN_NAME"
	for mac in $FW_MACS; do
		echo "iptables  -A $CHAIN_NAME -m mac --mac-source $mac -j DROP"
		echo "ip6tables -A $CHAIN_NAME -m mac --mac-source $mac -j DROP"
	done
	echo "# <<< clientstatus block <<<"
}

apply_fw_rules_ipt() {
	[ -f "$FW_USER" ] || : > "$FW_USER"
	build_ipt_block > /tmp/clientstatus.fwblock.$$
	sed '/^# >>> clientstatus block >>>$/,/^# <<< clientstatus block <<<$/d' \
		"$FW_USER" > /tmp/clientstatus.fwuser.$$
	cat /tmp/clientstatus.fwblock.$$ >> /tmp/clientstatus.fwuser.$$
	cat /tmp/clientstatus.fwuser.$$ > "$FW_USER"
	. /tmp/clientstatus.fwblock.$$
	rm -f /tmp/clientstatus.fwblock.$$ /tmp/clientstatus.fwuser.$$
	return 0
}

remove_fw_rules_ipt() {
	if grep -q "^# >>> clientstatus block >>>$" "$FW_USER" 2>/dev/null; then
		sed '/^# >>> clientstatus block >>>$/,/^# <<< clientstatus block <<<$/d' \
			"$FW_USER" > /tmp/clientstatus.fwuser.$$
		cat /tmp/clientstatus.fwuser.$$ > "$FW_USER"
		rm -f /tmp/clientstatus.fwuser.$$
	fi
	iptables  -D FORWARD -j "$CHAIN_NAME" 2>/dev/null
	iptables  -F "$CHAIN_NAME" 2>/dev/null
	iptables  -X "$CHAIN_NAME" 2>/dev/null
	ip6tables -D FORWARD -j "$CHAIN_NAME" 2>/dev/null
	ip6tables -F "$CHAIN_NAME" 2>/dev/null
	ip6tables -X "$CHAIN_NAME" 2>/dev/null
	return 0
}

apply_fw_rules() {
	if is_nft; then
		apply_fw_rules_nft
	elif is_ipt; then
		apply_fw_rules_ipt
	else
		logger -t clientstatus "No supported firewall backend found"
		return 1
	fi
}

remove_fw_rules() {
	if is_nft; then
		remove_fw_rules_nft
	elif is_ipt; then
		remove_fw_rules_ipt
	fi
}

start_service() {
	config_load $CONF
	config_get enabled main enabled 0

	[ "$enabled" = "1" ] || return 0

	apply_fw_rules

	procd_open_instance
	procd_set_param command /usr/bin/clientstatus
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	remove_fw_rules
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
