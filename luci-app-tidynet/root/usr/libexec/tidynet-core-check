#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later

state=/etc/tidynet/state
lock=/tmp/tidynet/core-latest.lock
mkdir -p "$state" /tmp/tidynet || exit 1
mkdir "$lock" 2>/dev/null || exit 0
trap 'rm -rf "$lock"' EXIT HUP INT TERM

now=$(date +%s)
checked=$(cat "$state/mihomo-latest-checked" 2>/dev/null)
case "$checked" in *[!0-9]*|'') checked=0;; esac
[ $((now-checked)) -ge 604800 ] || exit 0

response="/tmp/tidynet/mihomo-release.$$.json"
tag=''
if curl --fail --location --silent --show-error --connect-timeout 4 --max-time 8 --max-filesize 4194304 \
	--proto '=https' --proto-redir '=https' -H 'Accept: application/vnd.github+json' \
	-H 'User-Agent: TidyNet' 'https://api.github.com/repos/MetaCubeX/mihomo/releases/latest' -o "$response"; then
	tag=$(jsonfilter -i "$response" -e '@.tag_name' 2>/dev/null)
	case "$tag" in v[0-9]*.[0-9]*.[0-9]*) printf '%s\n' "$tag" > "$state/mihomo-latest.new" && mv -f "$state/mihomo-latest.new" "$state/mihomo-latest";; esac
fi
rm -f "$response"
printf '%s\n' "$now" > "$state/mihomo-latest-checked.new" && mv -f "$state/mihomo-latest-checked.new" "$state/mihomo-latest-checked"
