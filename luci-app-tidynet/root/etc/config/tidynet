config main 'main'
	option enabled '0'
	option traffic_enabled '0'
	option profile ''
	option dashboard_url ''
	option api_listen '127.0.0.1:9090'
	option dns_enabled '0'
	option dns_listen '127.0.0.1:10535'
	option dns_ipv6 '0'
	option dns_mode 'redir-host'
	list dns_upstreams '223.5.5.5'
	list dns_upstreams 'https://dns.alidns.com/dns-query'
	option adblock_enabled '0'
	option core_channel 'stable'

config rule_source 'default_ads'
	option name 'StevenBlack hosts'
	option url 'https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts'
	option enabled '1'
	option format 'hosts'
	option behavior 'domain'
	option action 'block'
