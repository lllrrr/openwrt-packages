#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later

USE_PROCD=1
START=96
STOP=09

start_service() {
	[ "$(uci -q get tidynet.main.adblock_enabled)" = 1 ] || return 0
	[ -x /usr/libexec/tidynet-stats ] || return 1
	procd_open_instance
	procd_set_param command /usr/libexec/tidynet-stats
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
