#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/tidynet-mihomo
RUNDIR=/etc/tidynet/runtime
. /usr/lib/tidynet/traffic.sh

config_file() {
	local profile
	profile="$(uci -q get tidynet.main.profile)"
	case "$profile" in
		''|*[!A-Za-z0-9_-]*) printf '%s\n' /etc/tidynet/config.yaml ;;
		*)
			if [ -s "/etc/tidynet/profiles/$profile.yaml" ]; then
				printf '%s\n' "/etc/tidynet/profiles/$profile.yaml"
			else
				printf '%s\n' /etc/tidynet/config.yaml
			fi
			;;
	esac
}

start_service() {
	local config
	[ -x "$PROG" ] || return 0
	mkdir -p "$RUNDIR" || return 1
	chmod 700 /etc/tidynet "$RUNDIR"
	if [ "$(uci -q get tidynet.main.enabled)" = 1 ]; then
		config="$(config_file)"
		traffic_profile "$config" "$RUNDIR/config.yaml" || { logger -t tidynet 'Runtime profile generation failed; check yq and TUN dependencies'; return 1; }
		config="$RUNDIR/config.yaml"
		"$PROG" -t -d "$RUNDIR" -f "$config" >/tmp/tidynet-config-check.log 2>&1 || {
			logger -t tidynet "Mihomo configuration validation failed; see /tmp/tidynet-config-check.log"
			return 1
		}
		procd_open_instance mihomo
		procd_set_param command "$PROG" -d "$RUNDIR" -f "$config"
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
	if [ "$(uci -q get tidynet.main.dns_enabled)" = 1 ] && [ -s /etc/tidynet/dns.yaml ]; then
		mkdir -p /etc/tidynet/dns-runtime
		"$PROG" -t -d /etc/tidynet/dns-runtime -f /etc/tidynet/dns.yaml >/tmp/tidynet-dns-check.log 2>&1 || {
			logger -t tidynet "TidyNet DNS configuration validation failed; see /tmp/tidynet-dns-check.log"
			return 1
		}
		procd_open_instance dns
		procd_set_param command "$PROG" -d /etc/tidynet/dns-runtime -f /etc/tidynet/dns.yaml
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
	traffic_apply_policy || { logger -t tidynet 'Protocol bypass policy failed'; return 1; }
}

stop_service() {
	traffic_clear_policy
}

reload_service() {
	stop
	start
}

service_triggers() {
	 procd_add_reload_trigger tidynet
}
