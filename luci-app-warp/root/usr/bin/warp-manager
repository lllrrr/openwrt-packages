#!/bin/sh
# Cloudflare WARP manager script for OpenWrt using cloudflare-warp
# SPDX-License-Identifier: GPL-3.0-or-later

. /lib/functions.sh

WARP_BIN="${WARP_BIN:-/usr/bin/warp}"
DATA_DIR="/etc/warp"
REG_FILE="$DATA_DIR/reg.json"
CONF_FILE="$DATA_DIR/conf.json"

need_warp() {
	if [ ! -x "$WARP_BIN" ]; then
		printf 'Error: warp binary not found at %s.\n' "$WARP_BIN" >&2
		return 1
	fi
}

update_uci_account() {
	[ -f "$CONF_FILE" ] || return 0

	if command -v jsonfilter >/dev/null 2>&1; then
		addr_v4="$(jsonfilter -i "$CONF_FILE" -e '@.config.interface.addresses.v4' 2>/dev/null)"
		addr_v6="$(jsonfilter -i "$CONF_FILE" -e '@.config.interface.addresses.v6' 2>/dev/null)"

		if [ -z "$addr_v4" ] && [ -z "$addr_v6" ]; then
			logger -t warp-manager "Warning: could not extract addresses from $CONF_FILE - please check JSON path"
		else
			[ -n "$addr_v4" ] && uci -q set warp.config.address_v4="$addr_v4"
			[ -n "$addr_v6" ] && uci -q set warp.config.address_v6="$addr_v6"
			uci commit warp
		fi
	fi
}

register_account() {
	need_warp || return 1
	
	printf 'Registering new WARP account using cloudflare-warp...\n'
	mkdir -p "$DATA_DIR"
	
	if "$WARP_BIN" generate --data-dir "$DATA_DIR"; then
		printf 'Successfully registered WARP account.\n'
		update_uci_account
		return 0
	else
		printf 'Failed to register WARP account.\n' >&2
		return 1
	fi
}

apply_license() {
	LICENSE_KEY="${1:-$(uci -q get warp.config.license_key)}"
	if [ -z "$LICENSE_KEY" ]; then
		printf 'Error: license_key is empty in configuration.\n' >&2
		return 1
	fi

	need_warp || return 1

	printf 'Applying WARP+ license key...\n'
	if "$WARP_BIN" update --data-dir "$DATA_DIR" --license "$LICENSE_KEY"; then
		printf 'Successfully applied license key.\n'
		update_uci_account
		return 0
	else
		printf 'Failed to apply license key.\n' >&2
		return 1
	fi
}

get_status() {
	if pgrep -f "warp.*run" >/dev/null 2>&1; then
		printf 'Service: running\n'
		
		# Check SOCKS5/HTTP port listening
		socks_port="$(uci -q get warp.config.socks_port)"
		http_port="$(uci -q get warp.config.http_port)"
		
		[ -n "$socks_port" ] && netstat -tln 2>/dev/null | grep -q ":${socks_port} " && \
			printf 'SOCKS5 Proxy: listening on port %s\n' "$socks_port"
			
		[ -n "$http_port" ] && netstat -tln 2>/dev/null | grep -q ":${http_port} " && \
			printf 'HTTP Proxy: listening on port %s\n' "$http_port"
			
	else
		printf 'Service: stopped\n'
	fi

	if [ -f "$REG_FILE" ]; then
		printf 'Account: registered\n'
		addr_v4="$(uci -q get warp.config.address_v4)"
		addr_v6="$(uci -q get warp.config.address_v6)"
		[ -n "$addr_v4" ] && printf 'IPv4: %s\n' "$addr_v4"
		[ -n "$addr_v6" ] && printf 'IPv6: %s\n' "$addr_v6"
	else
		printf 'Account: not registered\n'
	fi
}

test_connection() {
	socks_port="$(uci -q get warp.config.socks_port)"
	
	if [ -z "$socks_port" ]; then
		printf 'Error: socks_port is not configured.\n' >&2
		return 1
	fi
	
	if ! netstat -tln 2>/dev/null | grep -q ":${socks_port} "; then
		printf 'Error: SOCKS5 proxy is not running on port %s.\n' "$socks_port" >&2
		return 1
	fi

	printf 'Testing connection through WARP SOCKS5 proxy...\n'
	
	test_output="$(curl -s -x "socks5://127.0.0.1:$socks_port" --max-time 10 https://www.cloudflare.com/cdn-cgi/trace)"
	
	if [ -z "$test_output" ]; then
		printf 'Failed to connect to Cloudflare trace service.\n' >&2
		return 1
	fi

	warp_status="$(echo "$test_output" | grep -i "^warp=" | cut -d= -f2)"
	ip_address="$(echo "$test_output" | grep -i "^ip=" | cut -d= -f2)"
	location="$(echo "$test_output" | grep -i "^loc=" | cut -d= -f2)"

	printf '\n--- Test Results ---\n'
	if [ "$warp_status" = "on" ] || [ "$warp_status" = "plus" ]; then
		printf 'WARP Status: \033[32m%s\033[0m\n' "$warp_status"
	else
		printf 'WARP Status: \033[31m%s\033[0m\n' "${warp_status:-unknown}"
	fi
	printf 'Exit IP: %s\n' "${ip_address:-unknown}"
	printf 'Location: %s\n' "${location:-unknown}"
	printf '--------------------\n'
}

reset_account() {
	printf 'Resetting WARP account data...\n'
	rm -f "$REG_FILE" "$CONF_FILE"
	uci -q delete warp.config.address_v4
	uci -q delete warp.config.address_v6
	uci commit warp
	printf 'Account data has been cleared.\n'
}

export_config() {
	if [ -f "$CONF_FILE" ]; then
		cat "$CONF_FILE"
	else
		printf 'No configuration found. Generate it first.\n' >&2
		return 1
	fi
}

set_enabled() {
	value="$1"
	uci -q get warp.config >/dev/null 2>&1 || uci set warp.config='warp'
	uci set warp.config.enabled="$value"
	uci commit warp
}

case "${1:-}" in
	register)
		register_account
		;;
	license)
		apply_license "${2:-}"
		;;
	status)
		get_status
		;;
	test)
		test_connection
		;;
	start)
		set_enabled 1
		/etc/init.d/warp start
		;;
	stop)
		set_enabled 0
		/etc/init.d/warp stop
		;;
	restart)
		set_enabled 1
		/etc/init.d/warp restart
		;;
	reset)
		reset_account
		;;
	export)
		export_config
		;;
	*)
		printf 'Usage: %s {register|license <key>|start|stop|restart|status|test|reset|export}\n' "$0"
		exit 1
		;;
esac
