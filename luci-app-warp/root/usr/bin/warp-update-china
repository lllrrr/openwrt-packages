#!/bin/sh
# Update China IP list for Cloudflare WARP bypass
# SPDX-License-Identifier: GPL-3.0-or-later

. /lib/functions.sh

CHINA_IP_FILE="/etc/warp/china_ip.txt"
TMP_FILE="/tmp/china_ip.txt"
LOG_FILE="/var/log/warp.log"

warp_log() {
	mkdir -p /var/log 2>/dev/null || true
	printf '%s warp-update-china: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE" 2>/dev/null || true
	logger -t warp-update-china "$*" 2>/dev/null || true
}

download_china_list() {
	warp_log "Downloading China IP list..."

	if curl -s -L --max-time 30 -o "$TMP_FILE" https://raw.githubusercontent.com/ChnRoute/custom/master/chnroute.txt; then
		if [ -s "$TMP_FILE" ]; then
			mv "$TMP_FILE" "$CHINA_IP_FILE"
			warp_log "Successfully updated China IP list"
			return 0
		fi
	fi

	warp_log "Failed to download China IP list"
	rm -f "$TMP_FILE"
	return 1
}

apply_china_routes() {
	BYPASS_CHINA="$(uci -q get warp.config.bypass_china)"
	[ "$BYPASS_CHINA" = "1" ] || return 0
	
	warp_log "Applying updated China IP list via nftables set..."
	/etc/init.d/warp restart >/dev/null 2>&1
}

clear_china_routes() {
	# Handled automatically by /etc/init.d/warp stop
	:
}

update_all() {
	if download_china_list; then
		apply_china_routes
	fi
}

case "$1" in
	update)
		update_all
		;;
	apply)
		apply_china_routes
		;;
	clear)
		clear_china_routes
		;;
	*)
		echo "Usage: $0 {update|apply|clear}"
		exit 1
		;;
esac
