#!/bin/sh /etc/rc.common

START=99
STOP=90
USE_PROCD=1

PROG=/usr/share/wechatpush-pro/wechatpush-pro
dir="/tmp/wechatpush-pro"

start_service() {
	local enable_value
	enable_value=$(uci -q get wechatpush-pro.config.enable)
	[ -z "$enable_value" ] && enable_value=0

	# 开关关闭时不启动实例，避免 procd 收到空 command 而报错
	if [ "$enable_value" = "0" ]; then
		mkdir -p "$dir"
		logger -t wechatpush-pro "service disabled by /etc/config/wechatpush-pro (enable=0), skip start"
		return 0
	fi

	if [ ! -x "$PROG" ]; then
		logger -t wechatpush-pro "ERROR: $PROG is not executable, please reinstall luci-app-wechatpush-pro"
		return 1
	fi

	mkdir -p "$dir"

	procd_open_instance
	procd_set_param command "$PROG"
	# 崩溃自动拉起
	procd_set_param respawn 3600 5 5
	# stdout/stderr 交给 procd，写入 syslog（logread 可见）
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/wechatpush-pro
	procd_close_instance
}

reload_service() {
	stop
	sleep 1
	start
}

stop_service() {
	mkdir -p "$dir"
	if [ -f "${dir}/child_pid" ]; then
		parent_pid=$(cat "${dir}/child_pid")
		if [ -n "$parent_pid" ]; then
			for child_pid in $(pgrep -P "$parent_pid" 2>/dev/null); do
				kill "$child_pid" 2>/dev/null
			done
		fi
	fi
	local pids=$(ps | grep "wechatpush-pro" | grep -v grep | grep -v "$$" | awk '{print $1}')
	[ -n "$pids" ] && echo "$pids" | xargs kill 2>/dev/null
	return 0
}

service_triggers() {
	procd_add_reload_trigger wechatpush-pro
}
