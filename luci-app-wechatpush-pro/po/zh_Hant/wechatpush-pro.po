msgstr "流量來源"

#: traffic source option (OAF support)
msgid "Traffic Data Source"
msgstr "流量數據來源"

#: traffic source option (OAF support)
msgid "wrtbwmon (iptables)"
msgstr "wrtbwmon（iptables 計數）"

#: traffic source option (OAF support)
msgid "OAF / OpenAppFilter (nftables, via ubus)"
msgstr "OAF / OpenAppFilter（nftables，通過 ubus）"

#: traffic source option (ctstat support)
msgid "ctstat (nftables / conntrack, via ubus)"
msgstr "ctstat（nftables / conntrack，通過 ubus）"

#: traffic source option (OAF support)
msgid "Auto (prefer wrtbwmon, then OAF)"
msgstr "自動（優先 wrtbwmon，其次 OAF）"

#: traffic source option (ctstat support)
msgid "Choose where per-client traffic statistics come from. ctstat reads cumulative download/upload per client from luci.ctstat over ubus and coexists with firewall4/nftables; wrtbwmon counts via iptables; OAF uses the fwx ubus object."
msgstr "選擇每臺客戶端流量統計的數據來源。ctstat 通過 ubus 從 luci.ctstat 讀取每臺設備的累計下載/上傳流量，可與 firewall4/nftables 共存；wrtbwmon 通過 iptables 計數；OAF 使用 fwx ubus 對象。"

#: ctstat timeout option
msgid "ctstat RPC timeout (seconds)"
msgstr "ctstat RPC 超時（秒）"

#: ctstat timeout option
msgid "Maximum time to wait for luci.ctstat.get_stats over ubus. Increase it on slow routers; a failed call keeps the last successful traffic snapshot."
msgstr "通過 ubus 調用 luci.ctstat.get_stats 的最長等待時間。路由器較慢時可適當調大；調用失敗會保留上一次成功的流量快照。"

#: wrtbwmon compatibility mode
msgid "wrtbwmon compatibility mode"
msgstr "wrtbwmon 兼容模式"

#: wrtbwmon compatibility mode
msgid "Auto (detect by package version)"
msgstr "自動（按軟件包版本檢測）"

#: wrtbwmon compatibility mode
msgid "Modern (wrtbwmon -f, 1.2.0+)"
msgstr "新版（wrtbwmon -f，1.2.0+）"

#: wrtbwmon compatibility mode
msgid "Legacy (wrtbwmon update, 1.0.x)"
msgstr "舊版（wrtbwmon update，1.0.x）"

#: wrtbwmon compatibility mode
msgid "Override the wrtbwmon command form when automatic version detection selects the wrong syntax."
msgstr "當自動版本檢測選錯命令格式時，可手動覆蓋 wrtbwmon 的調用方式。"

#: OAF ubus API option
msgid "OAF ubus API"
msgstr "OAF ubus 接口"

#: OAF ubus API option
msgid "Auto (get_user_stat, then top users)"
msgstr "自動（先 get_user_stat，再 top users）"

#: OAF ubus API option
msgid "get_user_stat (all clients)"
msgstr "get_user_stat（全部設備）"

#: OAF ubus API option
msgid "get_daily_top_users (top 8 only)"
msgstr "get_daily_top_users（僅前 8 臺）"

#: OAF ubus API option
msgid "Select which fwx ubus interface supplies per-client traffic. get_user_stat returns all clients; get_daily_top_users only returns the top 8."
msgstr "選擇由哪個 fwx ubus 接口提供每客戶端流量。get_user_stat 返回全部設備；get_daily_top_users 只返回流量最高的 8 臺。"

#: traffic accumulate option (OAF support)
msgid "Accumulate Total Traffic Across Days (OAF only)"
msgstr "跨天累計總流量（僅 OAF 有效）"

#: traffic accumulate option (OAF support)
msgid "When using OAF, let wechatpush-pro keep a running total across days by detecting the midnight reset and adding each completed day to a baseline. Wrtbwmon and ctstat already accumulate by themselves, so this has no effect there. Turn OFF \"Reset Traffic Data Every Day at Midnight\" when enabling this."
msgstr "使用 OAF 時，讓 wechatpush-pro 自動檢測零點歸零、把每天流量累加到基線，從而得到跨天累計總流量。wrtbwmon 和 ctstat 自身已累計，此選項對其無效。開啓本項時請關閉“每天零點重置流量數據”。"

