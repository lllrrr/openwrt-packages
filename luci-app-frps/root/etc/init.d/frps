#!/bin/sh /etc/rc.common
#
# Copyright 2020 lwz322 <lwz322@qq.com>
# Licensed to the public under the MIT License.
#
# 多实例版（v2）：每个 instance section 启动一个独立 frps 进程。
#

START=99
USE_PROCD=1

NAME="frps"
CONFIG_FOLDER="/var/etc/$NAME"

_log() {
	local level="$1" ; shift
	local msg="$@"
	logger -p "daemon.$level" -t "$NAME" "$msg"

	echo "[$level] $msg" >&2
}

_info() { _log "info" $@; }
_err()  { _log "err"  $@; }

# 因Uci的option名不能带 . 号，故用 __ 替代；在调用此函数时，frp参数名称，分3类
# 1.Toml字符串类，直接使用，并加双引号输出
# 2.Toml布尔和整数，使用时，名称请附加 ..INT 后缀，在此处理后，并原样输出
# 3.Toml数组，使用时请附加 ..ARR 后缀，网页端可 不加引号使用逗号或空格分隔 的简写方式，处理后，再加方括号输出
# 4.uci值存在单独的 * 号时（如frps参数allowUsers），可能导致for取值异常，要处理
append_options() {
	local file="$1" ; shift
	local o v f
	for o in "$@" ; do
		f=""
		if [ -n "$(echo $o | grep "..INT")" ];then
			f=1
			o=${o//..INT/}
		fi
		if [ -n "$(echo $o | grep "..ARR")" ];then
			f=2
			o=${o//..ARR/}
		fi
		eval v=\$${o//./__}
		if [ -n "$v" ] ; then
			[ "$f" == "" ] && echo "$o = \"$v\"" >>"$file"
			[ "$f" == "1" ] && echo "$o = $v" >>"$file"
			if [ "$f" == "2" ];then
				local T M
				M=""
				if [ "$o" == "allowPorts" ];then
					# 对allowPorts特殊处理，标准写法和简写法
					if [ -n "$(echo "$v" | grep "{" | grep "}")" ];then
						echo "$o = [ $v ]" >>"$file"
					else
						v=${v//,/ }
						for T in $v ; do
						if [ -z "$(echo "$T" | grep "\-")" ];then
							T="{ single = $T }"
						else
							[ "${T%-*}" -ge "${T#*-}" ] && continue
							T="{ start = ${T%-*}, end = ${T#*-} }"
						fi
						[ -n "$M" ] && M="$M, "
						M=$M$T
						done
						echo "$o = [ $M ]" >>"$file"
					fi
				else
					v=${v//,/ }
					if [ -n "$(echo "$v" | grep "^\* \| \* \| \*$")" ];then
						v="${v//\*/\"*\"}"
					fi
					[ "$v" == "*" ] && v=\"*\"
					for T in $v ; do
					if [ "${T:0:1}" == "\"" -o "${T:0:1}" == "'" ] && [ "${#T}" == "1" ];then
						continue
					fi
					if [ "${T:0:1}" == "\"" -a "$(echo -n "$T" | tail -c 1)" == "\"" ] || [ "${T:0:1}" == "'" -a "$(echo -n "$T" | tail -c 1)" == "'" ];then
						true
					else
						T=${T//\'/}
						T=\"${T//\"/}\"
					fi
					[ -n "$M" ] && M="$M, "
					M=$M$T
					done
					echo "$o = [$M]" >>"$file"
				fi
			fi
		fi
	done
}

append_setting() {
	local file="$1" ; shift
	local s="$1"
	if [ -n "$s" ] ; then
		echo "$s" >>"$file"
	fi
}

instance_section_validate() {
	uci_validate_section "$NAME" "instance" "$1" \
		'enabled:bool:0' \
		'alias:string' \
		'client_file:string' \
		'run_user:string' \
		'set_firewall:string' \
		'tcp_ports:string' \
		'udp_ports:string' \
		'enable_logging:bool:0' \
		'std_redirect:bool:0' \
		'log__to:string' \
		'log__level:or("trace", "debug", "info", "warn", "error")' \
		'log__maxDays:uinteger' \
		'log__disablePrintColor:or("true", "false")' \
		'bindAddr:string' \
		'bindPort:integer' \
		'auth__method:or("token", "oidc")' \
		'auth__token:string' \
		'transport__tcpMux:or("true", "false")' \
		'transport__tcpMuxKeepaliveInterval:uinteger' \
		'kcpBindPort:port' \
		'quicBindPort:port' \
		'vhostHTTPPort:port' \
		'vhostHTTPSPort:port' \
		'transport__maxPoolCount:uinteger' \
		'maxPortsPerClient:uinteger' \
		'allowPorts:string' \
		'subDomainHost:host' \
		'transport__tls__force:or("true", "false")' \
		'transport__tls__certFile:file' \
		'transport__tls__keyFile:file' \
		'transport__tls__trustedCaFile:file' \
		'transport__heartbeatTimeout:integer' \
		'proxyBindAddr:string' \
		'extra_setting:list(string)' \
		'webServer__addr:host' \
		'webServer__port:port' \
		'webServer__user:string' \
		'webServer__password:string' \
		'webServer__tls__certFile:file' \
		'webServer__tls__keyFile:file'
}

client_file_validate() {
	local file="$1"

	test -f "$file" || return 1
	test -x "$file" || chmod 755 "$file"

	eval "$file" -h | grep -q "$NAME"
	return $?
}

add_rule_extra_option() {
	append_setting "$2" "$1"
}

create_config_file() {
	local config_file="$1"
	local section="$2"
	local tmp_file="$(mktemp /tmp/frps-XXXXXX)"

	echo "# 文件生成时间：$(date +%Y-%m-%d_%H:%M:%S)" > "$tmp_file"
	echo "# 实例：$section" >> "$tmp_file"

	append_options "$tmp_file" \
		"bindAddr" "bindPort..INT" "proxyBindAddr" "auth.method" "auth.token" \
		"kcpBindPort..INT" "quicBindPort..INT" "vhostHTTPPort..INT" "vhostHTTPSPort..INT" \
		"transport.tcpMux..INT" "transport.tcpMuxKeepaliveInterval..INT"

	if [ "x$enable_logging" = "x1" ] ; then
		append_options "$tmp_file" \
			"log.to" "log.level" "log.maxDays..INT" "log.disablePrintColor..INT"
	fi

	append_options "$tmp_file" \
		"transport.maxPoolCount..INT" "maxPortsPerClient..INT" "transport.heartbeatTimeout..INT" \
		"subDomainHost" "allowPorts..ARR" \
		"transport.tls.force..INT" "transport.tls.certFile" "transport.tls.keyFile" "transport.tls.trustedCaFile" \
		"webServer.addr" "webServer.port..INT" "webServer.user" "webServer.password" \
		"webServer.tls.certFile" "webServer.tls.keyFile"

	config_list_foreach "$section" "extra_setting" add_rule_extra_option "$tmp_file"

	sed '/^$/d' "$tmp_file" >"$config_file"
	[ "$?" = "0" ] && rm -f "$tmp_file"
}

# 防火墙：按实例独立规则名 frps_<sid>_t_auto / frps_<sid>_u_auto
add_firewall() {
	local section="$1"
	[ "$set_firewall" = "no" ] && return 0
	[ -z "$set_firewall" ] && return 0

	local rname_t="frps_${section}_t_auto"
	local rname_u="frps_${section}_u_auto"
	local mark1=0 mark2=0

	if [ -n "$tcp_ports" ]; then
		mark1=1
		[ "$set_firewall" = "check" ] && [ "$tcp_ports" = "$(uci -q get firewall.${rname_t}.dest_port)" ] && mark1=0
		if [ "$mark1" = "1" ]; then
			uci -q delete firewall.${rname_t}
			uci set firewall.${rname_t}=rule
			uci set firewall.${rname_t}.name="${rname_t}"
			uci set firewall.${rname_t}.target="ACCEPT"
			uci set firewall.${rname_t}.src="wan"
			uci set firewall.${rname_t}.proto="tcp"
			uci set firewall.${rname_t}.dest_port="$tcp_ports"
			uci set firewall.${rname_t}.enabled="1"
		fi
	fi
	if [ -n "$udp_ports" ]; then
		mark2=1
		[ "$set_firewall" = "check" ] && [ "$udp_ports" = "$(uci -q get firewall.${rname_u}.dest_port)" ] && mark2=0
		if [ "$mark2" = "1" ]; then
			uci -q delete firewall.${rname_u}
			uci set firewall.${rname_u}=rule
			uci set firewall.${rname_u}.name="${rname_u}"
			uci set firewall.${rname_u}.target="ACCEPT"
			uci set firewall.${rname_u}.src="wan"
			uci set firewall.${rname_u}.proto="udp"
			uci set firewall.${rname_u}.dest_port="$udp_ports"
			uci set firewall.${rname_u}.enabled="1"
		fi
	fi
	[ "$mark1" = "0" ] && [ "$mark2" = "0" ] && return 0
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
}

del_firewall() {
	local section="$1"
	local rname_t="frps_${section}_t_auto"
	local rname_u="frps_${section}_u_auto"
	# 仅当 set_firewall=force 或实例已被禁用/删除时清理
	[ "$set_firewall" != "force" ] && [ -n "$2" ] && return 0
	local A=$(uci -q show firewall.${rname_t})
	local B=$(uci -q show firewall.${rname_u})
	[ -n "$A" ] && uci -q delete firewall.${rname_t}
	[ -n "$B" ] && uci -q delete firewall.${rname_u}
	if [ -n "$A" ] || [ -n "$B" ]; then
		uci commit firewall
		/etc/init.d/firewall reload >/dev/null 2>&1
	fi
}

logfile_prepare() {
	local section="$1"
	local link="/tmp/frps_log_${section}.txt"
	local std_log="/tmp/frps_std_redirect_${section}.log"

	if [ "x$enable_logging" != "x1" ];then
		rm -f "$link" "$std_log"
		echo "未配置日志输出保存" > "$link"
		return 1
	fi

	if [ "${std_redirect}" = "1" ];then
		if [ -z "${log__to}" -o "${log__to}" = "console" ];then
			log__to="$std_log"
			true >"${log__to}"
		else
			mkdir -p "$(dirname "${log__to}")"
			touch "${log__to}" 2>/dev/null
			if [ "$?" != "0" ];then
				log__to="$std_log"
				echo "【$(date +%Y-%m-%d_%H:%M:%S)】--->警告：配置的日志文件路径似乎无效/只读！" > "${log__to}"
			fi
		fi
	fi

	if [ -n "${log__to}" -a "${log__to}" != "console" ];then
		mkdir -p "$(dirname "${log__to}")"
		touch "${log__to}"
	fi

	if [ -n "$run_user" ]; then
		chmod 644 "$log__to"
		chown "$run_user" "$log__to" 2>/dev/null
	fi

	# 实例级软链
	ln -sf "${log__to}" "$link"
}

start_instance() {
	local section="$1"

	if ! instance_section_validate "$section" ; then
		_err "Instance section validate failed: \"$section\""
		return 1
	fi

	if [ "x$enabled" != "x1" ] ; then
		_info "Instance \"$section\" disabled."
		del_firewall "$section"
		return 0
	fi

	# 解析 client_file: instance.client_file → main.default_client_file → /usr/bin/frps
	# 三级 fallback：避免「程序管理切到某版本后该目录被外部清理」整个服务起不来
	local effective_client="$client_file"
	if [ -z "$effective_client" ] || ! client_file_validate "$effective_client" ; then
		effective_client=$(uci -q get frps.main.default_client_file)
	fi
	if [ -z "$effective_client" ] || ! client_file_validate "$effective_client" ; then
		effective_client="/usr/bin/frps"
	fi
	if ! client_file_validate "$effective_client" ; then
		_err "Instance \"$section\": no valid client_file (tried instance, default, /usr/bin/frps)."
		return 1
	fi

	# 解析 run_user: instance.run_user → main.default_run_user
	local effective_user="$run_user"
	if [ -z "$effective_user" ]; then
		effective_user=$(uci -q get frps.main.default_run_user)
	fi

	test -d "$CONFIG_FOLDER" || mkdir -p "$CONFIG_FOLDER"
	local config_file="$CONFIG_FOLDER/frps.${section}.toml"

	create_config_file "$config_file" "$section"

	if [ ! -f "$config_file" ] ; then
		_err "Could not create config file: \"$config_file\""
		return 1
	fi

	logfile_prepare "$section"

	# 记录实例 state（供 controller 读取）
	mkdir -p /var/run/frps
	{
		echo "section=${section}"
		echo "toml=${config_file}"
		echo "log=${log__to}"
		echo "web_port=${webServer__port}"
		echo "client_file=${effective_client}"
	} > "/var/run/frps/${section}.state"

	procd_open_instance "frps.${section}"
	if [ "${std_redirect}" = "1" ];then
		procd_set_param command "/bin/sh"
		procd_append_param command -c "exec ${effective_client} -c ${config_file} >>\"${log__to}\" 2>&1"
	else
		procd_set_param command "$effective_client"
		procd_append_param command -c "$config_file"
	fi
	procd_set_param respawn
	procd_set_param file "$config_file"
	[ -n "$effective_user" ] && procd_set_param user "$effective_user"
	procd_close_instance

	add_firewall "$section"
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}

start_service() {
	config_load "$NAME"

	# 全局总开关
	local global_enabled
	global_enabled=$(uci -q get frps.main.enabled)
	if [ "$global_enabled" != "1" ]; then
		_info "Global disabled (frps.main.enabled != 1)."
		return 0
	fi

	mkdir -p /var/run/frps
	config_foreach start_instance "instance"

	# 兼容旧 UI：全局软链指向第一个 enabled 实例的日志
	local default_link=""
	local f
	for f in /var/run/frps/*.state; do
		[ -f "$f" ] || continue
		local sec
		sec=$(basename "$f" .state)
		[ "$(uci -q get frps.${sec}.enabled)" = "1" ] || continue
		default_link="/tmp/frps_log_${sec}.txt"
		break
	done
	if [ -n "$default_link" ] && [ -e "$default_link" ]; then
		ln -sf "$default_link" /tmp/frps_log_link.txt
	fi
}

service_stopped() {
	# 清理实例 state；保留 /var/etc/frps/*.toml 方便诊断
	rm -f /var/run/frps/*.state 2>/dev/null
	# 清理实例级防火墙规则（force 模式）
	config_load "$NAME"
	config_foreach _stop_cleanup_fw "instance"
}

_stop_cleanup_fw() {
	local section="$1"
	set_firewall=$(uci -q get "frps.${section}.set_firewall")
	del_firewall "$section"
}
