#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:60
msgid "PPPoE Dial-up"
msgstr "宽带拨号"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:61
msgid "Broadband account"
msgstr "宽带账号"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:62
msgid ""
"Dial up with the broadband account and password supplied by your ISP. Choose "
"this when the line requires PPPoE authentication."
msgstr "使用运营商提供的宽带账号和密码拨号。当线路需要 PPPoE 认证时选择此项。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:67
msgid "DHCP Client"
msgstr "现有路由器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:68
msgid "Existing router"
msgstr "已有路由器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:69
msgid ""
"Obtain an address automatically from an upstream modem or router. This is "
"the usual choice for a new router behind an existing gateway."
msgstr ""
"从上级光猫或路由器自动获取地址。这是新路由器接在现有网关之后的常见选择。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:74
msgid "Side Router"
msgstr "旁路由"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:75
msgid "Keep the main router"
msgstr "保留主路由器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:76
msgid ""
"Keep the existing main router and use this device for additional services. "
"LAN clients use this device as their gateway."
msgstr ""
"保留现有主路由器，将此设备用于附加服务。局域网客户端将把此设备作为网关。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:278
msgid "Configuration applied successfully."
msgstr "配置已成功应用。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:395
msgid "Not configured"
msgstr "未配置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:395
msgid "No wireless radio"
msgstr "无无线网卡"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:396
msgid "Enabled"
msgstr "已开启"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:396
msgid "Disabled"
msgstr "已关闭"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:405
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:513
msgid "Smart NetPilot"
msgstr "智能网络向导"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:406
msgid "Network setup"
msgstr "网络设置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:409
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:514
msgid "Guided setup"
msgstr "引导式设置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:410
msgid ""
"Use Smart NetPilot to finish network setup quickly and safely with guidance."
msgstr "使用智能网络向导，即可在指引下快速且安全地完成网络设置。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:412
msgid "Automatic light and dark theme"
msgstr "自动适配明暗主题"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:413
msgid "Validated before apply"
msgstr "应用前校验"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:414
msgid "IPv4 and IPv6"
msgstr "IPv4 与 IPv6"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:418
msgid "Current mode"
msgstr "当前模式"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:419
msgid "Management address"
msgstr "管理地址"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:419
msgid "Unknown"
msgstr "未知"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:420
msgid "Wireless"
msgstr "无线"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:421
msgid "HTTPS management"
msgstr "HTTPS 管理"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:459
msgid "Current"
msgstr "当前"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:466
#, javascript-format
msgid "Configure %s"
msgstr "配置 %s"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:489
#, javascript-format
msgid "Could not save the selected mode. %s"
msgstr "无法保存所选模式。%s"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:517
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:608
msgid "Configuration"
msgstr "配置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:525
msgid "Selected mode"
msgstr "所选模式"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:539
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:673
msgid "Hide advanced settings"
msgstr "收起高级设置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:539
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:673
msgid "Advanced settings"
msgstr "高级设置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:547
msgid "Change mode"
msgstr "更改模式"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:556
msgid "WAN Settings"
msgstr "WAN 设置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:558
msgid "Wireless Settings"
msgstr "无线设置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:558
msgid ""
"Set the wireless name and password. For advanced options, open Network → "
"Wireless."
msgstr "设置无线名称和密码。更多高级选项请打开“网络 → 无线”。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:559
msgid "Other Settings"
msgstr "其他设置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:692
msgid "Network Mode"
msgstr "网络模式"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:709
msgid "WAN device"
msgstr "WAN 设备"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:710
msgid "Physical network port used for the internet connection."
msgstr "用于连接互联网的物理网络端口。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:725
msgid "This is the switch CPU port, not a physical network port."
msgstr "这是交换机 CPU 口，不是物理网络端口。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:730
msgid "PPPoE username"
msgstr "PPPoE 用户名"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:734
msgid "PPPoE password"
msgstr "PPPoE 密码"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:739
msgid "WAN address mode"
msgstr "WAN 地址模式"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:740
msgid "Choose how the WAN interface obtains its address."
msgstr "选择 WAN 接口获取地址的方式。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:742
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:775
msgid "Static IPv4 address"
msgstr "静态 IPv4 地址"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:743
msgid "DHCP client"
msgstr "DHCP 客户端"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:747
msgid "WAN IPv4 address"
msgstr "WAN IPv4 地址"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:752
msgid "WAN IPv4 netmask"
msgstr "WAN IPv4 子网掩码"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:761
msgid "WAN IPv4 gateway"
msgstr "WAN IPv4 网关"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:766
msgid "Custom DNS servers"
msgstr "自定义 DNS 服务器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:767
msgid "Leave empty to obtain DNS servers automatically."
msgstr "留空则自动获取 DNS 服务器。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:772
msgid "LAN address mode"
msgstr "LAN 地址模式"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:773
msgid ""
"DHCP client mode takes the LAN address from the upstream router. Check the "
"upstream lease table to find the new address."
msgstr ""
"DHCP 客户端模式下，LAN 地址由上级路由器分配。请在上级路由器的租约列表中查找新"
"地址。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:776
msgid "DHCP client (assigned upstream)"
msgstr "DHCP 客户端（由上级分配）"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:780
msgid "LAN IPv4 address"
msgstr "LAN IPv4 地址"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:781
msgid ""
"The management address of this router. Choose an address outside the "
"upstream DHCP pool."
msgstr "本路由器的管理地址。请选择上级 DHCP 地址池之外的地址。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:787
msgid "LAN IPv4 netmask"
msgstr "LAN IPv4 子网掩码"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:796
msgid "LAN IPv4 gateway"
msgstr "LAN IPv4 网关"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:797
msgid ""
"Side router only: enter the address of the main router. It must be in the "
"same subnet as this router."
msgstr "仅旁路由模式：输入主路由器的地址，且必须与本路由器处于同一子网。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:802
msgid "LAN DNS servers"
msgstr "局域网 DNS 服务器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:803
msgid "DNS servers handed to LAN clients. Leave empty to use the defaults."
msgstr "下发给局域网客户端的 DNS 服务器。留空则使用默认值。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:809
msgid "Enable IPv6"
msgstr "启用 IPv6"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:810
msgid ""
"Configure IPv6 on the WAN and LAN interfaces. Disable it if your ISP does "
"not provide IPv6."
msgstr "在 WAN 和 LAN 接口上启用 IPv6。如果你的运营商不提供 IPv6，请关闭。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:814
msgid "Disable the LAN DHCP server"
msgstr "关闭 LAN DHCP 服务器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:815
msgid ""
"Only one DHCP server should run on a network. Disable this router’s server "
"when the main router already provides one."
msgstr ""
"同一网络中只应运行一个 DHCP 服务器。如果主路由器已提供 DHCP，请关闭本路由器的"
"服务器。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:819
msgid "Advertise a DNS server to LAN clients"
msgstr "向局域网客户端通告 DNS 服务器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:820
msgid "Force LAN clients to use the DNS server selected below."
msgstr "强制局域网客户端使用下方选择的 DNS 服务器。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:825
msgid "DNS server to advertise"
msgstr "向外通告的 DNS 服务器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:826
msgid "Use this router’s LAN address"
msgstr "使用本路由器的 LAN 地址"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:827
msgid "Ali DNS: 223.5.5.5"
msgstr "阿里 DNS：223.5.5.5"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:828
msgid "Baidu DNS: 180.76.76.76"
msgstr "百度 DNS：180.76.76.76"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:829
msgid "114 DNS: 114.114.114.114"
msgstr "114 DNS：114.114.114.114"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:830
msgid "Google DNS: 8.8.8.8"
msgstr "Google DNS：8.8.8.8"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:831
msgid "Cloudflare DNS: 1.1.1.1"
msgstr "Cloudflare DNS：1.1.1.1"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:835
msgid "Redirect management to HTTPS"
msgstr "将管理页面重定向到 HTTPS"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:836
msgid "Generate a local certificate and redirect HTTP requests to HTTPS."
msgstr "生成本地证书，并将 HTTP 请求重定向到 HTTPS。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:842
msgid "Wireless name (SSID)"
msgstr "无线名称（SSID）"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:845
msgid "Enter a wireless name"
msgstr "输入无线名称"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:848
msgid "Wireless password"
msgstr "无线密码"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:852
msgid "At least 8 characters"
msgstr "至少 8 个字符"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:857
msgid "Enable SYN-flood protection"
msgstr "启用 SYN Flood 防护"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:858
msgid ""
"Recommended. Protects the router and LAN clients from SYN-flood attacks."
msgstr "推荐开启。保护路由器和局域网客户端免受 SYN Flood 攻击。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:885
#, javascript-format
msgid ""
"The management address will change from %s to %s. The current page will "
"disconnect and then open the new address."
msgstr "管理地址将从 %s 变为 %s。当前页面会断开连接，然后打开新地址。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:888
msgid ""
"The LAN interface will become a DHCP client. Its new address is assigned by "
"the upstream router, so it cannot be predicted. Find the lease in the "
"upstream router after applying."
msgstr ""
"LAN 接口将变为 DHCP 客户端。其新地址由上级路由器分配，无法预先确定。应用后请"
"在上级路由器中查找租约。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:893
msgid ""
"Management access will switch to HTTPS after the configuration is applied."
msgstr "配置应用后，管理页面将切换为 HTTPS。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:894
msgid ""
"HTTPS redirection will be disabled. Management access will return to HTTP "
"after the configuration is applied."
msgstr "HTTPS 重定向将被关闭。配置应用后，管理页面将恢复为 HTTP。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:898
msgid ""
"The wireless name or password changed. Wireless clients will need to "
"reconnect."
msgstr "无线名称或密码已更改，无线客户端需要重新连接。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1019
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1494
msgid "Cancel"
msgstr "取消"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1028
msgid "Discard and go back"
msgstr "放弃并返回"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1031
msgid "Discard unsaved changes?"
msgstr "放弃未保存的更改？"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1035
msgid ""
"You have unsaved settings on this page. Going back to the mode selection "
"discards them."
msgstr "此页面有尚未保存的设置，返回模式选择后将丢弃这些修改。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1113
msgid "Apply cancelled."
msgstr "已取消应用。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1117
#, javascript-format
msgid "Configuration could not be saved. %s"
msgstr "配置无法保存。%s"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1130
msgid "There are no changes to apply."
msgstr "没有需要应用的更改。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1136
msgid "Could not prepare the configuration apply. Please try again."
msgstr "无法准备应用配置，请重试。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1154
#, javascript-format
msgid "Apply request failed with status %s."
msgstr "应用请求失败（状态 %s）。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1190
msgid "Configuration applied without confirmation."
msgstr "配置已应用，未启用自动回滚确认。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1206
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1392
msgid "The configuration could not be applied."
msgstr "无法应用配置。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1211
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1344
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1384
msgid "Configuration confirmed. The new settings are kept."
msgstr "已确认配置，新设置将保留。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1294
#, javascript-format
msgid ""
"If you do not confirm within %d seconds, the previous configuration is "
"restored automatically."
msgstr "如果在 %d 秒内未确认，将自动恢复之前的配置。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1302
msgid "Keep configuration"
msgstr "保留配置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1310
msgid "Roll back now"
msgstr "立即回滚"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1340
msgid "Saving confirmation…"
msgstr "正在保存确认…"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1351
msgid "The device did not confirm the configuration. Please try again."
msgstr "设备未能确认配置，请重试。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1361
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1375
msgid "Restoring the previous configuration…"
msgstr "正在恢复之前的配置…"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1406
msgid ""
"The new settings were applied. Keep them, or the previous configuration will "
"be restored automatically."
msgstr "新设置已应用。请保留它们，否则将自动恢复之前的配置。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1408
msgid "Rollback in"
msgstr "回滚倒计时"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1410
msgid "s"
msgstr "秒"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1416
#, javascript-format
msgid "New management address: %s"
msgstr "新的管理地址：%s"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1419
msgid "Confirm the new configuration"
msgstr "确认新配置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1460
msgid "Reconnect to the previous address"
msgstr "重新连接到之前的地址"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1469
msgid "Close"
msgstr "关闭"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1472
msgid "Restoring the previous configuration"
msgstr "正在恢复之前的配置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1475
msgid ""
"The previous network settings are being restored. The connection will be "
"interrupted; reconnect to the router once it is done."
msgstr "正在恢复之前的网络设置。连接会中断，完成后请重新连接到路由器。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1476
#, javascript-format
msgid "Previous management address: %s"
msgstr "之前的管理地址：%s"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1503
msgid "Apply without confirmation"
msgstr "不确认，直接应用"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1512
msgid "Apply and disconnect"
msgstr "应用并断开连接"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1512
msgid "Continue and apply"
msgstr "继续并应用"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1515
