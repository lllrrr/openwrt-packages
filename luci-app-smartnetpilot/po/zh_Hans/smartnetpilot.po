msgid "Apply without confirmation"
msgstr "不确认，直接应用"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1862
msgid "Apply and disconnect"
msgstr "应用并断开连接"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1862
