#!/bin/sh
# luci.sheep — rpcd RPC handler (kiwi style)

readonly NAME="sheep"
. /usr/share/libubox/jshn.sh

getStatus() {
	local running=0 pid="" uptime=""
	pid=$(pgrep -f "/usr/bin/sheep" 2>/dev/null | head -1)
	[ -n "$pid" ] && running=1
	if [ -n "$pid" ]; then
		local start_time now hz elapsed d h m
		start_time=$(awk '{print $22}' /proc/"$pid"/stat 2>/dev/null)
		now=$(awk '{print int($1)}' /proc/uptime 2>/dev/null)
		if [ -n "$start_time" ] && [ -n "$now" ]; then
			hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
			elapsed=$(( now - start_time / hz ))
			[ "$elapsed" -lt 0 ] && elapsed=0
			d=$(( elapsed / 86400 ))
			h=$(( (elapsed % 86400) / 3600 ))
			m=$(( (elapsed % 3600) / 60 ))
			if [ "$d" -gt 0 ]; then
				uptime="${d}d ${h}h ${m}m"
			elif [ "$h" -gt 0 ]; then
				uptime="${h}h ${m}m"
			else
				uptime="${m}m"
			fi
		fi
	fi
	json_init
	json_add_boolean "running" "$running"
	json_add_int    "pid"     "${pid:-0}"
	json_add_string "uptime"  "$uptime"
	json_dump
	json_cleanup
}

getLog() {
	local output
	output=$(tail -c 65536 /tmp/sheep.log 2>/dev/null | tr '\n' '\036')
	json_init
	json_add_string "log" "$output"
	json_dump
	json_cleanup
}

clearLog() {
	> /tmp/sheep.log 2>/dev/null
	json_init
	json_add_boolean "result" 1
	json_dump
	json_cleanup
}

start() {
	/etc/init.d/sheep start >/dev/null 2>&1
	json_init
	json_add_boolean "result" 1
	json_dump
	json_cleanup
}

stop() {
	/etc/init.d/sheep stop >/dev/null 2>&1
	json_init
	json_add_boolean "result" 1
	json_dump
	json_cleanup
}

restart() {
	/etc/init.d/sheep restart >/dev/null 2>&1
	json_init
	json_add_boolean "result" 1
	json_dump
	json_cleanup
}

case "$1" in
	list)
		json_init
		json_add_object "getStatus"; json_close_object
		json_add_object "getLog";    json_close_object
		json_add_object "clearLog";  json_close_object
		json_add_object "start";     json_close_object
		json_add_object "stop";      json_close_object
		json_add_object "restart";   json_close_object
		json_dump
		json_cleanup
		;;
	call)
		case "$2" in
			getStatus) getStatus ;;
			getLog)    getLog    ;;
			clearLog)  clearLog  ;;
			start)     start     ;;
			stop)      stop      ;;
			restart)   restart   ;;
		esac
		;;
esac
