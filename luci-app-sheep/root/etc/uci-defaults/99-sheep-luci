#!/bin/sh
# First-boot ACL defaults — grants luci-app-sheep RPC access

# Exit if running in IPKG_INSTROOT (during package installation)
[ -n "${IPKG_INSTROOT}" ] && exit 0

# Ensure rpcd config exists
uci -c /etc/config show rpcd > /dev/null 2>&1 || {
	uci -c /etc/config set rpcd=rpcd
	uci -c /etc/config set rpcd.@rpcd[0]=rpcd
}

# Ensure ACL list exists and add our ACL
uci -c /etc/config get rpcd.@rpcd[0].acl > /dev/null 2>&1 || {
	uci -c /etc/config set rpcd.@rpcd[0].acl='luci-app-sheep'
}

# Check if luci-app-sheep is already in ACL list
if ! uci -c /etc/config get rpcd.@rpcd[0].acl | grep -q 'luci-app-sheep'; then
	# Append luci-app-sheep to existing ACL list
	acl=$(uci -c /etc/config get rpcd.@rpcd[0].acl)
	uci -c /etc/config set rpcd.@rpcd[0].acl="${acl} luci-app-sheep"
fi

uci -c /etc/config commit rpcd
/etc/init.d/rpcd restart 2>/dev/null || true

exit 0
