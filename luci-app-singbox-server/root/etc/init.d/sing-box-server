#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later

START=99
STOP=10
USE_PROCD=1

NAME=sing-box-server
PROG=/usr/bin/sing-box
HELPER=/usr/libexec/sing-box-server
CONF=/var/etc/sing-box-server/config.json
LOG=/var/log/sing-box-server.log

service_triggers() {
	procd_add_reload_trigger sing_box_server
}

start_service() {
	local enabled config_file log_file
	config_load sing_box_server
	config_get_bool enabled global enabled 0
	[ "$enabled" = "1" ] || return 0
	config_get config_file global config_file "$CONF"
	config_get log_file global log_file "$LOG"
	mkdir -p "$(dirname "$config_file")" "$(dirname "$log_file")"
	$HELPER gen_config "$config_file" || return 1

	procd_open_instance sing-box-server
	procd_set_param command "$PROG" run -c "$config_file"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$config_file"
	procd_set_param limits nofile=1048576
	procd_close_instance
}

reload_service() {
	restart
}
