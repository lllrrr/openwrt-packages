config global 'global'
	option enabled '0'
	option log_level 'info'
	option listen '::'
	option sniff '1'
	option tcp_fast_open '0'
	option multipath_tcp '0'
	option config_file '/var/etc/sing-box-server/config.json'
	option log_file '/var/log/sing-box-server.log'

config server
	option enabled '1'
	option remarks 'vmess-ws'
	option protocol 'vmess'
	option listen_port '10086'
	option uuid '00000000-0000-0000-0000-000000000000'
	option transport 'ws'
	option path '/vmess'
	option tls '0'

config server
	option enabled '0'
	option remarks 'vless-reality'
	option protocol 'vless'
	option listen_port '443'
	option uuid '00000000-0000-0000-0000-000000000000'
	option flow 'xtls-rprx-vision'
	option transport 'tcp'
	option tls '1'
	option tls_mode 'reality'
	option server_name 'www.microsoft.com'
	option reality_private_key ''
	option reality_short_id ''
	option reality_handshake_server 'www.microsoft.com'
	option reality_handshake_server_port '443'
