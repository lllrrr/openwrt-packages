#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
PROG=/usr/bin/sheep
CONF=/etc/shadowsocks-rust/config.json

_fw_rule_name() {
	local port="${1:-8388}"
	echo "sheep-${port}"
}

# 确保 rpcd 有 luci-app-sheep 的 ACL（每次启动都检查，防止恢复备份后丢失）
ensure_rpcd_acl() {
	local acl_name="luci-app-sheep"
	local acl_file="/usr/share/rpcd/acl.d/${acl_name}.json"
	[ -f "$acl_file" ] || return 0

	# 检查 rpcd config 中是否已包含该 ACL
	uci -q get rpcd.@rpcd[0].acl | grep -q "$acl_name" && return 0

	# 添加到现有列表
	local acl
	acl=$(uci -q get rpcd.@rpcd[0].acl || "")
	uci set rpcd.@rpcd[0].acl="${acl} ${acl_name}"
	uci commit rpcd
	/etc/init.d/rpcd reload 2>/dev/null || true
}

add_firewall_rule() {
	local manage_firewall server_port
	config_get_bool manage_firewall server manage_firewall 0
	[ "$manage_firewall" -eq 1 ] || return 0
	config_get server_port server server_port 8388

	local name
	name="$(_fw_rule_name "$server_port")"

	# 避免重复添加
	uci show firewall | grep -q "name='${name}'" && return 0

	uci batch <<-EOF
		add firewall rule
		set firewall.@rule[-1].name='${name}'
		set firewall.@rule[-1].src='wan'
		set firewall.@rule[-1].dest_port='${server_port}'
		add_list firewall.@rule[-1].proto='tcp'
		add_list firewall.@rule[-1].proto='udp'
		set firewall.@rule[-1].target='ACCEPT'
		commit firewall
	EOF
	/etc/init.d/firewall reload
}

remove_firewall_rule() {
	# 删除所有以 sheep- 开头的规则，避免改端口后旧规则残留
	local section changed=0
	for section in $(uci show firewall | grep "name='sheep-" | cut -d. -f2); do
		uci delete "firewall.${section}"
		changed=1
	done
	[ "$changed" -eq 1 ] || return 0
	uci commit firewall
	/etc/init.d/firewall reload
}

# 每次启动（包括开机）都检查 ACL，然后启动服务
boot() {
	ensure_rpcd_acl
	start
}

start_service() {
	local enabled
	config_load sheep
	config_get_bool enabled server enabled 0

	[ "$enabled" -eq 1 ] || return 0

	/usr/libexec/sheep-ctrl.sh sync_config
	add_firewall_rule
	# 启动时也确保 ACL
	ensure_rpcd_acl

	procd_open_instance
	procd_set_param command /bin/sh
	procd_append_param command -c
	procd_append_param command "exec $PROG -c $CONF >> /tmp/sheep.log 2>&1"
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	config_load sheep
	remove_firewall_rule
}

service_triggers() {
	procd_add_reload_trigger sheep
}

reload_service() {
	stop
	start
}
