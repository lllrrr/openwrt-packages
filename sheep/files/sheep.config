config sheep 'server'
	option enabled          '0'
	option server           '0.0.0.0'
	option server_port      '8388'
	option password         ''
	option method           'aes-256-gcm'
	option timeout          '300'
	option fast_open        '0'
	option mode             'tcp_and_udp'
	option plugin           ''
	option plugin_opts      ''
	option manage_firewall  '1'
