#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
    config_load iptv-tool

    local data_dir log_dir
    config_get data_dir settings data_dir "/etc/iptv-tool/data"
    config_get log_dir  settings log_dir  "/etc/iptv-tool/logs"

    mkdir -p "$data_dir"
    mkdir -p "$log_dir"

    procd_open_instance
    procd_set_param command /usr/bin/iptv-server --data "$data_dir" --log-dir "$log_dir"
    procd_set_param respawn 300 5
    procd_set_param pidfile /var/run/iptv-tool.pid
    procd_set_param env TZ=Asia/Shanghai
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

boot() {
    config_load iptv-tool
    local enabled
    config_get_bool enabled settings enabled 0

    [ "$enabled" -eq 0 ] && return 0

    start
}