{
	"luci-app-oxidns": {
		"description": "Grant access to the OxiDNS LuCI app",
		"read": {
			"ubus": {
				"luci.oxidns": [
					"status",
					"core_progress",
					"core_update_check",
					"config_read",
					"settings_read",
					"logs_recent",
					"rules_status",
					"rules_check",
					"prewarm_read",
					"hijack_get",
					"geo_get",
					"geo_progress",
					"credentials_status",
					"upstream_probe"
				]
			}
		},
		"write": {
			"ubus": {
				"luci.oxidns": [
					"core_install",
					"core_reinstall",
					"core_update",
					"core_remove",
					"service_start",
					"service_stop",
					"service_restart",
					"service_enable",
					"service_disable",
					"config_validate",
					"config_save",
					"settings_save",
					"rules_update",
					"rules_restore",
					"prewarm_save",
					"prewarm_run",
					"hijack_save",
					"geo_save",
					"geo_reset",
					"geo_download",
					"credentials_generate",
					"credentials_set",
					"credentials_reveal",
					"credentials_migrate",
					"credentials_clear"
				]
			}
		}
	},
	"luci-app-oxidns-core-upload": {
		"description": "Allow installing an explicitly uploaded OxiDNS core (requires allow_core_upload=1)",
		"write": {
			"cgi-io": [ "upload" ],
			"file": {
				"/tmp/oxidns-core-upload-*": [ "write" ]
			},
			"ubus": {
				"luci.oxidns": [ "core_upload_install" ]
			}
		}
	}
}
