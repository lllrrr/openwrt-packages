#!/bin/sh

set -eu

UCI_PACKAGE="oxidns"
UCI_SECTION="main"
OXIDNS_BIN="/usr/bin/oxidns"
WEBUI_DIR="/usr/share/oxidns/webui"
TARGETS_FILE="${OXIDNS_TARGETS_FILE:-/usr/share/oxidns/targets.json}"
DEFAULT_CONFIG_PATH="/etc/oxidns/config.yaml"
DEFAULT_WORKING_DIR="/var/lib/oxidns"
DEFAULT_RULES_DIR="/etc/oxidns/rule"
DEFAULT_SERVICE_NAME="oxidns"
DEFAULT_CORE_REPOSITORY="svenshi/oxidns"
DEFAULT_CORE_BUNDLE="full"
GITHUB_API_BASE="https://api.github.com"
LEARN_RESET_SCRIPT="${OXIDNS_LEARN_RESET_SCRIPT:-/usr/libexec/oxidns/learn-reset.sh}"
LEARN_CRON_FILE="${OXIDNS_LEARN_CRON_FILE:-/etc/crontabs/root}"
LEARN_CRON_BEGIN="# BEGIN luci-app-oxidns learn-reset"
LEARN_CRON_END="# END luci-app-oxidns learn-reset"
TMP_ROOT="${TMPDIR:-/tmp}"
CORE_PROGRESS_DIR="$TMP_ROOT/luci-oxidns"
CORE_PROGRESS_LOG="$CORE_PROGRESS_DIR/core-progress.log"
CORE_LOCK_DIR="$CORE_PROGRESS_DIR/core-operation.lock"
CORE_LOCK_HELD=0

# DNS 劫持：状态唯一事实源是 /etc/config/firewall 里的 oxidns_hijack* 段
# （存在 = 已开启）。段形如 target DNAT + 无 dest_ip，fw4 渲染为
# nft `redirect to :<dest_port>`（iptables REDIRECT --to-ports 的 nft 等价）。
FIREWALL_INIT="${OXIDNS_FIREWALL_INIT:-/etc/init.d/firewall}"
HIJACK_SECT_BOTH="oxidns_hijack"
HIJACK_SECT_UDP="oxidns_hijack_udp"
HIJACK_SECT_TCP="oxidns_hijack_tcp"
HIJACK_MARK="oxidns-dns-hijack"

CONFIG_PATH="$DEFAULT_CONFIG_PATH"
WORKING_DIR="$DEFAULT_WORKING_DIR"
RULES_DIR="$DEFAULT_RULES_DIR"
SERVICE_NAME="$DEFAULT_SERVICE_NAME"
CORE_REPOSITORY="$DEFAULT_CORE_REPOSITORY"
CORE_BUNDLE="$DEFAULT_CORE_BUNDLE"
DOWNLOAD_PROXY=""
GITHUB_TOKEN=""
DOWNLOAD_ERROR=""
DOWNLOAD_RC=""

json_escape_stream() {
	awk 'BEGIN { ORS = "" }
	{
		if (NR > 1)
			printf "\\n";
		for (i = 1; i <= length($0); i++) {
			c = substr($0, i, 1);
			if (c == "\\")
				printf "\\\\";
			else if (c == "\"")
				printf "\\\"";
			else if (c == "\t")
				printf "\\t";
			else if (c == "\r")
				printf "\\r";
			else
				printf "%s", c;
		}
	}'
}

json_string() {
	printf '"'
	printf '%s' "$1" | json_escape_stream
	printf '"'
}

json_file_string() {
	printf '"'
	if [ -r "$1" ]; then
		json_escape_stream < "$1"
	fi
	printf '"'
}

json_bool() {
	if [ "${1:-0}" = "1" ]; then
		printf 'true'
	else
		printf 'false'
	fi
}

json_error() {
	printf '{'
	printf '"ok":false,'
	printf '"code":'
	json_string "$1"
	printf ',"message":'
	json_string "$2"
	printf '}\n'
}

json_detailed_error() {
	CODE="$1"
	MESSAGE="$2"
	STAGE="${3:-}"
	DETAIL="${4:-}"

	printf '{'
	printf '"ok":false,'
	printf '"code":'
	json_string "$CODE"
	printf ',"message":'
	json_string "$MESSAGE"
	if [ -n "$STAGE" ]; then
		printf ',"stage":'
		json_string "$STAGE"
	fi
	if [ -n "$DETAIL" ]; then
		printf ',"detail":'
		json_string "$DETAIL"
	fi
	printf '}\n'
}

sanitize_progress_text() {
	awk -v token="$GITHUB_TOKEN" -v proxy="$DOWNLOAD_PROXY" '
		function redact(value, secret,    out, pos) {
			if (secret == "")
				return value;
			out = "";
			while ((pos = index(value, secret)) > 0) {
				out = out substr(value, 1, pos - 1) "[redacted]";
				value = substr(value, pos + length(secret));
			}
			return out value;
		}
		{
			line = redact(redact($0, token), proxy);
			gsub(/[[:cntrl:]]/, " ", line);
			print line;
		}
	'
}

prepare_core_progress_dir() {
	if [ -L "$CORE_PROGRESS_DIR" ] || { [ -e "$CORE_PROGRESS_DIR" ] && [ ! -d "$CORE_PROGRESS_DIR" ]; }; then
		return 1
	fi
	if [ ! -d "$CORE_PROGRESS_DIR" ]; then
		mkdir "$CORE_PROGRESS_DIR" 2>/dev/null || return 1
	fi
	if command -v chown >/dev/null 2>&1; then
		chown 0:0 "$CORE_PROGRESS_DIR" 2>/dev/null || true
	fi
	chmod 700 "$CORE_PROGRESS_DIR" 2>/dev/null || true
	return 0
}

prepare_core_progress_file() {
	RESET_FILE="${1:-0}"
	prepare_core_progress_dir || return 1
	if [ -L "$CORE_PROGRESS_LOG" ] || { [ -e "$CORE_PROGRESS_LOG" ] && [ ! -f "$CORE_PROGRESS_LOG" ]; }; then
		rm -f "$CORE_PROGRESS_LOG" 2>/dev/null || return 1
	fi
	if [ "$RESET_FILE" = "1" ] || [ ! -e "$CORE_PROGRESS_LOG" ]; then
		: > "$CORE_PROGRESS_LOG" 2>/dev/null || return 1
	fi
	[ ! -L "$CORE_PROGRESS_LOG" ] || return 1
	if command -v chown >/dev/null 2>&1; then
		chown 0:0 "$CORE_PROGRESS_LOG" 2>/dev/null || true
	fi
	chmod 600 "$CORE_PROGRESS_LOG" 2>/dev/null || true
	return 0
}

progress_timestamp() {
	date '+%H:%M:%S' 2>/dev/null || printf '--:--:--'
}

core_progress_log() {
	PROGRESS_KIND="$1"
	PROGRESS_MESSAGE="$2"
	PROGRESS_TEXT="$(printf '%s' "$PROGRESS_MESSAGE" | sanitize_progress_text)"
	[ -n "$PROGRESS_TEXT" ] || PROGRESS_TEXT="-"
	prepare_core_progress_file 0 || return 0
	printf '[%s] %s %s\n' "$(progress_timestamp)" "$PROGRESS_KIND" "$PROGRESS_TEXT" >> "$CORE_PROGRESS_LOG" 2>/dev/null || true
}

core_progress_command() {
	core_progress_log "command" "+ $1"
}

core_progress_reset() {
	prepare_core_progress_file 1 || return 0
	core_progress_log "info" "$1"
}

pid_is_running() {
	PID_VALUE="$1"
	case "$PID_VALUE" in
		''|*[!0-9]*)
			return 1
			;;
	esac
	kill -0 "$PID_VALUE" 2>/dev/null
}

clear_stale_core_lock() {
	[ -d "$CORE_LOCK_DIR" ] && [ ! -L "$CORE_LOCK_DIR" ] || return 1
	LOCK_PID="$(sed -n '1p' "$CORE_LOCK_DIR/pid" 2>/dev/null || true)"
	if pid_is_running "$LOCK_PID"; then
		return 1
	fi
	rm -f "$CORE_LOCK_DIR/pid" 2>/dev/null || return 1
	rmdir "$CORE_LOCK_DIR" 2>/dev/null || return 1
}

acquire_core_lock() {
	prepare_core_progress_dir || {
		json_error "core_lock_failed" "failed to prepare core operation lock directory"
		return 1
	}
	if mkdir "$CORE_LOCK_DIR" 2>/dev/null || { clear_stale_core_lock && mkdir "$CORE_LOCK_DIR" 2>/dev/null; }; then
		CORE_LOCK_HELD=1
		printf '%s\n' "$$" > "$CORE_LOCK_DIR/pid" 2>/dev/null || true
		chmod 700 "$CORE_LOCK_DIR" 2>/dev/null || true
		return 0
	fi
	core_progress_log "error" "another core operation is already running"
	json_error "core_operation_busy" "another OxiDNS core operation is already running"
	return 1
}

release_core_lock() {
	if [ "${CORE_LOCK_HELD:-0}" = "1" ]; then
		rm -f "$CORE_LOCK_DIR/pid" 2>/dev/null || true
		rmdir "$CORE_LOCK_DIR" 2>/dev/null || true
		CORE_LOCK_HELD=0
	fi
}

run_with_core_lock() {
	acquire_core_lock || return 1
	trap 'release_core_lock' EXIT
	trap 'release_core_lock; exit 1' HUP INT TERM
	"$@"
	CORE_ACTION_RC="$?"
	release_core_lock
	trap - EXIT HUP INT TERM
	return "$CORE_ACTION_RC"
}

file_size_bytes() {
	[ -f "$1" ] || {
		printf '0'
		return 0
	}
	wc -c < "$1" 2>/dev/null | awk '{ print $1 + 0 }'
}

emit_core_progress() {
	if ! prepare_core_progress_file 0; then
		printf '{"ok":true,"path":'
		json_string "$CORE_PROGRESS_LOG"
		printf ',"mtime":"","size":"0","text":""}\n'
		return 0
	fi
	printf '{"ok":true,"path":'
	json_string "$CORE_PROGRESS_LOG"
	printf ',"mtime":'
	json_string "$(stat_mtime "$CORE_PROGRESS_LOG")"
	printf ',"size":'
	json_string "$(file_size_bytes "$CORE_PROGRESS_LOG")"
	printf ',"text":'
	json_file_string "$CORE_PROGRESS_LOG"
	printf '}\n'
}

uci_get() {
	KEY="$1"
	DEFAULT="$2"
	if command -v uci >/dev/null 2>&1; then
		uci -q get "$UCI_PACKAGE.$UCI_SECTION.$KEY" 2>/dev/null || printf '%s' "$DEFAULT"
	else
		printf '%s' "$DEFAULT"
	fi
}

load_settings() {
	SERVICE_NAME="$DEFAULT_SERVICE_NAME"
	CONFIG_PATH="$(uci_get config_path "$DEFAULT_CONFIG_PATH")"
	WORKING_DIR="$(uci_get working_dir "$DEFAULT_WORKING_DIR")"
	RULES_DIR="$(uci_get rules_dir "$DEFAULT_RULES_DIR")"
	CORE_REPOSITORY="$(uci_get core_repository "$DEFAULT_CORE_REPOSITORY")"
	CORE_BUNDLE="$(uci_get core_bundle "$DEFAULT_CORE_BUNDLE")"
	DOWNLOAD_PROXY="$(uci_get download_proxy '')"
	GITHUB_TOKEN="$(uci_get github_token '')"
	LEARN_RESET_FREQ="$(uci_get learn_reset_freq off)"
	LEARN_RESET_TIME="$(uci_get learn_reset_time 04:00)"
	LEARN_RESET_WEEKDAY="$(uci_get learn_reset_weekday 1)"
	LEARN_RESET_CN="$(uci_get learn_reset_cn 1)"
	LEARN_RESET_PROXY="$(uci_get learn_reset_proxy 1)"
	LEARN_RESET_API_URL="$(uci_get learn_reset_api_url http://127.0.0.1:9199)"
	LEARN_RESET_API_USER="$(uci_get learn_reset_api_user admin)"
	LEARN_RESET_API_PASS="$(uci_get learn_reset_api_pass '')"
}

init_script() {
	printf '/etc/init.d/%s' "$SERVICE_NAME"
}

service_enabled() {
	INIT="$(init_script)"
	[ -x "$INIT" ] && "$INIT" enabled >/dev/null 2>&1
}

service_running() {
	INIT="$(init_script)"
	if [ -x "$INIT" ] && "$INIT" status >/dev/null 2>&1; then
		return 0
	fi
	if command -v pgrep >/dev/null 2>&1 && pgrep -x oxidns >/dev/null 2>&1; then
		return 0
	fi
	return 1
}

yaml_scalar_clean() {
	sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/^"//; s/"$//; s/^'\''//; s/'\''$//'
}

config_api_listen() {
	[ -r "$CONFIG_PATH" ] || return 1
	awk '
		/^[^[:space:]#][^:]*:/ {
			top = $0;
			sub(/:.*/, "", top);
			second = "";
		}
		top == "api" && /^[[:space:]]+http:[[:space:]]*[^[:space:]#]/ {
			sub(/^[[:space:]]+http:[[:space:]]*/, "", $0);
			print $0;
			exit;
		}
		top == "api" && /^[[:space:]]+http:[[:space:]]*$/ {
			second = "http";
			next;
		}
		top == "api" && second == "http" && /^[[:space:]]+listen:[[:space:]]*/ {
			sub(/^[[:space:]]+listen:[[:space:]]*/, "", $0);
			print $0;
			exit;
		}
	' "$CONFIG_PATH" | yaml_scalar_clean
}

config_log_file() {
	[ -r "$CONFIG_PATH" ] || return 1
	awk '
		/^[^[:space:]#][^:]*:/ {
			top = $0;
			sub(/:.*/, "", top);
		}
		top == "log" && /^[[:space:]]+file:[[:space:]]*[^[:space:]#]/ {
			sub(/^[[:space:]]+file:[[:space:]]*/, "", $0);
			print $0;
			exit;
		}
	' "$CONFIG_PATH" | yaml_scalar_clean
}

# 解析 config.yaml 里 plugins 列表的 udp_server / tcp_server 监听地址。
# 每类取第一个，输出形如 "udp_server :5335" / "tcp_server :53"，未配置的不输出。
config_dns_listen() {
	[ -r "$CONFIG_PATH" ] || return 1
	awk '
		/^[^[:space:]#][^:]*:/ {
			top = $0;
			sub(/:.*/, "", top);
		}
		top != "plugins" { next }
		/^[[:space:]]*-[[:space:]]/ {
			item_type = "";
			in_args = 0;
			got = 0;
		}
		!got && /^[[:space:]]+type:[[:space:]]*[^[:space:]#]/ {
			t = $0;
			sub(/^[[:space:]]+type:[[:space:]]*/, "", t);
			sub(/[[:space:]].*$/, "", t);
			if (t == "udp_server" || t == "tcp_server")
				item_type = t;
		}
		/^[[:space:]]+args:/ { in_args = 1 }
		item_type != "" && in_args && !got && /^[[:space:]]+listen:[[:space:]]*[^[:space:]#]/ {
			l = $0;
			sub(/^[[:space:]]+listen:[[:space:]]*/, "", l);
			sub(/[[:space:]]*(#.*)?$/, "", l);
			gsub(/"/, "", l);
			print item_type " " l;
			got = 1;
		}
	' "$CONFIG_PATH"
}

# 从监听地址提取端口（":53" / "0.0.0.0:53" / "[::]:53" → 53）
hijack_port_of_listen() {
	[ -n "$1" ] || return 1
	L="$(printf '%s' "$1" | yaml_scalar_clean)"
	case "$L" in
		*:*) PORT="${L##*:}" ;;
		*) PORT="$L" ;;
	esac
	case "$PORT" in
		''|*[!0-9]*) return 1 ;;
	esac
	if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
		return 1
	fi
	printf '%s' "$PORT"
}

# 从 config.yaml 解析 DNS 监听端口 → DNS_UDP_PORT / DNS_TCP_PORT（解析不到为空）
# 注意：这里用 awk 匹配即 exit 取首行，不用 "sed | head"——MSYS 下该组合会随机死锁。
resolve_dns_ports() {
	DNS_UDP_PORT=""
	DNS_TCP_PORT=""
	[ -r "$CONFIG_PATH" ] || return 1
	RAW="$(config_dns_listen || true)"
	UDP_LISTEN="$(printf '%s\n' "$RAW" | awk '/^udp_server /{sub(/^udp_server /,"");print;exit}')"
	TCP_LISTEN="$(printf '%s\n' "$RAW" | awk '/^tcp_server /{sub(/^tcp_server /,"");print;exit}')"
	DNS_UDP_PORT="$(hijack_port_of_listen "$UDP_LISTEN" || true)"
	DNS_TCP_PORT="$(hijack_port_of_listen "$TCP_LISTEN" || true)"
	if [ -z "$DNS_UDP_PORT" ] && [ -z "$DNS_TCP_PORT" ]; then
		return 1
	fi
	return 0
}

# 日志文件解析：config.yaml 的 log.file（相对路径按上游语义基于 working_dir 展开）；
# 未配置时退回默认路径 /var/log/oxidns.log
resolve_log_file() {
	load_settings
	LOG_FILE_CONFIGURED=0
	LOG_FILE=""
	if [ -r "$CONFIG_PATH" ]; then
		LOG_FILE="$(config_log_file || true)"
	fi
	if [ -n "$LOG_FILE" ]; then
		LOG_FILE_CONFIGURED=1
		case "$LOG_FILE" in
			/*) ;;
			*) LOG_FILE="$WORKING_DIR/${LOG_FILE#./}" ;;
		esac
	else
		LOG_FILE="/var/log/oxidns.log"
	fi
}

webui_url_from_config() {
	LISTEN="$(config_api_listen || true)"
	[ -n "$LISTEN" ] || return 1
	LISTEN="${LISTEN#http://}"
	LISTEN="${LISTEN#https://}"
	case "$LISTEN" in
		*:*) ;;
		*) return 1 ;;
	esac
	HOST="${LISTEN%:*}"
	PORT="${LISTEN##*:}"
	case "$HOST" in
		''|'0.0.0.0'|'::'|'[::]')
			HOST="127.0.0.1"
			;;
	esac
	[ -n "$PORT" ] || return 1
	printf 'http://%s:%s/' "$HOST" "$PORT"
}

listen_host_from_config() {
	LISTEN="$(config_api_listen || true)"
	[ -n "$LISTEN" ] || return 1
	LISTEN="${LISTEN#http://}"
	LISTEN="${LISTEN#https://}"
	case "$LISTEN" in
		*:*) ;;
		*) return 1 ;;
	esac
	printf '%s' "${LISTEN%:*}"
}

is_loopback_host() {
	case "$1" in
		localhost|127.*|'::1'|'[::1]')
			return 0
			;;
	esac
	return 1
}

is_wildcard_host() {
	case "$1" in
		''|'0.0.0.0'|'::'|'[::]')
			return 0
			;;
	esac
	return 1
}

build_info_json() {
	if [ -x "$OXIDNS_BIN" ]; then
		"$OXIDNS_BIN" build-info 2>/dev/null || true
	fi
}

json_value_from_string() {
	KEY="$1"
	JSON="$2"
	if command -v jsonfilter >/dev/null 2>&1; then
		printf '%s' "$JSON" | jsonfilter -e "@.$KEY" 2>/dev/null || true
	else
		printf '%s' "$JSON" | sed -n "s/.*\"$KEY\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" | sed -n '1p'
	fi
}

detect_rust_target_from_file() {
	TARGET_FILE="$1"
	ARCH="$2"
	[ -r "$TARGET_FILE" ] || return 1
	awk -v arch="$ARCH" '
		function field_value(line,    value) {
			value = line;
			sub(/^.*:[[:space:]]*"/, "", value);
			sub(/".*$/, "", value);
			return value;
		}
		/"rust_target"[[:space:]]*:/ {
			target = field_value($0);
			next;
		}
		target != "" && (/"uname_arches"[[:space:]]*:/ || /"aliases"[[:space:]]*:/) {
			line = $0;
			gsub(/[\[\],"]/, " ", line);
			n = split(line, parts, /[[:space:]]+/);
			for (i = 1; i <= n; i++) {
				if (parts[i] == arch) {
					print target;
					found = 1;
					exit;
				}
			}
		}
		END { exit found ? 0 : 1 }
	' "$TARGET_FILE"
}

detect_rust_target() {
	ARCH="$(uname -m 2>/dev/null || printf unknown)"
	if detect_rust_target_from_file "$TARGETS_FILE" "$ARCH"; then
		return 0
	fi
	case "$ARCH" in
		x86_64|amd64)
			printf 'x86_64-unknown-linux-musl'
			;;
		aarch64|arm64)
			printf 'aarch64-unknown-linux-musl'
			;;
		i386|i686)
			printf 'i686-unknown-linux-musl'
			;;
		armv7l|armv7)
			printf 'armv7-unknown-linux-musleabihf'
			;;
		armv6l|armv6)
			printf 'arm-unknown-linux-musleabihf'
			;;
		*)
			return 1
			;;
	esac
}

emit_status() {
	load_settings
	ENABLED=0
	RUNNING=0
	CORE_INSTALLED=0
	WEBUI_INSTALLED=0
	WEBUI_LOCAL_ONLY=0
	WEBUI_WILDCARD=0
	BUILD_JSON="$(build_info_json)"
	CORE_VERSION="$(json_value_from_string version "$BUILD_JSON")"
	CORE_BUNDLE_VALUE="$(json_value_from_string bundle "$BUILD_JSON")"
	CORE_TARGET="$(detect_rust_target 2>/dev/null || printf unknown)"
	WEBUI_URL="$(webui_url_from_config 2>/dev/null || true)"
	WEBUI_LISTEN="$(config_api_listen 2>/dev/null || true)"
	WEBUI_HOST="$(listen_host_from_config 2>/dev/null || true)"

	if [ -x "$OXIDNS_BIN" ]; then CORE_INSTALLED=1; fi
	if [ -d "$WEBUI_DIR" ]; then WEBUI_INSTALLED=1; fi
	if is_loopback_host "$WEBUI_HOST"; then WEBUI_LOCAL_ONLY=1; fi
	if is_wildcard_host "$WEBUI_HOST"; then WEBUI_WILDCARD=1; fi
	if service_enabled; then ENABLED=1; fi
	if service_running; then RUNNING=1; fi

	printf '{'
	printf '"ok":true,'
	printf '"backend":"rpcd",'
	printf '"core":{"installed":'
	json_bool "$CORE_INSTALLED"
	printf ',"version":'
	json_string "$CORE_VERSION"
	printf ',"bundle":'
	json_string "$CORE_BUNDLE_VALUE"
	printf ',"target":'
	json_string "$CORE_TARGET"
	printf ',"binary_path":'
	json_string "$OXIDNS_BIN"
	printf '}'
	printf ',"service":'
	json_string "$SERVICE_NAME"
	printf ',"config_path":'
	json_string "$CONFIG_PATH"
	printf ',"working_dir":'
	json_string "$WORKING_DIR"
	printf ',"service_status":{"running":'
	json_bool "$RUNNING"
	printf ',"enabled":'
	json_bool "$ENABLED"
	printf ',"init_script":'
	json_string "$(init_script)"
	printf '}'
	printf ',"webui":{"installed":'
	json_bool "$WEBUI_INSTALLED"
	printf ',"url":'
	json_string "$WEBUI_URL"
	printf ',"listen":'
	json_string "$WEBUI_LISTEN"
	printf ',"local_only":'
	json_bool "$WEBUI_LOCAL_ONLY"
	printf ',"wildcard":'
	json_bool "$WEBUI_WILDCARD"
	printf ',"path":'
	json_string "$WEBUI_DIR"
	printf '}'
	printf ',"build":'
	if printf '%s' "$BUILD_JSON" | grep -q '^{'; then
		printf '%s' "$BUILD_JSON"
	else
		printf 'null'
	fi
	printf '}\n'
}

run_service() {
	load_settings
	ACTION="$1"
	INIT="$(init_script)"
	case "$ACTION" in
		start|restart|enable)
			if [ ! -x "$OXIDNS_BIN" ]; then
				json_error "core_not_installed" "Install the OxiDNS core before using service controls"
				return 1
			fi
			;;
	esac
	if [ ! -x "$INIT" ]; then
		json_error "service_unavailable" "init script not found: $INIT"
		return 1
	fi
	SERVICE_OUT="$(mktemp "$TMP_ROOT/luci-oxidns-service.XXXXXX")"
	if "$INIT" "$ACTION" >"$SERVICE_OUT" 2>&1; then
		rm -f "$SERVICE_OUT"
		printf '{"ok":true,"action":'
		json_string "$ACTION"
		printf '}\n'
	else
		MSG="$(read_error_detail_file "$SERVICE_OUT" 2>/dev/null || true)"
		rm -f "$SERVICE_OUT"
		json_error "service_failed" "${MSG:-service action failed}"
		return 1
	fi
}

stat_mtime() {
	stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || printf ''
}

emit_config_read() {
	load_settings
	if [ ! -r "$CONFIG_PATH" ]; then
		printf '{"ok":false,"code":"config_not_found","message":"configuration file not found","path":'
		json_string "$CONFIG_PATH"
		printf '}\n'
		return 1
	fi
	printf '{'
	printf '"ok":true,'
	printf '"path":'
	json_string "$CONFIG_PATH"
	printf ',"mtime":'
	json_string "$(stat_mtime "$CONFIG_PATH")"
	printf ',"content":'
	json_file_string "$CONFIG_PATH"
	printf '}\n'
}

safe_single_line_value() {
	printf '%s' "$1" | awk '
		BEGIN { ok = 1; cr = sprintf("%c", 13) }
		NR > 1 { ok = 0 }
		index($0, cr) { ok = 0 }
		END { exit ok ? 0 : 1 }
	'
}

json_field_string() {
	NAME="$1"
	VALUE="$2"
	printf '"%s":' "$NAME"
	json_string "$VALUE"
}

emit_settings_read() {
	load_settings
	TOKEN_SET=0
	PROXY_SET=0
	if [ -n "$GITHUB_TOKEN" ]; then TOKEN_SET=1; fi
	if [ -n "$DOWNLOAD_PROXY" ]; then PROXY_SET=1; fi
	printf '{'
	printf '"ok":true,'
	json_field_string core_repository "$CORE_REPOSITORY"
	printf ','
	json_field_string core_bundle "$CORE_BUNDLE"
	printf ','
	json_field_string config_path "$CONFIG_PATH"
	printf ','
	json_field_string working_dir "$WORKING_DIR"
	printf ','
	json_field_string download_proxy "$DOWNLOAD_PROXY"
	printf ','
	json_field_string github_token ''
	printf ',"download_proxy_set":'
	json_bool "$PROXY_SET"
	printf ',"github_token_set":'
	json_bool "$TOKEN_SET"
	printf '}\n'
}

settings_value() {
	KEY="$1"
	INPUT="$2"
	VALUE="$(input_value "$KEY" "$INPUT")"
	if ! safe_single_line_value "$VALUE"; then
		return 1
	fi
	printf '%s' "$VALUE"
}

# ===== DNS 劫持（fw4 redirect：LAN :53 → 本机 oxidns DNS 端口）=====

hijack_managed_sections() {
	for SECT in "$HIJACK_SECT_BOTH" "$HIJACK_SECT_UDP" "$HIJACK_SECT_TCP"; do
		if uci -q get "firewall.$SECT" >/dev/null 2>&1; then
			printf '%s\n' "$SECT"
		fi
	done
}

hijack_add_section() {
	SECT="$1"
	PROTO="$2"
	PORT="$3"
	uci -q set "firewall.$SECT=redirect" || return 1
	uci -q set "firewall.$SECT.name=$HIJACK_MARK" || return 1
	uci -q set "firewall.$SECT.src=lan" || return 1
	uci -q set "firewall.$SECT.proto=$PROTO" || return 1
	uci -q set "firewall.$SECT.src_dport=53" || return 1
	uci -q set "firewall.$SECT.dest_port=$PORT" || return 1
	uci -q set "firewall.$SECT.target=DNAT" || return 1
}

hijack_firewall_reload() {
	if [ -x "$FIREWALL_INIT" ]; then
		"$FIREWALL_INIT" reload >/dev/null 2>&1
		return $?
	fi
	return 1
}

# 输出状态 JSON 片段（调用方负责包一层 {"ok":true,...}）
emit_hijack_status() {
	RELOADED="${1:-}"
	SECT_JSON=""
	ENABLED=0
	for SECT in $(hijack_managed_sections); do
		SECT_JSON="$SECT_JSON\"$SECT\","
		ENABLED=1
	done
	SECT_JSON="${SECT_JSON%,}"
	UDP_JSON="null"
	if [ -n "$DNS_UDP_PORT" ]; then
		UDP_JSON="$DNS_UDP_PORT"
	fi
	TCP_JSON="null"
	if [ -n "$DNS_TCP_PORT" ]; then
		TCP_JSON="$DNS_TCP_PORT"
	fi
	WARN_JSON="null"
	if [ "$RELOADED" = "0" ]; then
		WARN_JSON='"firewall_reload_failed"'
	fi
	printf '"enabled":%s,"udp_port":%s,"tcp_port":%s,"sections":[%s],"reloaded":%s,"warn":%s}' \
		"$ENABLED" "$UDP_JSON" "$TCP_JSON" "$SECT_JSON" "${RELOADED:-null}" "$WARN_JSON"
}

emit_hijack_get() {
	if ! command -v uci >/dev/null 2>&1; then
		json_error "uci_unavailable" "uci command not found"
		return 1
	fi
	load_settings
	resolve_dns_ports || true
	printf '{"ok":true,'
	emit_hijack_status
	printf '\n'
}

emit_hijack_save() {
	INPUT="$(cat)"
	if ! command -v uci >/dev/null 2>&1; then
		json_error "uci_unavailable" "uci command not found"
		return 1
	fi
	load_settings
	ENABLED="$(input_bool enabled "$INPUT")"
	# 先给端口变量兜底：config.yaml 不可读时 resolve_dns_ports 根本不会跑，
	# 而 set -u 下引用未绑定变量会直接终止整个后端（连 JSON 错误都发不出）。
	DNS_UDP_PORT=""
	DNS_TCP_PORT=""
	if [ -r "$CONFIG_PATH" ]; then
		resolve_dns_ports || true
	fi
	if [ "$ENABLED" = "1" ] && [ -z "$DNS_UDP_PORT" ] && [ -z "$DNS_TCP_PORT" ]; then
		json_error "no_dns_listen" "could not resolve a udp_server/tcp_server listen port from config.yaml"
		return 1
	fi
	for SECT in $(hijack_managed_sections); do
		uci -q delete "firewall.$SECT" >/dev/null 2>&1 || true
	done
	if [ "$ENABLED" = "1" ]; then
		if [ -n "$DNS_UDP_PORT" ] && [ "$DNS_UDP_PORT" = "$DNS_TCP_PORT" ]; then
			hijack_add_section "$HIJACK_SECT_BOTH" "tcp udp" "$DNS_UDP_PORT" || {
				json_error "hijack_write_failed" "failed to add the firewall redirect section"
				return 1
			}
		else
			if [ -n "$DNS_UDP_PORT" ]; then
				hijack_add_section "$HIJACK_SECT_UDP" "udp" "$DNS_UDP_PORT" || {
					json_error "hijack_write_failed" "failed to add the UDP redirect section"
					return 1
				}
			fi
			if [ -n "$DNS_TCP_PORT" ]; then
				hijack_add_section "$HIJACK_SECT_TCP" "tcp" "$DNS_TCP_PORT" || {
					json_error "hijack_write_failed" "failed to add the TCP redirect section"
					return 1
				}
			fi
		fi
	fi
	if ! uci -q commit firewall; then
		json_error "hijack_save_failed" "failed to commit firewall changes"
		return 1
	fi
	RELOADED=1
	if ! hijack_firewall_reload; then
		RELOADED=0
	fi
	printf '{"ok":true,'
	emit_hijack_status "$RELOADED"
	printf '\n'
}

emit_settings_save() {
	INPUT="$(cat)"
	if ! command -v uci >/dev/null 2>&1; then
		json_error "uci_unavailable" "uci command not found"
		return 1
	fi
	load_settings

	if ! REPOSITORY_VALUE="$(settings_value core_repository "$INPUT")" ||
		! BUNDLE_VALUE="$(settings_value core_bundle "$INPUT")" ||
		! CONFIG_VALUE="$(settings_value config_path "$INPUT")" ||
		! WORKING_VALUE="$(settings_value working_dir "$INPUT")" ||
		! PROXY_VALUE="$(settings_value download_proxy "$INPUT")"; then
		json_error "invalid_settings" "settings values must be single-line strings"
		return 1
	fi

	[ -n "$REPOSITORY_VALUE" ] || REPOSITORY_VALUE="$DEFAULT_CORE_REPOSITORY"
	[ -n "$BUNDLE_VALUE" ] || BUNDLE_VALUE="$DEFAULT_CORE_BUNDLE"
	[ -n "$CONFIG_VALUE" ] || CONFIG_VALUE="$DEFAULT_CONFIG_PATH"
	[ -n "$WORKING_VALUE" ] || WORKING_VALUE="$DEFAULT_WORKING_DIR"

	case "$REPOSITORY_VALUE" in
		*/*) ;;
		*)
			json_error "invalid_core_repository" "core_repository must use owner/repo format"
			return 1
			;;
	esac
	if printf '%s' "$REPOSITORY_VALUE" | grep -q '[^A-Za-z0-9_.\/-]'; then
		json_error "invalid_core_repository" "core_repository contains unsupported characters"
		return 1
	fi

	case "$BUNDLE_VALUE" in
		full|standard|minimal) ;;
		*)
			json_error "invalid_core_bundle" "core_bundle must be one of full, standard, minimal"
			return 1
			;;
	esac
	if ! valid_config_path_setting "$CONFIG_VALUE"; then
		json_error "invalid_config_path" "config_path must be an absolute OxiDNS-related file path"
		return 1
	fi
	if ! valid_working_dir_setting "$WORKING_VALUE"; then
		json_error "invalid_working_dir" "working_dir must be an absolute OxiDNS-related directory path"
		return 1
	fi

	uci -q set oxidns.main=settings
	uci -q set "oxidns.main.core_repository=$REPOSITORY_VALUE"
	uci -q set "oxidns.main.core_bundle=$BUNDLE_VALUE"
	uci -q set "oxidns.main.config_path=$CONFIG_VALUE"
	uci -q set "oxidns.main.working_dir=$WORKING_VALUE"
	uci -q delete oxidns.main.api_base_url >/dev/null 2>&1 || true
	uci -q delete oxidns.main.install_mode >/dev/null 2>&1 || true
	uci -q delete oxidns.main.service_name >/dev/null 2>&1 || true
	uci -q delete oxidns.main.package_feed_url >/dev/null 2>&1 || true
	uci -q delete oxidns.main.manifest_url >/dev/null 2>&1 || true

	CLEAR_PROXY="$(input_bool clear_download_proxy "$INPUT")"
	if [ "$CLEAR_PROXY" = "1" ]; then
		uci -q delete oxidns.main.download_proxy >/dev/null 2>&1 || true
	elif [ -n "$PROXY_VALUE" ]; then
		uci -q set "oxidns.main.download_proxy=$PROXY_VALUE"
	elif [ -z "$DOWNLOAD_PROXY" ]; then
		uci -q delete oxidns.main.download_proxy >/dev/null 2>&1 || true
	fi

	NEW_TOKEN="$(input_value github_token "$INPUT")"
	CLEAR_TOKEN="$(input_bool clear_github_token "$INPUT")"
	if [ "$CLEAR_TOKEN" = "1" ]; then
		uci -q delete oxidns.main.github_token >/dev/null 2>&1 || true
	elif [ -n "$NEW_TOKEN" ]; then
		if ! safe_single_line_value "$NEW_TOKEN"; then
			json_error "invalid_token" "github_token must be a single-line value"
			return 1
		fi
		uci -q set oxidns.main.github_token="$NEW_TOKEN"
	fi

	if uci -q commit oxidns; then
		emit_settings_read
	else
		json_error "settings_save_failed" "failed to commit oxidns settings"
		return 1
	fi
}

input_value() {
	KEY="$1"
	INPUT="$2"
	if command -v jsonfilter >/dev/null 2>&1; then
		printf '%s' "$INPUT" | jsonfilter -e "@.$KEY" 2>/dev/null || true
	else
		printf '%s' "$INPUT" | sed -n "s/.*\"$KEY\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p"
	fi
}

input_has_key() {
	KEY="$1"
	INPUT="$2"
	printf '%s' "$INPUT" | grep -q "\"$KEY\"[[:space:]]*:"
}

input_bool() {
	KEY="$1"
	INPUT="$2"
	VALUE="$(input_value "$KEY" "$INPUT")"
	case "$VALUE" in
		1|true|TRUE|yes|YES|on|ON)
			printf '1'
			;;
		*)
			printf '0'
			;;
	esac
}

path_is_under() {
	CHILD="$1"
	PARENT="$2"
	[ -n "$CHILD" ] && [ -n "$PARENT" ] || return 1
	case "$CHILD" in
		"$PARENT"/*)
			return 0
			;;
	esac
	return 1
}

oxidns_named_path() {
	PATH_VALUE="$1"
	BASE_NAME="$(basename "$PATH_VALUE" 2>/dev/null || printf '')"
	DIR_NAME="$(dirname "$PATH_VALUE" 2>/dev/null || printf '')"
	DIR_BASE="$(basename "$DIR_NAME" 2>/dev/null || printf '')"
	case "$BASE_NAME:$DIR_BASE" in
		*oxidns*|*:oxidns*)
			return 0
			;;
	esac
	return 1
}

safe_remove_config_path() {
	PATH_VALUE="$1"
	[ -n "$PATH_VALUE" ] || return 1
	case "$PATH_VALUE" in
		/*) ;;
		*) return 1 ;;
	esac
	[ -d "$PATH_VALUE" ] && return 1
	oxidns_named_path "$PATH_VALUE"
}

safe_remove_working_dir() {
	PATH_VALUE="$1"
	[ -n "$PATH_VALUE" ] || return 1
	case "$PATH_VALUE" in
		/*) ;;
		*) return 1 ;;
	esac
	case "$PATH_VALUE" in
		/|/bin|/dev|/etc|/lib|/mnt|/overlay|/proc|/rom|/root|/sbin|/sys|/tmp|/usr|/var|/www)
			return 1
			;;
	esac
	oxidns_named_path "$PATH_VALUE"
}

path_has_parent_ref() {
	case "$1" in
		..|../*|*/..|*/../*)
			return 0
			;;
	esac
	return 1
}

valid_config_path_setting() {
	PATH_VALUE="$1"
	path_has_parent_ref "$PATH_VALUE" && return 1
	safe_remove_config_path "$PATH_VALUE"
}

valid_working_dir_setting() {
	PATH_VALUE="$1"
	path_has_parent_ref "$PATH_VALUE" && return 1
	safe_remove_working_dir "$PATH_VALUE"
}

validate_config_file() {
	FILE="$1"
	load_settings
	if [ ! -x "$OXIDNS_BIN" ]; then
		printf 'oxidns binary not found or not executable: %s' "$OXIDNS_BIN"
		return 1
	fi
	mkdir -p "$WORKING_DIR"
	"$OXIDNS_BIN" check -c "$FILE" -d "$WORKING_DIR" 2>&1
}

emit_config_validate() {
	INPUT="$(cat)"
	CONTENT="$(input_value content "$INPUT")"
	TMP_FILE="$(mktemp "$TMP_ROOT/oxidns-config.XXXXXX")"
	if input_has_key content "$INPUT"; then
		if [ -z "$CONTENT" ]; then
			rm -f "$TMP_FILE"
			json_error "missing_content" "configuration content is required"
			return 1
		fi
		printf '%s' "$CONTENT" > "$TMP_FILE"
	elif [ -r "$CONFIG_PATH" ]; then
		cp "$CONFIG_PATH" "$TMP_FILE"
	else
		rm -f "$TMP_FILE"
		json_error "config_missing" "no configuration content or file available"
		return 1
	fi
	if OUTPUT="$(validate_config_file "$TMP_FILE")"; then
		rm -f "$TMP_FILE"
		printf '{"ok":true,"message":'
		json_string "${OUTPUT:-configuration is valid}"
		printf '}\n'
	else
		rm -f "$TMP_FILE"
		json_error "config_invalid" "$OUTPUT"
		return 1
	fi
}

emit_config_save() {
	load_settings
	INPUT="$(cat)"
	CONTENT="$(input_value content "$INPUT")"
	BASE_MTIME="$(input_value base_mtime "$INPUT")"
	RESTART="$(input_value restart "$INPUT")"
	[ -n "$RESTART" ] || RESTART="$(input_value reload "$INPUT")"

	if [ -z "$CONTENT" ]; then
		json_error "missing_content" "configuration content is required"
		return 1
	fi
	if [ -n "$BASE_MTIME" ] && [ -e "$CONFIG_PATH" ] && [ "$BASE_MTIME" != "$(stat_mtime "$CONFIG_PATH")" ]; then
		json_error "config_conflict" "configuration file changed since it was loaded"
		return 1
	fi

	TMP_FILE="$(mktemp "$TMP_ROOT/oxidns-config.XXXXXX")"
	printf '%s' "$CONTENT" > "$TMP_FILE"
	if ! OUTPUT="$(validate_config_file "$TMP_FILE")"; then
		rm -f "$TMP_FILE"
		json_error "config_invalid" "$OUTPUT"
		return 1
	fi

	mkdir -p "$(dirname "$CONFIG_PATH")"
	if [ -e "$CONFIG_PATH" ]; then
		mkdir -p "$WORKING_DIR/config-backups"
		cp "$CONFIG_PATH" "$WORKING_DIR/config-backups/config.yaml.$(date +%Y%m%d%H%M%S)" 2>/dev/null || true
	fi
	mv "$TMP_FILE" "$CONFIG_PATH"

	RESTART_STATUS="not_requested"
	MESSAGE="configuration saved"
	if [ "$RESTART" = "true" ] || [ "$RESTART" = "1" ]; then
		INIT="$(init_script)"
		SERVICE_OUT="$(mktemp "$TMP_ROOT/oxidns-service.XXXXXX")"
		if [ ! -x "$INIT" ]; then
			rm -f "$SERVICE_OUT"
			json_error "service_unavailable" "configuration saved, but init script was not found"
			return 1
		fi
		if "$INIT" restart >"$SERVICE_OUT" 2>&1; then
			RESTART_STATUS="requested"
			MESSAGE="configuration saved and service restarted"
		else
			MSG="$(read_error_detail_file "$SERVICE_OUT" 2>/dev/null || true)"
			rm -f "$SERVICE_OUT"
			json_error "service_restart_failed" "configuration saved, but service restart failed: ${MSG:-service restart failed}"
			return 1
		fi
		rm -f "$SERVICE_OUT"
	fi

	printf '{"ok":true,"path":'
	json_string "$CONFIG_PATH"
	printf ',"mtime":'
	json_string "$(stat_mtime "$CONFIG_PATH")"
	printf ',"restart":'
	json_string "$RESTART_STATUS"
	printf ',"message":'
	json_string "$MESSAGE"
	printf '}\n'
}

rules_dir_path() {
	load_settings
	[ -n "$RULES_DIR" ] || RULES_DIR="$DEFAULT_RULES_DIR"
	printf '%s' "$RULES_DIR"
}

valid_rules_dir() {
	[ -n "$1" ] || return 1
	case "$1" in
		/*)
			return 0
			;;
	esac
	return 1
}

# 规则文件名只允许一层目录内的普通 .txt 名称，避免跳出规则目录
valid_rule_name() {
	case "$1" in
		''|*[!A-Za-z0-9._-]*)
			return 1
			;;
	esac
	case "$1" in
		*.txt)
			return 0
			;;
	esac
	return 1
}

rule_file_lines() {
	if [ -f "$1" ]; then
		awk 'END { print NR + 0 }' "$1" 2>/dev/null || printf '0'
	else
		printf '0'
	fi
}

emit_rules_list() {
	DIR="$(rules_dir_path)"
	DIR_EXISTS=0
	if [ -d "$DIR" ]; then
		DIR_EXISTS=1
	fi
	printf '{"ok":true,"dir":'
	json_string "$DIR"
	printf ',"rules_dir_exists":'
	json_bool "$DIR_EXISTS"
	printf ',"files":['
	SEP=""
	if [ "$DIR_EXISTS" = "1" ]; then
		for FILE in "$DIR"/*.txt; do
			[ -f "$FILE" ] || continue
			NAME="$(basename "$FILE")"
			valid_rule_name "$NAME" || continue
			printf '%s' "$SEP"
			printf '{"name":'
			json_string "$NAME"
			printf ',"path":'
			json_string "$FILE"
			printf ',"exists":true'
			printf ',"size":'
			json_string "$(file_size_bytes "$FILE")"
			printf ',"lines":'
			json_string "$(rule_file_lines "$FILE")"
			printf ',"mtime":'
			json_string "$(stat_mtime "$FILE")"
			printf '}'
			SEP=","
		done
	fi
	printf ']}\n'
}

emit_rules_read() {
	INPUT="$(cat)"
	NAME="$(input_value name "$INPUT")"
	if ! valid_rule_name "$NAME"; then
		json_error "invalid_name" "rule file name is not allowed"
		return 1
	fi

	DIR="$(rules_dir_path)"
	FILE="$DIR/$NAME"
	EXISTS=0
	if [ -f "$FILE" ]; then
		EXISTS=1
	fi

	printf '{'
	printf '"ok":true,"dir":'
	json_string "$DIR"
	printf ',"name":'
	json_string "$NAME"
	printf ',"path":'
	json_string "$FILE"
	printf ',"exists":'
	json_bool "$EXISTS"
	printf ',"size":'
	json_string "$(file_size_bytes "$FILE")"
	printf ',"lines":'
	json_string "$(rule_file_lines "$FILE")"
	printf ',"mtime":'
	json_string "$(stat_mtime "$FILE")"
	printf ',"content":'
	json_file_string "$FILE"
	printf '}\n'
}

# 备份规则文件，并只保留最近 10 份（工作目录可能是 tmpfs，不做无限累积）
backup_rule_file() {
	BACKUP_SOURCE="$1"
	BACKUP_NAME="$2"
	BACKUP_DIR="$WORKING_DIR/config-backups/rules"

	mkdir -p "$BACKUP_DIR" 2>/dev/null || return 0
	cp "$BACKUP_SOURCE" "$BACKUP_DIR/$BACKUP_NAME.$(date +%Y%m%d%H%M%S)" 2>/dev/null || return 0

	KEEP=0
	for OLD_BACKUP in "$BACKUP_DIR/$BACKUP_NAME".*; do
		[ -f "$OLD_BACKUP" ] || continue
		KEEP="$((KEEP + 1))"
	done
	if [ "$KEEP" -gt 10 ]; then
		ls -1t "$BACKUP_DIR/$BACKUP_NAME".* 2>/dev/null | tail -n +11 | while IFS= read -r STALE; do
			rm -f "$STALE"
		done
	fi
	return 0
}

emit_rules_save() {
	load_settings
	INPUT="$(cat)"
	NAME="$(input_value name "$INPUT")"
	BASE_MTIME="$(input_value base_mtime "$INPUT")"
	RESTART="$(input_bool restart "$INPUT")"

	if ! valid_rule_name "$NAME"; then
		json_error "invalid_name" "rule file name is not allowed"
		return 1
	fi
	if ! input_has_key content "$INPUT"; then
		json_error "missing_content" "rule file content is required"
		return 1
	fi

	DIR="$(rules_dir_path)"
	if ! valid_rules_dir "$DIR"; then
		json_error "invalid_rules_dir" "rule directory must be an absolute path"
		return 1
	fi

	FILE="$DIR/$NAME"
	if ! path_is_under "$FILE" "$DIR"; then
		json_error "invalid_name" "rule file path escapes the rule directory"
		return 1
	fi
	if [ ! -d "$DIR" ]; then
		json_error "rules_dir_missing" "rule directory was not found: $DIR"
		return 1
	fi
	if [ -n "$BASE_MTIME" ] && [ -e "$FILE" ] && [ "$BASE_MTIME" != "$(stat_mtime "$FILE")" ]; then
		json_error "rule_conflict" "rule file changed since it was loaded"
		return 1
	fi

	CONTENT="$(input_value content "$INPUT")"

	TMP_FILE="$(mktemp "$DIR/.oxidns-rule.XXXXXX" 2>/dev/null)" || TMP_FILE=""
	if [ -z "$TMP_FILE" ]; then
		json_error "rule_write_failed" "unable to create a temporary file in $DIR"
		return 1
	fi

	MODE="644"
	if [ -e "$FILE" ]; then
		EXISTING_MODE="$(stat -c %a "$FILE" 2>/dev/null || printf '')"
		if [ -n "$EXISTING_MODE" ]; then
			MODE="$EXISTING_MODE"
		fi
		backup_rule_file "$FILE" "$NAME"
	fi

	# 规则表按行解析：统一为 LF，末尾补一个换行（空内容则写成空文件）
	if [ -n "$CONTENT" ]; then
		printf '%s\n' "$CONTENT" | tr -d '\r' > "$TMP_FILE"
	else
		: > "$TMP_FILE"
	fi

	chmod "$MODE" "$TMP_FILE" 2>/dev/null || true

	if ! mv -f "$TMP_FILE" "$FILE"; then
		rm -f "$TMP_FILE"
		json_error "rule_write_failed" "unable to replace $FILE"
		return 1
	fi

	RESTART_STATUS="not_requested"
	MESSAGE="rule file saved"
	if [ "$RESTART" = "1" ]; then
		INIT="$(init_script)"
		SERVICE_OUT="$(mktemp "$TMP_ROOT/oxidns-service.XXXXXX")"
		if [ ! -x "$INIT" ]; then
			rm -f "$SERVICE_OUT"
			json_error "service_unavailable" "rule file saved, but init script was not found"
			return 1
		fi
		if "$INIT" restart >"$SERVICE_OUT" 2>&1; then
			RESTART_STATUS="requested"
			MESSAGE="rule file saved and service restarted"
		else
			MSG="$(read_error_detail_file "$SERVICE_OUT" 2>/dev/null || true)"
			rm -f "$SERVICE_OUT"
			json_error "service_restart_failed" "rule file saved, but service restart failed: ${MSG:-service restart failed}"
			return 1
		fi
		rm -f "$SERVICE_OUT"
	fi

	printf '{"ok":true,"dir":'
	json_string "$DIR"
	printf ',"name":'
	json_string "$NAME"
	printf ',"path":'
	json_string "$FILE"
	printf ',"exists":true'
	printf ',"size":'
	json_string "$(file_size_bytes "$FILE")"
	printf ',"lines":'
	json_string "$(rule_file_lines "$FILE")"
	printf ',"mtime":'
	json_string "$(stat_mtime "$FILE")"
	printf ',"restart":'
	json_string "$RESTART_STATUS"
	printf ',"message":'
	json_string "$MESSAGE"
	printf '}\n'
}

valid_reset_time() {
	case "$1" in
		[0-2][0-9]:[0-5][0-9]) ;;
		*) return 1 ;;
	esac
	case "${1%%:*}" in
		00|01|02|03|04|05|06|07|08|09|1[0-9]|2[0-3]) return 0 ;;
		*) return 1 ;;
	esac
}

valid_weekday() {
	case "$1" in
		0|1|2|3|4|5|6) return 0 ;;
		*) return 1 ;;
	esac
}

# freq + time (+ weekday) -> busybox crontab line "M H * * *|dow"
learn_reset_cron_line() {
	FREQ="$1"
	TIME="$2"
	WEEKDAY="$3"
	HOUR="${TIME%%:*}"
	MINUTE="${TIME##*:}"
	# crond 对 08/09 的解析因实现而异，去掉前导零
	HOUR="${HOUR#0}"
	MINUTE="${MINUTE#0}"
	case "$FREQ" in
		daily)
			printf '%s %s * * *' "$MINUTE" "$HOUR"
			;;
		weekly)
			printf '%s %s * * %s' "$MINUTE" "$HOUR" "$WEEKDAY"
			;;
		*)
			return 1
			;;
	esac
}

# $1 = cron line ("" removes the managed block)
update_learn_reset_cron() {
	CRON_LINE="$1"
	if ! touch "$LEARN_CRON_FILE" 2>/dev/null; then
		return 1
	fi
	if grep -qF "$LEARN_CRON_BEGIN" "$LEARN_CRON_FILE" 2>/dev/null; then
		# 托管块标记本身以 # 开头，不能用它当 sed 地址分隔符；改用 awk 字面前缀匹配
		TMP_CRON="$(mktemp "$TMP_ROOT/oxidns-cron.XXXXXX" 2>/dev/null)" || TMP_CRON=""
		if [ -z "$TMP_CRON" ]; then
			return 1
		fi
		awk -v beg="$LEARN_CRON_BEGIN" -v end="$LEARN_CRON_END" '
			skip && index($0, end) == 1 { skip = 0; next }
			skip { next }
			index($0, beg) == 1 { skip = 1; next }
			{ print }
		' "$LEARN_CRON_FILE" > "$TMP_CRON" || { rm -f "$TMP_CRON"; return 1; }
		cat "$TMP_CRON" > "$LEARN_CRON_FILE" || { rm -f "$TMP_CRON"; return 1; }
		rm -f "$TMP_CRON"
	fi
	if [ -n "$CRON_LINE" ]; then
		# 补一个换行，避免托管块拼到最后一行已有条目上
		if [ -s "$LEARN_CRON_FILE" ] && [ -n "$(tail -c 1 "$LEARN_CRON_FILE" 2>/dev/null)" ]; then
			printf '\n' >> "$LEARN_CRON_FILE"
		fi
		{
			printf '%s\n' "$LEARN_CRON_BEGIN"
			printf '%s %s\n' "$CRON_LINE" "$LEARN_RESET_SCRIPT"
			printf '%s\n' "$LEARN_CRON_END"
		} >> "$LEARN_CRON_FILE"
	fi
	if [ -x /etc/init.d/cron ]; then
		/etc/init.d/cron restart >/dev/null 2>&1 || true
	fi
	return 0
}

learn_reset_cron_installed() {
	grep -qF "$LEARN_CRON_BEGIN" "$LEARN_CRON_FILE" 2>/dev/null
}

emit_learn_reset_get() {
	load_settings
	CRON_INSTALLED=0
	SCRIPT_INSTALLED=0
	if learn_reset_cron_installed; then
		CRON_INSTALLED=1
	fi
	if [ -x "$LEARN_RESET_SCRIPT" ]; then
		SCRIPT_INSTALLED=1
	fi
	printf '{"ok":true,'
	printf '"reset_cn":'
	json_bool "$LEARN_RESET_CN"
	printf ',"reset_proxy":'
	json_bool "$LEARN_RESET_PROXY"
	printf ',"freq":'
	json_string "$LEARN_RESET_FREQ"
	printf ',"time":'
	json_string "$LEARN_RESET_TIME"
	printf ',"weekday":'
	json_string "$LEARN_RESET_WEEKDAY"
	printf ',"api_url":'
	json_string "$LEARN_RESET_API_URL"
	printf ',"api_user":'
	json_string "$LEARN_RESET_API_USER"
	printf ',"has_pass":'
	if [ -n "$LEARN_RESET_API_PASS" ]; then json_bool 1; else json_bool 0; fi
	printf ',"cron_installed":'
	json_bool "$CRON_INSTALLED"
	printf ',"script_installed":'
	json_bool "$SCRIPT_INSTALLED"
	printf ',"script_path":'
	json_string "$LEARN_RESET_SCRIPT"
	printf '}\n'
}

emit_learn_reset_save() {
	load_settings
	INPUT="$(cat)"
	FREQ="$(input_value freq "$INPUT")"
	TIME="$(input_value time "$INPUT")"
	WEEKDAY="$(input_value weekday "$INPUT")"
	RESET_CN="$(input_bool reset_cn "$INPUT")"
	RESET_PROXY="$(input_bool reset_proxy "$INPUT")"
	API_URL="$(input_value api_url "$INPUT")"
	API_USER="$(input_value api_user "$INPUT")"
	API_PASS="$(input_value api_pass "$INPUT")"

	case "$FREQ" in
		off|daily|weekly) ;;
		*)
			json_error "invalid_freq" "schedule must be off, daily or weekly"
			return 1
			;;
	esac
	if ! valid_reset_time "$TIME"; then
		json_error "invalid_time" "reset time must be HH:MM between 00:00 and 23:59"
		return 1
	fi
	if [ "$FREQ" = "weekly" ] && ! valid_weekday "$WEEKDAY"; then
		json_error "invalid_weekday" "day of week must be 0 (Sunday) to 6 (Saturday)"
		return 1
	fi
	case "$API_URL" in
		http://*|https://*) ;;
		*)
			json_error "invalid_api_url" "API address must start with http:// or https://"
			return 1
			;;
	esac
	API_URL="${API_URL%/}"

	uci -q set "oxidns.main.learn_reset_freq=$FREQ"
	uci -q set "oxidns.main.learn_reset_time=$TIME"
	if [ "$FREQ" = "weekly" ]; then
		uci -q set "oxidns.main.learn_reset_weekday=$WEEKDAY"
	fi
	uci -q set "oxidns.main.learn_reset_cn=$RESET_CN"
	uci -q set "oxidns.main.learn_reset_proxy=$RESET_PROXY"
	uci -q set "oxidns.main.learn_reset_api_url=$API_URL"
	uci -q set "oxidns.main.learn_reset_api_user=$API_USER"
	# 空密码 = 保持已存密码不变，避免编辑计划时把密码误清掉
	if [ -n "$API_PASS" ]; then
		uci -q set "oxidns.main.learn_reset_api_pass=$API_PASS"
	fi
	if ! uci -q commit oxidns; then
		json_error "settings_save_failed" "unable to commit UCI changes"
		return 1
	fi

	load_settings
	CRON_LINE=""
	if [ "$LEARN_RESET_FREQ" != "off" ]; then
		CRON_LINE="$(learn_reset_cron_line "$LEARN_RESET_FREQ" "$LEARN_RESET_TIME" "$LEARN_RESET_WEEKDAY")"
	fi
	if ! update_learn_reset_cron "$CRON_LINE"; then
		json_error "cron_update_failed" "unable to update the crontab at $LEARN_CRON_FILE"
		return 1
	fi

	printf '{"ok":true,'
	printf '"freq":'
	json_string "$LEARN_RESET_FREQ"
	printf ',"time":'
	json_string "$LEARN_RESET_TIME"
	printf ',"weekday":'
	json_string "$LEARN_RESET_WEEKDAY"
	printf ',"reset_cn":'
	json_bool "$LEARN_RESET_CN"
	printf ',"reset_proxy":'
	json_bool "$LEARN_RESET_PROXY"
	printf ',"cron_line":'
	json_string "$CRON_LINE"
	printf ',"cron_installed":'
	if learn_reset_cron_installed; then json_bool 1; else json_bool 0; fi
	printf '}\n'
}

emit_learn_reset_run() {
	load_settings
	if [ ! -x "$LEARN_RESET_SCRIPT" ]; then
		json_error "script_missing" "reset script not found: $LEARN_RESET_SCRIPT"
		return 1
	fi
	OUT="$(mktemp "$TMP_ROOT/oxidns-learn-reset.XXXXXX" 2>/dev/null)" || OUT=""
	if [ -z "$OUT" ]; then
		json_error "reset_failed" "unable to create a temporary file"
		return 1
	fi
	if "$LEARN_RESET_SCRIPT" >"$OUT" 2>&1; then
		DETAIL="$(cat "$OUT")"
		rm -f "$OUT"
		printf '{"ok":true,"detail":'
		json_string "$DETAIL"
		printf '}\n'
	else
		DETAIL="$(cat "$OUT")"
		rm -f "$OUT"
		json_detailed_error "reset_failed" "one or more learned sets failed to clear" "" "$DETAIL"
		return 1
	fi
}

emit_log_lines_json() {
	SOURCE="$1"
	FILE="$2"
	printf '{"ok":true,"source":'
	json_string "$SOURCE"
	printf ',"lines":['
	SEP=""
	while IFS= read -r LINE; do
		printf '%s' "$SEP"
		json_string "$LINE"
		SEP=","
	done < "$FILE"
	printf ']}\n'
}

read_logread_logs() {
	LIMIT="$1"
	OUT_FILE="$2"
	SCAN_LIMIT="$((LIMIT * 4))"
	: > "$OUT_FILE"
	if ! command -v logread >/dev/null 2>&1; then
		return 1
	fi
	if [ "$SCAN_LIMIT" -lt 100 ]; then
		SCAN_LIMIT=100
	elif [ "$SCAN_LIMIT" -gt 2000 ]; then
		SCAN_LIMIT=2000
	fi

	logread -l "$SCAN_LIMIT" -e oxidns 2>/dev/null | awk '
		BEGIN {
			esc = sprintf("%c", 27);
			csi = esc "\\[[0-9;?]*[ -/]*[@-~]";
		}
		/oxidns\[[0-9]+\]:/ {
			gsub(csi, "");
			gsub(/\r/, "");
			sub(/^.* oxidns\[[0-9]+\]:[[:space:]]*/, "");
			print;
		}
	' | tail -n "$LIMIT" > "$OUT_FILE" || true
}

read_log_file_logs() {
	LOG_PATH="$1"
	LIMIT="$2"
	OUT_FILE="$3"
	: > "$OUT_FILE"
	[ -f "$LOG_PATH" ] || return 1
	tail -n "$LIMIT" "$LOG_PATH" > "$OUT_FILE" 2>/dev/null || return 1
	return 0
}

emit_logs_recent() {
	INPUT="$(cat)"
	LIMIT="$(input_value limit "$INPUT")"
	[ -n "$LIMIT" ] || LIMIT=200
	case "$LIMIT" in
		*[!0-9]*|'') LIMIT=200 ;;
	esac
	resolve_log_file
	TMP_FILE="$(mktemp "$TMP_ROOT/oxidns-logs.XXXXXX")"
	SOURCE="logread"
	if [ "$LOG_FILE_CONFIGURED" = "1" ]; then
		# config.yaml 配置了 log.file：日志以文件为准，读不到（尚未产生）就返回空
		read_log_file_logs "$LOG_FILE" "$LIMIT" "$TMP_FILE" || true
		SOURCE="file"
	else
		# 未配置 log.file：oxidns 走 syslog，退回 logread
		read_logread_logs "$LIMIT" "$TMP_FILE" || true
	fi
	emit_log_lines_json "$SOURCE" "$TMP_FILE"
	rm -f "$TMP_FILE"
}

# 清空日志文件内容：原地截断（oxidns 追加写，截断后从新 EOF 续写，无需重启）
emit_logs_clear() {
	resolve_log_file
	if path_has_parent_ref "$LOG_FILE"; then
		json_error "invalid_log_file" "log file path must not contain '..'"
		return 1
	fi
	case "$LOG_FILE" in
		/*) ;;
		*)
			json_error "invalid_log_file" "log file path must be absolute"
			return 1
			;;
	esac
	if [ "$LOG_FILE" != "/var/log/oxidns.log" ] && ! oxidns_named_path "$LOG_FILE"; then
		json_error "invalid_log_file" "refusing to clear a file that is not an oxidns log"
		return 1
	fi
	if [ -L "$LOG_FILE" ]; then
		json_error "invalid_log_file" "refusing to clear a symbolic link"
		return 1
	fi
	if [ ! -f "$LOG_FILE" ]; then
		printf '{"ok":true,'
		json_field_string path "$LOG_FILE"
		printf ',"existed":false'
		printf ',"cleared_bytes":"0"'
		printf '}\n'
		return 0
	fi
	CLEARED_SIZE="$(file_size_bytes "$LOG_FILE")"
	if ! : > "$LOG_FILE"; then
		json_error "log_clear_failed" "unable to truncate $LOG_FILE"
		return 1
	fi
	printf '{"ok":true,'
	json_field_string path "$LOG_FILE"
	printf ',"existed":true'
	printf ',"cleared_bytes":'
	json_string "$CLEARED_SIZE"
	printf '}\n'
}

read_error_detail_file() {
	DETAIL_FILE="$1"
	[ -r "$DETAIL_FILE" ] || return 0
	awk -v token="$GITHUB_TOKEN" -v proxy="$DOWNLOAD_PROXY" '
		function redact(value, secret,    out, pos) {
			if (secret == "")
				return value;
			out = "";
			while ((pos = index(value, secret)) > 0) {
				out = out substr(value, 1, pos - 1) "[redacted]";
				value = substr(value, pos + length(secret));
			}
			return out value;
		}
		{
			line = redact(redact($0, token), proxy);
			gsub(/[[:cntrl:]]/, " ", line);
			print line;
		}
	' "$DETAIL_FILE" | tail -c 1200
}

set_download_error_from_file() {
	ERROR_FILE="$1"
	ERROR_RC="$2"
	ERROR_TOOL="$3"
	ERROR_DETAIL="$(read_error_detail_file "$ERROR_FILE" 2>/dev/null || true)"
	ERROR_DETAIL="$(printf '%s' "$ERROR_DETAIL" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
	[ -n "$ERROR_DETAIL" ] || ERROR_DETAIL="$ERROR_TOOL exited with code $ERROR_RC"
	DOWNLOAD_RC="$ERROR_RC"
	DOWNLOAD_ERROR="$ERROR_TOOL exited with code $ERROR_RC: $ERROR_DETAIL"
	rm -f "$ERROR_FILE"
}

run_download_command() {
	DOWNLOAD_TOOL="$1"
	DOWNLOAD_DISPLAY="$2"
	DOWNLOAD_OUT="$3"
	shift 3
	DOWNLOAD_ERR_FILE="$(mktemp "$TMP_ROOT/oxidns-download.XXXXXX")"
	DOWNLOAD_DONE_FILE="$(mktemp "$TMP_ROOT/oxidns-download-done.XXXXXX")"
	rm -f "$DOWNLOAD_DONE_FILE"
	core_progress_command "$DOWNLOAD_DISPLAY"
	case "$-" in
		*e*) DOWNLOAD_RESTORE_ERREXIT=1 ;;
		*) DOWNLOAD_RESTORE_ERREXIT=0 ;;
	esac
	set +e
	DOWNLOAD_LAST_SIZE=""
	(
		while [ ! -f "$DOWNLOAD_DONE_FILE" ]; do
			if [ -f "$DOWNLOAD_OUT" ]; then
				DOWNLOAD_SIZE="$(file_size_bytes "$DOWNLOAD_OUT")"
				if [ "$DOWNLOAD_SIZE" != "$DOWNLOAD_LAST_SIZE" ]; then
					core_progress_log "progress" "$DOWNLOAD_TOOL downloaded $DOWNLOAD_SIZE bytes"
					DOWNLOAD_LAST_SIZE="$DOWNLOAD_SIZE"
				fi
			fi
			sleep 1
		done
	) &
	DOWNLOAD_MONITOR_PID="$!"
	"$@" >/dev/null 2>"$DOWNLOAD_ERR_FILE"
	DOWNLOAD_CMD_RC="$?"
	: > "$DOWNLOAD_DONE_FILE"
	wait "$DOWNLOAD_MONITOR_PID" 2>/dev/null || true
	rm -f "$DOWNLOAD_DONE_FILE"
	if [ "$DOWNLOAD_RESTORE_ERREXIT" = "1" ]; then
		set -e
	else
		set +e
	fi
	if [ "$DOWNLOAD_CMD_RC" -eq 0 ]; then
		rm -f "$DOWNLOAD_ERR_FILE"
		DOWNLOAD_ERROR=""
		DOWNLOAD_RC=0
		core_progress_log "success" "$DOWNLOAD_TOOL download complete: $(file_size_bytes "$DOWNLOAD_OUT") bytes"
		return 0
	fi
	set_download_error_from_file "$DOWNLOAD_ERR_FILE" "$DOWNLOAD_CMD_RC" "$DOWNLOAD_TOOL"
	core_progress_log "error" "$DOWNLOAD_ERROR"
	return "$DOWNLOAD_CMD_RC"
}

download_file() {
	URL="$1"
	OUT="$2"
	DOWNLOAD_ERROR=""
	DOWNLOAD_RC=""
	if command -v curl >/dev/null 2>&1; then
		if [ -n "$DOWNLOAD_PROXY" ]; then
			if [ -n "$GITHUB_TOKEN" ]; then
				run_download_command curl "curl -fsSL --proxy [configured] -H 'User-Agent: luci-app-oxidns' -H 'Authorization: Bearer [redacted]' -o $OUT $URL" "$OUT" curl -fsSL --proxy "$DOWNLOAD_PROXY" -H "User-Agent: luci-app-oxidns" -H "Authorization: Bearer $GITHUB_TOKEN" -o "$OUT" "$URL"
			else
				run_download_command curl "curl -fsSL --proxy [configured] -H 'User-Agent: luci-app-oxidns' -o $OUT $URL" "$OUT" curl -fsSL --proxy "$DOWNLOAD_PROXY" -H "User-Agent: luci-app-oxidns" -o "$OUT" "$URL"
			fi
		elif [ -n "$GITHUB_TOKEN" ]; then
			run_download_command curl "curl -fsSL -H 'User-Agent: luci-app-oxidns' -H 'Authorization: Bearer [redacted]' -o $OUT $URL" "$OUT" curl -fsSL -H "User-Agent: luci-app-oxidns" -H "Authorization: Bearer $GITHUB_TOKEN" -o "$OUT" "$URL"
		else
			run_download_command curl "curl -fsSL -H 'User-Agent: luci-app-oxidns' -o $OUT $URL" "$OUT" curl -fsSL -H "User-Agent: luci-app-oxidns" -o "$OUT" "$URL"
		fi
	elif command -v uclient-fetch >/dev/null 2>&1; then
		if [ -n "$GITHUB_TOKEN" ]; then
			run_download_command uclient-fetch "uclient-fetch -O $OUT --header='User-Agent: luci-app-oxidns' --header='Authorization: Bearer [redacted]' $URL" "$OUT" uclient-fetch -O "$OUT" --header="User-Agent: luci-app-oxidns" --header="Authorization: Bearer $GITHUB_TOKEN" "$URL"
		else
			run_download_command uclient-fetch "uclient-fetch -O $OUT --header='User-Agent: luci-app-oxidns' $URL" "$OUT" uclient-fetch -O "$OUT" --header="User-Agent: luci-app-oxidns" "$URL"
		fi
	elif command -v wget >/dev/null 2>&1; then
		if [ -n "$GITHUB_TOKEN" ]; then
			run_download_command wget "wget --header='User-Agent: luci-app-oxidns' --header='Authorization: Bearer [redacted]' -O $OUT $URL" "$OUT" wget --header="User-Agent: luci-app-oxidns" --header="Authorization: Bearer $GITHUB_TOKEN" -O "$OUT" "$URL"
		else
			run_download_command wget "wget --header='User-Agent: luci-app-oxidns' -O $OUT $URL" "$OUT" wget --header="User-Agent: luci-app-oxidns" -O "$OUT" "$URL"
		fi
	else
		DOWNLOAD_RC=127
		DOWNLOAD_ERROR="none of curl, uclient-fetch, or wget is installed"
		core_progress_log "error" "$DOWNLOAD_ERROR"
		return 1
	fi
}

require_download_transport() {
	if [ -n "$DOWNLOAD_PROXY" ] && ! command -v curl >/dev/null 2>&1; then
		core_progress_log "error" "download_proxy requires curl, but curl is not installed"
		json_detailed_error "download_proxy_requires_curl" "download_proxy is configured, but curl is not installed; install curl or clear download_proxy" "prepare_download" "download_proxy only works with curl on OpenWrt"
		return 1
	fi
	return 0
}

sha256_file() {
	sha256sum "$1" 2>/dev/null | awk '{ print $1 }'
}

asset_name_for_bundle() {
	BUNDLE="$1"
	RUST_TARGET="$2"
	case "$BUNDLE" in
		full)
			printf 'oxidns-%s.tar.gz' "$RUST_TARGET"
			;;
		standard|minimal)
			printf 'oxidns-%s-%s.tar.gz' "$BUNDLE" "$RUST_TARGET"
			;;
		*)
			return 1
			;;
	esac
}

release_api_url() {
	REPOSITORY="$1"
	TARGET="$2"
	if [ "$TARGET" = "latest" ]; then
		printf '%s/repos/%s/releases/latest' "$GITHUB_API_BASE" "$REPOSITORY"
	else
		printf '%s/repos/%s/releases/tags/%s' "$GITHUB_API_BASE" "$REPOSITORY" "$TARGET"
	fi
}

version_tag() {
	VERSION="$1"
	case "$VERSION" in
		v*) printf '%s' "$VERSION" ;;
		*) printf 'v%s' "$VERSION" ;;
	esac
}

select_release_asset() {
	RELEASE_FILE="$1"
	WANT_ASSET="$2"

	SELECT_TAG=""
	SELECT_ASSET_NAME=""
	SELECT_URL=""
	SELECT_SHA256=""
	SELECT_SIZE=""

	if ! command -v jsonfilter >/dev/null 2>&1; then
		return 2
	fi

	SELECT_TAG="$(jsonfilter -i "$RELEASE_FILE" -e '@.tag_name' 2>/dev/null || true)"
	[ -n "$SELECT_TAG" ] || return 1

	NAME_FILE="$(mktemp "$TMP_ROOT/oxidns-asset-name.XXXXXX")"
	URL_FILE="$(mktemp "$TMP_ROOT/oxidns-asset-url.XXXXXX")"
	DIGEST_FILE="$(mktemp "$TMP_ROOT/oxidns-asset-digest.XXXXXX")"
	SIZE_FILE="$(mktemp "$TMP_ROOT/oxidns-asset-size.XXXXXX")"
	SELECT_FILE="$(mktemp "$TMP_ROOT/oxidns-asset-selected.XXXXXX")"

	if ! jsonfilter -i "$RELEASE_FILE" -e '@.assets[*].name' > "$NAME_FILE" 2>/dev/null ||
		! jsonfilter -i "$RELEASE_FILE" -e '@.assets[*].browser_download_url' > "$URL_FILE" 2>/dev/null ||
		! jsonfilter -i "$RELEASE_FILE" -e '@.assets[*].digest' > "$DIGEST_FILE" 2>/dev/null ||
		! jsonfilter -i "$RELEASE_FILE" -e '@.assets[*].size' > "$SIZE_FILE" 2>/dev/null; then
		rm -f "$NAME_FILE" "$URL_FILE" "$DIGEST_FILE" "$SIZE_FILE" "$SELECT_FILE"
		return 1
	fi

	if ! awk -v want="$WANT_ASSET" -v url_file="$URL_FILE" -v digest_file="$DIGEST_FILE" -v size_file="$SIZE_FILE" '
		BEGIN {
			while ((getline url < url_file) > 0)
				urls[++url_count] = url;
			while ((getline digest < digest_file) > 0)
				digests[++digest_count] = digest;
			while ((getline size < size_file) > 0)
				sizes[++size_count] = size;
		}
		{
			idx++;
			if ($0 == want) {
				print $0;
				print urls[idx];
				print digests[idx];
				print sizes[idx];
				found = 1;
				exit;
			}
		}
		END {
			exit found ? 0 : 1;
		}
	' "$NAME_FILE" > "$SELECT_FILE"; then
		rm -f "$NAME_FILE" "$URL_FILE" "$DIGEST_FILE" "$SIZE_FILE" "$SELECT_FILE"
		return 1
	fi

	SELECT_ASSET_NAME="$(sed -n '1p' "$SELECT_FILE")"
	SELECT_URL="$(sed -n '2p' "$SELECT_FILE")"
	SELECT_SHA256="$(sed -n '3p' "$SELECT_FILE" | sed 's/^sha256://')"
	SELECT_SIZE="$(sed -n '4p' "$SELECT_FILE")"
	rm -f "$NAME_FILE" "$URL_FILE" "$DIGEST_FILE" "$SIZE_FILE" "$SELECT_FILE"
	[ -n "$SELECT_ASSET_NAME" ] && [ -n "$SELECT_URL" ]
}

valid_sha256() {
	printf '%s' "$1" | grep -Eq '^[0-9a-fA-F]{64}$'
}

validate_safe_archive() {
	ARCHIVE="$1"
	if ! tar -tzf "$ARCHIVE" | awk '
		{
			path = $0;
			while (path ~ /^\.\//)
				sub(/^\.\//, "", path);
			while (path ~ /\/$/)
				sub(/\/$/, "", path);
			if (path == "" || path ~ /^\//)
				bad = 1;
			n = split(path, parts, "/");
			for (i = 1; i <= n; i++) {
				if (parts[i] == "" || parts[i] == "..")
					bad = 1;
			}
		}
		END { exit bad ? 1 : 0 }
	'; then
		return 1
	fi

	if ! tar -tvzf "$ARCHIVE" | awk '
		{
			type = substr($0, 1, 1);
			if (type != "-" && type != "d")
				bad = 1;
		}
		END { exit bad ? 1 : 0 }
	'; then
		return 1
	fi

	return 0
}

valid_ipv4() {
	printf '%s' "$1" | awk -F. '
		NF != 4 { exit 1 }
		{
			for (i = 1; i <= 4; i++) {
				if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255)
					exit 1;
			}
		}
	'
}

lan_ipv4_from_uci() {
	command -v uci >/dev/null 2>&1 || return 1
	LAN_IP="$(uci -q get network.lan.ipaddr 2>/dev/null || true)"
	if valid_ipv4 "$LAN_IP"; then
		printf '%s' "$LAN_IP"
		return 0
	fi
	return 1
}

lan_ipv4_from_interface() {
	IFACE="${1:-br-lan}"
	command -v ip >/dev/null 2>&1 || return 1
	ip -4 addr show dev "$IFACE" 2>/dev/null | awk '
		/ inet / {
			addr = $2;
			sub(/\/.*/, "", addr);
			print addr;
			exit;
		}
	'
}

default_api_listen() {
	LAN_IP="$(lan_ipv4_from_uci 2>/dev/null || true)"
	if [ -z "$LAN_IP" ]; then
		LAN_IP="$(lan_ipv4_from_interface br-lan 2>/dev/null || true)"
	fi
	if ! valid_ipv4 "$LAN_IP"; then
		LAN_IP="0.0.0.0"
	fi
	printf '%s:9199' "$LAN_IP"
}

write_openwrt_default_config() {
	SOURCE_FILE="$1"
	OUT_FILE="$2"
	DEFAULT_LISTEN="$(default_api_listen)"
	awk -v default_listen="$DEFAULT_LISTEN" '
		BEGIN {
			top = "";
			second = "";
			third = "";
			listen_done = 0;
			root_done = 0;
		}
		/^[^[:space:]#][^:]*:/ {
			top = $0;
			sub(/:.*/, "", top);
			second = "";
			third = "";
		}
		top == "api" && /^[[:space:]][[:space:]]http:[[:space:]]*$/ {
			second = "http";
			third = "";
			print;
			next;
		}
		top == "api" && second == "http" && /^[[:space:]][[:space:]][[:space:]][[:space:]]webui:[[:space:]]*$/ {
			third = "webui";
			print;
			next;
		}
		top == "api" && second == "http" && /^[[:space:]][[:space:]][[:space:]][[:space:]]listen:[[:space:]]*/ {
			print "    listen: \"" default_listen "\"";
			listen_done = 1;
			next;
		}
		top == "api" && second == "http" && third == "webui" && /^[[:space:]][[:space:]][[:space:]][[:space:]][[:space:]][[:space:]]root:[[:space:]]*/ {
			print "      root: \"/usr/share/oxidns/webui\"";
			root_done = 1;
			next;
		}
		{ print }
		END {
			if (!listen_done || !root_done)
				exit 42;
		}
	' "$SOURCE_FILE" > "$OUT_FILE"
}

core_install_error() {
	ERROR_CODE="$1"
	ERROR_MESSAGE="$2"
	ERROR_STAGE="${3:-}"
	ERROR_DETAIL="${4:-}"
	rm -rf "${CORE_TMP_DIR:-}" 2>/dev/null || true
	core_progress_log "error" "$ERROR_CODE: $ERROR_MESSAGE"
	[ -n "$ERROR_STAGE" ] && core_progress_log "error" "stage=$ERROR_STAGE"
	[ -n "$ERROR_DETAIL" ] && core_progress_log "error" "$ERROR_DETAIL"
	json_detailed_error "$ERROR_CODE" "$ERROR_MESSAGE" "$ERROR_STAGE" "$ERROR_DETAIL"
	return 1
}

install_core_from_release() {
	ACTION="$1"
	RELEASE_TARGET="$2"
	REQUEST_BUNDLE="$3"
	load_settings
	require_download_transport || return 1

	case "$CORE_REPOSITORY" in
		*/*) ;;
		*)
			core_progress_log "error" "invalid core_repository: $CORE_REPOSITORY"
			json_error "invalid_core_repository" "core_repository must use owner/repo format"
			return 1
			;;
	esac

	core_progress_command "uname -m"
	if ! RUST_TARGET="$(detect_rust_target 2>/dev/null)"; then
		core_progress_log "error" "unsupported CPU architecture"
		json_error "unsupported_target" "current CPU architecture does not match a published OxiDNS Linux musl release"
		return 1
	fi
	core_progress_log "info" "target=$RUST_TARGET"
	if ! ASSET_NAME="$(asset_name_for_bundle "$REQUEST_BUNDLE" "$RUST_TARGET")"; then
		core_progress_log "error" "unsupported bundle: $REQUEST_BUNDLE"
		json_error "unsupported_core_bundle" "core bundle must be one of full, standard, minimal"
		return 1
	fi
	core_progress_log "info" "repository=$CORE_REPOSITORY bundle=$REQUEST_BUNDLE asset=$ASSET_NAME"

	CORE_TMP_DIR="$(mktemp -d "$TMP_ROOT/oxidns-core.XXXXXX")"
	RELEASE_FILE="$CORE_TMP_DIR/release.json"
	ARCHIVE_FILE="$CORE_TMP_DIR/$ASSET_NAME"
	UNPACK_DIR="$CORE_TMP_DIR/unpack"
	RELEASE_URL="$(release_api_url "$CORE_REPOSITORY" "$RELEASE_TARGET")"

	core_progress_log "info" "fetch release metadata: $RELEASE_URL"
	if ! download_file "$RELEASE_URL" "$RELEASE_FILE"; then
		core_install_error "release_fetch_failed" "failed to fetch OxiDNS release metadata" "download_metadata" "repository=$CORE_REPOSITORY release=$RELEASE_TARGET url=$RELEASE_URL; ${DOWNLOAD_ERROR:-unknown download error}"
		return 1
	fi
	core_progress_command "jsonfilter release metadata for $ASSET_NAME"
	set +e
	select_release_asset "$RELEASE_FILE" "$ASSET_NAME"
	SELECT_RELEASE_RC="$?"
	set -e
	if [ "$SELECT_RELEASE_RC" -ne 0 ]; then
		if [ "$SELECT_RELEASE_RC" -eq 2 ]; then
			SELECT_RELEASE_DETAIL="jsonfilter is not installed or unavailable; wanted asset=$ASSET_NAME repository=$CORE_REPOSITORY release=$RELEASE_TARGET"
		else
			SELECT_RELEASE_DETAIL="wanted asset=$ASSET_NAME repository=$CORE_REPOSITORY release=$RELEASE_TARGET"
		fi
		core_install_error "release_asset_not_found" "selected OxiDNS release does not contain the required archive" "select_release_asset" "$SELECT_RELEASE_DETAIL"
		return 1
	fi
	core_progress_log "success" "selected release=$SELECT_TAG asset=$SELECT_ASSET_NAME size=${SELECT_SIZE:-unknown}"
	if ! valid_sha256 "$SELECT_SHA256"; then
		core_install_error "release_digest_missing" "selected OxiDNS release asset does not include a valid SHA256 digest" "verify_release_digest" "asset=$SELECT_ASSET_NAME digest=${SELECT_SHA256:-missing}"
		return 1
	fi
	core_progress_log "info" "download archive: $SELECT_URL"
	if ! download_file "$SELECT_URL" "$ARCHIVE_FILE"; then
		core_install_error "core_download_failed" "failed to download OxiDNS core archive" "download_archive" "asset=$SELECT_ASSET_NAME url=$SELECT_URL; ${DOWNLOAD_ERROR:-unknown download error}"
		return 1
	fi

	core_progress_command "sha256sum $ARCHIVE_FILE"
	ACTUAL_SHA256="$(sha256_file "$ARCHIVE_FILE" || true)"
	if [ -z "$ACTUAL_SHA256" ] || [ "$ACTUAL_SHA256" != "$SELECT_SHA256" ]; then
		core_install_error "core_checksum_failed" "OxiDNS core archive SHA256 does not match the release digest" "verify_checksum" "asset=$SELECT_ASSET_NAME expected=$SELECT_SHA256 actual=${ACTUAL_SHA256:-missing}"
		return 1
	fi
	core_progress_log "success" "checksum verified: $ACTUAL_SHA256"
	core_progress_command "tar -tzf $ARCHIVE_FILE"
	if ! validate_safe_archive "$ARCHIVE_FILE"; then
		core_install_error "core_archive_unsafe" "OxiDNS core archive contains unsafe paths or links" "validate_archive" "asset=$SELECT_ASSET_NAME"
		return 1
	fi

	mkdir -p "$UNPACK_DIR"
	TAR_OUT="$(mktemp "$TMP_ROOT/oxidns-tar.XXXXXX")"
	core_progress_command "tar -xzf $ARCHIVE_FILE -C $UNPACK_DIR"
	if ! tar -xzf "$ARCHIVE_FILE" -C "$UNPACK_DIR" >"$TAR_OUT" 2>&1; then
		TAR_DETAIL="$(read_error_detail_file "$TAR_OUT" 2>/dev/null || true)"
		rm -f "$TAR_OUT"
		core_install_error "core_unpack_failed" "failed to unpack OxiDNS core archive" "unpack_archive" "${TAR_DETAIL:-tar extraction failed}"
		return 1
	fi
	rm -f "$TAR_OUT"
	if [ ! -f "$UNPACK_DIR/oxidns" ]; then
		core_install_error "core_archive_invalid" "OxiDNS core archive does not contain an oxidns binary" "install_files" "asset=$SELECT_ASSET_NAME"
		return 1
	fi
	core_progress_log "success" "archive unpacked"

	CONFIG_TMP=""
	if [ ! -e "$CONFIG_PATH" ]; then
		if [ ! -f "$UNPACK_DIR/config.yaml" ]; then
			core_install_error "core_archive_invalid" "OxiDNS core archive does not contain config.yaml" "install_files" "asset=$SELECT_ASSET_NAME"
			return 1
		fi
		CONFIG_TMP="$CORE_TMP_DIR/config.yaml.openwrt"
		core_progress_command "adapt config.yaml for OpenWrt defaults"
		if ! write_openwrt_default_config "$UNPACK_DIR/config.yaml" "$CONFIG_TMP"; then
			core_install_error "default_config_unsupported" "release config.yaml cannot be adapted for OpenWrt defaults" "install_files" "config=$UNPACK_DIR/config.yaml"
			return 1
		fi
	fi

	SERVICE_RESTART="not_requested"
	SERVICE_WAS_RUNNING=0
	if service_running; then SERVICE_WAS_RUNNING=1; fi
	INIT="$(init_script)"
	if [ "$SERVICE_WAS_RUNNING" = "1" ] && [ -x "$INIT" ]; then
		core_progress_command "$INIT stop"
		"$INIT" stop >/dev/null 2>&1 || true
	fi

	core_progress_command "install -m 755 $UNPACK_DIR/oxidns $OXIDNS_BIN"
	mkdir -p "$(dirname "$OXIDNS_BIN")" "$WORKING_DIR"
	cp "$UNPACK_DIR/oxidns" "$CORE_TMP_DIR/oxidns.new"
	chmod 755 "$CORE_TMP_DIR/oxidns.new"
	mv "$CORE_TMP_DIR/oxidns.new" "$OXIDNS_BIN"

	if [ -d "$UNPACK_DIR/webui" ]; then
		core_progress_command "copy webui files to $WEBUI_DIR"
		WEBUI_TMP="$CORE_TMP_DIR/webui.new"
		rm -rf "$WEBUI_TMP"
		mkdir -p "$(dirname "$WEBUI_DIR")" "$WEBUI_TMP"
		cp -R "$UNPACK_DIR/webui/." "$WEBUI_TMP/"
		rm -rf "$WEBUI_DIR"
		mv "$WEBUI_TMP" "$WEBUI_DIR"
	fi

	if [ -n "$CONFIG_TMP" ]; then
		core_progress_command "install default config to $CONFIG_PATH"
		mkdir -p "$(dirname "$CONFIG_PATH")"
		mv "$CONFIG_TMP" "$CONFIG_PATH"
	elif [ -f "$UNPACK_DIR/config.yaml" ]; then
		core_progress_command "copy config example to $WORKING_DIR/config.yaml.example"
		cp "$UNPACK_DIR/config.yaml" "$WORKING_DIR/config.yaml.example" 2>/dev/null || true
	fi

	CONFIG_CHECK_OK=0
	core_progress_command "$OXIDNS_BIN check -c $CONFIG_PATH -d $WORKING_DIR"
	if CONFIG_CHECK_OUTPUT="$(validate_config_file "$CONFIG_PATH" 2>&1)"; then
		CONFIG_CHECK_OK=1
		core_progress_log "success" "$CONFIG_CHECK_OUTPUT"
	else
		CONFIG_CHECK_OUTPUT="${CONFIG_CHECK_OUTPUT:-configuration check failed}"
		core_progress_log "error" "$CONFIG_CHECK_OUTPUT"
	fi
	if [ "$SERVICE_WAS_RUNNING" = "1" ] && [ -x "$INIT" ]; then
		SERVICE_OUT="$(mktemp "$TMP_ROOT/oxidns-service.XXXXXX")"
		core_progress_command "$INIT start"
		if "$INIT" start >"$SERVICE_OUT" 2>&1; then
			SERVICE_RESTART="requested"
			core_progress_log "success" "service restarted"
		else
			MSG="$(read_error_detail_file "$SERVICE_OUT" 2>/dev/null || true)"
			rm -f "$SERVICE_OUT"
			core_install_error "service_restart_failed" "core installed, but service restart failed" "restart_service" "${MSG:-service restart failed}"
			return 1
		fi
		rm -f "$SERVICE_OUT"
	fi

	rm -rf "$CORE_TMP_DIR"
	core_progress_log "success" "core $ACTION completed: version=$SELECT_TAG bundle=$REQUEST_BUNDLE target=$RUST_TARGET"
	printf '{"ok":true,"action":'
	json_string "$ACTION"
	printf ',"version":'
	json_string "$SELECT_TAG"
	printf ',"bundle":'
	json_string "$REQUEST_BUNDLE"
	printf ',"target":'
	json_string "$RUST_TARGET"
	printf ',"asset":'
	json_string "$SELECT_ASSET_NAME"
	printf ',"binary_path":'
	json_string "$OXIDNS_BIN"
	printf ',"webui_path":'
	json_string "$WEBUI_DIR"
	printf ',"service_restart":'
	json_string "$SERVICE_RESTART"
	printf ',"config_check":{"ok":'
	json_bool "$CONFIG_CHECK_OK"
	printf ',"message":'
	json_string "$CONFIG_CHECK_OUTPUT"
	printf '}}\n'
}

emit_core_install_locked() {
	load_settings
	core_progress_reset "install OxiDNS core"
	if [ -x "$OXIDNS_BIN" ]; then
		core_progress_log "error" "core already installed"
		json_error "core_already_installed" "OxiDNS core is already installed; use repair reinstall instead"
		return 1
	fi
	install_core_from_release install latest "$CORE_BUNDLE"
}

emit_core_install() {
	run_with_core_lock emit_core_install_locked
}

emit_core_reinstall_locked() {
	load_settings
	core_progress_reset "repair reinstall OxiDNS core"
	BUILD_JSON="$(build_info_json)"
	CURRENT_VERSION="$(json_value_from_string version "$BUILD_JSON")"
	CURRENT_BUNDLE="$(json_value_from_string bundle "$BUILD_JSON")"
	if [ ! -x "$OXIDNS_BIN" ] || [ -z "$CURRENT_VERSION" ]; then
		core_progress_log "error" "core is not installed or cannot report its version"
		json_error "core_not_installed" "OxiDNS core is not installed or cannot report its version"
		return 1
	fi
	core_progress_log "info" "current_version=$CURRENT_VERSION current_bundle=${CURRENT_BUNDLE:-$CORE_BUNDLE}"
	[ -n "$CURRENT_BUNDLE" ] || CURRENT_BUNDLE="$CORE_BUNDLE"
	install_core_from_release reinstall "$(version_tag "$CURRENT_VERSION")" "$CURRENT_BUNDLE"
}

emit_core_reinstall() {
	run_with_core_lock emit_core_reinstall_locked
}

upload_core_error() {
	ERROR_CODE="$1"
	ERROR_MESSAGE="$2"
	ERROR_STAGE="${3:-}"
	ERROR_DETAIL="${4:-}"
	rm -rf "${CORE_TMP_DIR:-}" 2>/dev/null || true
	[ -n "${UPLOAD_PATH:-}" ] && rm -f "$UPLOAD_PATH" 2>/dev/null || true
	core_progress_log "error" "$ERROR_CODE: $ERROR_MESSAGE"
	[ -n "$ERROR_STAGE" ] && core_progress_log "error" "stage=$ERROR_STAGE"
	[ -n "$ERROR_DETAIL" ] && core_progress_log "error" "$ERROR_DETAIL"
	json_detailed_error "$ERROR_CODE" "$ERROR_MESSAGE" "$ERROR_STAGE" "$ERROR_DETAIL"
	return 1
}

valid_upload_path() {
	case "$1" in
		/tmp/oxidns-core-upload-*) return 0 ;;
	esac
	return 1
}

validate_uploaded_binary() {
	BIN="$1"
	chmod 755 "$BIN"
	if command -v hexdump >/dev/null 2>&1; then
		MAGIC="$(dd if="$BIN" bs=4 count=1 2>/dev/null | hexdump -v -e '1/1 "%02x"')"
		[ "$MAGIC" = "7f454c46" ] || return 1
	elif command -v od >/dev/null 2>&1; then
		MAGIC="$(dd if="$BIN" bs=4 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')"
		[ "$MAGIC" = "7f454c46" ] || return 1
	fi
	CHECK_BIN="$(dirname "$OXIDNS_BIN")/.oxidns-upload-check.$$"
	mkdir -p "$(dirname "$OXIDNS_BIN")"
	cp "$BIN" "$CHECK_BIN" || return 1
	chmod 755 "$CHECK_BIN"
	set +e
	"$CHECK_BIN" build-info >/dev/null 2>&1
	VALIDATE_RC="$?"
	set -e
	rm -f "$CHECK_BIN"
	[ "$VALIDATE_RC" -eq 0 ]
}

install_uploaded_core_from_unpack() {
	UPLOAD_KIND="$1"
	UNPACK_DIR="$2"
	HAS_WEBUI=0
	CONFIG_CHECK_OK=0
	CONFIG_CHECK_OUTPUT=""
	SERVICE_RESTART="not_requested"

	if [ ! -f "$UNPACK_DIR/oxidns" ]; then
		upload_core_error "uploaded_core_invalid" "uploaded archive does not contain an oxidns binary" "validate_uploaded_core" "expected file: oxidns"
		return 1
	fi
	core_progress_command "validate uploaded oxidns binary"
	if ! validate_uploaded_binary "$UNPACK_DIR/oxidns"; then
		upload_core_error "uploaded_core_invalid" "uploaded oxidns binary cannot report build-info" "validate_uploaded_core" "the uploaded binary either is not executable for this target or build-info failed"
		return 1
	fi
	core_progress_log "success" "uploaded binary passed validation"

	CONFIG_TMP=""
	if [ ! -e "$CONFIG_PATH" ] && [ -f "$UNPACK_DIR/config.yaml" ]; then
		CONFIG_TMP="$CORE_TMP_DIR/config.yaml.openwrt"
		core_progress_command "adapt uploaded config.yaml for OpenWrt defaults"
		if ! write_openwrt_default_config "$UNPACK_DIR/config.yaml" "$CONFIG_TMP"; then
			upload_core_error "default_config_unsupported" "uploaded config.yaml cannot be adapted for OpenWrt defaults" "install_files" "config=$UNPACK_DIR/config.yaml"
			return 1
		fi
	fi

	SERVICE_WAS_RUNNING=0
	if service_running; then SERVICE_WAS_RUNNING=1; fi
	INIT="$(init_script)"
	if [ "$SERVICE_WAS_RUNNING" = "1" ] && [ -x "$INIT" ]; then
		core_progress_command "$INIT stop"
		"$INIT" stop >/dev/null 2>&1 || true
	fi

	core_progress_command "install -m 755 $UNPACK_DIR/oxidns $OXIDNS_BIN"
	mkdir -p "$(dirname "$OXIDNS_BIN")" "$WORKING_DIR"
	cp "$UNPACK_DIR/oxidns" "$CORE_TMP_DIR/oxidns.new"
	chmod 755 "$CORE_TMP_DIR/oxidns.new"
	mv "$CORE_TMP_DIR/oxidns.new" "$OXIDNS_BIN"

	if [ -d "$UNPACK_DIR/webui" ]; then
		core_progress_command "copy webui files to $WEBUI_DIR"
		WEBUI_TMP="$CORE_TMP_DIR/webui.new"
		rm -rf "$WEBUI_TMP"
		mkdir -p "$(dirname "$WEBUI_DIR")" "$WEBUI_TMP"
		cp -R "$UNPACK_DIR/webui/." "$WEBUI_TMP/"
		rm -rf "$WEBUI_DIR"
		mv "$WEBUI_TMP" "$WEBUI_DIR"
		HAS_WEBUI=1
	fi

	if [ -n "$CONFIG_TMP" ]; then
		core_progress_command "install default config to $CONFIG_PATH"
		mkdir -p "$(dirname "$CONFIG_PATH")"
		mv "$CONFIG_TMP" "$CONFIG_PATH"
	elif [ -f "$UNPACK_DIR/config.yaml" ]; then
		core_progress_command "copy config example to $WORKING_DIR/config.yaml.example"
		cp "$UNPACK_DIR/config.yaml" "$WORKING_DIR/config.yaml.example" 2>/dev/null || true
	fi

	if [ -e "$CONFIG_PATH" ]; then
		core_progress_command "$OXIDNS_BIN check -c $CONFIG_PATH -d $WORKING_DIR"
		if CONFIG_CHECK_OUTPUT="$(validate_config_file "$CONFIG_PATH" 2>&1)"; then
			CONFIG_CHECK_OK=1
			core_progress_log "success" "$CONFIG_CHECK_OUTPUT"
		else
			CONFIG_CHECK_OUTPUT="${CONFIG_CHECK_OUTPUT:-configuration check failed}"
			core_progress_log "error" "$CONFIG_CHECK_OUTPUT"
		fi
	else
		CONFIG_CHECK_OUTPUT="configuration file is not installed"
		core_progress_log "error" "$CONFIG_CHECK_OUTPUT"
	fi

	if [ "$SERVICE_WAS_RUNNING" = "1" ] && [ -x "$INIT" ]; then
		SERVICE_OUT="$(mktemp "$TMP_ROOT/oxidns-service.XXXXXX")"
		core_progress_command "$INIT start"
		if "$INIT" start >"$SERVICE_OUT" 2>&1; then
			SERVICE_RESTART="requested"
			core_progress_log "success" "service restarted"
		else
			MSG="$(read_error_detail_file "$SERVICE_OUT" 2>/dev/null || true)"
			rm -f "$SERVICE_OUT"
			upload_core_error "service_restart_failed" "core installed, but service restart failed" "restart_service" "${MSG:-service restart failed}"
			return 1
		fi
		rm -f "$SERVICE_OUT"
	fi

	BUILD_JSON="$(build_info_json)"
	VERSION="$(json_value_from_string version "$BUILD_JSON")"
	BUNDLE="$(json_value_from_string bundle "$BUILD_JSON")"
	rm -f "$UPLOAD_PATH"
	rm -rf "$CORE_TMP_DIR"
	core_progress_log "success" "uploaded core installed: version=${VERSION:-unknown} bundle=${BUNDLE:-unknown}"
	printf '{"ok":true,"action":"upload_install","kind":'
	json_string "$UPLOAD_KIND"
	printf ',"version":'
	json_string "$VERSION"
	printf ',"bundle":'
	json_string "$BUNDLE"
	printf ',"binary_path":'
	json_string "$OXIDNS_BIN"
	printf ',"webui_installed":'
	json_bool "$HAS_WEBUI"
	printf ',"webui_path":'
	json_string "$WEBUI_DIR"
	printf ',"service_restart":'
	json_string "$SERVICE_RESTART"
	printf ',"config_check":{"ok":'
	json_bool "$CONFIG_CHECK_OK"
	printf ',"message":'
	json_string "$CONFIG_CHECK_OUTPUT"
	printf '}}\n'
}

emit_core_upload_install_locked() {
	load_settings
	core_progress_reset "install uploaded OxiDNS core"
	INPUT="$(cat)"
	UPLOAD_PATH="$(input_value path "$INPUT")"
	core_progress_log "info" "uploaded_path=${UPLOAD_PATH:-missing}"

	if ! valid_upload_path "$UPLOAD_PATH" || [ ! -f "$UPLOAD_PATH" ]; then
		core_progress_log "error" "invalid upload path"
		json_detailed_error "invalid_upload_path" "uploaded file must be a readable /tmp/oxidns-core-upload-* file" "validate_uploaded_core" "path=${UPLOAD_PATH:-missing}"
		return 1
	fi

	CORE_TMP_DIR="$(mktemp -d "$TMP_ROOT/oxidns-core-upload.XXXXXX")"
	UNPACK_DIR="$CORE_TMP_DIR/unpack"
	mkdir -p "$UNPACK_DIR"

	core_progress_command "tar -tzf $UPLOAD_PATH"
	if tar -tzf "$UPLOAD_PATH" >/dev/null 2>&1; then
		if ! validate_safe_archive "$UPLOAD_PATH"; then
			upload_core_error "uploaded_archive_unsafe" "uploaded archive contains unsafe paths or links" "validate_archive" "archive=$UPLOAD_PATH"
			return 1
		fi
		TAR_OUT="$(mktemp "$TMP_ROOT/oxidns-upload-tar.XXXXXX")"
		core_progress_command "tar -xzf $UPLOAD_PATH -C $UNPACK_DIR"
		if ! tar -xzf "$UPLOAD_PATH" -C "$UNPACK_DIR" >"$TAR_OUT" 2>&1; then
			TAR_DETAIL="$(read_error_detail_file "$TAR_OUT" 2>/dev/null || true)"
			rm -f "$TAR_OUT"
			upload_core_error "uploaded_archive_unpack_failed" "failed to unpack uploaded OxiDNS archive" "unpack_archive" "${TAR_DETAIL:-tar extraction failed}"
			return 1
		fi
		rm -f "$TAR_OUT"
		install_uploaded_core_from_unpack "archive" "$UNPACK_DIR"
		return $?
	fi

	core_progress_command "cp $UPLOAD_PATH $UNPACK_DIR/oxidns"
	cp "$UPLOAD_PATH" "$UNPACK_DIR/oxidns"
	install_uploaded_core_from_unpack "binary" "$UNPACK_DIR"
}

emit_core_upload_install() {
	run_with_core_lock emit_core_upload_install_locked
}

emit_core_remove_locked() {
	INPUT="$(cat)"
	load_settings
	core_progress_reset "remove OxiDNS core"
	REMOVE_CONFIG="$(input_bool remove_config "$INPUT")"
	REMOVE_WORKDIR="$(input_bool remove_workdir "$INPUT")"
	CONFIG_REMOVED=0
	WORKDIR_REMOVED=0
	CONFIG_BACKUP=""

	if [ "$REMOVE_CONFIG" = "1" ] && ! safe_remove_config_path "$CONFIG_PATH"; then
		core_progress_log "error" "refusing unsafe config path: $CONFIG_PATH"
		json_detailed_error "unsafe_config_path" "refusing to delete unsafe configuration path" "remove_config" "config=$CONFIG_PATH"
		return 1
	fi
	if [ "$REMOVE_WORKDIR" = "1" ] && ! safe_remove_working_dir "$WORKING_DIR"; then
		core_progress_log "error" "refusing unsafe working directory: $WORKING_DIR"
		json_detailed_error "unsafe_working_dir" "refusing to delete unsafe working directory" "remove_working_dir" "working_dir=$WORKING_DIR"
		return 1
	fi
	if [ "$REMOVE_WORKDIR" = "1" ] && [ "$REMOVE_CONFIG" != "1" ] && path_is_under "$CONFIG_PATH" "$WORKING_DIR" && [ -e "$CONFIG_PATH" ]; then
		CONFIG_BACKUP="$(mktemp "$TMP_ROOT/oxidns-config-preserve.XXXXXX")"
		core_progress_command "preserve $CONFIG_PATH before removing $WORKING_DIR"
		if cp "$CONFIG_PATH" "$CONFIG_BACKUP" 2>/dev/null; then
			:
		else
			rm -f "$CONFIG_BACKUP"
			CONFIG_BACKUP=""
			core_progress_log "error" "failed to preserve config before removing working directory"
			json_detailed_error "config_preserve_failed" "failed to preserve configuration before removing working directory" "remove_working_dir" "config=$CONFIG_PATH working_dir=$WORKING_DIR"
			return 1
		fi
	fi

	INIT="$(init_script)"
	if [ -x "$INIT" ]; then
		core_progress_command "$INIT stop"
		"$INIT" stop >/dev/null 2>&1 || true
		core_progress_command "$INIT disable"
		"$INIT" disable >/dev/null 2>&1 || true
	fi
	core_progress_command "rm -f $OXIDNS_BIN"
	rm -f "$OXIDNS_BIN"
	core_progress_command "rm -rf $WEBUI_DIR"
	rm -rf "$WEBUI_DIR"

	if [ "$REMOVE_CONFIG" = "1" ]; then
		core_progress_command "rm -f $CONFIG_PATH"
		rm -f "$CONFIG_PATH"
		CONFIG_REMOVED=1
	fi
	if [ "$REMOVE_WORKDIR" = "1" ]; then
		core_progress_command "rm -rf $WORKING_DIR"
		rm -rf "$WORKING_DIR"
		WORKDIR_REMOVED=1
	fi
	if [ -n "$CONFIG_BACKUP" ] && [ -f "$CONFIG_BACKUP" ]; then
		core_progress_command "restore preserved config to $CONFIG_PATH"
		mkdir -p "$(dirname "$CONFIG_PATH")"
		mv "$CONFIG_BACKUP" "$CONFIG_PATH"
	fi
	core_progress_log "success" "core removed"
	printf '{"ok":true,"action":"remove","binary_path":'
	json_string "$OXIDNS_BIN"
	printf ',"webui_path":'
	json_string "$WEBUI_DIR"
	printf ',"config_path":'
	json_string "$CONFIG_PATH"
	printf ',"working_dir":'
	json_string "$WORKING_DIR"
	printf ',"config_removed":'
	json_bool "$CONFIG_REMOVED"
	printf ',"working_dir_removed":'
	json_bool "$WORKDIR_REMOVED"
	printf ',"config_preserved":'
	if [ "$CONFIG_REMOVED" = "1" ]; then json_bool 0; else json_bool 1; fi
	printf ',"working_dir_preserved":'
	if [ "$WORKDIR_REMOVED" = "1" ]; then json_bool 0; else json_bool 1; fi
	printf '}\n'
}

emit_core_remove() {
	run_with_core_lock emit_core_remove_locked
}

case "${1:-}" in
	list)
		printf '{'
		printf '"status":{},'
		printf '"core_install":{},'
		printf '"core_reinstall":{},'
		printf '"core_upload_install":{"path":"string"},'
		printf '"core_progress":{},'
		printf '"core_remove":{"remove_config":"boolean","remove_workdir":"boolean"},'
		printf '"service_start":{},'
		printf '"service_stop":{},'
		printf '"service_restart":{},'
		printf '"service_enable":{},'
		printf '"service_disable":{},'
		printf '"config_read":{},'
		printf '"config_validate":{"content":"string"},'
		printf '"config_save":{"content":"string","base_mtime":"string","restart":"boolean"},'
		printf '"settings_read":{},'
		printf '"settings_save":{"core_repository":"string","core_bundle":"string","config_path":"string","working_dir":"string","download_proxy":"string","github_token":"string","clear_download_proxy":"boolean","clear_github_token":"boolean"},'
		printf '"rules_list":{},'
		printf '"rules_read":{"name":"string"},'
		printf '"rules_save":{"name":"string","content":"string","base_mtime":"string","restart":"boolean"},'
		printf '"learn_reset_get":{},'
		printf '"learn_reset_save":{"reset_cn":"boolean","reset_proxy":"boolean","freq":"string","time":"string","weekday":"string","api_url":"string","api_user":"string","api_pass":"string"},'
		printf '"learn_reset_run":{},'
		printf '"logs_recent":{"limit":"number"},'
		printf '"logs_clear":{},'
		printf '"hijack_get":{},'
		printf '"hijack_save":{"enabled":"boolean"}'
		printf '}\n'
		;;
	call)
		case "${2:-}" in
			status)
				emit_status
				;;
			core_install)
				emit_core_install
				;;
			core_reinstall)
				emit_core_reinstall
				;;
			core_upload_install)
				emit_core_upload_install
				;;
			core_progress)
				emit_core_progress
				;;
			core_remove)
				emit_core_remove
				;;
			service_start)
				run_service start
				;;
			service_stop)
				run_service stop
				;;
			service_restart)
				run_service restart
				;;
			service_enable)
				run_service enable
				;;
			service_disable)
				run_service disable
				;;
			config_read)
				emit_config_read
				;;
			config_validate)
				emit_config_validate
				;;
			config_save)
				emit_config_save
				;;
			rules_list)
				emit_rules_list
				;;
			rules_read)
				emit_rules_read
				;;
			rules_save)
				emit_rules_save
				;;
			learn_reset_get)
				emit_learn_reset_get
				;;
			learn_reset_save)
				emit_learn_reset_save
				;;
			learn_reset_run)
				emit_learn_reset_run
				;;
			settings_read)
				emit_settings_read
				;;
			settings_save)
				emit_settings_save
				;;
			logs_recent)
				emit_logs_recent
				;;
			logs_clear)
				emit_logs_clear
				;;
			hijack_get)
				emit_hijack_get
				;;
			hijack_save)
				emit_hijack_save
				;;
			*)
				printf '{"ok":false,"error":"unknown method"}\n'
				exit 1
				;;
		esac
		;;
	*)
		printf '{"ok":false,"error":"usage: luci.oxidns list|call <method>"}\n'
		exit 1
		;;
esac
