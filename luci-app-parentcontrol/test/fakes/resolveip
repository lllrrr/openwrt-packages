#!/bin/sh
# 读 $FAKE_RESOLVE（每行：<4|6> <host> <ip>），命令行最后一个是 host。
# 设 FAKE_RESOLVE_LOG 时把被查询的 host 记下来（W13/W17：断言 CIDR 不进解析器、
# 关键词/apex/www 变体确实被查询过）。
fam=4; [ "$1" = "-6" ] && fam=6
host=""; for a in "$@"; do host="$a"; done
[ -n "$FAKE_RESOLVE_LOG" ] && printf '%s\n' "$host" >> "$FAKE_RESOLVE_LOG"
[ -f "$FAKE_RESOLVE" ] || exit 0
while read -r f h ip; do
    [ "$f" = "$fam" ] && [ "$h" = "$host" ] && echo "$ip"
done < "$FAKE_RESOLVE"
exit 0
