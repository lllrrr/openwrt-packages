#!/bin/sh
# nft 桩：默认（未设 FAKE_NFT_STATE）退出 1 —— 相当于「主机上没有 nft」，
# apply_offload/restore_offload 会直接跳过（既有测试行为不变）。
# 设 FAKE_NFT_STATE=<file> 后变成状态化桩：文件每行 "<handle>|<规则文本>"，
# 模拟 nft 的 inet fw4 forward 链。只实现 init.d 用到的子集：
#   [-a] list chain inet fw4 forward
#   delete rule inet fw4 forward handle N
#   insert rule inet fw4 forward <规则文本...>
ST="$FAKE_NFT_STATE"
[ -n "$ST" ] || exit 1

# 跳过前导短选项（-a 等）
while [ $# -gt 0 ]; do
	case "$1" in -*) shift ;; *) break ;; esac
done

[ $# -ge 5 ] || exit 2
op=$1
case "$op" in
list)
	[ "$2" = "chain" ] || exit 2
	[ "$3.$4.$5" = "inet.fw4.forward" ] || exit 2
	[ -f "$ST" ] || exit 0
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		h=${line%%|*}
		rule=${line#*|}
		printf '\t%s # handle %s\n' "$rule" "$h"
	done < "$ST"
	exit 0 ;;
delete)
	[ "$2" = "rule" ] || exit 2
	[ "$6" = "handle" ] || exit 2
	h=$7
	tmp="$ST.tmp"
	: > "$tmp"
	found=0
	if [ -f "$ST" ]; then
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			case "${line%%|*}" in
			"$h") found=1; continue ;;
			esac
			printf '%s\n' "$line" >> "$tmp"
		done < "$ST"
	fi
	mv "$tmp" "$ST"
	# 不存在的 handle 退非 0（对齐真实 nft，复审 S1）
	[ "$found" = 1 ] && exit 0
	exit 1 ;;
insert)
	[ "$2" = "rule" ] || exit 2
	[ "$3.$4.$5" = "inet.fw4.forward" ] || exit 2
	shift 5
	# handle 单调递增、从不重用（对齐真实 nft，复审 S1）：计数器存旁文件；
	# 首次使用时按现存最大 handle 播种（兼容测试手工 seed 的状态文件）。
	if [ -f "$ST.next" ]; then
		h=$(cat "$ST.next")
	else
		h=1
		[ -f "$ST" ] && h=$(awk -F'|' '{if ($1 + 0 > m) m = $1 + 0} END {print m + 1}' "$ST")
	fi
	echo $(( h + 1 )) > "$ST.next"
	tmp="$ST.tmp"
	printf '%s|%s\n' "$h" "$*" > "$tmp"
	[ -f "$ST" ] && cat "$ST" >> "$tmp"
	mv "$tmp" "$ST"
	exit 0 ;;
esac
exit 2
