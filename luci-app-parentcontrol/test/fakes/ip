#!/bin/sh
# ip 桩：
#   `ip neigh show` → 从 $FAKE_IP_NEIGH 读邻居表（每行形如
#     "<ip> dev eth0 lladdr <mac> REACHABLE"，按真实 ip 输出格式）。
#   `ip -6 route show dev <dev>` → 从 $FAKE_IP_ROUTE6 读真实格式的路由表（每行形如
#     "<prefix> dev <device> proto static metric 1024 pref medium"，也允许
#     "unreachable <prefix> dev <device> …"），按行内 `dev <device>` 过滤后原样
#     输出（F3：pc_lan_nets6 的数据源）。
# 其余子命令静默 exit 0（不得报错，否则会惊动既有用例）。
if [ "$1" = "neigh" ] && [ "$2" = "show" ]; then
	[ -n "$FAKE_IP_NEIGH" ] && [ -f "$FAKE_IP_NEIGH" ] && cat "$FAKE_IP_NEIGH"
	exit 0
fi
if [ "$1" = "-6" ] && [ "$2" = "route" ] && [ "$3" = "show" ] && [ "$4" = "dev" ]; then
	if [ -n "$FAKE_IP_ROUTE6" ] && [ -f "$FAKE_IP_ROUTE6" ]; then
		awk -v d="$5" '
			{
				for (i = 1; i < NF; i++)
					if ($i == "dev" && $(i + 1) == d) { print; break }
			}' "$FAKE_IP_ROUTE6"
	fi
	exit 0
fi
exit 0
