#!/bin/sh /etc/rc.common
# rtfwupgrade 开机闭环：刷写永远伴随重启，刷写结果只能在重启后才能确认。
#
# 为什么是 init 服务而不是 uci-defaults：
#   uci-defaults 是**一次性**的 —— /etc/init.d/boot 的 uci_apply_defaults 在脚本
#   成功返回后立刻 rm -f 掉已应用的文件，第二次开机它根本不会被调用。
#   而「刷写后重启」这件事每次都要再判一次，所以只能挂在 init 服务上，
#   不能放进 80_rtfwupgrade（那是安装/首次启动的迁移入口，不是开机钩子）。
#
# START=95：排在 network/procd 之后、boot 收尾之前；此时 /usr/lib/os-release
# 与状态文件都已就位，CLI 也能跑。
# START 由 /etc/rc.common 读取（不是本脚本内引用），shellcheck 的「未使用」是误报。
# shellcheck disable=SC2034
START=95

start() {
	# --boot-check 只在存在 flash-pending 时才会输出并上报，其余情况静默退出。
	# 这条命令绝不能让它失败启动流程：设备刚刷完，状态文件可能是坏的。
	/usr/bin/rtfwupgrade.sh flash-status --boot-check >/dev/null 2>&1 || true
}
