#!/bin/bash

crrun=$1
crid=$2
NAME=devgate
DEBUG=1  # 开启调试

config_t_get() {
	local index=${3:-0}
	local ret=$(uci -q get "${NAME}.@${1}[${index}].${2}")
	echo "${ret:-$4}"
}

LOG_FILE="/var/log/devgate.log"
IDLIST="/var/$NAME.idlist"

bin_nft=$(which nft 2>/dev/null)
bin_iptables=$(which iptables 2>/dev/null)
bin_ip6tables=$(which ip6tables 2>/dev/null)

get_device_chain() {
	local id="$1"
	local device_chain=$(config_t_get device chain "$id" "forward")

	case "$device_chain" in
		input)
			echo "input"
			;;
		*)
			echo "forward"
			;;
	esac
}

dbg() {
	if [ "$DEBUG" -eq 1 ]; then
		local d="$(date '+%Y-%m-%d %H:%M:%S')"
		echo "[$d] FW-DEBUG: $@" >> "$LOG_FILE"
	fi
}

info() {
	local d="$(date '+%Y-%m-%d %H:%M:%S')"
	echo "[$d] FW-INFO: $@" >> "$LOG_FILE"
}

run_nft() {
	local output rc

	output="$("$bin_nft" "$@" 2>&1)"
	rc=$?

	[ -n "$output" ] && {
		while IFS= read -r line; do
			dbg "nft: $line"
		done <<-EOF
		$output
		EOF
	}

	return "$rc"
}

# MAC解析函数。IP只作为旧配置兼容输入，运行时始终解析成MAC再生效。
normalize_mac() {
	local mac
	mac=$(echo "${1:-}" | xargs | tr '[:upper:]' '[:lower:]')

	if echo "$mac" | grep -qE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; then
		echo "$mac"
		return 0
	fi

	return 1
}

resolve_ip_to_mac() {
	local ip="$1"
	local mac

	if [ -f "/proc/net/arp" ]; then
		mac=$(awk -v ip="$ip" 'tolower($1) == tolower(ip) && $4 != "00:00:00:00:00:00" { print $4; exit }' /proc/net/arp 2>/dev/null)
		mac=$(normalize_mac "$mac") && {
			echo "$mac"
			return 0
		}
	fi

	if command -v ip >/dev/null 2>&1; then
		mac=$(ip neigh show "$ip" 2>/dev/null | awk 'tolower($0) ~ /lladdr/ { for (i = 1; i <= NF; i++) if ($i == "lladdr") { print $(i + 1); exit } }')
		mac=$(normalize_mac "$mac") && {
			echo "$mac"
			return 0
		}
	fi

	return 1
}

resolve_target_mac() {
	local target="$1"
	local mac

	target=$(echo "${target}" | xargs)
	dbg "解析目标MAC: $target"

	mac=$(normalize_mac "$target") && {
		echo "$mac"
		return 0
	}

	mac=$(resolve_ip_to_mac "$target") && {
		dbg "通过IP解析目标MAC: $target -> $mac"
		echo "$mac"
		return 0
	}

	dbg "无法解析目标MAC: $target"
	return 1
}

parse_target() {
	local mac

	mac=$(resolve_target_mac "$1") || return 1
	echo "mac:single:$mac"
}

# 检查防火墙工具
check_firewall_tool() {
	nftables_ver=
	iptables_ver=

	if [ -x "$bin_nft" ]; then
		nftables_ver=1
		dbg "检测到nftables: $bin_nft"
	elif [ -x "$bin_iptables" ] && [ -x "$bin_ip6tables" ]; then
		iptables_ver=1
		dbg "检测到iptables: $bin_iptables, $bin_ip6tables"
	else
		info "错误: 未找到可用的防火墙工具"
		return 1
	fi
	return 0
}

# 初始化防火墙
init_firewall() {
	check_firewall_tool || return 1

	info "初始化防火墙规则 (黑名单模式，REJECT目标，控制强度按设备规则)"

	if [ -n "$nftables_ver" ]; then
		# 使用nftables
		dbg "初始化nftables"

		# 删除可能存在的旧表
		"$bin_nft" delete table inet devgate 2>/dev/null
		sleep 1

		# 创建新表
		run_nft add table inet devgate || return 1
		run_nft add chain inet devgate forward "{ type filter hook forward priority -100; policy accept; }" || return 1

		# 创建MAC黑名单集合
		run_nft add set inet devgate blacklist_mac "{ type ether_addr; }" || return 1
		run_nft add set inet devgate blacklist_mac_input "{ type ether_addr; }" || return 1

		# 禁止访问公共网络：参考LuCI防火墙通信规则，匹配源MAC后拒绝转发。
		run_nft add rule inet devgate forward ether saddr @blacklist_mac counter reject comment '"DevGate MAC forward reject"' || return 1

		# 禁止访问全部网络：额外匹配访问路由器本机的INPUT流量
		run_nft add chain inet devgate input "{ type filter hook input priority -100; policy accept; }" || return 1
		run_nft add rule inet devgate input ether saddr @blacklist_mac_input counter reject comment '"DevGate MAC input reject"' || return 1

		info "nftables初始化完成"

	elif [ -n "$iptables_ver" ]; then
		info "错误: MAC识别需要nftables支持，不初始化iptables规则"
		return 1
	fi

	return 0
}

# 停止防火墙规则
stop_firewall() {
	info "停止防火墙规则"
	check_firewall_tool || return 1

	if [ -n "$nftables_ver" ]; then
		"$bin_nft" delete table inet devgate 2>/dev/null && info "nftables规则已删除"
	fi

	if [ -n "$iptables_ver" ]; then
		# 清理旧版本可能遗留的ipset规则
		iptables -D FORWARD -m set --match-set devgate_blacklist src -j REJECT 2>/dev/null
		ip6tables -D FORWARD -m set --match-set devgate_blacklist6 src -j REJECT 2>/dev/null
		iptables -D INPUT -m set --match-set devgate_input_blacklist src -j REJECT 2>/dev/null
		ip6tables -D INPUT -m set --match-set devgate_input_blacklist6 src -j REJECT 2>/dev/null
		ipset destroy devgate_blacklist 2>/dev/null
		ipset destroy devgate_blacklist6 2>/dev/null
		ipset destroy devgate_input_blacklist 2>/dev/null
		ipset destroy devgate_input_blacklist6 2>/dev/null

		info "iptables规则已删除"
	fi

	# 清理ID列表
	rm -f "$IDLIST"
}

# 添加设备到防火墙
add_device() {
	check_firewall_tool || return 1

	local id="$1"
	local target=$(config_t_get device mac "$id")
	local device_chain=$(get_device_chain "$id")
	[ -z "$target" ] && {
		dbg "添加设备失败: ID $id 的目标地址为空"
		return
	}

	local comment=$(config_t_get device comment "$id" "设备$id")
	info "添加设备到防火墙: $comment ($target, $device_chain)"

	local parsed_result=$(parse_target "$target")
	if [ $? -ne 0 ]; then
		info "添加失败: 无法解析地址 $target"
		return
	fi

	IFS=':' read -r type subtype value <<< "$parsed_result"
	dbg "解析结果: type=$type, subtype=$subtype, value=$value"

	if [ -n "$nftables_ver" ]; then
		# nftables处理
		case "$type" in
			"mac")
				run_nft add element inet devgate blacklist_mac "{ $value }" || return 1
				[ "$device_chain" = "input" ] && run_nft add element inet devgate blacklist_mac_input "{ $value }"
				dbg "已添加到nftables黑名单(MAC): $value"
				;;
			*)
				info "添加失败: 只支持MAC目标 $target"
				return 1
				;;
		esac

	elif [ -n "$iptables_ver" ]; then
		info "错误: MAC识别需要nftables支持，iptables后端不启用设备 $target"
		return 1
	fi

	# 验证规则
	verify_firewall_rule "$value" || return 1
}

# 验证防火墙规则
verify_firewall_rule() {
	local target="$1"

	dbg "验证防火墙规则: $target"

	if [ -n "$nftables_ver" ]; then
		"$bin_nft" list table inet devgate 2>/dev/null | grep -qi "$target" && {
			dbg "验证成功: $target 在nftables规则中"
			return 0
		}
	elif [ -n "$iptables_ver" ]; then
		info "错误: MAC识别需要nftables支持，iptables后端无法验证"
	fi

	dbg "验证失败: $target 不在防火墙规则中"
	return 1
}

# 从防火墙移除设备
del_device() {
	check_firewall_tool || return 1

	local id="$1"
	local target=$(config_t_get device mac "$id")
	local device_chain=$(get_device_chain "$id")
	[ -z "$target" ] && {
		dbg "移除设备失败: ID $id 的目标地址为空"
		return
	}

	local comment=$(config_t_get device comment "$id" "设备$id")
	info "从防火墙移除设备: $comment ($target, $device_chain)"

	local parsed_result=$(parse_target "$target")
	[ $? -eq 0 ] || {
		info "移除失败: 无法解析地址 $target"
		return
	}

	IFS=':' read -r type subtype value <<< "$parsed_result"

	if [ -n "$nftables_ver" ]; then
		case "$type" in
			"mac")
				"$bin_nft" delete element inet devgate blacklist_mac "{ $value }" 2>/dev/null
				"$bin_nft" delete element inet devgate blacklist_mac_input "{ $value }" 2>/dev/null
				dbg "已从nftables移除(MAC): $value"
				;;
			*)
				info "移除失败: 只支持MAC目标 $target"
				return 1
				;;
		esac

	elif [ -n "$iptables_ver" ]; then
		info "错误: MAC识别需要nftables支持，iptables后端无可移除规则"
		return 1
	fi
}

# 显示防火墙状态
show_firewall_status() {
	check_firewall_tool || return 1

	echo ""
	echo "防火墙状态:"
	echo "控制方式: 黑名单"
	echo "控制强度: 按设备规则"
	echo ""

	if [ -n "$nftables_ver" ]; then
		echo "nftables规则:"
		"$bin_nft" list table inet devgate 2>/dev/null || echo "  未找到devgate表"
	elif [ -n "$iptables_ver" ]; then
		echo "iptables规则:"
		echo "  MAC识别需要nftables支持，iptables后端不启用DevGate规则"
	fi
}

# 诊断函数
diagnose() {
	echo ""
	echo "=== 设备门禁系统诊断 ==="
	echo ""

	# 检查服务
	echo "1. 服务状态:"
	if pidof devgatectrl >/dev/null 2>&1; then
		echo "   ✓ devgatectrl 正在运行"
	else
		echo "   ✗ devgatectrl 未运行"
	fi

	# 检查配置文件
	echo ""
	echo "2. 配置文件:"
	if [ -f "/etc/config/devgate" ]; then
		echo "   ✓ 配置文件存在"
		uci show devgate 2>/dev/null | grep -c "device" | while read count; do
			echo "   配置了 $count 个设备"
		done
	else
		echo "   ✗ 配置文件不存在"
	fi

	# 检查防火墙工具
	echo ""
	echo "3. 防火墙工具:"
	if [ -x "$bin_nft" ]; then
		echo "   ✓ nftables: $bin_nft"
		echo "   版本: $($bin_nft --version 2>/dev/null | head -1)"
	elif [ -x "$bin_iptables" ]; then
		echo "   ✓ iptables: $bin_iptables"
		echo "   版本: $($bin_iptables --version 2>/dev/null | head -1)"
	else
		echo "   ✗ 未找到防火墙工具"
	fi

	# 显示当前规则
	show_firewall_status

	# 检查ID列表
	echo ""
	echo "4. 当前控制列表:"
	if [ -f "$IDLIST" ] && [ -s "$IDLIST" ]; then
		echo "   当前禁止的设备:"
		cat "$IDLIST" | sed 's/!//g' | while read id; do
			local target=$(config_t_get device mac "$id")
			local comment=$(config_t_get device comment "$id" "设备$id")
			echo "   ID$id: $comment ($target)"
		done
	else
		echo "   当前没有设备被禁止"
	fi

	echo ""
	echo "=== 诊断完成 ==="
}

# 主命令处理
case "$crrun" in
	"start")
		info "启动设备门禁"
		stop_firewall
		init_firewall
		if [ $? -eq 0 ]; then
			info "设备门禁启动成功"
			show_firewall_status
		else
			info "设备门禁启动失败"
			exit 1
		fi
		;;

	"stop")
		info "停止设备门禁"
		stop_firewall
		info "设备门禁已停止"
		;;

	"add")
		[ -z "$crid" ] && {
			echo "错误: 需要指定设备ID"
			exit 1
		}
		info "添加设备控制: ID=$crid"
		add_device "$crid" || exit 1
		show_firewall_status
		;;

	"del")
		[ -z "$crid" ] && {
			echo "错误: 需要指定设备ID"
			exit 1
		}
		info "移除设备控制: ID=$crid"
		del_device "$crid" || exit 1
		show_firewall_status
		;;

	"status")
		show_firewall_status
		;;

	"diagnose")
		diagnose
		;;

	"test")
		# 测试目标MAC解析
		echo "测试目标MAC解析:"
		for test in "00:11:22:33:44:55" "192.168.1.100" "invalid"; do
			echo -n "$test: "
			if parse_target "$test" >/dev/null; then
				echo "✓ 有效"
				parse_target "$test"
			else
				echo "✗ 无效"
			fi
		done
		;;

	"help"|"")
		echo "设备门禁系统命令工具"
		echo ""
		echo "用法: $0 {start|stop|add <id>|del <id>|status|diagnose|test|help}"
		echo ""
		echo "命令说明:"
		echo "  start           - 初始化防火墙规则"
		echo "  stop            - 停止并清理所有防火墙规则"
		echo "  add <id>        - 添加设备到控制列表"
		echo "  del <id>        - 从控制列表移除设备"
		echo "  status          - 显示防火墙状态"
		echo "  diagnose        - 系统诊断"
		echo "  test            - 测试地址解析"
		echo "  help            - 显示此帮助信息"
		;;

	*)
		echo "错误: 未知命令 '$crrun'"
		echo "使用: $0 help 查看帮助"
		exit 1
		;;
esac
