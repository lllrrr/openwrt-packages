#!/bin/sh

crrun=$1
crid=$2
NAME=devgate
DEBUG=1  # 开启调试

LOG_FILE="/var/log/devgate.log"
IDLIST="/var/$NAME.idlist"
RULE_PREFIX="devgate_"
DEFAULT_SRC_ZONE="lan"
FORWARD_DEST_ZONE="*"

bin_fw4=$(command -v fw4 2>/dev/null)

config_t_get() {
	local index=${3:-0}
	local ret=$(uci -q get "${NAME}.@${1}[${index}].${2}")
	echo "${ret:-$4}"
}

get_device_chain() {
	local id="$1"
	local device_chain=$(config_t_get device chain "$id" "forward")

	case "$device_chain" in
		input)
			echo "input"
			;;
		*)
			echo "forward"
			;;
	esac
}

dbg() {
	if [ "$DEBUG" -eq 1 ]; then
		local d="$(date '+%Y-%m-%d %H:%M:%S')"
		echo "[$d] FW-DEBUG: $@" >> "$LOG_FILE"
	fi
}

info() {
	local d="$(date '+%Y-%m-%d %H:%M:%S')"
	echo "[$d] FW-INFO: $@" >> "$LOG_FILE"
}

run_logged() {
	local label="$1"
	shift

	local output rc
	output="$("$@" 2>&1)"
	rc=$?

	[ -n "$output" ] && {
		while IFS= read -r line; do
			dbg "$label: $line"
		done <<-EOF
		$output
		EOF
	}

	return "$rc"
}

normalize_mac() {
	local mac
	mac=$(echo "${1:-}" | xargs | tr '[:upper:]' '[:lower:]')

	if echo "$mac" | grep -qE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; then
		echo "$mac"
		return 0
	fi

	return 1
}

rule_section() {
	local id="$1"
	local kind="$2"

	echo "${RULE_PREFIX}${id}_${kind}"
}

rule_name() {
	local comment="$1"
	local kind="$2"

	case "$kind" in
		input)
			echo "DevGate - $comment - 路由器本机"
			;;
		*)
			echo "DevGate - $comment - 转发流量"
			;;
	esac
}

check_firewall_tool() {
	if ! command -v uci >/dev/null 2>&1; then
		info "错误: 未找到uci命令"
		return 1
	fi

	if [ ! -x /etc/init.d/firewall ] && [ ! -x "$bin_fw4" ]; then
		info "错误: 未找到firewall4防火墙服务"
		return 1
	fi

	dbg "检测到OpenWrt firewall UCI接口"
	[ -x /etc/init.d/firewall ] && dbg "firewall服务: /etc/init.d/firewall"
	[ -x "$bin_fw4" ] && dbg "fw4命令: $bin_fw4"

	return 0
}

reload_firewall() {
	if [ -x /etc/init.d/firewall ]; then
		run_logged "firewall reload" /etc/init.d/firewall reload
		return $?
	fi

	run_logged "fw4 reload" "$bin_fw4" reload
}

commit_firewall() {
	uci -q commit firewall || {
		info "错误: 提交firewall配置失败"
		return 1
	}

	reload_firewall || {
		info "错误: 重载firewall失败"
		return 1
	}
}

delete_device_firewall_rules() {
	local id="$1"

	uci -q delete "firewall.$(rule_section "$id" forward)"
	uci -q delete "firewall.$(rule_section "$id" input)"
}

delete_all_devgate_firewall_rules() {
	local section

	uci -q show firewall | sed -n "s/^firewall\.\(${RULE_PREFIX}[A-Za-z0-9_]*\)=rule$/\1/p" | while IFS= read -r section; do
		[ -n "$section" ] && uci -q delete "firewall.$section"
	done
}

set_firewall_option() {
	local section="$1"
	local option="$2"
	local value="$3"

	uci -q set "firewall.$section.$option=$value"
}

create_forward_rule() {
	local section="$1"
	local mac="$2"
	local name="$3"

	uci -q set "firewall.$section=rule" || return 1
	set_firewall_option "$section" enabled "1" || return 1
	set_firewall_option "$section" name "$name" || return 1
	set_firewall_option "$section" src "$DEFAULT_SRC_ZONE" || return 1
	set_firewall_option "$section" dest "$FORWARD_DEST_ZONE" || return 1
	set_firewall_option "$section" src_mac "$mac" || return 1
	set_firewall_option "$section" proto "all" || return 1
	set_firewall_option "$section" target "REJECT" || return 1
}

create_input_rule() {
	local section="$1"
	local mac="$2"
	local name="$3"

	uci -q set "firewall.$section=rule" || return 1
	set_firewall_option "$section" enabled "1" || return 1
	set_firewall_option "$section" name "$name" || return 1
	set_firewall_option "$section" src "$DEFAULT_SRC_ZONE" || return 1
	set_firewall_option "$section" src_mac "$mac" || return 1
	set_firewall_option "$section" proto "all" || return 1
	set_firewall_option "$section" target "REJECT" || return 1
}

verify_firewall_rule() {
	local id="$1"
	local mac="$2"
	local device_chain="$3"
	local forward_section input_section

	forward_section=$(rule_section "$id" forward)
	input_section=$(rule_section "$id" input)

	dbg "验证firewall通信规则: ID=$id MAC=$mac chain=$device_chain"

	[ "$(uci -q get "firewall.$forward_section.src_mac")" = "$mac" ] || {
		dbg "验证失败: 转发规则不存在或MAC不匹配"
		return 1
	}

	[ "$(uci -q get "firewall.$forward_section.target")" = "REJECT" ] || {
		dbg "验证失败: 转发规则目标不是REJECT"
		return 1
	}

	if [ "$device_chain" = "input" ]; then
		[ "$(uci -q get "firewall.$input_section.src_mac")" = "$mac" ] || {
			dbg "验证失败: 本机访问规则不存在或MAC不匹配"
			return 1
		}
	fi

	dbg "验证成功: DevGate通信规则已写入firewall配置"
	return 0
}

init_firewall() {
	check_firewall_tool || return 1

	info "初始化防火墙规则 (黑名单模式，REJECT目标，规则同步到firewall通信规则)"
	delete_all_devgate_firewall_rules
	commit_firewall || return 1
	info "firewall通信规则初始化完成"

	return 0
}

stop_firewall() {
	info "停止防火墙规则"
	check_firewall_tool || return 1

	delete_all_devgate_firewall_rules
	commit_firewall || return 1

	rm -f "$IDLIST"
	info "DevGate通信规则已删除"
}

add_device() {
	check_firewall_tool || return 1

	local id="$1"
	local target=$(config_t_get device mac "$id")
	local device_chain=$(get_device_chain "$id")
	[ -z "$target" ] && {
		dbg "添加设备失败: ID $id 的目标地址为空"
		return 1
	}

	local comment=$(config_t_get device comment "$id" "设备$id")
	local mac

	mac=$(normalize_mac "$target") || {
		info "添加失败: 目标MAC无效 $target"
		return 1
	}

	info "添加设备到firewall通信规则: $comment ($mac, $device_chain)"

	delete_device_firewall_rules "$id"
	create_forward_rule "$(rule_section "$id" forward)" "$mac" "$(rule_name "$comment" forward)" || return 1
	if [ "$device_chain" = "input" ]; then
		create_input_rule "$(rule_section "$id" input)" "$mac" "$(rule_name "$comment" input)" || return 1
	fi

	if ! commit_firewall; then
		info "添加失败: firewall重载失败，回滚DevGate规则"
		delete_device_firewall_rules "$id"
		commit_firewall >/dev/null 2>&1 || true
		return 1
	fi

	verify_firewall_rule "$id" "$mac" "$device_chain" || return 1
}

del_device() {
	check_firewall_tool || return 1

	local id="$1"
	local target=$(config_t_get device mac "$id")
	local comment=$(config_t_get device comment "$id" "设备$id")

	info "从firewall通信规则移除设备: $comment ($target)"

	delete_device_firewall_rules "$id"
	commit_firewall || return 1
}

show_firewall_status() {
	check_firewall_tool || return 1

	echo ""
	echo "防火墙状态:"
	echo "控制方式: 黑名单"
	echo "控制强度: 按设备规则"
	echo "规则来源: /etc/config/firewall 通信规则"
	echo ""

	echo "DevGate通信规则:"
	if uci -q show firewall | grep -q "^firewall\.${RULE_PREFIX}"; then
		uci -q show firewall | grep "^firewall\.${RULE_PREFIX}"
	else
		echo "  当前没有DevGate通信规则"
	fi
}

diagnose() {
	echo ""
	echo "=== 设备门禁系统诊断 ==="
	echo ""

	echo "1. 服务状态:"
	if pidof devgatectrl >/dev/null 2>&1; then
		echo "   ✓ devgatectrl 正在运行"
	else
		echo "   ✗ devgatectrl 未运行"
	fi

	echo ""
	echo "2. 配置文件:"
	if [ -f "/etc/config/devgate" ]; then
		echo "   ✓ 配置文件存在"
		uci show devgate 2>/dev/null | grep -c "device" | while read count; do
			echo "   配置了 $count 个设备"
		done
	else
		echo "   ✗ 配置文件不存在"
	fi

	echo ""
	echo "3. 防火墙接口:"
	if command -v uci >/dev/null 2>&1; then
		echo "   ✓ uci: $(command -v uci)"
	else
		echo "   ✗ 未找到uci"
	fi

	if [ -x /etc/init.d/firewall ]; then
		echo "   ✓ firewall服务: /etc/init.d/firewall"
	else
		echo "   ✗ 未找到firewall服务"
	fi

	if [ -x "$bin_fw4" ]; then
		echo "   ✓ fw4: $bin_fw4"
		echo "   版本: $($bin_fw4 -V 2>/dev/null | head -1)"
	else
		echo "   ? 未找到fw4命令"
	fi

	show_firewall_status

	echo ""
	echo "4. 当前控制列表:"
	if [ -f "$IDLIST" ] && [ -s "$IDLIST" ]; then
		echo "   当前禁止的设备:"
		cat "$IDLIST" | sed 's/!//g' | while read id; do
			local target=$(config_t_get device mac "$id")
			local comment=$(config_t_get device comment "$id" "设备$id")
			echo "   ID$id: $comment ($target)"
		done
	else
		echo "   当前没有设备被禁止"
	fi

	echo ""
	echo "=== 诊断完成 ==="
}

case "$crrun" in
	start)
		info "启动设备门禁"
		init_firewall
		if [ $? -eq 0 ]; then
			info "设备门禁启动成功"
			show_firewall_status
		else
			info "设备门禁启动失败"
			exit 1
		fi
		;;

	stop)
		info "停止设备门禁"
		stop_firewall
		info "设备门禁已停止"
		;;

	add)
		[ -z "$crid" ] && {
			echo "错误: 需要指定设备ID"
			exit 1
		}
		info "添加设备控制: ID=$crid"
		add_device "$crid" || exit 1
		show_firewall_status
		;;

	del)
		[ -z "$crid" ] && {
			echo "错误: 需要指定设备ID"
			exit 1
		}
		info "移除设备控制: ID=$crid"
		del_device "$crid" || exit 1
		show_firewall_status
		;;

	status)
		show_firewall_status
		;;

	diagnose)
		diagnose
		;;

	help|"")
		echo "设备门禁系统命令工具"
		echo ""
		echo "用法: $0 {start|stop|add <id>|del <id>|status|diagnose|help}"
		echo ""
		echo "命令说明:"
		echo "  start           - 初始化firewall通信规则"
		echo "  stop            - 停止并清理所有DevGate通信规则"
		echo "  add <id>        - 添加设备到控制列表"
		echo "  del <id>        - 从控制列表移除设备"
		echo "  status          - 显示防火墙状态"
		echo "  diagnose        - 系统诊断"
		echo "  help            - 显示此帮助信息"
		;;

	*)
		echo "错误: 未知命令 '$crrun'"
		echo "使用: $0 help 查看帮助"
		exit 1
		;;
esac
