#!/bin/sh

NAME=devgate
LOG_FILE="/var/log/devgate.log"
DEBUG=1

IDLIST="/var/$NAME.idlist"

# 日志函数
dbg() {
	[ "$DEBUG" -eq 1 ] && {
		local d="$(date '+%Y-%m-%d %H:%M:%S')"
		echo "[$d] CTRL-DEBUG: $@" >> "$LOG_FILE"
	}
}

info() {
	local d="$(date '+%Y-%m-%d %H:%M:%S')"
	echo "[$d] CTRL-INFO: $@" >> "$LOG_FILE"
}

# 配置文件读取
config_t_get() {
	local index=${3:-0}
	local ret=$(uci -q get "${NAME}.@${1}[${index}].${2}")
	echo "${ret:=${4}}"
}

# 获取启用设备
get_enabled_devices() {
	uci show "$NAME" 2>/dev/null | sed -n "s/^${NAME}\.@device\[\([0-9][0-9]*\)\]\.enable='1'.*/\1/p" | sort -n
}

get_enabled_device_count() {
	get_enabled_devices | wc -l
}

# 时间检查函数
is_time_in_range() {
	local start_time=$1
	local end_time=$2
	local current_time=$(date +%H:%M)

	if [ "$start_time" = "$end_time" ]; then
		return 0
	elif [ "$start_time" \< "$end_time" ]; then
		[ "$current_time" \> "$start_time" ] && [ "$current_time" \< "$end_time" ] && return 0
	else
		[ "$current_time" \> "$start_time" ] || [ "$current_time" \< "$end_time" ] && return 0
	fi
	return 1
}

is_weekday_in_range() {
	local configured_weekdays=$1
	local current_weekday=$(date +%u)

	[ "$configured_weekdays" = "0" ] && return 0

	for ww in $(echo "$configured_weekdays" | sed 's/,/ /g'); do
		[ "$current_weekday" = "$ww" ] && return 0
	done
	return 1
}

# 主检查函数
check_device_control() {
	local id="$1"
	local target=$(config_t_get device mac "$id")
	local weekdays=$(config_t_get device week "$id" "0")
	local start_time=$(config_t_get device time_from "$id" "00:00")
	local end_time=$(config_t_get device time_over "$id" "00:00")

	is_weekday_in_range "$weekdays" || {
		dbg "生效日期外: $target"
		return 0
	}

	if is_time_in_range "$start_time" "$end_time"; then
		dbg "禁用时段内: $target ($start_time-$end_time)"
		return 1
	fi

	dbg "禁用时段外: $target ($start_time-$end_time)"
	return 0
}

# 同步设备状态
sync_device_status() {
	local id="$1"
	local target=$(config_t_get device mac "$id")
	local comment=$(config_t_get device comment "$id" "设备$id")
	local is_blocked=0

	if [ -f "$IDLIST" ] && grep -q "!${id}!" "$IDLIST" 2>/dev/null; then
		is_blocked=1
	fi

	dbg "设备状态: $target, 已阻止=$is_blocked"

	if check_device_control "$id"; then
		if [ "$is_blocked" -eq 1 ]; then
			dbg "解除阻止: $target"
			devgate del "$id"
			sed -i "/!$id!/d" "$IDLIST" 2>/dev/null
			info "允许上网: $comment ($target)"
		fi
	else
		if [ "$is_blocked" -eq 0 ]; then
			dbg "添加阻止: $target"
			if devgate add "$id"; then
				if ! grep -q "!$id!" "$IDLIST" 2>/dev/null; then
					echo "!$id!" >> "$IDLIST"
				fi
				info "阻止上网: $comment ($target)"
			else
				info "阻止失败: $comment ($target)"
			fi
		fi
	fi
}

# 主处理循环
main_loop() {
	info "设备门禁守护进程启动"
	while :; do
		dbg "开始检查设备"
		if [ "$(get_enabled_device_count)" -eq 0 ]; then
			devgate stop
			break
		fi
		for id in $(get_enabled_devices); do
			sync_device_status "$id"
		done

		sleep 60
	done
}

# 启动
main_loop
