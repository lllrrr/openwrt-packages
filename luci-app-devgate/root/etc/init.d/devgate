#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

NAME=devgate
LOCK="/var/lock/$NAME.lock"
EXTRA_COMMANDS="actual"
EXTRA_HELP="	actual	Print runtime status for LuCI"

actual() {
	local pids pid

	pids="$(pidof devgatectrl 2>/dev/null)"
	pid="${pids%% *}"

	if [ -n "$pid" ]; then
		printf '{"running":true,"pid":"%s"}\n' "$pid"
	else
		printf '{"running":false,"pid":null}\n'
	fi
}

start_instance() {
	procd_open_instance
	procd_set_param command /usr/bin/devgatectrl
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

_devgate_start() {
	if uci show "$NAME" 2>/dev/null | grep -q "\.enable='1'"; then
		touch "$LOCK"
		/usr/bin/devgate start || {
			rm -f "$LOCK" 2>/dev/null
			return 1
		}
		sleep 2
		start_instance
	else
		stop_service
	fi
}

start_service(){
	[ -f "$LOCK" ] && return 0
	_devgate_start
	rm -f "$LOCK"
}

service_triggers() {
	procd_add_reload_trigger 'devgate'
}

stop_service(){
	local pids
	pids="$(pidof devgatectrl 2>/dev/null)"
	[ -n "$pids" ] && kill $pids >/dev/null 2>&1
	rm -f "$LOCK" 2>/dev/null
	[ -x /usr/bin/devgate ] && /usr/bin/devgate stop || true
}
