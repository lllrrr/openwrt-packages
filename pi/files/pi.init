#!/bin/sh /etc/rc.common
# Pi - Mihomo Transparent Proxy (Nikki hybrid: TCP REDIRECT + UDP TUN)
# LAN TCP → redirect to redir-port
# LAN UDP → mark TUN_MARK → policy route → TUN device (mihomo handles)

USE_PROCD=1
START=99
STOP=10

NAME=pi
PROG=/usr/bin/pi
CONFIG_DIR=/etc/pi
RUN_DIR=/var/run/pi
LOG_DIR=/var/log/pi

REDIR_PORT=7893
DNS_PORT=1053
TUN_MARK=0x81
TUN_MASK=0xFF
TUN_TABLE=81

_log() { logger -t pi "$*"; }

# ── nftables ─────────────────────────────────────────────────────

add_bypass_addr() {
	local addr="$1"
	case "$addr" in
		*:*) nft add element inet pi user_bypass_v6 "{ $addr }" 2>/dev/null ;;
		*)   nft add element inet pi user_bypass_v4 "{ $addr }" 2>/dev/null ;;
	esac
}

add_bypass_device() {
	nft add element inet pi bypass_devices_v4 "{ $1 }" 2>/dev/null || \
		_log "bypass device add failed: $1"
}

load_nftables() {
	local redir_port dns_port proxy_router tun_dev ipv4_proxy ipv6_proxy bypass_china_ip

	config_load pi
	config_get redir_port  global redir_port "$REDIR_PORT"
	config_get dns_port    global dns_port    "$DNS_PORT"
	config_get_bool proxy_router global proxy_router 1
	config_get tun_dev     global tun_dev     "utun"
	config_get_bool ipv4_proxy global ipv4    1
	config_get_bool ipv6_proxy global ipv6    0
	config_get_bool bypass_china_ip global bypass_china_ip 0

	nft delete table inet pi 2>/dev/null || true

	cat <<-BASENFT > /tmp/pi.nft
	table inet pi {

	    # ── Bypass sets ──────────────────────────────────────────
	    set bypass_v4 {
	        type ipv4_addr
	        flags interval
	        elements = { 0.0.0.0/8, 10.0.0.0/8,
	            100.64.0.0/10, 127.0.0.0/8,
	            169.254.0.0/16, 172.16.0.0/12,
	            192.0.0.0/24, 192.168.0.0/16,
	            198.18.0.0/15, 198.51.100.0/24,
	            203.0.113.0/24, 224.0.0.0/4,
	            240.0.0.0/4 }
	    }

	    set bypass_v6 {
	        type ipv6_addr
	        flags interval
	        elements = { ::, ::1,
	            ::ffff:0.0.0.0/96,
	            64:ff9b::/96,
	            fc00::/7, fe80::/10,
	            ff00::/8 }
	    }

	    set user_bypass_v4 { type ipv4_addr; flags interval; }
	    set user_bypass_v6 { type ipv6_addr; flags interval; }
	    set bypass_devices_v4 { type ipv4_addr; flags interval; }

	    # ── LAN DNS hijack ───────────────────────────────────────
	    chain lan_dns_hijack {
	        meta l4proto { tcp, udp } th dport 53 counter redirect to $dns_port
	    }

	    # ── LAN TCP redirect ────────────────────────────────────
	    chain lan_redirect {
	        meta l4proto tcp counter redirect to $redir_port
	    }

	    # ── LAN TCP redirect (dstnat nat hook) ──────────────────
	    chain dstnat {
	        type nat hook prerouting priority dstnat + 1; policy accept;
	        iifname "lo" return
	        iifname "$tun_dev" return
	        fib daddr type { local, broadcast, anycast, multicast } counter return
	        ct direction reply counter return
	        ip  daddr @bypass_v4      return
	        ip6 daddr @bypass_v6      return
	        ip  daddr @user_bypass_v4 return
	        ip6 daddr @user_bypass_v6 return
	        ip saddr @bypass_devices_v4 return
	        jump lan_dns_hijack
	        jump lan_redirect
	    }

	    # ── LAN UDP TUN mark ────────────────────────────────────
	    chain lan_tun {
	        meta l4proto udp counter meta mark set $TUN_MARK accept
	    }

	    chain mangle_prerouting {
	        type filter hook prerouting priority mangle; policy accept;
	        iifname "lo" return
	        iifname "$tun_dev" return
	        fib daddr type { local, broadcast, anycast, multicast } counter return
	        ct direction reply counter return
	        ip  daddr @bypass_v4      return
	        ip6 daddr @bypass_v6      return
	        ip  daddr @user_bypass_v4 return
	        ip6 daddr @user_bypass_v6 return
	        ip saddr @bypass_devices_v4 return
	        jump lan_tun
	    }

	    # ── Accept TUN device traffic ───────────────────────────
	    chain mangle_prerouting_tun {
	        type filter hook prerouting priority mangle - 1; policy accept;
	        iifname "$tun_dev" meta l4proto { tcp, udp, icmp } counter accept
	    }

	BASENFT

	if [ "$proxy_router" = "1" ]; then
		cat <<-ROUTERNFT >> /tmp/pi.nft
	    # ── Router self DNS ──────────────────────────────────────
	    chain router_dns_hijack {
	        meta l4proto { tcp, udp } th dport 53 counter redirect to $dns_port
	    }

	    # ── Router self TCP redirect ────────────────────────────
	    chain router_redirect {
	        meta l4proto tcp counter redirect to $redir_port
	    }

	    chain nat_output {
	        type nat hook output priority filter; policy accept;
	        socket cgroupv2 level 2 "services/pi" counter return
	        jump router_dns_hijack
	        fib daddr type { local, broadcast, anycast, multicast } counter return
	        ct direction reply counter return
	        ip  daddr @bypass_v4      return
	        ip6 daddr @bypass_v6      return
	        ip  daddr @user_bypass_v4 return
	        ip6 daddr @user_bypass_v6 return
	        jump router_redirect
	    }

	    # ── Router self UDP TUN mark ────────────────────────────
	    chain router_tun_mark {
	        meta l4proto udp counter meta mark set $TUN_MARK accept
	    }

	    chain mangle_output {
	        type route hook output priority mangle; policy accept;
	        socket cgroupv2 level 2 "services/pi" counter return
	        fib daddr type { local, broadcast, anycast, multicast } counter return
	        ct direction reply counter return
	        ip  daddr @bypass_v4      return
	        ip6 daddr @bypass_v6      return
	        ip  daddr @user_bypass_v4 return
	        ip6 daddr @user_bypass_v6 return
	        meta l4proto vmap { tcp: continue, udp: jump router_tun_mark }
	    }
	ROUTERNFT
	fi

	echo "}" >> /tmp/pi.nft

	nft -f /tmp/pi.nft

	config_list_foreach global bypass_addrs add_bypass_addr
	config_list_foreach global bypass_devices add_bypass_device

	# ── Bypass China IPs ────────────────────────────────────────
	if [ "$bypass_china_ip" = "1" ]; then
		CHINA_IP_FILE="$CONFIG_DIR/china_ip.txt"
		if [ -f "$CHINA_IP_FILE" ]; then
			while IFS= read -r cidr || [ -n "$cidr" ]; do
				[ -n "$cidr" ] && case "$cidr" in
					# skip comments/empty lines
					\#*) ;;
					*) add_bypass_addr "$cidr" ;;
				esac
			done < "$CHINA_IP_FILE"
			_log "China IP bypass loaded ($(wc -l < "$CHINA_IP_FILE") entries)"
		else
			_log "China IP list not found at $CHINA_IP_FILE, downloading..."
			# Download in background — don't block startup
			( wget -q -O /tmp/china_ip.txt \
			    "https://raw.githubusercontent.com/17mon/china_ip_list/master/china_ip_list.txt" 2>/dev/null \
			  && [ -s /tmp/china_ip.txt ] \
			  && mv /tmp/china_ip.txt "$CHINA_IP_FILE" \
			  && _log "China IP list downloaded to $CHINA_IP_FILE (restart to activate)" ) &>/dev/null &
		fi
	fi

	_log "nftables loaded (redir=$redir_port dns=$dns_port tun=$tun_dev)"
}

unload_nftables() {
	nft delete table inet pi 2>/dev/null && \
		_log "nftables removed" || true
}

# ── TUN routing ────────────────────────────────────────────────

setup_tun_routing() {
	local tun_dev
	config_load pi
	config_get tun_dev global tun_dev "utun"

	ip link show dev "$tun_dev" >/dev/null 2>&1 || {
		_log "TUN $tun_dev not found"
		return 1
	}

	ip -4 rule add fwmark "$TUN_MARK/$TUN_MASK" table "$TUN_TABLE" prio 200 2>/dev/null || true
	ip -4 route add unicast default dev "$tun_dev" table "$TUN_TABLE" 2>/dev/null || \
		ip -4 route replace unicast default dev "$tun_dev" table "$TUN_TABLE" 2>/dev/null
	echo 0 > "/proc/sys/net/ipv4/conf/$tun_dev/rp_filter" 2>/dev/null || true
	echo 1 > "/proc/sys/net/ipv4/conf/$tun_dev/accept_local" 2>/dev/null || true

	_log "TUN routing: mark=$TUN_MARK table=$TUN_TABLE via $tun_dev"
}

teardown_tun_routing() {
	ip -4 rule del fwmark "$TUN_MARK/$TUN_MASK" table "$TUN_TABLE" 2>/dev/null || true
	ip -4 route flush table "$TUN_TABLE" 2>/dev/null || true
	_log "TUN routing cleared"
}

# ── procd service ────────────────────────────────────────────────

start_service() {
	local enabled config_file log_level

	config_load pi
	config_get_bool enabled     global enabled     0
	config_get      config_file global config_file "$CONFIG_DIR/config.yaml"
	config_get      log_level   global log_level   "info"

	mkdir -p "$RUN_DIR" "$LOG_DIR"

	# Sync log_level from UCI to config.yaml
	[ -f "$config_file" ] && sed -i "s/^log-level:.*/log-level: $log_level/" "$config_file" 2>/dev/null

	procd_open_instance
	procd_set_param command /bin/sh
	procd_append_param command -c

	if [ "$enabled" = "1" ] && [ -f "$config_file" ]; then
		_log "Starting mihomo..."
		procd_append_param command "exec \"$PROG\" -d \"$CONFIG_DIR\" >> $LOG_DIR/pi.log 2>&1"
		procd_set_param file "$config_file"
		procd_set_param respawn 3600 5 5
	else
		[ "$enabled" = "1" ] || _log "Disabled"
		[ -f "$config_file" ] || _log "Config not found: $config_file"
		# Dummy process so procd always has an instance → trigger always fires
		procd_append_param command "sleep 99999999"
	fi

	procd_set_param pidfile "$RUN_DIR/pi.pid"
	procd_set_param term_timeout 10
	procd_close_instance
}

service_started() {
	local enabled
	config_load pi
	config_get_bool enabled global enabled 0
	[ "$enabled" = "1" ] || { _log "Disabled, skipping startup checks"; return 0; }

	local tun_dev tun_timeout tun_interval pid_timeout
	config_load pi
	config_get tun_dev      global tun_dev      "utun"
	config_get tun_timeout  global tun_timeout  30
	config_get tun_interval global tun_interval 1
	config_get pid_timeout  global pid_timeout  15

	# Wait for pid file
	_log "Waiting for pid file (${pid_timeout}s)..."
	local w=0
	while [ "$w" -lt "$pid_timeout" ]; do
		[ -f "$RUN_DIR/pi.pid" ] && { _log "pid ready after ${w}s"; break; }
		w=$((w + 1)); sleep 1
	done
	[ -f "$RUN_DIR/pi.pid" ] || { _log "TIMEOUT: no pid"; return 1; }

	# Wait for TUN device
	_log "Waiting for TUN $tun_dev (${tun_timeout}s)..."
	w=0
	while [ "$w" -lt "$tun_timeout" ]; do
		ip link show dev "$tun_dev" >/dev/null 2>&1 && { _log "TUN $tun_dev up after ${w}s"; break; }
		w=$((w + tun_interval)); sleep "$tun_interval"
	done
	if [ "$w" -ge "$tun_timeout" ]; then
		_log "TIMEOUT: TUN $tun_dev not found"
		return 1
	fi

	_log "Applying nftables..."
	load_nftables 2>&1 | logger -t pi
	_log "nftables applied"

	setup_tun_routing || return 1

	_log "Proxy active"
}

stop_service() {
	teardown_tun_routing
	unload_nftables
	rm -rf "$RUN_DIR"
	_log "Stopped"
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "pi"
}

extra_command "hot_reload" "Hot-reload Mihomo config"
hot_reload() {
	[ -f "$RUN_DIR/pi.pid" ] || { echo "not running"; return 1; }
	kill -HUP "$(cat "$RUN_DIR/pi.pid")" 2>/dev/null || true
	_log "hot_reload sent"
}

status() {
	if [ -f "$RUN_DIR/pi.pid" ] && kill -0 "$(cat "$RUN_DIR/pi.pid")" 2>/dev/null; then
		echo "running (PID $(cat "$RUN_DIR/pi.pid"))"
		nft list table inet pi >/dev/null 2>&1 && echo "firewall: active" || echo "firewall: inactive"
		local tun_dev; config_load pi; config_get tun_dev global tun_dev "utun"
		ip link show dev "$tun_dev" >/dev/null 2>&1 && echo "tun: $tun_dev UP" || echo "tun: $tun_dev DOWN"
	else
		echo "stopped"
	fi
}
