#!/bin/sh
# Runs after the package files are unpacked (apk: post-install, opkg: postinst).
[ -n "${IPKG_INSTROOT}" ] || {
	# migrate from luci-app-clientblock, the pre-2.0 name. The state
	# directory moves as a whole so blocked addresses, trusted proxies,
	# device history and feeds survive the rename.
	if [ -d /etc/clientblock ] && [ ! -d /etc/languard ]; then
		mv /etc/clientblock /etc/languard
	fi
	if [ -f /var/run/clientblock-watch.pid ]; then
		kill "$(cat /var/run/clientblock-watch.pid)" 2>/dev/null
		rm -f /var/run/clientblock-watch.pid
	fi
	if [ -x /etc/init.d/clientblock ]; then
		/etc/init.d/clientblock stop    >/dev/null 2>&1
		/etc/init.d/clientblock disable >/dev/null 2>&1
	fi
	rm -f /etc/init.d/clientblock \
	      /etc/nftables.d/90-clientblock.nft \
	      /usr/libexec/rpcd/luci.clientblock \
	      /usr/libexec/clientblock-luci-realip \
	      /usr/sbin/clientblock-watch \
	      /usr/share/luci/menu.d/luci-app-clientblock.json \
	      /usr/share/rpcd/acl.d/luci-app-clientblock.json \
	      /www/luci-static/resources/view/clientblock.js

	mkdir -p /etc/languard /etc/nftables.d
	[ -s /etc/languard/blocked_ips.json ] || echo '{}' > /etc/languard/blocked_ips.json
	[ -s /etc/languard/blocked.json ]     || echo '{}' > /etc/languard/blocked.json
	[ -s /etc/languard/names.json ]       || echo '{}' > /etc/languard/names.json
	chmod 600 /etc/languard/*.json 2>/dev/null

	# LuCI logs the socket peer as the client; with a trusted proxy in front
	# that is the proxy. Teach its login log to use the forwarded address.
	if lua /usr/libexec/languard-luci-realip >/dev/null 2>&1; then
		/etc/init.d/uhttpd restart >/dev/null 2>&1
	fi

	/etc/init.d/rpcd restart    >/dev/null 2>&1
	/etc/init.d/languard enable  >/dev/null 2>&1
	/etc/init.d/languard restart >/dev/null 2>&1
	fw4 reload >/dev/null 2>&1

	echo "luci-app-languard: open LuCI -> Network -> LAN Guard"
}
exit 0
