#!/usr/bin/lua
-- Make LuCI's login log name the real client when a trusted reverse proxy
-- (lucky, nginx, ...) sits in front of uhttpd.
--
-- uhttpd exports a fixed set of request headers to its handlers and neither
-- X-Forwarded-For nor X-Real-IP is in it, so the proxy writes the address into
-- X-HTTP-Method-Override instead. The value is only believed when that address
-- has a live conntrack entry: the proxy fills the header only when the client
-- left it empty, so a client could otherwise claim any address it likes.
--
-- Only the two syslog calls in session_setup change. Authentication, routing
-- and the UI are untouched, and the original file is kept next to it.
local TARGET = "/usr/share/ucode/luci/dispatcher.uc"
local ORIG = TARGET .. ".languard-orig"
-- the backup was named after the old package; adopt it on rename
local LEGACY_ORIG = TARGET .. ".clientblock-orig"
local MARKER = "real client address"

local HELPERS = [[
// languard: real client address behind a trusted reverse proxy.
function addr_has_connection(ip) {
	try {
		let ct = readfile('/proc/net/nf_conntrack') || '';
		let want = length(ip);

		for (let line in split(ct, '\n')) {
			// only the first src= of a line is the original direction; the
			// reply tuple names the peer and would match any host we talked to
			let i = index(line, 'src=');

			if (i < 0)
				continue;

			let after = substr(line, i + 4, want + 1);

			if (substr(after, 0, want) == ip && substr(after, want, 1) == ' ')
				return true;
		}
	}
	catch (e) { }

	return false;
}

function client_log_addr() {
	let addr = http.getenv('REMOTE_ADDR') || '?';

	if (addr == '?')
		return addr;

	try {
		let trusted = json(readfile('/etc/languard/trusted_proxies.json') || '{}');
		if (!trusted || !trusted[addr])
			return addr;

		// X-HTTP-Method-Override carries the address because uhttpd does not
		// export the forwarding headers; the others are kept for completeness.
		let real = http.getenv('HTTP_X_HTTP_METHOD_OVERRIDE');
		if (!real) {
			let fwd = http.getenv('HTTP_X_FORWARDED_FOR') || http.getenv('HTTP_X_REAL_IP');
			if (fwd) {
				let parts = split(fwd, ',');
				real = parts[length(parts) - 1];
			}
		}

		real = real ? trim(real) : null;
		if (real && match(real, /^[0-9a-fA-F:.]+$/) && addr_has_connection(real))
			return real;
	}
	catch (e) { }

	return addr;
}

function session_setup(user, pass, path) {]]

local OLD_IMPORT = "import { open, stat, glob, lsdir, unlink, basename } from 'fs';"
local NEW_IMPORT = "import { open, stat, glob, lsdir, unlink, basename, readfile } from 'fs';"

local function readf(p)
	local f = io.open(p, "r")
	if not f then return nil end
	local s = f:read("*a")
	f:close()
	return s
end

local function writef(p, s)
	local f = io.open(p, "w")
	if not f then return false end
	f:write(s)
	f:close()
	return true
end

local function already_patched(s)
	return s:find(MARKER, 1, true) ~= nil
end

if readf(LEGACY_ORIG) then
	os.remove(ORIG)
	os.rename(LEGACY_ORIG, ORIG)
end

local src = readf(ORIG)
if not src then
	local cur = readf(TARGET)
	if not cur then
		io.stderr:write("luci dispatcher not found\n")
		os.exit(1)
	end
	-- never adopt an already-patched file as the pristine copy
	if already_patched(cur) then
		io.write("already patched\n")
		os.exit(0)
	end
	writef(ORIG, cur)
	src = cur
end

if not src:find(OLD_IMPORT, 1, true) then
	if src:find("basename, readfile", 1, true) then
		-- import already carries readfile (a different LuCI revision)
	else
		io.stderr:write("unexpected dispatcher import line, leaving it alone\n")
		os.exit(1)
	end
else
	src = src:gsub(OLD_IMPORT, function() return NEW_IMPORT end, 1)
end

if not src:find("function session_setup(user, pass, path) {", 1, true) then
	io.stderr:write("session_setup not found, leaving it alone\n")
	os.exit(1)
end
src = src:gsub("function session_setup%(user, pass, path%) {", function() return HELPERS end, 1)

local calls = 0
src = src:gsub('http%.getenv%("REMOTE_ADDR"%) || "%?"', function()
	calls = calls + 1
	return "client_log_addr()"
end)

if calls ~= 2 then
	io.stderr:write(string.format("expected 2 call sites, found %d\n", calls))
	os.exit(1)
end

if not src:find("readfile('/proc/net/nf_conntrack')", 1, true) then
	io.stderr:write("self-check failed, not writing\n")
	os.exit(1)
end

if not writef(TARGET, src) then
	io.stderr:write("cannot write dispatcher\n")
	os.exit(1)
end

io.write(string.format("patched, %d call sites\n", calls))
os.exit(0)
