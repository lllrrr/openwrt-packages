# ---------------------------------------------------------------
# 路由规则 —— 严格按原 97 条的顺序
# ---------------------------------------------------------------
routing {
    # ---- 1. 显式直连域名(原 Custom_Direct 前置的 3 条 + 21 条自建) ----
    domain(suffix: pkg-containers.githubusercontent.com) -> direct
    domain(suffix: production.cloudfront.docker.com) -> direct
    domain(suffix: phimgood.com) -> direct
    domain(suffix: wbx2.com) -> direct
    domain(suffix: webex.com) -> direct
    domain(suffix: cisco.com) -> direct
    domain(suffix: ciscospark.com) -> direct
    domain(suffix: webexapis.com) -> direct
    domain(suffix: webexcontent.com) -> direct
    domain(suffix: druva.com) -> direct
    domain(suffix: box.com) -> direct
    domain(suffix: box.net) -> direct
    domain(suffix: boxcloud.com) -> direct
    domain(suffix: slack.com) -> direct
    domain(suffix: unpkg.com) -> direct
    domain(suffix: lrclib.net) -> direct
    domain(suffix: practice.rs) -> direct

    # ---- 2. 显式代理域名 ----
    domain(suffix: cloudflare.com) -> proxy
    domain(suffix: workbuddy.ai) -> proxy
    domain(suffix: codebuddy.ai) -> proxy

    # ---- 3. 关键词直连 ----
    domain(keyword: workbuddy) -> direct

    # ---- 4. 自建规则 ----
    domain(suffix: totheglory.im) -> direct
    domain(suffix: dpdns.org) -> proxy

    # ---- 5. 私网 ----
    domain(geosite: category-public-tracker) -> direct
    domain(geosite: private) -> direct
    dip(geoip: private) -> direct(must)

