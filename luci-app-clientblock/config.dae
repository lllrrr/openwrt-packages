# honk 配置 — 由当前 OpenClash 配置完整转换
#
# 来源: /etc/openclash/config/default.yaml 的 97 条运行时规则
#       + Custom_Direct(1098 域名/10 CIDR) + Custom_Proxy(17 域名/1 CIDR)
#       + Steam_CDN(3 域名/23 CIDR) + Custom_Port_Direct(非标端口)
#
# 规则顺序与原配置一致:先匹配先赢。
# 未启动:要生效需替换 /etc/honk/config.dae 并重启 honk。

global {
    wan_interface: auto
    lan_interface: br-lan
    log_level: info
    log_file: 'honk.log'
    # domain++ = 嗅探并按 SNI/Host 重新路由,对应 OpenClash 的 fake-ip 行为
    dial_mode: domain++
    auto_config_kernel_parameter: true
    data_dir: '/etc/honk/data'
    bootstrap_resolver: '223.5.5.5:53'
    store_subscribe: true
    nfqueue_enable: true
    tcp_check_url: 'https://www.gstatic.com/generate_204'
    tcp_check_http_method: HEAD
    check_interval: 300s
    check_tolerance: 50ms
}

# ---------------------------------------------------------------
# 订阅(两个源,与 OpenClash 一致)
# ---------------------------------------------------------------
subscription {
    wd: 'https://wd-turbo.com/subscribe/bavgbz-o_ne4wkx-PbFZ4qtO' {
        interval: 3600s
    }
    yuyun: 'https://yuyun.mhlnf.cn/yuyunsvip?token=62b447defada94b3f596203c9f7a2614#name=cloudfisher_provider' {
        interval: 3600s
    }
}

assets {
    subscription {
        ua: 'clash.meta'
    }
}

# ---------------------------------------------------------------
# 分组:一个规则分组 = 一个 honk 组,与原 OpenClash 分组一一对应
#
# 订阅里的 Traffic:/Expire: 是伪节点,所有组都排除它们。
# policy: min_moving_avg = 组内按延迟自动择优(对应 Smart-Select)
# policy: fixed(0)       = 固定第一个成员(对应 DIRECT)
# ---------------------------------------------------------------
group {
    # --- 直连组:对应 OpenClash 的 🎯 DIRECT / 🐟 Final / 🎮 Steam 等 ---
    direct_grp {
        filter: name('__never__')
        policy: fixed(0)
        final: direct
    }

    # --- 代理分组 ---
    proxy {
        # 🚀 PROXY / 🐟 Rule-Based / 🇺🇸 United States (Primary)
        filter: subtag('wd') && !name(keyword: 'Traffic') && !name(keyword: 'Expire')
        policy: min_moving_avg
        final: block
    }
    telegram {
        # 💬 Telegram —— 原配置指向香港节点
        filter: subtag('wd') && !name(keyword: 'Traffic') && !name(keyword: 'Expire') && name('Hong Kong')
        policy: min_moving_avg
        final: block
    }
    social {
        # 🌐 Social Media
        filter: subtag('wd') && !name(keyword: 'Traffic') && !name(keyword: 'Expire')
        policy: min_moving_avg
        final: block
    }
    chatgpt {
        # 🤖 ChatGPT —— 建议美国原生 IP
        filter: subtag('wd') && !name(keyword: 'Traffic') && !name(keyword: 'Expire') && name('United States')
        policy: min_moving_avg
        final: block
    }
    copilot {
        # 🤖 Copilot
        filter: subtag('wd') && !name(keyword: 'Traffic') && !name(keyword: 'Expire') && name('United States')
        policy: min_moving_avg
        final: block
    }
    ai {
        # 🤖 AI Services
        filter: subtag('wd') && !name(keyword: 'Traffic') && !name(keyword: 'Expire') && name('United States')
