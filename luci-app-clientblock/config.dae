    # ---- 11. GeoIP 应用分流 ----
    dip(geoip: telegram) -> telegram
    dip(geoip: twitter) -> social
    dip(geoip: facebook) -> social
    dip(geoip: google) -> google
    dip(geoip: netflix) -> netflix

    # ---- 12. 国内域名与地址直连 ----
    domain(geosite: cn) -> direct
    dip(geoip: cn) -> direct

    # ---- 13. 非标端口直连(80/443 之外) ----
    dport(1-79, 81-442, 444-65535) -> direct

    # ---- 14. 下载工具与代理进程直连 ----
    pname(aria2c) -> direct
    pname(BitComet) -> direct
    pname(fdm) -> direct
    pname(NetTransport) -> direct
    pname(qbittorrent) -> direct
    pname(Thunder) -> direct
    pname(transmission-daemon) -> direct
    pname(transmission-qt) -> direct
    pname(uTorrent) -> direct
    pname(WebTorrent) -> direct
    pname(Folx) -> direct
    pname(Transmission) -> direct
    pname(v2ray) -> direct
    pname(ss-local) -> direct
    pname(ssr-local) -> direct
    pname(ss-redir) -> direct
    pname(ssr-redir) -> direct
    pname(ss-server) -> direct
    pname(trojan-go) -> direct
    pname(xray) -> direct
    pname(hysteria) -> direct
    pname(singbox) -> direct
    pname(UUBooster) -> direct
    pname(uugamebooster) -> direct

    # ---- 15. 兜底:80/443 走 Final 组,其余直连 ----
    # 原配置 DstPort 80/443 -> 🐟 Final,而 Final 当前指向 DIRECT。
    # 这里直接写 direct,与你当前的实际行为一致。
    dport(80, 443) -> direct
    fallback: direct
}

# ---------------------------------------------------------------
# DNS —— 对应 OpenClash 的 fake-ip 模式
# ---------------------------------------------------------------
dns {
    ipversion_prefer: 4
    upstream {
        # 国内直连解析
        direct_dns: 'udp://223.5.5.5:53' -> direct
        # 国外经代理解析,避免污染
        proxy_doh: 'https://dns.google/dns-query' -> proxy
    }
    routing {
        request {
            qname(geosite: cn) -> direct_dns
            fallback: proxy_doh
        }
        response {
            fallback: accept
        }
    }
}

# ---------------------------------------------------------------
# Clash API 兼容层:languard 的流量统计与现有面板都能直接对接
# ---------------------------------------------------------------
experimental {
    clash_api {
        external_controller: '127.0.0.1:9090'
        secret: '991788'
        default_mode: 'Rule'
    }
    cache_file {
        enabled: true
        store_dns: true
    }
}
