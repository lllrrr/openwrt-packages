chain user_ip_input {
	type filter hook input priority -1; policy accept;
	ip saddr @blocked_ip4 counter drop comment "clientblock-ip-in"
}

chain user_ip_forward {
	type filter hook forward priority -1; policy accept;
	ip daddr @blocked_ip4 counter drop comment "clientblock-ip-out"
	ip saddr @blocked_ip4 counter drop comment "clientblock-ip-in"
}
