config shellinabox 'main'
	option enable '1'
	option port_min '4200'
	option port_max '4210'
	option ssl '0'
	option ssl_cert '/etc/shellinabox/certificate.pem'
	option no_beep '1'
	option css '/etc/shellinabox/white-on-black.css'
	option command '/bin/login'
	option uid '0'
	option gid '0'
	option cwd '/root'
