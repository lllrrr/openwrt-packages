msgid "Allow starting an on-demand ShellInABox terminal"
msgstr "允许按需启动 ShellInABox 终端"

msgid "Black on white"
msgstr "白底黑字"

msgid "CSS style"
msgstr "CSS 样式"

msgid "CGI port range (default: 4200-4210). Each terminal session listens on a separate port; the browser must be able to reach this range."
msgstr "CGI 端口范围（默认：4200-4210）。每个终端会话监听独立的端口，浏览器必须能够访问此范围内的端口。"

msgid "Command"
msgstr "命令"

msgid "Config"
msgstr "配置"

msgid "Enable"
msgstr "启用"

msgid "Enable ShellInABox SSL before using the terminal through HTTPS LuCI"
msgstr "通过 HTTPS LuCI 使用终端前，请先启用 ShellInABox SSL"

msgid "Forbidden"
msgstr "禁止访问"

msgid "Grant UCI access for luci-app-shellinabox"
msgstr "授予 luci-app-shellinabox 访问 UCI 配置的权限"

msgid "Group ID"
msgstr "组 ID"

msgid "Group id to run the command with (default: 0)"
msgstr "运行命令使用的组 ID（默认：0）"

msgid "Invalid ShellInABox configuration"
msgstr "ShellInABox 配置无效"

msgid "Maximum port"
msgstr "最大端口"

msgid "Maximum port must not be smaller than minimum port."
msgstr "最大端口不能小于最小端口。"

msgid "Minimum port"
msgstr "最小端口"

msgid "PEM file containing a certificate and an unencrypted traditional RSA private key. The default self-signed certificate is generated on the first HTTPS terminal launch. Open the terminal port separately to trust a self-signed certificate if needed."
msgstr "包含证书和未加密的传统格式 RSA 私钥的 PEM 文件。默认自签名证书会在首次通过 HTTPS 启动终端时生成。如需信任自签名证书，请单独访问终端端口并确认信任。"

msgid "SSL"
msgstr "SSL"

msgid "SSL cert"
msgstr "SSL 证书"

msgid "Select a bundled style or enter an absolute path to a CSS file on the router. Changes apply to new terminal sessions."
msgstr "选择内置样式或输入路由器上 CSS 文件的绝对路径。修改对新建的终端会话生效。"

msgid "ShellInABox default"
msgstr "ShellInABox 默认样式"

msgid "ShellInABox Instance"
msgstr "ShellInABox 实例"

msgid "ShellInABox is disabled"
msgstr "ShellInABox 已禁用"

msgid "ShellInABox is disabled. Enable it in Config and try again."
msgstr "ShellInABox 已禁用。请在“配置”页面启用后重试。"

msgid "Start terminal"
msgstr "启动终端"

msgid "Suppress all audio output"
msgstr "禁用所有声音输出"

msgid "Terminal"
msgstr "终端"

msgid "Unable to read the CSS style file"
msgstr "无法读取 CSS 样式文件"

msgid "Unable to prepare ShellInABox certificate"
msgstr "无法准备 ShellInABox 证书"

msgid "Unable to start ShellInABox; check the port range and certificate"
msgstr "无法启动 ShellInABox，请检查端口范围和证书"

msgid "Use an absolute CSS file path ending in .css, or select ShellInABox default."
msgstr "请使用以 .css 结尾的 CSS 文件绝对路径，或选择 ShellInABox 默认样式。"

msgid "Use an absolute directory path without colons or line breaks."
msgstr "请使用不含冒号或换行符的绝对目录路径。"

msgid "User ID"
msgstr "用户 ID"

msgid "User id to run the command with (default: 0)"
msgstr "运行命令使用的用户 ID（默认：0）"

msgid "White on black"
msgstr "黑底白字"

msgid "Working directory"
msgstr "工作目录"
