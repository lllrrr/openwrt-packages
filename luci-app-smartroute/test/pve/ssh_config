# smartroute PVE 测试环境：isp 走家里局域网的 v6 link-local（由 MAC EUI-64 推出），其余经 isp/router 跳转
Host lab-isp
  HostName fe80::5a:ff:fe00:101%%eth0
Host lab-router
  HostName 10.255.0.2
  ProxyJump lab-isp
  # r24 / r25 同一地址、主机密钥不同：不记录，否则切换后 ssh 拒绝经它跳转
  UserKnownHostsFile /dev/null
  LogLevel ERROR
Host lab-side
  HostName 192.168.99.3
  ProxyJump lab-router
Host lab-hosts
  User alpine
  HostName fe80::5a:ff:fe00:500%%br-lan
  ProxyJump lab-router
Host lab-*
  User root
  IdentityFile ~/.ssh/lab_ed25519
  UserKnownHostsFile ~/.ssh/lab_known_hosts
  StrictHostKeyChecking no
  ConnectTimeout 8
