# 智能分流。配置项说明见 docs/PRD.md；mark_mask 与 table_base 避开了 OpenClash / nikki / HomeProxy / PassWall 的常用值
config global 'main'
	option enabled '0'
	option interface 'br-lan'
	option ipv6 '1'
	option mark_mask '0x1f000000'
	option table_base '3100'
	option idle_timeout '600'
	option dns_keep '300'
	option update_hour '4'
	option geosite_url 'https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat'
	option geoip_url 'https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat'
