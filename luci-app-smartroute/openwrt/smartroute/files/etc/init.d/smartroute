#!/bin/sh /etc/rc.common
# 智能分流后台：未启用时不启动；配置变更时向运行中的进程发 SIGHUP（不打断已有连接），否则重启
START=95
STOP=10
USE_PROCD=1
PROG=/usr/bin/smartroute

sr_enabled() {
	config_load smartroute
	config_get_bool en main enabled 0
	[ "$en" = 1 ]
}

start_service() {
	sr_enabled || return 0
	procd_open_instance
	procd_set_param command "$PROG" run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 15
	procd_close_instance
}

reload_service() {
	if sr_enabled && [ -s /var/run/smartroute.pid ] && kill -0 "$(cat /var/run/smartroute.pid)" 2>/dev/null; then
		kill -HUP "$(cat /var/run/smartroute.pid)"
	else
		stop 2>/dev/null
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger smartroute
}
