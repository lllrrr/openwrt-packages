#!/bin/sh

# Copyright (C) 2006 OpenWrt.org
# Copyright (C) 2026 rule2c <rule2c@gmail.com>

NAME=netcontrol
LOG_FILE="/var/log/netcontrol.log"
DEBUG=0

# RAM 运行目录（频繁读写）
DURATION_DIR="/var/lib/netcontrol"
# 持久化目录（重启后保留）
PERSIST_DIR="/etc/netcontrol"

DURATION_DB="$DURATION_DIR/duration.db"
CONNECTION_LOG="$DURATION_DIR/connections.log"
STATUS_FILE="$DURATION_DIR/device_status.tsv"

IDLIST="/var/$NAME.idlist"
TARGETLIST="/var/$NAME.targets"
# 与 netcontrol reset-duration 共用的 duration.db 写锁
DB_LOCK="/var/lock/netcontrol-db.lock"

# ─── 日志 ────────────────────────────────────────────────────────────────────

dbg() {
    [ "$DEBUG" -eq 1 ] && {
        local d; d="$(date '+%Y-%m-%d %H:%M:%S')"
        echo "[$d] CTRL-DEBUG: $*" >> "$LOG_FILE"
    }
}

info() {
    local d; d="$(date '+%Y-%m-%d %H:%M:%S')"
    echo "[$d] CTRL-INFO: $*" >> "$LOG_FILE"
}

# ─── 配置读取 ─────────────────────────────────────────────────────────────────

# device 段的标量字段读每轮刷新的缓存（见 refresh_device_cache）。comment 含空格会
# 破坏缓存的记录格式，故不入缓存，与 netcontrol 段一同回落到 uci；缓存里查不到 id
# 时同样回落。
config_t_get() {
    local index="${3:-0}" ret="" rec n=""
    if [ "$1" = "device" ]; then
        case "$2" in
            target)     n=2 ;;
            enable)     n=3 ;;
            time_mode)  n=4 ;;
            week)       n=5 ;;
            timestart)  n=6 ;;
            timeend)    n=7 ;;
            duration)   n=8 ;;
            reset_cycle) n=9 ;;
        esac
        if [ -n "$n" ]; then
            for rec in $DEVICE_CACHE; do
                [ "${rec%%|*}" = "$index" ] || continue
                ret="$rec"
                while [ "$n" -gt 1 ]; do ret="${ret#*|}"; n=$((n - 1)); done
                ret="${ret%%|*}"
                # 命中即返回：字段为空代表该选项没配，直接给默认值。不能因为空就回落
                # 到 uci——period 模式本就没有 duration/reset_cycle，会每轮白跑一次 exec。
                echo "${ret:-$4}"
                return
            done
        fi
    fi
    ret="$(uci -q get "${NAME}.@${1}[${index}].${2}")"
    echo "${ret:-$4}"
}

# ─── 工具函数 ─────────────────────────────────────────────────────────────────

target_key() { printf '%s' "$1" | sed 's/[^A-Za-z0-9_.-]/_/g'; }

# 总开关是否开启
master_enabled() { [ "$(config_t_get netcontrol enabled 0 0)" = "1" ]; }

# 拆除整张 nftables 表（总开关关闭时调用，幂等）
teardown_firewall() {
    command -v nft >/dev/null 2>&1 || return 0
    nft list table inet netcontrol >/dev/null 2>&1 || return 0
    nft delete table inet netcontrol 2>/dev/null
}

# ─── Duration DB ─────────────────────────────────────────────────────────────

db_delete_target() {
    local tmp="$DURATION_DB.$$"
    [ -f "$DURATION_DB" ] || return 0
    awk -F, -v t="$1" '$1!=t' "$DURATION_DB" > "$tmp" && mv "$tmp" "$DURATION_DB"
    rm -f "$tmp"
}

# ─── Connection Log ───────────────────────────────────────────────────────────

last_connection_action() {
    awk -F, -v t="$1" '$2==t{action=$3} END{print action}' "$CONNECTION_LOG" 2>/dev/null
}

# 按行数截断日志：超过 max 行时只保留最新 keep 行。
# 用 tail+mv 换文件而非原地截断——两个脚本都是 >> 追加（每次重新打开），
# 没有长期持有的 fd，换 inode 不会写到旧文件里去。
_rotate_log_file() {
    local file="$1" max="$2" keep="$3" count tmp
    count=$(wc -l < "$file" 2>/dev/null) || return
    if [ "$count" -gt "$max" ]; then
        tmp="${file}.$$"
        tail -n "$keep" "$file" > "$tmp" && mv "$tmp" "$file"
        rm -f "$tmp"
        dbg "日志已轮转：$file ${count} 行 → ${keep} 行"
    fi
}

_rotate_connection_log() { _rotate_log_file "$CONNECTION_LOG" 2000 1000; }

# 主日志同样要有上限：它在 tmpfs 上，且 netcontrol 与本进程都往里写，
# 长期运行不封顶会吃内存。
_rotate_main_log() { _rotate_log_file "$LOG_FILE" 2000 1000; }

# ─── 持久化 ───────────────────────────────────────────────────────────────────

# 内容没变就不写：PERSIST_DIR 在 /etc（overlay，落在闪存上），而 duration.db 只在
# 在线状态翻转或周期重置时才变，无条件写等于无谓的闪存磨损。
sync_persist() {
    mkdir -p "$PERSIST_DIR" || return
    {
        flock 9 2>/dev/null
        cmp -s "$DURATION_DB" "$PERSIST_DIR/duration.db" 2>/dev/null || \
            cp "$DURATION_DB" "$PERSIST_DIR/duration.db" 2>/dev/null
    } 9>"$DB_LOCK"
    for f in "$DURATION_DIR"/last_reset_*; do
        [ -f "$f" ] || continue
        cmp -s "$f" "$PERSIST_DIR/${f##*/}" 2>/dev/null || cp "$f" "$PERSIST_DIR/" 2>/dev/null
    done
    dbg "上网时长数据已同步至持久化存储"
}

# ─── 目录初始化 ───────────────────────────────────────────────────────────────

init_dirs() {
    mkdir -p "$DURATION_DIR" "$PERSIST_DIR" /var/lock
    touch "$DURATION_DB" "$CONNECTION_LOG" "$STATUS_FILE" "$IDLIST" "$TARGETLIST" 2>/dev/null

    # 从持久化目录恢复数据。**只在运行时账本不存在或为空时恢复**：那才是真正重启过
    # 路由器（/var 是 tmpfs，重启必空）。若每次启动都无条件覆盖，仅仅重启一次服务就会
    # 把账本回滚到上一次持久化的时刻——而持久化只在每 10 轮 / 周期重置 / SIGTERM 时
    # 发生，且守护进程大半时间阻塞在 sleep，ash 的 trap 要等当前命令结束才执行，procd
    # 默认 5 秒后就 SIGKILL，退出时那次 sync_persist 基本跑不到。
    # 回滚不止是丢数据：last_connect 被拉回旧值后，之后第一次 disconnect 会用旧起点算
    # ts - lc，把回滚窗口里的**离线**时间也一并计入配额（实测多算了 62 秒）。
    if [ ! -s "$DURATION_DB" ] && [ -s "$PERSIST_DIR/duration.db" ]; then
        cp "$PERSIST_DIR/duration.db" "$DURATION_DB"
        dbg "运行时账本为空（应为重启后），已从持久化存储恢复上网时长数据"
    fi
    for f in "$PERSIST_DIR"/last_reset_*; do
        [ -f "$f" ] && cp "$f" "$DURATION_DIR/" 2>/dev/null
    done
}

reset_runtime_state() {
    rm -f "$IDLIST" "$TARGETLIST"
    touch "$IDLIST" "$TARGETLIST" 2>/dev/null
}

# ─── SIGTERM 优雅退出 ─────────────────────────────────────────────────────────

_on_sigterm() {
    info "收到终止信号，正在保存数据，请稍候..."
    sync_persist
    exit 0
}
trap '_on_sigterm' TERM INT

# ─── 设备规则查询 ─────────────────────────────────────────────────────────────

# 设备规则缓存，每轮刷新一次，之后所有规则查询纯靠 shell 变量展开，零进程派生。
# get_rules_for_target 一轮里会被调用多次（update / allow 或 block / clear_idlist），
# 若每次都去查 uci，派生数是设备数的平方级。
#
# 记录格式（字段顺序必须与 config_t_get 的字段号映射一致）：
#     id|target|enable|time_mode|week|timestart|timeend|duration|reset_cycle
# 记录之间用空格分隔，以便直接 for 遍历而不必改 IFS。comment 是自由文本、可能含
# 空格，会撑破这个格式，故不入缓存。
DEVICE_CACHE=""

refresh_device_cache() {
    DEVICE_CACHE="$(uci -q show "$NAME" 2>/dev/null | awk -v q="'" '
        /\.@device\[[0-9]+\]/ {
            idx = $0; sub(/^[^[]*\[/, "", idx); sub(/\].*$/, "", idx)
            if (!(idx in seen)) { seen[idx] = 1; order[++n] = idx }
            if ($0 !~ /\]\./) next                 # 段头行 xxx.@device[N]=device
            key = $0; sub(/^[^]]*\]\./, "", key); sub(/=.*$/, "", key)
            val = $0; sub(/^[^=]*=/, "", val)
            if (substr(val, 1, 1) == q) val = substr(val, 2, length(val) - 2)
            # 含空格或 | 的值一律丢弃：前者破坏记录间的分隔，后者破坏字段间的分隔，
            # 都会让后续字段整体错位。丢弃后 config_t_get 取到空值并回落到默认值。
            # 前端校验不放行这两种字符，只有命令行 uci set 才可能写进来。
            if (val ~ /[ |]/) next
            f[idx, key] = val
        }
        END {
            split("target enable time_mode week timestart timeend duration reset_cycle", cols, " ")
            for (i = 1; i <= n; i++) {
                id = order[i]
                rec = id
                for (c = 1; c <= 8; c++) rec = rec "|" ((id, cols[c]) in f ? f[id, cols[c]] : "")
                printf "%s ", rec
            }
        }')"
}

get_all_devices() {
    local rec
    for rec in $DEVICE_CACHE; do echo "${rec%%|*}"; done
}

get_rules_for_target() {
    local target="$1" enabled_only="${2:-0}"
    local rec rest rule_target enabled

    for rec in $DEVICE_CACHE; do
        rest="${rec#*|}"                 # target|enable|...
        rule_target="${rest%%|*}"
        [ "$rule_target" = "$target" ] || continue
        if [ "$enabled_only" = "1" ]; then
            rest="${rest#*|}"            # enable|...
            enabled="${rest%%|*}"
            [ "$enabled" = "1" ] || continue
        fi
        echo "${rec%%|*}"
    done
}

get_enabled_rules_for_target() { get_rules_for_target "$1" 1; }

get_all_targets() {
    local rec rest target
    for rec in $DEVICE_CACHE; do
        rest="${rec#*|}"; target="${rest%%|*}"
        [ -n "$target" ] && echo "$target"
    done
    [ -f "$TARGETLIST" ] && awk -F'\t' 'NF>=3{print $3}' "$TARGETLIST"
}

get_blocked_id_for_target() {
    [ -f "$TARGETLIST" ] || return 0
    awk -F'\t' -v t="$1" '$3==t{print $2;exit}' "$TARGETLIST"
}

delete_blocked_target_state() {
    local tmp="$TARGETLIST.$$"
    [ -f "$TARGETLIST" ] || return 0
    awk -F'\t' -v t="$1" '$3!=t' "$TARGETLIST" > "$tmp" && mv "$tmp" "$TARGETLIST"
    rm -f "$tmp"
}

set_blocked_target_state() {
    local key; key="$(target_key "$1")"
    delete_blocked_target_state "$1"
    printf '%s\t%s\t%s\n' "$key" "$2" "$1" >> "$TARGETLIST"
}

clear_idlist_for_target() {
    local target="$1" id blocked_id
    [ -f "$IDLIST" ] || return 0
    blocked_id="$(get_blocked_id_for_target "$target")"
    [ -n "$blocked_id" ] && sed -i "/!${blocked_id}!/d" "$IDLIST" 2>/dev/null
    for id in $(get_rules_for_target "$target" 0); do
        sed -i "/!${id}!/d" "$IDLIST" 2>/dev/null
    done
}

# ─── 防火墙状态查询 ───────────────────────────────────────────────────────────

ensure_firewall_ready() {
    command -v nft >/dev/null 2>&1 || return 1
    nft list table inet netcontrol >/dev/null 2>&1 && return 0
    # 表缺失才重建。但关总开关时 init.d 会先删表再由 procd 终止本进程，
    # 这中间若本进程仍在跑会把刚删的表又建回来，留下无人维护的孤儿表。
    # 故重建前确认总开关仍开启（uci 在 reload 前已提交，关闭时这里读到 0）。
    [ "$(config_t_get netcontrol enabled 0 0)" = "1" ] || return 1
    netcontrol start >/dev/null 2>&1
}

# MAC 正则必须大小写兼容，不能依赖先转小写：BusyBox 的 tr 可能未编译字符类支持，
# [:upper:] 会被当成普通字符集，大写 MAC 原样通过并被判成 ipv6，于是查错集合、
# 每轮重复拦截而界面始终显示放行中。
target_type() {
    if printf '%s' "$1" | grep -qE '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'; then
        echo "mac"
    elif printf '%s' "$1" | grep -q ':'; then
        echo "ipv6"
    else
        echo "ipv4"
    fi
}

# 邻居表项"距上次被用来发帧"的秒数，取该设备所有合格表项里最小的；拿不到则输出空。
#
# ip -s neigh 的输出形如：
#   192.168.1.100 dev br-lan lladdr 00:11:22:33:44:55  used 42/42/40probes 1 STALE
# 三元组是 used/confirmed/updated。注意第三个数字和 probes 之间没有空格，所以只能
# 定位 "used" 这个词再按 "/" 切，不能靠数空格字段。
# BusyBox 精简版的 ip 不支持 -s，输出里没有 used 字段，此时返回空串，
# 由 target_online 回落到表项存在性判定。
#
# 两类表项必须排除，否则 used 会被路由器自己的管家流量刷新，判定恒为在线：
#   1. fe80:: 链路本地地址——上面跑的是 RA / NS / DHCPv6 / mDNS，与设备是否上网无关。
#   2. 带 router 标志的表项（按 MAC 汇总时）——邻居发过 RA 就会被打上该标志，内核
#      随后对它做周期性可达性探测，探测本身就刷新 used，而设备待机时网口仍活着照样
#      回应。实测某智能电视因发 RA 导致三个 v6 地址全带 router 标志，遥控关机后
#      fe80 那条的 used 长期在 100 秒上下打转，把诚实的 IPv4 表项（用了 400 多秒
#      没动）压了下去，已用时长通宵不停增长。
#      只在按 MAC 汇总时排除：那时还有 IPv4 表项兜底；直接按某个 IPv6 地址配的目标
#      要是也排除，就没有任何表项可用了。
# _neigh_idle 在「ip -s 可用、但该设备一条合格表项都没有」时输出的哨兵值：远大于
# 任何真实空闲秒数，语义是"查不到用网痕迹"。可以据此判离线，但**不能**拿它当真实
# 空闲时长去回拨记账时刻（见 track_online_state）。
NEIGH_IDLE_UNKNOWN=999999

_neigh_idle() {
    local key="$1" bymac="$2"
    ip -s neigh show 2>/dev/null | awk -v k="$key" -v bymac="$bymac" -v unknown="$NEIGH_IDLE_UNKNOWN" '
        /(^| )used / { seen = 1 }
        /FAILED|INCOMPLETE/ { next }
        tolower($1) ~ /^fe80:/ { next }
        {
            if (bymac == "1") {
                if (index(tolower($0), k) == 0) next
                for (i = 1; i < NF; i++) if ($i == "router") next
            }
            else if ($1 != k) next
            for (i = 1; i < NF; i++)
                if ($i == "used") {
                    split($(i + 1), a, "/"); v = a[1] + 0
                    if (best == "" || v < best) best = v
                    break
                }
        }
        # 有 used 字段说明 ip 支持 -s，此时"一条合格表项都没有"是有意义的结论：
        # 设备的真实上网地址早已没有流量，判离线。输出远大于阈值的哨兵而不是空串——
        # 空串会让调用方回落到"表项存在即在线"，那正是本函数要规避的误判。
        END { if (best != "") print best; else if (seen) print unknown }'
}

# 空闲多久算下线。要大于守护进程的最长轮询间隔（60 秒），避免设备只是短暂没流量
# 就被判离线导致计时忽走忽停；又要远小于设备关机后邻居表项的存活时间。
ONLINE_IDLE_MAX=300

# 设备是否正在上网。
#
# 首选 ip -s neigh 的 used 空闲秒数：邻居表项每次被用来向该设备发帧就清零，有流量
# 就接近 0。这是唯一能区分"正在用网"和"表项还在但设备早关了"的信号——表项存在
# （哪怕 flags=0x2）只说明路由器知道它的 MAC，而设备待机时网口通常仍活着（WoL /
# 投屏唤醒），表项能赖十几个小时，据此计时会把整个待机时段算进配额。
#
# 不能按邻居状态（REACHABLE/STALE）判断：设备正在下载时表项会在
# STALE → DELAY → PROBE → REACHABLE 之间循环，10~60 秒采样很容易正好采到 STALE，
# 反而漏掉真正在用网的时段。
#
# 拿不到 used 时回落到表项存在性或 conntrack 判定。
# CIDR / IP 范围无法逐主机判定，一律视为在线。
# target_online 把本次测到的空闲秒数留在这里，供 track_online_state 回拨记账时刻。
# 走回落判定（BusyBox 的 ip 不支持 -s）或目标是网段/范围时置空，表示无从得知。
ONLINE_IDLE=''

target_online() {
    local target="$1" lc idle
    ONLINE_IDLE=''
    case "$(target_type "$target")" in
        mac)
            lc="$(printf '%s' "$target" | tr 'A-Z' 'a-z')"
            idle="$(_neigh_idle "$lc" 1)"
            [ -n "$idle" ] && { ONLINE_IDLE="$idle"; [ "$idle" -le "$ONLINE_IDLE_MAX" ]; return $?; }
            awk -v m="$lc" 'NR>1 && tolower($4)==m && $3!="0x0"{f=1} END{exit(f?0:1)}' /proc/net/arp 2>/dev/null && return 0
            ip neigh show 2>/dev/null | grep -Fi "lladdr $lc" | grep -qv FAILED
            ;;
        ipv6)
            case "$target" in */*) return 0 ;; esac
            idle="$(_neigh_idle "$target" 0)"
            [ -n "$idle" ] && { ONLINE_IDLE="$idle"; [ "$idle" -le "$ONLINE_IDLE_MAX" ]; return $?; }
            ip -6 neigh show 2>/dev/null | awk -v t="$target" '$1==t && $0!~/FAILED/{f=1} END{exit(f?0:1)}' && return 0
            grep -qF "src=$target " /proc/net/nf_conntrack 2>/dev/null
            ;;
        *)
            case "$target" in */*|*-*) return 0 ;; esac
            idle="$(_neigh_idle "$target" 0)"
            [ -n "$idle" ] && { ONLINE_IDLE="$idle"; [ "$idle" -le "$ONLINE_IDLE_MAX" ]; return $?; }
            awk -v t="$target" 'NR>1 && $1==t && $3!="0x0"{f=1} END{exit(f?0:1)}' /proc/net/arp 2>/dev/null && return 0
            grep -qF "src=$target " /proc/net/nf_conntrack 2>/dev/null
            ;;
    esac
}

# 按在线状态推进计时：在线且未计时→记 connect 开始累计；离线且在计时→记
# disconnect 冻结累计。切忌一放行就无条件记 connect——那样设备不在线也扣时长，
# 每日重置后会退化成“每天 0 点起的前 N 分钟可上网”。
track_online_state() {
    local target="$1" last
    last="$(last_connection_action "$target")"
    # 这两条走 info 而非 dbg：DEBUG 默认关闭时，“时长不增加”类问题在日志里将无迹
    # 可循。只在状态翻转时打印，不是每轮一条，量可控。
    if target_online "$target"; then
        [ "$last" != "connect" ] && {
            record_connection_time "$target" "connect"
            info "$target 已在线，开始累计上网时长"
        }
    else
        [ "$last" = "connect" ] && {
            # 判离线的条件是"空闲已超过 ONLINE_IDLE_MAX"，所以走到这里时，设备距最后
            # 一次真正用网已经过去 ONLINE_IDLE 秒。按当前时刻记 disconnect 会把这段纯
            # 空闲算进配额——实测待机电视一次 77 秒的遥测心跳被记成 428 秒，八成是空的。
            # 迟滞窗口是为了防抖动（设备短暂停顿不该被判离线），不该同时充当计时；
            # 因此把记账时刻回拨到最后一次用网的时刻。
            # 拿不到空闲秒数（BusyBox 回落判定）或拿到的是哨兵值（表项已消失，无从
            # 得知真实时刻）时，按迟滞窗口本身回拨，不做更激进的猜测。
            local now back
            now="$(date +%s)"
            back="$ONLINE_IDLE"
            case "$back" in ''|*[!0-9]*) back="$ONLINE_IDLE_MAX" ;; esac
            [ "$back" -ge "$NEIGH_IDLE_UNKNOWN" ] && back="$ONLINE_IDLE_MAX"
            record_connection_time "$target" "disconnect" "$((now - back))"
            info "$target 已离线，暂停累计上网时长（回拨 ${back} 秒空闲时间）"
        }
    fi
}

# 用 nft get element 精确查询而非 grep 文本输出：nft 存储时会做规范化
# （192.168.10.10/24 → 192.168.10.0/24、2001:0db8::1 → 2001:db8::1），
# grep 原始输入永远匹配不到，导致每轮误判未拦截而重复 add、状态表显示错误。
# get element 对查询值做同样的规范化，且地址落在已拦截网段内也算命中；表或集合
# 不存在时它直接失败，无需另做存在性预检。
target_in_firewall() {
    local target="$1" lc
    command -v nft >/dev/null 2>&1 || return 1
    case "$(target_type "$target")" in
        mac)
            lc="$(printf '%s' "$target" | tr 'A-Z' 'a-z')"
            nft get element inet netcontrol blacklist_mac "{ $lc }" >/dev/null 2>&1
            ;;
        ipv6) nft get element inet netcontrol blacklist6 "{ $target }" >/dev/null 2>&1 ;;
        *)    nft get element inet netcontrol blacklist  "{ $target }" >/dev/null 2>&1 ;;
    esac
}

delete_target_from_firewall() {
    local target="$1" type lc
    command -v nft >/dev/null 2>&1 || return 0
    nft list table inet netcontrol >/dev/null 2>&1 || return 0
    type="$(target_type "$target")"
    case "$type" in
        mac)
            lc="$(printf '%s' "$target" | tr 'A-Z' 'a-z')"
            nft delete element inet netcontrol blacklist_mac "{ $lc }" 2>/dev/null
            ;;
        ipv6) nft delete element inet netcontrol blacklist6  "{ $target }" 2>/dev/null ;;
        *)    nft delete element inet netcontrol blacklist   "{ $target }" 2>/dev/null ;;
    esac
}

# ─── 时间检查 ─────────────────────────────────────────────────────────────────

is_time_in_range() {
    local start="$1" end="$2" cur; cur="$(date +%H:%M)"
    if [ "$start" = "$end" ]; then
        return 0
    elif [ "$start" \< "$end" ]; then
        { [ "$cur" = "$start" ] || [ "$cur" = "$end" ] || \
          { [ "$cur" \> "$start" ] && [ "$cur" \< "$end" ]; }; } && return 0
    else
        { [ "$cur" = "$start" ] || [ "$cur" = "$end" ] || \
          [ "$cur" \> "$start" ] || [ "$cur" \< "$end" ]; } && return 0
    fi
    return 1
}

is_weekday_in_range() {
    local wdays="$1" cur; cur="$(date +%u)"
    [ "$wdays" = "0" ] && return 0
    # 前后补逗号后用 case 子串匹配，省掉 tr 与子 shell（wdays 形如 "1,2,3,4,5"）
    case ",$wdays," in *",$cur,"*) return 0 ;; esac
    return 1
}

# ─── 时长管理 ─────────────────────────────────────────────────────────────────

# 第三个参数可指定记账时刻（默认取当前时间）：判离线时要回拨到设备最后一次真正
# 用网的时刻，见 track_online_state。
record_connection_time() {
    local target="$1" action="$2" ts_override="$3"
    local ts tmp
    ts="${ts_override:-$(date +%s)}"
    tmp="$DURATION_DB.$$"

    # 两个分支各用一次 awk 就地改写整个 db，避免在锁里反复 fork。记录改写在原位而非
    # 追加到末尾，查询不依赖顺序。
    if [ "$action" = "connect" ]; then
        {
            flock 9 2>/dev/null
            awk -F, -v OFS=, -v t="$target" -v ts="$ts" '
                $1 == t { print t, ts, ($3 == "" ? 0 : $3), ($4 == "" ? 0 : $4); found = 1; next }
                        { print }
                END     { if (!found) print t, ts, 0, 0 }
            ' "$DURATION_DB" > "$tmp" 2>/dev/null && mv "$tmp" "$DURATION_DB"
            rm -f "$tmp"
        } 9>"$DB_LOCK"
        printf '%s,%s,connect\n' "$ts" "$target" >> "$CONNECTION_LOG"
        return 0
    fi

    if [ "$action" = "disconnect" ]; then
        [ "$(last_connection_action "$target")" = "connect" ] || return 0
        {
            flock 9 2>/dev/null
            # 目标不在 db 里时不补写：没有起算点就无从计算这段时长
            # 增量允许为负：ts 被回拨后，若这段空闲期里 checkpoint 已经把时间落进
            # total，就要在这里扣回来，否则回拨白做。总数夹在 0 以上兜住异常。
            awk -F, -v OFS=, -v t="$target" -v ts="$ts" '
                $1 == t {
                    lc = ($2 == "" ? ts : $2); tc = ($3 == "" ? 0 : $3); lr = ($4 == "" ? 0 : $4)
                    tot = tc + (ts - lc); if (tot < 0) tot = 0
                    print t, ts, tot, lr; next
                }
                { print }
            ' "$DURATION_DB" > "$tmp" 2>/dev/null && mv "$tmp" "$DURATION_DB"
            rm -f "$tmp"
        } 9>"$DB_LOCK"
        printf '%s,%s,disconnect\n' "$ts" "$target" >> "$CONNECTION_LOG"
    fi
}

# 单次 awk 同时读 duration.db 和 connections.log 得出已用秒数。
# 合成一次 awk 而非"查存在 + 取字段 + 查最后动作"分开跑：本函数每个目标每轮会被
# 调用两次（check_device_control 一次、write_status_file 一次）。
# 用 FILENAME 而非 FNR==NR 区分两个文件：duration.db 为空时 FNR==NR 会把
# connections.log 的行误当成 db 记录。
# 把正在计时的目标"已过但尚未落账"的秒数并进 total，并把 last_connect 推到当前。
#
# total 只在 disconnect 时更新，中间时段靠 now - last_connect 现算，而 connections.log
# 位于 /var（tmpfs）重启即失。若不落账，重启后 last_action 为空、那段时长直接蒸发——
# 重启一次路由器配额就归零，是可以随手绕过的漏洞。
#
# 落账前后 used 不变（total 增加多少，now - last_connect 就减少多少），不会重复计数。
# 每 10 轮一次，重启最多丢约 10 分钟；代价是计时期间 duration.db 每 10 轮变一次，
# sync_persist 会因此真的写一次闪存，空闲时仍然一次都不写。
checkpoint_connection_time() {
    local target="$1" ts tmp
    [ "$(last_connection_action "$target")" = "connect" ] || return 0
    ts="$(date +%s)"
    tmp="$DURATION_DB.$$"
    {
        flock 9 2>/dev/null
        awk -F, -v OFS=, -v t="$target" -v ts="$ts" '
            $1 == t {
                lc = ($2 == "" ? ts : $2); tc = ($3 == "" ? 0 : $3); lr = ($4 == "" ? 0 : $4)
                sd = ts - lc; if (sd < 0) sd = 0
                print t, ts, tc + sd, lr; next
            }
            { print }
        ' "$DURATION_DB" > "$tmp" 2>/dev/null && mv "$tmp" "$DURATION_DB"
        rm -f "$tmp"
    } 9>"$DB_LOCK"
}

get_connection_time() {
    local target="$1" now r
    now="$(date +%s)"
    r="$(awk -F, -v t="$target" -v now="$now" -v db="$DURATION_DB" '
        FILENAME == db { if ($1 == t) { lc = $2; tc = $3; found = 1 } ; next }
        $2 == t        { act = $3 }
        END {
            if (!found) { print 0; exit }
            if (lc == "") lc = now
            if (tc == "") tc = 0
            if (act == "connect") { sd = now - lc; if (sd < 0) sd = 0; tc += sd }
            printf "%d\n", tc
        }' "$DURATION_DB" "$CONNECTION_LOG" 2>/dev/null)"
    echo "${r:-0}"
}

# epoch → 格式化日期，兼容 GNU date 和 BusyBox date
_epoch_fmt() {
    local ts="$1" fmt="$2" r
    r="$(date -d "@$ts" "$fmt" 2>/dev/null)"
    [ -n "$r" ] && { echo "$r"; return; }
    r="$(date -D "%s" -d "$ts" "$fmt" 2>/dev/null)"
    [ -n "$r" ] && { echo "$r"; return; }
    awk -v ts="$ts" -v f="${fmt#+}" 'BEGIN{print strftime(f,ts+0)}' 2>/dev/null || echo "0"
}

should_reset_duration() {
    local target="$1" cycle="$2"
    local rf="$DURATION_DIR/last_reset_$(target_key "$target")"
    [ ! -f "$rf" ] && return 0
    local lr; lr="$(cat "$rf" 2>/dev/null)"
    case "$cycle" in
        daily)   [ "$(_epoch_fmt "$lr" +%Y%m%d)" != "$(date +%Y%m%d)" ] ;;
        weekly)  [ "$(_epoch_fmt "$lr" +%Y%W)"   != "$(date +%Y%W)"   ] ;;
        monthly) [ "$(_epoch_fmt "$lr" +%Y%m)"   != "$(date +%Y%m)"   ] ;;
        *)       false ;;
    esac
}

reset_duration_counter() {
    local target="$1" cycle="$2"
    local now key
    now="$(date +%s)"
    key="$(target_key "$target")"

    # 重置时立刻持久化（重置周期长，写盘次数极少）
    mkdir -p "$PERSIST_DIR"
    {
        flock 9 2>/dev/null
        db_delete_target "$target"
        printf '%s,%s,0,%s\n' "$target" "$now" "$now" >> "$DURATION_DB"
        echo "$now" > "$DURATION_DIR/last_reset_$key"
        cp "$DURATION_DB" "$PERSIST_DIR/duration.db" 2>/dev/null
        cp "$DURATION_DIR/last_reset_$key" "$PERSIST_DIR/" 2>/dev/null
    } 9>"$DB_LOCK"

    info "已重置 $target 的上网时长（重置周期：$cycle）"
}

# ─── 动态 sleep 计算 ──────────────────────────────────────────────────────────
# 找出最快触达时长上限的设备，以其剩余秒数作为唤醒间隔（范围：10 ~ 60 秒）

calc_sleep_seconds() {
    local min=60 id target time_mode duration used_sec remaining
    for id in $(get_all_devices); do
        [ "$(config_t_get device enable "$id" "0")" = "1" ] || continue
        time_mode="$(config_t_get device time_mode "$id" "period")"
        [ "$time_mode" = "duration" ] || [ "$time_mode" = "combined" ] || continue
        target="$(config_t_get device target "$id")"
        [ "$(last_connection_action "$target")" = "connect" ] || continue
        duration="$(config_t_get device duration "$id" "60")"
        used_sec="$(get_connection_time "$target")"
        remaining=$(( duration * 60 - used_sec ))
        [ "$remaining" -gt 5 ] && [ "$remaining" -lt "$min" ] && min=$remaining
    done
    [ "$min" -lt 10 ] && min=10
    echo "$min"
}

# ─── 设备状态文件 ─────────────────────────────────────────────────────────────
# 格式：target\tblocked\tused_min\tmax_min\tcomment\tenabled\ttime_mode

write_status_file() {
    local tmp="$STATUS_FILE.$$"
    local id target comment enabled blocked used_min max_min time_mode used_sec
    : > "$tmp"
    for id in $(get_all_devices); do
        target="$(config_t_get device target    "$id")"
        [ -n "$target" ] || continue
        comment="$(config_t_get device comment "$id" "")"
        # 去除可能破坏 TSV 列对齐的制表符/换行符
        comment="$(printf '%s' "$comment" | tr -d '\t\n\r')"
        enabled="$(config_t_get device enable  "$id" "0")"
        time_mode="$(config_t_get device time_mode "$id" "period")"

        if target_in_firewall "$target" 2>/dev/null; then blocked=1; else blocked=0; fi

        # 时间段模式没有时长维度，输出 "-" 而非 0/上限，避免界面显示一个永不增长的
        # “已用 0 分钟”，看起来像计时卡死。
        used_min="-"; max_min="-"
        if [ "$time_mode" = "duration" ] || [ "$time_mode" = "combined" ]; then
            used_sec="$(get_connection_time "$target")"
            used_min=$((used_sec / 60))
            max_min="$(config_t_get device duration "$id" "60")"
        fi

        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$target" "$blocked" "$used_min" "$max_min" "$comment" "$enabled" "$time_mode" \
            >> "$tmp"
    done
    mv "$tmp" "$STATUS_FILE"
}

# ─── 控制逻辑 ─────────────────────────────────────────────────────────────────

check_device_control() {
    local id="$1" target time_mode weekdays start end duration cycle used_sec used_min max_min

    target="$(config_t_get device target       "$id")"
    time_mode="$(config_t_get device time_mode "$id" "period")"
    weekdays="$(config_t_get device week    "$id" "0")"

    # 周期重置必须先于星期/时段判断：重置是计数器自身的周期属性，跟设备此刻是否被
    # 允许上网无关。若放在时段判断之后，像 09:00-23:59 这种窗口在 00:00~09:00 之间
    # 根本走不到重置，界面会一直停在昨天用满的数值且处于拦截中；星期不匹配的日子
    # 同理整天不重置。
    # 同一目标配多条规则时会重复走到这里，但重置后 last_reset 即为当天，本周期内
    # 不会再次触发，幂等。
    case "$time_mode" in
        duration|combined)
            cycle="$(config_t_get device reset_cycle "$id" "daily")"
            should_reset_duration "$target" "$cycle" && reset_duration_counter "$target" "$cycle"
            ;;
    esac

    is_weekday_in_range "$weekdays" || { dbg "当前星期不在允许范围，拒绝 $target 上网"; return 1; }

    case "$time_mode" in
        period)
            start="$(config_t_get device timestart "$id" "00:00")"
            end="$(config_t_get device timeend   "$id" "00:00")"
            is_time_in_range "$start" "$end" || { dbg "当前时间不在允许时段（$start-$end），拒绝 $target 上网"; return 1; }
            dbg "当前时间在允许时段内，放行 $target"; return 0
            ;;
        duration)
            duration="$(config_t_get device duration "$id" "60")"
            used_sec="$(get_connection_time "$target")"
            used_min=$((used_sec / 60)); max_min="$duration"
            dbg "时长检查：$target 已用 ${used_min} 分钟，上限 ${max_min} 分钟"
            [ "$used_min" -ge "$max_min" ] && { dbg "$target 已超出上网时长限制"; return 1; }
            track_online_state "$target"
            dbg "$target 时长未超出，允许上网"; return 0
            ;;
        combined)
            start="$(config_t_get device timestart "$id" "00:00")"
            end="$(config_t_get device timeend   "$id" "00:00")"
            is_time_in_range "$start" "$end" || { dbg "当前时间不在允许时段，拒绝 $target 上网"; return 1; }
            # 组合模式一律叠加时长限制，不设单独的启用开关：关掉的话本模式与"时间段
            # 控制"完全等价、纯属冗余，还会造成填了时长却不计时的困惑。
            duration="$(config_t_get device duration "$id" "60")"
            used_sec="$(get_connection_time "$target")"
            used_min=$((used_sec / 60)); max_min="$duration"
            [ "$used_min" -ge "$max_min" ] && { dbg "$target 虽在允许时段内，但已超出时长上限"; return 1; }
            track_online_state "$target"
            dbg "$target 在允许时段内，放行上网"; return 0
            ;;
        *)
            start="$(config_t_get device timestart "$id" "00:00")"
            end="$(config_t_get device timeend   "$id" "00:00")"
            is_time_in_range "$start" "$end"; return $?
            ;;
    esac
}

target_allowed_by_any_rule() {
    local target="$1" id
    for id in $(get_enabled_rules_for_target "$target"); do
        if check_device_control "$id"; then
            dbg "$target 命中放行规则（规则 ID=$id）"; return 0
        fi
    done
    dbg "$target 未命中任何放行规则，执行拦截"; return 1
}

target_really_blocked() {
    local blocked_id; blocked_id="$(get_blocked_id_for_target "$1")"
    [ -n "$blocked_id" ] || return 1
    [ -f "$IDLIST" ] || return 1
    grep -q "!${blocked_id}!" "$IDLIST" 2>/dev/null || return 1
    target_in_firewall "$1"; return $?
}

allow_target() {
    local target="$1" id blocked_id had=0
    blocked_id="$(get_blocked_id_for_target "$target")"
    [ -n "$blocked_id" ] && had=1
    target_in_firewall "$target" && had=1
    if [ -f "$IDLIST" ]; then
        for id in $(get_rules_for_target "$target" 0); do
            grep -q "!${id}!" "$IDLIST" 2>/dev/null && { had=1; break; }
        done
    fi
    if [ "$had" -eq 0 ]; then
        clear_idlist_for_target "$target"
        delete_blocked_target_state "$target"
        return 0
    fi
    [ -n "$blocked_id" ] && netcontrol del "$blocked_id" >/dev/null 2>&1
    delete_target_from_firewall "$target"
    clear_idlist_for_target "$target"
    delete_blocked_target_state "$target"
    info "已恢复 $target 的上网权限"
}

block_target() {
    local target="$1" id
    id="$(get_enabled_rules_for_target "$target" | sed -n '1p')"
    [ -n "$id" ] || { dbg "$target 应被拦截但无已启用规则，自动放行"; allow_target "$target"; return 0; }
    target_really_blocked "$target" && { dbg "$target 已在防火墙中拦截，无需重复操作"; return 0; }
    ensure_firewall_ready
    if ! target_in_firewall "$target"; then
        dbg "将 $target 加入防火墙拦截（规则 ID=$id）"
        netcontrol add "$id" >/dev/null 2>&1
    else
        dbg "$target 已在防火墙中，同步更新状态记录（规则 ID=$id）"
    fi
    grep -q "!${id}!" "$IDLIST" 2>/dev/null || echo "!${id}!" >> "$IDLIST"
    set_blocked_target_state "$target" "$id"
    info "已限制 $target 的上网权限"
    record_connection_time "$target" "disconnect"
}

update_target_status() {
    local target="$1" ids
    ids="$(get_enabled_rules_for_target "$target")"
    if [ -z "$ids" ]; then
        dbg "$target 无已启用规则，放行上网"
        allow_target "$target"; return 0
    fi
    if target_allowed_by_any_rule "$target"; then allow_target "$target"
    else block_target "$target"
    fi
}

# ─── 主循环 ───────────────────────────────────────────────────────────────────

main_loop() {
    local loop_count=0 targets target

    info "时间控制守护进程已启动"
    init_dirs
    reset_runtime_state

    while :; do
        # 每轮开头刷新一次设备缓存，本轮内所有规则查询都读它（见 refresh_device_cache）。
        # 必须放在总开关分支之前：关闭态下 write_status_file 也要遍历设备。
        refresh_device_cache

        # 总开关：关闭时立即清除所有拦截规则与运行时状态后空转，
        # 不依赖 init.d/procd 能否可靠停掉本进程（其在各版本行为不一）。
        if ! master_enabled; then
            dbg "总开关已关闭：清除所有拦截规则，空转等待"
            teardown_firewall
            reset_runtime_state
            write_status_file
            sleep 10
            continue
        fi

        dbg "开始检查各设备的上网控制规则"
        targets="$(get_all_targets)"

        if [ -z "$targets" ]; then
            dbg "暂无上网控制目标，等待配置"
            write_status_file
            sleep 60
            continue
        fi

        echo "$targets" | sort -u | while IFS= read -r target; do
            [ -n "$target" ] || continue
            update_target_status "$target"
        done

        loop_count=$((loop_count + 1))
        if [ $((loop_count % 10)) -eq 0 ]; then
            _rotate_connection_log
            _rotate_main_log
            # 先把在计时的目标落账再持久化，否则存进 /etc 的 total 永远是上一次
            # disconnect 时的旧值，重启后这中间的时长全部丢失
            echo "$targets" | sort -u | while IFS= read -r target; do
                [ -n "$target" ] && checkpoint_connection_time "$target"
            done
            sync_persist
        fi

        write_status_file
        sleep "$(calc_sleep_seconds)"
    done
}

main_loop
