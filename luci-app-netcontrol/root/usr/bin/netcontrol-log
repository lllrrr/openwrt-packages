#!/bin/sh

# 时间控制日志查看工具

NAME=netcontrol
LOG_FILE="/var/log/$NAME.log"
CONNECTION_LOG="/var/lib/$NAME/connections.log"

show_realtime_log() {
    echo "正在显示实时日志，按 Ctrl+C 退出..."
    echo ""
    # 用 printf 输出转义序列，确保在 BusyBox ash 下生效。
    # 分类用 case 通配而非 echo|grep，避免每行 fork。
    tail -f "$LOG_FILE" | while IFS= read -r line; do
        case "$line" in
            *失败*|*错误*)      printf '\033[1;31m%s\033[0m\n' "$line" ;;  # 红：失败/错误
            *已恢复*)           printf '\033[1;32m%s\033[0m\n' "$line" ;;  # 绿：恢复上网
            *已限制*|*已重置*)  printf '\033[1;33m%s\033[0m\n' "$line" ;;  # 黄：限制/重置
            *)                  printf '%s\n' "$line" ;;
        esac
    done
}

show_connection_log() {
    echo "设备连接记录:"
    echo "────────────────────────────────────────────────────────────────────"
    echo "时间                 设备             状态"
    echo "────────────────────────────────────────────────────────────────────"
    if [ ! -f "$CONNECTION_LOG" ]; then
        echo "暂无连接记录"
        return
    fi
    # 由 read 按 IFS=, 直接拆列，省掉每行数次 cut 的进程开销
    tail -n 20 "$CONNECTION_LOG" | while IFS=, read -r timestamp target action; do
        time_str=$(date -d "@$timestamp" '+%Y-%m-%d %H:%M:%S' 2>/dev/null) || time_str=""
        case "$action" in
            connect)    action="上线" ;;
            disconnect) action="下线" ;;
        esac
        printf '%-20s %-18s %s\n' "${time_str:-$timestamp}" "$target" "$action"
    done
}

show_help() {
    echo "时间控制日志查看工具"
    echo ""
    echo "用法: netcontrol-log {realtime|connections|help}"
    echo ""
    echo "  realtime     实时显示日志（彩色高亮）"
    echo "  connections  显示设备连接记录"
    echo "  help         显示此帮助"
}

case "$1" in
    realtime)    show_realtime_log ;;
    connections) show_connection_log ;;
    help|"")     show_help ;;
    *)           echo "未知命令: $1"; show_help; exit 1 ;;
esac
