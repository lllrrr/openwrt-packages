# 仓库里的可执行位已经是 755，这里只是兜底：某些打包/同步方式会丢权限位
chmod +x /etc/init.d/netcontrol /usr/bin/netcontrol /usr/bin/netcontrolctrl \
         /usr/bin/netcontrol-log /usr/libexec/netcontrol-call 2>/dev/null

# 兜底：conffile 正常会带上默认配置，万一缺失就补一份最小可用的
[ -s /etc/config/netcontrol ] || cat > /etc/config/netcontrol <<'DEFCFG'
config netcontrol
	option enabled '0'
	option chain 'forward'
	option rand_mac_block '0'
DEFCFG

# ── 从旧包 luci-app-timecontrol 迁移 ──────────────────────────────────────────
# 配置节名和 device 段的地址字段都变了（mac -> target）。uci-defaults 只执行一次，
# 执行后自身被删除，不需要额外的“已迁移”标记。
migrate_from_timecontrol() {
    [ -f /etc/config/timecontrol ] || return 0
    # 新配置里已经有设备规则，说明用户已经自行配过，不覆盖
    uci -q get netcontrol.@device[0] >/dev/null 2>&1 && return 0

    local v idx=0
    for v in enabled chain; do
        local ov; ov="$(uci -q get "timecontrol.@timecontrol[0].$v")"
        [ -n "$ov" ] && uci -q set "netcontrol.@netcontrol[0].$v=$ov"
    done

    while [ -n "$(uci -q get "timecontrol.@device[$idx]")" ]; do
        uci -q add netcontrol device >/dev/null
        for v in comment enable time_mode timestart timeend duration reset_cycle week; do
            local ov; ov="$(uci -q get "timecontrol.@device[$idx].$v")"
            [ -n "$ov" ] && uci -q set "netcontrol.@device[-1].$v=$ov"
        done
        # 字段改名：旧 mac 承载的其实是任意目标地址
        local ot; ot="$(uci -q get "timecontrol.@device[$idx].mac")"
        [ -n "$ot" ] && uci -q set "netcontrol.@device[-1].target=$ot"
        idx=$((idx + 1))
    done
    uci -q commit netcontrol

    # 已累计的上网时长一并搬过来。记录以目标地址为键，地址没变，直接复制即可。
    [ -d /etc/timecontrol ] && [ ! -d /etc/netcontrol ] && cp -r /etc/timecontrol /etc/netcontrol 2>/dev/null

    # 停掉旧服务并取消自启：两套规则同时跑会互相拆对方的 nftables 表
    [ -x /etc/init.d/timecontrol ] && {
        /etc/init.d/timecontrol stop 2>/dev/null
        /etc/init.d/timecontrol disable 2>/dev/null
    }
    logger -t netcontrol "已从 luci-app-timecontrol 迁移 $idx 条设备规则"
}
migrate_from_timecontrol

# 注册开机自启（init 脚本会按 uci 里的总开关自行决定是否真的加载规则）
/etc/init.d/netcontrol enable 2>/dev/null

# 让 LuCI 的“保存并应用”能触发本服务 reload
uci -q batch <<-EOF >/dev/null
	delete ucitrack.@netcontrol[-1]
	add ucitrack netcontrol
	set ucitrack.@netcontrol[-1].init=netcontrol
	commit ucitrack
EOF

/etc/init.d/rpcd restart
rm -f /tmp/luci-indexcache /tmp/luci-modulecache/* 2>/dev/null
exit 0
