#!/bin/sh /etc/rc.common

#
# Copyright (C) 2026 rule2c <rule2c@gmail.com>
#

START=99
USE_PROCD=1

# service_state 供 LuCI 判断状态；用自定义命令名避开部分版本 rc.common 内置 status 的覆盖。
EXTRA_COMMANDS="status service_state"
EXTRA_HELP="	status         显示守护进程运行状态（running/stopped）
	service_state  显示服务综合状态（running/disabled/stopped），供 LuCI 使用"

NAME=netcontrol
IDLIST="/var/$NAME.idlist"
TARGETLIST="/var/$NAME.targets"

tc_enabled() { [ "$(uci -q get ${NAME}.@${NAME}[0].enabled 2>/dev/null)" = "1" ]; }

cleanup_runtime_state() {
	rm -f "$IDLIST" "$TARGETLIST" 2>/dev/null
}

# 服务综合状态：running=开关开且进程存活 / disabled=开关关闭 / stopped=开关开但进程已退出。
# 开关关闭时守护进程仍空转，故不能仅凭进程存在判定为运行中。
service_state() {
	tc_enabled || { echo "disabled"; return; }
	if pgrep -f netcontrolctrl >/dev/null 2>&1 || ps w 2>/dev/null | grep -q '[n]etcontrolctrl'; then
		echo "running"
	else
		echo "stopped"
	fi
}

# CLI status：输出状态并以退出码反映是否运行中
status() {
	local st; st="$(service_state)"
	echo "$st"
	[ "$st" = "running" ]
}

start_instance() {
	procd_open_instance
	procd_set_param command /usr/bin/netcontrolctrl
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

# 守护进程必须无条件注册：实例只能在 start_service 里注册（rc.common 的 reload
# 不经 rc_procd 包裹，procd_open_instance 的数据提交不上去）。daemon 在总开关
# 关闭时自行空转，常驻无副作用。
start_service() {
	if tc_enabled; then
		netcontrol start
	else
		netcontrol stop
		cleanup_runtime_state
	fi
	start_instance
}

# 配置变更触发。只维护防火墙表状态，不做进程级操作。启用时仅在表缺失才装载：
# 无条件 start 会 flush 整表，已生效的拦截要等 daemon 下一轮才恢复。
reload_service() {
	if tc_enabled; then
		nft list table inet netcontrol >/dev/null 2>&1 || netcontrol start
	else
		netcontrol stop
		cleanup_runtime_state
	fi
}

service_triggers() {
	procd_add_reload_trigger 'netcontrol'
}

stop_service() {
	# 进程由 procd 终止（勿用 killall，会触发 respawn），这里只清规则与运行时文件
	netcontrol stop
	cleanup_runtime_state
}
