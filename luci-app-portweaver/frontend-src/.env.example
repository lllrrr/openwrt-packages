# SSH连接配置
SSH_HOST=192.168.1.1
SSH_PORT=22
SSH_USERNAME=root

# 认证方式1: 使用密码
SSH_PASSWORD=your_password

# 认证方式2: 使用私钥 (如果设置了私钥，将优先使用私钥)
# SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa
# SSH_PASSPHRASE=your_passphrase_if_needed

# 远程目标路径
SSH_REMOTE_PATH=/www/luci-static/resources/view/portweaver

# 本地编译输出路径（相对于项目根目录）
LOCAL_DIST_PATH=../htdocs/luci-static/resources/view/portweaver

# OpenAI 翻译配置 (由 luci-types 提供 i18n 翻译功能时使用)
OPENAI_API_KEY=your_api_key_here
# 可选的自定义 API 端点 (例如 Ollama, DeepSeek 等兼容 OpenAI 格式的接口)
# OPENAI_API_URL=https://api.openai.com/v1
# 可选使用的 OpenAI 模型 (默认: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

