{
	"luci-app-portweaver": {
		"description": "Grant UCI and ubus access for LuCI PortWeaver app",
		"read": {
			"file": {
				"/tmp/portweaver.log": [
					"read"
				],
				"/etc/init.d/portweaver": [
					"exec"
				],
				"/usr/bin/portweaver": [
					"exec"
				]
			},
			"uci": [
				"portweaver"
			],
			"ubus": {
				"portweaver": [
					"get_full_status",
					"get_rathole_status",
					"get_rathole_info",
					"get_frps_info",
					"get_frpc_info",
					"get_ddns_status",
					"get_ddns_info",
					"get_frpc_proxy_stats",
					"get_frps_proxy_stats",
					"list_projects",
					"get_nftables_rules",
					"read_frp_config",
					"validate_frp_config",
					"wol_status"
				]
			}
		},
		"write": {
			"file": {
				"/tmp/portweaver.log": [
					"write"
				]
			},
			"uci": [
				"portweaver"
			],
			"ubus": {
				"uci": [
					"commit"
				],
				"portweaver": [
					"set_enabled",
					"clear_frpc_logs",
					"clear_rathole_logs",
					"clear_ddns_logs",
					"clear_frps_logs",
					"reload_config",
					"restart_project",
					"write_frp_config",
					"wol_wake"
				]
			}
		}
	}
}
