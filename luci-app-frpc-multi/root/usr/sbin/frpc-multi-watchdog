#!/bin/sh
# Every minute (cron): start any enabled frpc-multi connection that is not running.
# Covers the case where procd gave up or the service was never started.
. /lib/functions.sh

SVC=${FRPCM_SERVICE:-frpc-multi}

mkdir -p /var/lock
exec 9>/var/lock/$SVC-watchdog.lock
flock -n 9 || exit 0

[ -x /etc/init.d/$SVC ] || exit 0
/etc/init.d/$SVC enabled || exit 0

config_load frpc_multi
config_get g_enabled global enabled 1
config_get g_watchdog global watchdog 1
[ "$g_enabled" = 1 ] && [ "$g_watchdog" = 1 ] || exit 0

STATE="$(ubus call service list "{\"name\":\"$SVC\"}" 2>/dev/null)"

check() {
	local sid="$1" enabled addr running
	config_get enabled "$sid" enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get addr "$sid" server_addr
	[ -n "$addr" ] || return 0
	# jsonfilter needs double-quoted keys (single quotes are not supported)
	running="$(echo "$STATE" | jsonfilter -e "@[\"$SVC\"].instances[\"$sid\"].running" 2>/dev/null)"
	if [ "$running" != "true" ]; then
		logger -t frpc-multi-watchdog "$sid not running, starting"
		/etc/init.d/$SVC start "$sid"
	fi
}
config_foreach check server
