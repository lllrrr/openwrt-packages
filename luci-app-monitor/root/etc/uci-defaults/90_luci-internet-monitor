#!/bin/sh

UCI="${INTERNET_MONITOR_UCI:-uci}"
RPCD_INIT="${INTERNET_MONITOR_RPCD_INIT:-/etc/init.d/rpcd}"
CACHE_DIR="${INTERNET_MONITOR_CACHE_DIR:-/tmp}"
changed=0
defaults_revision="$("$UCI" -q get internet-monitor.global.defaults_revision 2>/dev/null)"
case "$defaults_revision" in ''|*[!0-9]*) defaults_revision=0 ;; esac

has_target_address() {
	"$UCI" -q show internet-monitor 2>/dev/null |
		grep -Fq ".address='$1'"
}

add_https_target() {
	target_section="$1"
	target_name="$2"
	target_address="$3"

	"$UCI" -q get "internet-monitor.$target_section" >/dev/null 2>&1 && return 0
	has_target_address "$target_address" && return 0

	"$UCI" -q set "internet-monitor.$target_section=target" || return 1
	"$UCI" -q set "internet-monitor.$target_section.enabled=1" || return 1
	"$UCI" -q set "internet-monitor.$target_section.name=$target_name" || return 1
	"$UCI" -q set "internet-monitor.$target_section.type=http" || return 1
	"$UCI" -q set "internet-monitor.$target_section.address=$target_address" || return 1
	"$UCI" -q set "internet-monitor.$target_section.family=ipv4" || return 1
	"$UCI" -q set "internet-monitor.$target_section.timeout=6" || return 1
	"$UCI" -q set "internet-monitor.$target_section.expected_codes=200" || return 1
	changed=1
}

if [ "$defaults_revision" -lt 1 ]; then
	add_https_target \
		'alidns_https' \
		'AliDNS HTTPS' \
		'https://dns.alidns.com/dns-query?dns=AAABAAABAAAAAAAAB2V4YW1wbGUDY29tAAABAAE' || exit 1
	add_https_target \
		'dnspod_https' \
		'DNSPod HTTPS' \
		'https://doh.pub/dns-query?dns=AAABAAABAAAAAAAAB2V4YW1wbGUDY29tAAABAAE' || exit 1
	"$UCI" -q set internet-monitor.global.defaults_revision=1 || exit 1
	changed=1
fi

if [ "$changed" -eq 1 ]; then
	"$UCI" -q commit internet-monitor || exit 1
fi

rm -f "$CACHE_DIR"/luci-indexcache.*
rm -rf "$CACHE_DIR"/luci-modulecache/
"$RPCD_INIT" reload 2>/dev/null || true

exit 0
