config global 'global'
	option enabled '1'
	option interval '60'
	option timeout '5'
	option failure_threshold '3'
	option recovery_threshold '2'
	option quorum '2'
	option history_days '30'
	option defaults_revision '1'

config target 'cloudflare_icmp'
	option enabled '1'
	option name 'Cloudflare IPv4'
	option type 'icmp'
	option address '1.1.1.1'
	option family 'ipv4'
	option timeout '3'

config target 'alidns_icmp'
	option enabled '1'
	option name 'AliDNS IPv4'
	option type 'icmp'
	option address '223.5.5.5'
	option family 'ipv4'
	option timeout '3'

config target 'alidns_https'
	option enabled '1'
	option name 'AliDNS HTTPS'
	option type 'http'
	option address 'https://dns.alidns.com/dns-query?dns=AAABAAABAAAAAAAAB2V4YW1wbGUDY29tAAABAAE'
	option family 'ipv4'
	option timeout '6'
	option expected_codes '200'

config target 'dnspod_https'
	option enabled '1'
	option name 'DNSPod HTTPS'
	option type 'http'
	option address 'https://doh.pub/dns-query?dns=AAABAAABAAAAAAAAB2V4YW1wbGUDY29tAAABAAE'
	option family 'ipv4'
	option timeout '6'
	option expected_codes '200'

config target 'openwrt_https'
	option enabled '1'
	option name 'OpenWrt HTTPS'
	option type 'http'
	option address 'https://openwrt.org/'
	option family 'auto'
	option timeout '6'
	option expected_codes '200-399'

config target 'cloudflare_https'
	option enabled '1'
	option name 'Cloudflare HTTPS'
	option type 'http'
	option address 'https://1.1.1.1/cdn-cgi/trace'
	option family 'ipv4'
	option timeout '6'
