#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034,SC3043

USE_PROCD=1
START=95
STOP=10

PROG=/usr/libexec/internet-monitor/daemon

start_service() {
	local enabled

	config_load internet-monitor
	config_get_bool enabled global enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	# Allow the bounded probe round to finish so the daemon can flush events.
	procd_set_param term_timeout 70
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger internet-monitor
}
