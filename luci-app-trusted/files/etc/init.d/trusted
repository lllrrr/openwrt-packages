#!/bin/sh /etc/rc.common
#
# luci-app-trusted - passwordless LuCI / terminal / SSH for whitelisted IPs.
#
# Firewall: a standalone "table inet trusted", loaded in one nft transaction
# and removed with "nft delete table".  It is deliberately *not* an
# /etc/nftables.d include, because:
#   * a bad line there aborts the whole fw4 ruleset (no firewall at all),
#   * fw4 reloads flush the NSS/ECM flow table, so every toggle would briefly
#     disturb traffic that has nothing to do with this plugin,
#   * fw4 never removes a chain it no longer knows about, which used to leave
#     empty chains behind after the plugin was switched off.
#
# The three options are independent: each one only writes the rules for its
# own ports.

START=99
STOP=90
USE_PROCD=1

WRAPPER=/usr/share/trusted/cgi-luci.wrapper
CGI=/www/cgi-bin/luci
STOCK=/usr/share/trusted/cgi-luci.stock
RUN=/var/run/trusted

LAN_IF=br-lan

# Passwordless terminal: a second ttyd, bound to the LAN interface only.
TERM_PORT=7682

# Passwordless SSH: a second dropbear (-B = allow blank passwords) plus a
# uid 0 account with an empty password hash.  Whitelisted clients are
# redirected from :22 to this port, which is only bound to the LAN address.
# The account's shell is a guard script, because busybox login accepts blank
# passwords too and the stock ttyd / serial console is reachable by everyone.
SSH_PORT=2222
SSH_USER=trusted
SSH_SHELL=/usr/share/trusted/ssh-shell
SHELLS_FILE=/etc/shells

TABLE=trusted

log() { logger -t trusted "$*"; }

# ------------------------------------------------------------- whitelist ---

# The validator lives in a shared file so that /usr/sbin/trusted gives the
# shell user exactly the same verdict as the firewall below.  If that file is
# missing the package is broken: accept everything instead of rejecting every
# entry, because "everything invalid" leaves only 127.0.0.1 in the set and,
# with the deny switch on, locks every LAN client out.  A malformed value that
# gets through is still caught by the "nft -c" check in build_table.
. /usr/share/trusted/lib.sh 2>/dev/null
if ! command -v valid_cidr4 >/dev/null 2>&1; then
	log "lib.sh missing, whitelist validation disabled"
	valid_cidr4() { return 0; }
fi

# /var/run/trusted/wl holds the effective whitelist, one entry per line.  It
# is read by the CGI wrapper (hot path) and by the ruleset generator.
collect_wl() {
	local ip tmp="$RUN/.wl.$$"

	: > "$tmp" || return 1
	echo "127.0.0.1" >> "$tmp"

	if [ "$(uci -q get trusted.global.enabled)" = "1" ]; then
		for ip in $(uci -q get trusted.global.ipaddr 2>/dev/null); do
			if valid_cidr4 "$ip"; then
				grep -qxF "$ip" "$tmp" || echo "$ip" >> "$tmp"
			else
				log "ignoring invalid whitelist entry '$ip' (IPv4 or IPv4/CIDR only)"
			fi
		done
	fi

	mv -f "$tmp" "$RUN/wl"
}

# The CGI wrapper must not trust a stale copy: it is sourced from a 0700
# root-owned directory, and it is rewritten on every (re)start.
write_state() {
	{
		echo "TRUSTED_ENABLED=1"
		if deny_active; then
			echo "TRUSTED_DENY=1"
		else
			echo "TRUSTED_DENY=0"
		fi
	} > "$RUN/state"
	chmod 0600 "$RUN/state"
}

# ---------------------------------------------------------------- feature ---

term_active() {
	[ "$(uci -q get trusted.global.enabled)" = "1" ] || return 1
	[ "$(uci -q get trusted.global.term_enabled)" = "1" ] || return 1
	[ -x /etc/init.d/ttyd ] && [ -x /usr/bin/ttyd ] || return 1
	[ -n "$LAN_ADDR" ]
}

ssh_active() {
	[ "$(uci -q get trusted.global.enabled)" = "1" ] || return 1
	[ "$(uci -q get trusted.global.ssh_enabled)" = "1" ] || return 1
	[ -x /usr/sbin/dropbear ] || return 1
	[ -x "$SSH_SHELL" ] || return 1
	[ -n "$LAN_ADDR" ] || return 1
	# needs the -B (allow blank password) flag
	/usr/sbin/dropbear -h 2>&1 | grep -q 'Allow blank password'
}

deny_active() {
	[ "$(uci -q get trusted.global.enabled)" = "1" ] || return 1
	[ "$(uci -q get trusted.global.deny_others)" = "1" ]
}

lan_addr() {
	ip -4 -o addr show dev "$LAN_IF" 2>/dev/null |
		awk '{ print $4 }' | cut -d/ -f1 | head -1
}

# A port held by a foreign process would make procd respawn forever, so the
# feature is skipped (and logged) instead of being started blindly.  A ttyd /
# dropbear listener on our port is our own previous instance during a
# restart and is not considered foreign.
port_usable() {
	local holder

	holder=$(netstat -ltnp 2>/dev/null | awk -v p=":$1\$" '$4 ~ p { print $NF; exit }')

	case "$holder" in
	''|*ttyd|*dropbear) return 0 ;;
	esac

	log "port $1 is held by \"$holder\", skipping"
	return 1
}

# ------------------------------------------------------------ ssh account ---

# Replace a system file in one atomic rename.  The old code rewrote
# /etc/passwd through a cat, which leaves a truncated authentication database
# behind if the power goes away mid-write.
rewrite_file() {
	local f="$1" regex="$2" tmp="$1.trusted-tmp" mode

	mode=$(stat -c %a "$f" 2>/dev/null)
	mode=${mode:-644}

	grep -v "$regex" "$f" > "$tmp" 2>/dev/null || return 1
	chmod "$mode" "$tmp" 2>/dev/null
	mv -f "$tmp" "$f" || { rm -f "$tmp"; return 1; }
}

add_ssh_account() {
	if ! grep -q "^$SSH_USER:" /etc/passwd 2>/dev/null; then
		echo "$SSH_USER:x:0:0:Trusted whitelist (passwordless SSH):/root:$SSH_SHELL" >> /etc/passwd
		if [ -f /etc/shadow ]; then
			echo "$SSH_USER::0:0:99999:7:::" >> /etc/shadow
		fi
	fi

	# dropbear refuses a login shell that is not listed here
	# ("User '%s' has invalid shell, rejected").
	if [ -f "$SHELLS_FILE" ] && ! grep -qx "$SSH_SHELL" "$SHELLS_FILE"; then
		echo "$SSH_SHELL" >> "$SHELLS_FILE"
	fi
}

del_ssh_account() {
	grep -q "^$SSH_USER:" /etc/passwd 2>/dev/null && rewrite_file /etc/passwd "^$SSH_USER:"
	[ -f /etc/shadow ] && grep -q "^$SSH_USER:" /etc/shadow 2>/dev/null && rewrite_file /etc/shadow "^$SSH_USER:"
	[ -f "$SHELLS_FILE" ] && grep -qxF "$SSH_SHELL" "$SHELLS_FILE" && rewrite_file "$SHELLS_FILE" "^$SSH_SHELL\$"

	return 0
}

# ---------------------------------------------------------------- firewall ---

unload_table() {
	nft delete table inet "$TABLE" 2>/dev/null
	return 0
}

# Render and load the ruleset.  The generated file is validated before it is
# loaded, so a mistake in here can never leave the router with a half-applied
# or invalid firewall.  The caller (start_service) treats a failure as "do not
# start the passwordless daemons at all".
build_table() {
	local term ssh deny elems f="$RUN/rules.nft"

	term=$(term_active && echo 1)
	ssh=$(ssh_active && echo 1)
	deny=$(deny_active && echo 1)

	if [ -z "$term" ] && [ -z "$ssh" ] && [ -z "$deny" ]; then
		unload_table
		return 0
	fi

	[ -f "$RUN/wl" ] || return 1

	elems=$(tr '\n' ',' < "$RUN/wl" | sed 's/,$//')

	# Port gates.  The accept rule is IPv4-only (the whitelist is IPv4); the
	# drop rule is not family-restricted, so the passwordless ports stay
	# closed over IPv6 as well - those two daemons have no source check of
	# their own.
	{
		echo "table inet $TABLE {"
		echo "	set wl4 {"
		echo "		type ipv4_addr"
		echo "		flags interval"
		echo "		elements = { $elems }"
		echo "	}"
		echo "	chain input {"
		echo "		type filter hook input priority filter - 1; policy accept;"
		echo "		iifname \"lo\" accept"
		if [ -n "$term" ]; then
			echo "		ip saddr @wl4 tcp dport $TERM_PORT accept"
			echo "		tcp dport $TERM_PORT drop"
		fi
		if [ -n "$ssh" ]; then
			echo "		ip saddr @wl4 tcp dport $SSH_PORT accept"
			echo "		tcp dport $SSH_PORT drop"
		fi
		if [ -n "$deny" ]; then
			# Web interface and the stock (password) terminal.  IPv6 is
			# left alone here: the whitelist is IPv4, and the CGI wrapper
			# answers 403 to any address it cannot match.
			echo "		ip saddr @wl4 tcp dport { 80, 443, $MAIN_PORT } accept"
			echo "		meta nfproto ipv4 tcp dport { 80, 443, $MAIN_PORT } drop"
		fi
		echo "	}"
		if [ -n "$term" ] || [ -n "$ssh" ]; then
			echo "	chain prerouting {"
			echo "		type nat hook prerouting priority dstnat - 5; policy accept;"
			[ -n "$term" ] && echo "		ip saddr @wl4 tcp dport $MAIN_PORT redirect to :$TERM_PORT"
			[ -n "$ssh" ] && echo "		ip saddr @wl4 tcp dport 22 redirect to :$SSH_PORT"
			echo "	}"
		fi
		echo "}"
	} > "$f" || return 1

	if ! nft -c -f "$f" 2>"$RUN/nft.err"; then
		log "generated ruleset rejected: $(head -2 "$RUN/nft.err" | tr '\n' ' ')"
		return 1
	fi

	# delete+add in one transaction: nft keeps no stale chain behind and the
	# switch is atomic from the kernel's point of view.
	if nft list table inet "$TABLE" >/dev/null 2>&1; then
		{ echo "delete table inet $TABLE"; cat "$f"; } > "$RUN/load.nft"
		nft -f "$RUN/load.nft" || { log "failed to load ruleset"; return 1; }
	else
		nft -f "$f" || { log "failed to load ruleset"; return 1; }
	fi
}

# -------------------------------------------------------------- cgi shim ---

# The live CGI is replaced by a small shell wrapper that execs the stashed
# stock script.  No upstream code is copied, so a luci-base upgrade cannot
# leave a stale fork behind: on the next start the (new) stock script is
# simply stashed again.
is_upstream_cgi() {
	[ -f "$1" ] &&
		grep -q 'dispatch(' "$1" 2>/dev/null &&
		! grep -q 'luci-app-trusted' "$1" 2>/dev/null
}

ensure_wrapper() {
	grep -q 'luci-app-trusted CGI wrapper' "$CGI" 2>/dev/null && return 0

	if is_upstream_cgi "$CGI"; then
		cp -f "$CGI" "$STOCK" && chmod 0755 "$STOCK"
	elif ! is_upstream_cgi "$STOCK"; then
		# Neither the live script nor the stash is a genuine upstream CGI
		# (e.g. an older version of this package left its own shim behind and
		# the stash was lost).  Wrapping an unknown file would only make it
		# worse, so leave LuCI alone.
		log "no stock CGI found, /www/cgi-bin/luci left untouched"
		return 1
	fi

	cp -f "$WRAPPER" "$CGI" || return 1
	chmod 0755 "$CGI"
	rm -f /tmp/luci-indexcache*
}

restore_stock() {
	is_upstream_cgi "$STOCK" || return 0
	grep -q 'luci-app-trusted CGI wrapper' "$CGI" 2>/dev/null || return 0
	cp -f "$STOCK" "$CGI"
	chmod 0755 "$CGI"
	rm -f /tmp/luci-indexcache*
}

# ------------------------------------------------------------------ procd ---

start_service() {
	mkdir -p "$RUN"
	chmod 0700 "$RUN"
	rm -rf "$RUN/sid"
	rm -f "$RUN/wl" "$RUN/state" "$RUN/rules.nft" "$RUN/load.nft" "$RUN/nft.err"
	mkdir -p "$RUN/sid"
	chmod 0700 "$RUN/sid"

	# Switched off in LuCI: leave nothing behind, not even the CGI wrapper,
	# so the router behaves exactly as if the package were not installed.
	if [ "$(uci -q get trusted.global.enabled)" != "1" ]; then
		stop_service
		return 0
	fi

	ensure_wrapper

	MAIN_PORT=$(uci -q get ttyd.@ttyd[0].port)
	case "$MAIN_PORT" in
	''|*[!0-9]*|0)
		[ -n "$MAIN_PORT" ] && log "invalid ttyd port \"$MAIN_PORT\", assuming 7681"
		MAIN_PORT=7681
		;;
	esac
	LAN_ADDR=$(lan_addr)

	if [ -z "$LAN_ADDR" ]; then
		log "no IPv4 address on $LAN_IF, passwordless terminal and SSH stay off"
	fi

	collect_wl
	write_state
	# One line in syslog that answers "did my address get in?", which is what
	# the shell recovery path needs to verify itself.
	log "effective whitelist: $(tr '\n' ' ' < "$RUN/wl")"

	# The gate has to exist before anything listens behind it: if the ruleset
	# cannot be built, the passwordless daemons are not started at all.  That
	# is the only state that is both safe (no un-gated root shell) and honest
	# (no dead redirect to a port nobody listens on).
	if ! build_table; then
		log "passwordless terminal and SSH not started (no firewall rules)"
		del_ssh_account
		return 1
	fi

	if term_active && port_usable "$TERM_PORT"; then
		procd_open_instance ttyd
		procd_set_param command /usr/bin/ttyd -i "$LAN_IF" -p "$TERM_PORT" -W /bin/login -f root
		procd_set_param respawn
		procd_close_instance
	fi

	if ssh_active && port_usable "$SSH_PORT"; then
		add_ssh_account
		# -e exports TRUSTED_SSH into the session, which is how the guard
		# shell tells a genuine SSH login from a console/ttyd login.
		procd_open_instance ssh
		procd_set_param command /usr/sbin/dropbear -F -e -B -p "$LAN_ADDR:$SSH_PORT" -P "$RUN/dropbear.pid"
		procd_set_param env TRUSTED_SSH=1
		procd_set_param respawn
		procd_close_instance
	else
		del_ssh_account
	fi
}

stop_service() {
	del_ssh_account
	unload_table
	restore_stock
	rm -rf "$RUN"
	rm -f /tmp/luci-indexcache* /tmp/luci-trusted-sessions.json
}

service_triggers() {
	procd_add_reload_trigger "trusted"
}
