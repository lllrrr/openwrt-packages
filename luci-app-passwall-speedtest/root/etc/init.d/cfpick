#!/bin/sh /etc/rc.common

START=99

USE_PROCD=1

# Scheduled speed tests are ordinary crontab lines, created and edited from
# the Web console (or by hand).  This service deliberately does not rewrite
# /etc/crontabs/root any more: the old generated "main" start line had to be
# kept in sync with UCI, which made all start tasks look special and could
# wipe node-scoped tasks on reload.
start_service() { :; }
stop_service() { :; }
reload_service() { :; }
