#!/bin/sh /etc/rc.common

# Standalone management console: a second uhttpd instance on its own port.
# LuCI keeps the configuration pages; this instance serves the operations
# console (dashboard + common settings) with its own login.

START=96
USE_PROCD=1

PROG=/usr/sbin/uhttpd
DOCROOT=/www/cfpick
SNAPSHOT=/tmp/cfpick-web.settings

service_triggers() {
	procd_add_reload_trigger "cfpick"
}

web_snapshot() {
	local enabled port bind

	config_load cfpick
	config_get_bool enabled global web_enabled 0
	config_get port global web_port 17544
	config_get bind global web_bind "0.0.0.0"

	printf '%s|%s|%s' "$enabled" "$port" "$bind"
}

start_service() {
	local enabled port bind

	web_snapshot > "$SNAPSHOT"

	config_load cfpick
	config_get_bool enabled global web_enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get port global web_port 17544
	config_get bind global web_bind "0.0.0.0"

	[ -x "$PROG" ] || return 0
	[ -d "$DOCROOT" ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" -f \
		-p "$bind:$port" \
		-h "$DOCROOT" \
		-x /cgi-bin \
		-I index.html \
		-t 60 -T 60 -k 20 -n 20 -N 100 \
		-D -S
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

reload_service() {
	local new old

	new="$(web_snapshot)"
	old="$(cat "$SNAPSHOT" 2>/dev/null)"

	# Plugin settings (cron, thresholds, ...) share the same UCI file and
	# trigger this service too; only restart when the console settings
	# actually changed, otherwise a save from the console would kill the
	# request that is writing it.
	[ "$new" = "$old" ] && return 0

	stop
	start
}
