#!/bin/sh
# One-time migration: add the independent-core, per-node DDNS and iterative
# convergence options to an existing /etc/config/cfpick (upgrades keep user
# config).  Existing values are never overwritten, including empty strings.

[ -f /etc/config/cfpick ] || exit 0

set_default() {
	uci -q get "cfpick.global.$1" >/dev/null 2>&1 && return 0
	uci -q set "cfpick.global.$1=$2"
}

set_default standalone_enabled 0
set_default standalone_core xray
set_default iterate_converge_count 5
set_default ddns_enabled 0
set_default ddns_ip_count 1
set_default ddns_ttl 300
set_default ddns_api_token ''
set_default ddns_zone_id ''
set_default ddns_zone_name ''
set_default ddns_proxied 0

uci -q commit cfpick
exit 0
