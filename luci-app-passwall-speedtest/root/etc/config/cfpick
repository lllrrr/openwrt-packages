config global 'global'
	option hour '24'
	option enabled '0'
	option ip_source 'builtin_ipv4'
	option custom_ip_file ''
	option custom_allip '0'
	option ip_online_url 'https://zip.cm.edu.kg/all.txt'
	option ip_online_regions 'JP SG KR'
	option tl '200'
	option tll '40'
	option tlr '0.2'
	option node_test_node ''
	option stable_node ''
	option node_test_url 'https://www.google.com/generate_204'
	option node_test_count '30'
	option node_test_timeout '5'
	option node_test_probes '3'
	option node_test_threads '5'
	option download_test_enabled '1'
	option download_test_count '5'
	option download_test_url 'https://speed.cloudflare.com/__down?bytes=10000000'
	option download_test_time '10'
	option iterate_enabled '0'
	option iterate_minutes '30'
	# 迭代收敛阈值：每轮收敛后剩余候选 ≤ N 个即保存结果、该节点提前结束。
	# 独立于 download_test_count（下载实测候选数），两者互不覆盖。
	option iterate_converge_count '5'
	# 独立测速：启用后统一测速改用本机 mihomo/Xray 内核（cfpick core），
	# 不再调用 PassWall 的 run_socks；关闭则保持原 PassWall 行为。
	option standalone_enabled '0'
	option standalone_core 'xray'
	# 按节点 DDNS：worker 表里填了 ddns_domain 的节点只写 Cloudflare DNS，
	# 不回写 PassWall 节点。
	option ddns_enabled '0'
	option ddns_ip_count '1'
	option ddns_ttl '300'
	option ddns_api_token ''
	option ddns_zone_id ''
	option ddns_zone_name ''
	option ddns_proxied '0'

# Standalone management console (cfpick-web).  Disabled by default; enable in
# LuCI and set the admin password in the console on first use.
	option web_enabled '0'
	option web_port '17544'
	option web_bind '0.0.0.0'
	option web_user 'admin'
	option web_password ''
	option web_timeout '3600'

config servers 'servers'
	option ssr_enabled '0'
	option passwall_enabled '0'
	option passwall2_enabled '0'
	option bypass_enabled '0'
	option vssr_enabled '0'
	option DNS_enabled '0'
	option AliDNS_ip_count '1'
	option AstraDNS_enabled '0'
	option AstraDNS_config '/etc/astra-dns/named.yaml'
	option AstraDNS_bin '/usr/bin/astra-dns'

# 五个固定 CM 源备选 IP 列表，共享 ip_online_url，仅 regions/port 不同。
# 每个 passwall worker 节点可在「第三方设置」里指派其中一个列表（node_ip 段）。
# 未指派的 worker 回退到第一个 enabled=1 的列表。
# port = 只保留源里该端口的条目（CF 常见 443/8443/2053/2083/2087/2096），默认 443。
config ip_list 'list1'
	option enabled '1'
	option name 'JP/SG/KR'
	option regions 'JP SG KR'
	option port '443'

config ip_list 'list2'
	option enabled '0'
	option name ''
	option regions ''
	option port '443'

config ip_list 'list3'
	option enabled '0'
	option name ''
	option regions ''
	option port '443'

config ip_list 'list4'
	option enabled '0'
	option name ''
	option regions ''
	option port '443'

config ip_list 'list5'
	option enabled '0'
	option name ''
	option regions ''
	option port '443'