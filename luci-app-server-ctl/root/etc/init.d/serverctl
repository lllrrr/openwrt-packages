#!/bin/sh /etc/rc.common

START=95
STOP=10

USE_PROCD=1

start_service() {
	local tz=$(cat /etc/TZ 2>/dev/null)

	procd_open_instance scheduler
	procd_set_param command /usr/bin/serverctl-scheduler
	[ -n "$tz" ] && procd_set_param env TZ="$tz"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
