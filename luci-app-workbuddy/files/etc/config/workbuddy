config workbuddy 'main'
	# 是否启用服务（1 启用 / 0 关闭）
	option enabled '1'

	# 监听端口与地址。0.0.0.0 表示允许局域网访问；仅本机使用可改为 127.0.0.1
	option port '8789'
	option host '0.0.0.0'

	# WorkBuddy 上游地址（内置服务器，一般无需修改）
	option endpoint 'https://www.workbuddy.ai'

	# 客户端版本号，用于上游请求的 User-Agent
	option client_version '5.5.2'

	# 自动获取客户端版本（1 开启 / 0 关闭）。
	# 开启后会尝试从官方来源探测最新版本，并记录上游实际接受过的最高版本；
	# 探测全部失败时回退到 client_version，不会让服务不可用。
	option auto_client_version '1'

	# 管理页管理员密码。留空则管理页不可用（会提示先设置）。
	# 设置后即可通过 http://<路由器IP>:8789/admin 打开独立管理网页，
	# 用该密码登录后管理 API 密钥、服务器与 Key、凭据池与模型策略。
	#   - 网页登录状态用带签名的 Cookie 保存，有效期 24 小时
	#   - 修改此密码会让所有已登录会话立即失效
	#   - 连续输错 8 次会锁定 5 分钟（同一来源 IP）
	#   - 忘记密码时改这里即可，无需其他操作
	option admin_password ''

	# access token 缓存文件（网页登录后自动写入，作为「默认凭据」）
	option token_file '/etc/workbuddy/token.json'

	# 仅免费模型：开启后 /v1/models 只暴露免费模型（x0.00），
	# 且 chat 请求若指定收费模型会自动替换为免费模型，避免扣费
	option only_free_models '1'

	# 公网访问：允许外网直连管理页与 API（1 开启 / 0 关闭）。
	# 默认关闭，仅局域网可访问。
	# 开启后本服务会自动在 UCI firewall 中创建端口转发规则 workbuddy_wan
	# （WAN → 本机监听端口），关闭时删除该规则。
	# 注意：管理页仍受管理员密码保护、API 仍受 API 密钥保护，
	# 但开放公网会暴露登录界面，请确认密码足够强。
	option wan_access '0'

	# 公网访问的外部端口（外网侧监听端口）。
	# 留空则与内部监听端口 port 一致；
	# 设置后外网用该端口访问，转发到本机 port 端口（内外端口分离）。
	# 例如设为 18789：外网 http://<公网IP>:18789 -> 本机 8789。
	# 建议换一个不显眼的端口降低被扫描概率。
	option wan_port ''

	# 共享访问令牌：旧版鉴权方式（可选）。
	# 推荐改用「API 密钥」（在 LuCI 中生成），支持多密钥、命名与单独吊销。
	# 留空且无 API 密钥时，局域网内无需鉴权。
	option share_token ''

	# ---------- 并发上限与排队（v1.8.0）----------
	#
	# 起因：sensenova 这类上游按 tpm/rpm 计费，N 个客户端同时冲上去，
	# 每把 Key 都会被自己人挤到限流，然后一起进冷却 —— 越压越慢。
	# 与其并发冲高被 429，不如排队等一会儿：同样的额度，吞吐反而更高。
	#
	# 超出的请求进 FIFO 队列等待额度；队列满了或等太久，立即返回
	# 429 + Retry-After，让客户端自己决定退避，而不是占着连接干等。
	#
	# 每个自定义上游单独计数，互不挤占；WorkBuddy 自己一个计数。

	# 单个自定义上游的并发上限（同时在途的请求数）。0 = 不限制。
	option up_max_inflight '4'

	# WorkBuddy 上游的并发上限。0 = 不限制。
	# 默认比自定义上游宽松，因为内置上游有多把凭据轮换，容忍度更高。
	option wb_max_inflight '6'

	# 排队上限（正在等待额度的请求数）。超过则立即 429 + Retry-After。
	# 32 大约相当于「扛过一次几秒钟的抖动」，再大只是把超时往后推。
	option queue_max '32'

	# 排队超时（秒）。等待超过该时长仍未拿到额度，返回 429 + Retry-After。
	option queue_timeout '20'

	# ---------- 上游连接池（v1.8.0）----------
	#
	# workbuddy-pool 常驻进程维持到上游的 TLS 连接池，省掉每个请求的
	# TCP + TLS 握手（实测固定开销约 130–190ms，占一次 1.5s 请求的 9–13%）。
	#
	# 池不可用（进程挂了、端口被占）时自动回退到直连 curl，服务不受影响；
	# 回退后 30 秒内不再尝试池，避免每个请求都白等一次连接超时。
	option use_pool '1'

	# 池监听端口。仅绑定 127.0.0.1，不对外暴露。
	option pool_port '8790'

	# 保活预热间隔（秒）。0 = 关闭预热。
	#
	# 为什么需要预热：两轮对话常间隔几十秒，空闲连接会被 NAT 或上游
	# 悄悄回收，不预热的话下一个请求照样从零握手，池子等于白建。
	# 取 30 是因为 nginx keepalive_timeout 默认为 75s，半值留出余量。
	option pool_keepalive '30'

	# ---------- 上游限流刹车（v1.8.1）----------
	#
	# 一次请求撞上游限流后会换下一把 Key 重试，最多试满 4 把；当 4 把
	# Key 都已冷却时，这 4 次尝试注定全失败，却给上游打了 4 倍流量。
	# 实测池侧 138 次上游请求 / 60 次客户端请求 = 2.25× 放大，其中 70%
	# 是这么烧掉的。刹车（上游级熔断器）掐断这条正反馈链。
	#
	# 注意它不创造容量，只是把「成片 429」变成「更平滑的退避」。

	# 窗口内累计多少次上游限流拒绝后闭闸。0 = 关闭刹车。
	option rl_brake_hits '4'

	# 计数窗口（秒）。
	option rl_brake_window '20'

	# 闭闸时长（秒）。闭闸期间只拦重试、不拦首次尝试；任一 Key 成功即合闸。
	option rl_brake_sec '8'

	# 回给客户端的 Retry-After 上限（秒）。防止算出荒谬的大值。
	option rl_brake_max_ra '15'

	# ---------- 静默看门狗（v1.8.2）----------
	#
	# 上游连上后一个字节都不回时，主动断开并按既有重试链换 Key，而不是
	# 让客户端干等。v1.8.1 及以前只有一个阈值（25s），实测证明这个值
	# 是客户端长尾的唯一来源：32 次看门狗中止全部落在 25–29s，13 个慢
	# 请求（≥5s）全都最终成功，只是白等了 25~34 秒。
	#
	# 关键区别：首字节前静默 = 上游根本没受理（服务端排队/撞配额），
	# 早点换 Key 就好；流中途静默 = 已出数据又卡住，换 Key 会浪费已生成
	# 的内容，应该多等。两者是不同事故，共用一个阈值必然顾此失彼。

	# 首字节档：上游连上后多久还没吐出第一个字节就换 Key。0 = 关闭该档。
	option up_first_byte_sec '12'

	# 流中档：已开始返回数据后，中途静默多久判定断流。0 = 关闭该档。
	# 取 25s 的依据（v1.8.2 扫 60/30/25，各 60 请求）：客户端 p90/p99/max
	# 几乎等于本档阈值 + 扫描间隔（超时那一刻才中止），所以本档直接决定
	# 长尾高度：60s 档 p90 65.1s，25s 档 p90 28.9s，成功率无可区分差异
	# （58.3% vs 65.0%，在配额波动范围内）。SSE 是逐字吐的，25s 一个字节
	# 都没有基本等于链路已断；确有长静默需求的上游请单独调大或配 0。
	option up_idle_sec '25'

	# WorkBuddy 通道静默上限（该通道首字节本来就慢，不参与首字节档）。
	option wb_idle_sec '75'

	# ---------- 上游响应回环桥（v1.8.3 引入，v1.8.4 修好）----------
	#
	# 起因是一个只在并发下出现的严重缺陷：ucode 的 popen() 管道 + uloop 读循环
	# 会丢可读事件，导致上游响应在 16384 字节（读缓冲）整数倍处被当成流结束
	# 提前关闭 —— 客户端拿到半截 SSE 流，却因为响应头是 `Connection: close`
	# 且没有 Content-Length 而**完全无法察觉**（curl 照报 code=200、退出码 0）。
	# 离线探针（probe2/probe3/probe6/probe7）用纯本地子进程复现了这两种症状：
	# 假 EOF 提前关闭，以及数据已完整却永不收尾。
	#
	# 阻塞 popen 管道上 EAGAIN 与 EOF 无法区分（proc.pid/returncode 也不可得），
	# 没法在管道路径上消歧；而 socket 读路径在同样并发下字节精确、EOF 可靠
	# （probe10：5/5 连接各 200000 字节无差错）。所以改为：curl 的 stdout 经
	# busybox nc 回环到一个本地 TCP socket，由 ucode 用 socket 读路径接收转发。
	#
	# 每条上游请求的连接都带一行请求 id 做握手，收到的数据按 id 归属到对应客户端。
	#
	# 【v1.8.4 修的坑】v1.8.3 上线后 60 并发直接把服务打死：popen() 的直接子进程
	# 是那个 sh，整条 `{ …; } | nc …` 管道在整个响应流期间都活着，于是任何一次
	# proc.close()（= pclose()/waitpid()）都要等管道退出才返回；单线程事件循环被
	# 钉死在 do_wait（diag183：Recv-Q 固定 87423、/health 无响应、56/60 code=000）。
	# 修法是在 bridgeWrap() 产出的命令串尾部追加 ` &`，sh 立刻退出、pclose() 收的
	# 是已死子进程（实测 2 ms 返回），数据仍逐字节完整送达。

	# 回环桥监听端口（仅绑定 127.0.0.1）。0 = 关闭回环桥，退回直接读 popen 管道。
	# 关闭后 v1.8.2 的静默截断缺陷会重新出现，仅用于诊断对比与紧急回退。
	option bridge_port '8791'

	# ---------- v2.0：会话粘性 / 内网上游 / 上游缓存 ----------
	#
	# 会话粘性（session affinity，借鉴 gpt-load / sub2api 的同一会话粘同一 Key）：
	# 同一客户端（按 API Key 名，未鉴权时按来源 IP）在窗口期内始终命中同一把
	# Key，避免多轮对话在 4 把 Key 之间乱跳导致上下文缓存（prompt caching）
	# 完全失效 —— 同一 Key 连续提问才能吃到上游的缓存命中，既省钱又省 TTFB。
	# 窗口到期或该 Key 冷却后自然失效，重新按权重轮询。
	option up_sticky_sec '900'

	# 是否允许自定义上游指向内网/本机地址（1 允许 / 0 禁止）。
	# 禁止后 baseUrl 不能是 localhost、127.*、10.*、192.168.*、172.16-31.*、
	# ::1、fc00::/7、fe80::/10 —— 防止有人把中转当跳板打内网（SSRF 防护）。
	# 本机自己的凭据池通道（workbuddy/ 前缀）不受此限制。
	option allow_private_upstream '1'

	# 调试日志（1 输出更多信息）
	option debug '0'