'use strict';

import * as fs from 'fs';
import { cursor } from 'uci';
import { connect } from 'ubus';

const init = '/etc/init.d/vhusbd';
const limit = 16384;

function settings() {
	let uci = cursor();
	return {
		binary_path: uci.get('virtualhere', 'main', 'binary_path') ?? '/usr/bin/vhusbd',
		config_path: uci.get('virtualhere', 'main', 'config_path') ?? '/etc/vhusbd.conf',
		autostart: system([init, 'enabled'], 2000) == 0 ? '1' : '0'
	};
}

function valid_path(path) {
	return type(path) == 'string' && match(path, /^\/[^[:cntrl:]]+$/) &&
		!match(path, /\/$/);
}

function state() {
	let conn = connect();
	if (!conn)
		return { error: 'service_unavailable' };
	let result = conn.call('service', 'list', { name: 'vhusbd' });
	conn.disconnect();
	if (result == null)
		return { error: 'service_unavailable' };
	let instances = result.vhusbd?.instances ?? {};
	let pids = [];
	for (let name, instance in instances)
		if (instance.running && instance.pid)
			push(pids, instance.pid);
	return { running: length(pids) > 0, active: length(instances) > 0, pids };
}

function binary_error(path) {
	if (!valid_path(path)) return 'invalid_path';
	let st = fs.stat(path);
	if (!st || st.type != 'file') return 'binary_missing';
	if (!st.size) return 'binary_empty';
	if (!fs.access(path, 'x')) return 'binary_permission';
	return null;
}

function read_config() {
	let path = settings().config_path;
	if (!valid_path(path)) return { error: 'invalid_path', path };
	let st = fs.stat(path);
	if (!st) {
		// A broken symlink or an inaccessible existing file is not a new file.
		if (fs.lstat(path) || !fs.access(fs.dirname(path), 'rx'))
			return { error: 'read_failed', detail: fs.error(), path };
		return { path, exists: false, content: '' };
	}
	if (st.type != 'file') return { error: 'not_regular', path };
	if (st.size > limit) return { error: 'too_large', path };
	let content = fs.readfile(path);
	if (content == null) return { error: 'read_failed', detail: fs.error(), path };
	if (length(content) > limit) return { error: 'too_large', path };
	if (index(content, '\x00') >= 0) return { error: 'not_text', path };
	return { path, exists: true, content };
}

function stop_and_wait(before) {
	if (system([init, 'stop'], 8000) != 0)
		return false;
	// procd may return before SIGTERM/SIGKILL has reaped the previous process.
	for (let i = 0; i < 60; i++) {
		if (!length(filter(before.pids, pid => fs.access('/proc/' + pid))))
			return true;
		system(['/bin/sleep', '0.1'], 1000);
	}
	return false;
}

function locked(callback) {
	let lock = fs.open('/var/lock/luci-virtualhere.lock', 'a', 0600);
	if (!lock || !lock.lock('xn')) {
		lock?.close();
		return { error: 'lock_failed' };
	}
	let result;
	try { result = callback(); }
	catch (e) {
		lock.close();
		die('VirtualHere RPC failed: ' + e);
	}
	lock.close();
	return result;
}

function write_config(args) {
	if (type(args.content) != 'string' || type(args.original) != 'string' ||
		length(args.content) > limit || length(args.original) > limit)
		return { error: 'too_large' };
	if (index(args.content, '\x00') >= 0) return { error: 'not_text' };
	let current = read_config();
	if (current.error) return current;
	if (args.path != current.path) return { error: 'path_changed' };
	if (args.original != current.content || args.exists != current.exists)
		return { error: 'conflict' };
	let config = settings();
	if (config.config_path != current.path) return { error: 'path_changed' };
	let target = current.exists ? fs.realpath(current.path) :
		fs.realpath(fs.dirname(current.path)) + '/' + fs.basename(current.path);
	if (!target || target == fs.realpath(config.binary_path) ||
		target == '/etc/config/virtualhere') return { error: 'same_path' };
	let before = state();
	if (before.error) return before;
	if (before.active && !args.apply) return { error: 'stop_before_save' };
	if (before.active && binary_error(config.binary_path))
		return { error: binary_error(config.binary_path) };
	if (before.active && !stop_and_wait(before)) return { error: 'stop_failed' };
	let tempdir, tempfile, file;
	let result;
	try {
		// VirtualHere can flush configuration at shutdown. Compare once more.
		let stopped = read_config();
		if (stopped.error) result = stopped;
		else if (stopped.path != current.path) result = { error: 'path_changed' };
		else if (stopped.content != current.content || stopped.exists != current.exists)
			result = { error: 'conflict' };
		else {
			let st = fs.stat(target);
			tempdir = fs.mkdtemp(fs.dirname(target) + '/.virtualhere-XXXXXX');
			if (tempdir) {
				tempfile = tempdir + '/config.ini';
				file = fs.open(tempfile, 'w', st ? (st.mode & 0777) : 0600);
			}
			let ok = file && file.write(args.content) == length(args.content) && file.flush();
			if (file && !file.close()) ok = false;
			file = null;
			if (ok && st) ok = fs.chown(tempfile, st.uid, st.gid) && fs.chmod(tempfile, st.mode & 0777);
			if (ok) ok = fs.rename(tempfile, target);
			result = ok ? { saved: true } : { error: 'write_failed', detail: fs.error() };
		}
	}
	catch (e) { result = { error: 'write_failed', detail: '' + e }; }
	file?.close();
	if (tempfile) fs.unlink(tempfile);
	if (tempdir) fs.rmdir(tempdir);
	if (before.active && system([init, 'start'], 8000) != 0)
		return { error: 'start_failed', saved: result.saved ?? false };
	return result;
}

const methods = {
	settings: { call: () => settings() },
	status: {
		call: () => {
			let config = settings();
			let result = state();
			result.binary_error = binary_error(config.binary_path);
			return result;
		}
	},
	read_config: { call: () => read_config() },
	save_settings: {
		args: { binary_path: '', config_path: '', autostart: '', apply: false },
		call: request => locked(() => {
			let args = request.args;
			if (!valid_path(args.binary_path) || !valid_path(args.config_path) ||
				(args.autostart != '0' && args.autostart != '1')) return { error: 'invalid_path' };
			let config_target = fs.realpath(args.config_path);
			if (args.binary_path == args.config_path || config_target == '/etc/config/virtualhere' ||
				(config_target && config_target == fs.realpath(args.binary_path)))
				return { error: 'same_path' };
			let before = state();
			if (before.error) return before;
			if (args.apply && before.active && binary_error(args.binary_path))
				return { error: binary_error(args.binary_path) };
			let uci = cursor();
			uci.set('virtualhere', 'main', 'virtualhere');
			uci.set('virtualhere', 'main', 'binary_path', args.binary_path);
			uci.set('virtualhere', 'main', 'config_path', args.config_path);
			uci.set('virtualhere', 'main', 'autostart', args.autostart);
			if (!uci.commit('virtualhere')) return { error: 'settings_failed' };
			if (system([init, args.autostart == '1' ? 'enable' : 'disable'], 2000) != 0)
				return { error: 'autostart_failed' };
			if (args.apply && before.active) {
				if (system([init, 'check'], 2000) != 0) return { error: 'config_invalid' };
				if (!stop_and_wait(before)) return { error: 'stop_failed' };
				if (system([init, 'start'], 8000) != 0) return { error: 'start_failed' };
			}
			return { saved: true };
		})
	},
	write_config: {
		args: { path: '', content: '', original: '', exists: false, apply: false },
		call: request => locked(() => write_config(request.args))
	},
	action: {
		args: { action: '' },
		call: request => locked(() => {
			let action = request.args.action;
			if (action != 'start' && action != 'stop' && action != 'restart')
				return { error: 'invalid_action' };
			if (action != 'stop') {
				let err = binary_error(settings().binary_path);
				if (err) return { error: err };
				if (system([init, 'check'], 2000) != 0) return { error: 'config_invalid' };
			}
			let before = state();
			if (before.error) return before;
			if (action != 'start' && !stop_and_wait(before)) return { error: 'stop_failed' };
			if (action != 'stop' && system([init, 'start'], 8000) != 0)
				return { error: 'start_failed' };
			return { success: true };
		})
	}
};

return { 'luci.virtualhere': methods };
