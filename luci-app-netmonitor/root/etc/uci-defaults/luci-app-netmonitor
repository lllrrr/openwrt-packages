#!/bin/sh
#
# luci-app-netmonitor UCI 默认值
#
# 说明：
#   1. 本脚本只在软件包安装/升级后执行一次，执行成功即被系统删除。
#   2. 出厂默认配置由软件包提供（/etc/config/netmonitor）。本脚本仅在配置
#      缺失时补齐默认值，已有配置保持原样，因此软件升级不会覆盖用户设置。
#   3. 无论配置是否已存在，都会执行权限修复、rpcd 重载与服务自启，
#      保证「装完即用」。
#   4. 这里使用 printf 管道喂给 uci batch，而不是 here-document，
#      以避免在部分非交互执行环境（如脚本被管道/SSH 直接执行）下失效。
#

. /lib/functions.sh

NM_CFG=netmonitor

# 已有配置则跳过默认值写入（不 exit，后续的服务启动仍需执行）
if ! uci -q show "$NM_CFG" >/dev/null 2>&1; then
	# 部分 OpenWrt/ImmortalWrt 版本的 uci 不会隐式创建新的 config 文件，
	# 直接 set 会报 "Entry not found"，因此这里先确保文件存在。
	[ -f "/etc/config/$NM_CFG" ] || : > "/etc/config/$NM_CFG"

	{
		printf 'set %s.global=global\n' "$NM_CFG"
		printf "set %s.global.enabled='1'\n" "$NM_CFG"
		printf "set %s.global.interval='10'\n" "$NM_CFG"
		printf "set %s.global.timeout='3'\n" "$NM_CFG"
		printf "set %s.global.count='1'\n" "$NM_CFG"
		printf "set %s.global.concurrency='5'\n" "$NM_CFG"
		printf "set %s.global.address_family='auto'\n" "$NM_CFG"
		printf "set %s.global.default_proto='icmp'\n" "$NM_CFG"
		printf "set %s.global.default_tcp_port='80'\n" "$NM_CFG"
		printf "set %s.global.interface=''\n" "$NM_CFG"
		printf "set %s.global.source=''\n" "$NM_CFG"
		printf "set %s.global.persistence='0'\n" "$NM_CFG"
		printf "set %s.global.history='24h'\n" "$NM_CFG"
		printf "set %s.global.persist_interval='300'\n" "$NM_CFG"
		printf "set %s.global.max_points='4320'\n" "$NM_CFG"
		printf "set %s.global.ui_refresh='2'\n" "$NM_CFG"
		printf "set %s.global.log_level='info'\n" "$NM_CFG"
		printf "set %s.global.fail_warn='3'\n" "$NM_CFG"
		printf "set %s.global.fail_critical='5'\n" "$NM_CFG"
		printf "set %s.global.loss_warn='5'\n" "$NM_CFG"
		printf "set %s.global.loss_critical='20'\n" "$NM_CFG"
		printf "set %s.global.latency_excellent='50'\n" "$NM_CFG"
		printf "set %s.global.latency_good='100'\n" "$NM_CFG"
		printf "set %s.global.latency_fair='200'\n" "$NM_CFG"
		printf "set %s.global.latency_poor='500'\n" "$NM_CFG"
		printf "set %s.global.notify_enabled='0'\n" "$NM_CFG"
		printf "set %s.global.notify_url=''\n" "$NM_CFG"

		printf 'set %s.baidu=target\n' "$NM_CFG"
		printf "set %s.baidu.name='Baidu'\n" "$NM_CFG"
		printf "set %s.baidu.host='www.baidu.com'\n" "$NM_CFG"
		printf "set %s.baidu.region='cn'\n" "$NM_CFG"
		printf "set %s.baidu.label=''\n" "$NM_CFG"
		printf "set %s.baidu.proto='icmp'\n" "$NM_CFG"
		printf "set %s.baidu.tcp_port='0'\n" "$NM_CFG"
		printf "set %s.baidu.family='auto'\n" "$NM_CFG"
		printf "set %s.baidu.interval='0'\n" "$NM_CFG"
		printf "set %s.baidu.timeout='3'\n" "$NM_CFG"
		printf "set %s.baidu.enabled='1'\n" "$NM_CFG"
		printf "set %s.baidu.remark=''\n" "$NM_CFG"

		printf 'set %s.alidns=target\n' "$NM_CFG"
		printf "set %s.alidns.name='AliDNS'\n" "$NM_CFG"
		printf "set %s.alidns.host='223.5.5.5'\n" "$NM_CFG"
		printf "set %s.alidns.region='cn'\n" "$NM_CFG"
		printf "set %s.alidns.label='DNS'\n" "$NM_CFG"
		printf "set %s.alidns.proto='icmp'\n" "$NM_CFG"
		printf "set %s.alidns.tcp_port='0'\n" "$NM_CFG"
		printf "set %s.alidns.family='ipv4'\n" "$NM_CFG"
		printf "set %s.alidns.interval='0'\n" "$NM_CFG"
		printf "set %s.alidns.timeout='3'\n" "$NM_CFG"
		printf "set %s.alidns.enabled='0'\n" "$NM_CFG"
		printf "set %s.alidns.remark=''\n" "$NM_CFG"

		printf 'set %s.cloudflare=target\n' "$NM_CFG"
		printf "set %s.cloudflare.name='Cloudflare'\n" "$NM_CFG"
		printf "set %s.cloudflare.host='1.1.1.1'\n" "$NM_CFG"
		printf "set %s.cloudflare.region='overseas'\n" "$NM_CFG"
		printf "set %s.cloudflare.label='DNS'\n" "$NM_CFG"
		printf "set %s.cloudflare.proto='icmp'\n" "$NM_CFG"
		printf "set %s.cloudflare.tcp_port='0'\n" "$NM_CFG"
		printf "set %s.cloudflare.family='ipv4'\n" "$NM_CFG"
		printf "set %s.cloudflare.interval='0'\n" "$NM_CFG"
		printf "set %s.cloudflare.timeout='3'\n" "$NM_CFG"
		printf "set %s.cloudflare.enabled='0'\n" "$NM_CFG"
		printf "set %s.cloudflare.remark=''\n" "$NM_CFG"

		printf 'set %s.googledns=target\n' "$NM_CFG"
		printf "set %s.googledns.name='GoogleDNS'\n" "$NM_CFG"
		printf "set %s.googledns.host='8.8.8.8'\n" "$NM_CFG"
		printf "set %s.googledns.region='overseas'\n" "$NM_CFG"
		printf "set %s.googledns.label='DNS'\n" "$NM_CFG"
		printf "set %s.googledns.proto='icmp'\n" "$NM_CFG"
		printf "set %s.googledns.tcp_port='0'\n" "$NM_CFG"
		printf "set %s.googledns.family='ipv4'\n" "$NM_CFG"
		printf "set %s.googledns.interval='0'\n" "$NM_CFG"
		printf "set %s.googledns.timeout='3'\n" "$NM_CFG"
		printf "set %s.googledns.enabled='0'\n" "$NM_CFG"
		printf "set %s.googledns.remark=''\n" "$NM_CFG"
	} | uci -q batch

	uci -q commit "$NM_CFG"
fi

# 升级补齐：只写「本版本新增、且当前确实缺失」的选项，绝不覆盖用户已有取值。
# 缺少这些选项时守护进程会回落到脚本内置默认值，功能不受影响；
# 这里补上是为了让 /etc/config/netmonitor 与实际生效配置保持可读一致。
if ! uci -q get "$NM_CFG.global.default_proto" >/dev/null 2>&1; then
	{
		printf "set %s.global.default_proto='icmp'\n" "$NM_CFG"
		printf "set %s.global.default_tcp_port='80'\n" "$NM_CFG"
	} | uci -q batch
	uci -q commit "$NM_CFG"
fi

# 文件系统可能不保留可执行位，这里显式补齐
chmod 0755 /etc/init.d/netmonitor 2>/dev/null
chmod 0755 /usr/libexec/netmonitor/netmon-daemon.sh 2>/dev/null

# 清掉 LuCI 索引缓存，保证「状态」菜单下立刻出现入口
rm -f /tmp/luci-indexcache* 2>/dev/null

# 让 rpcd 加载本插件的 ucode RPC 后端
/etc/init.d/rpcd restart >/dev/null 2>&1

# 安装后自动使能并启动服务
/etc/init.d/netmonitor enable >/dev/null 2>&1
/etc/init.d/netmonitor start >/dev/null 2>&1

exit 0
