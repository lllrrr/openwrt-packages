{
	"luci-app-bypass": {
		"description": "Bypass (NaiveProxy + BypassCore) access",
		"read": {
			"uci": ["bypass"],
			"ubus": {
				"uci": ["changes", "get"]
			}
		},
		"write": {
			"uci": ["bypass"],
			"ubus": {
				"uci": ["add", "apply", "confirm", "delete", "order", "rename", "set"],
				"file": ["exec"]
			},
			"file": {
				"/usr/share/bypass/api.sh": ["exec"]
			}
		}
	}
}
