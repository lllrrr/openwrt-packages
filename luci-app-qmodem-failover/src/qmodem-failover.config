# /etc/config/qmodem_failover
# QMODEM 故障切换默认配置
# 修改后执行: /etc/init.d/qmodem-failover restart

config qmodem_failover 'general'
	# 是否启用本插件 (0=禁用, 1=启用)
	option enabled '1'

	# 有线 WAN 接口名（通过 ip link show 查看）
	option wan_iface 'eth0'

	# QMODEM 移动网络接口名（USB网卡通常为 usb0，PPP拨号为 ppp0）
	option lte_iface 'usb0'

	# 检测间隔（秒）：每隔多少秒 Ping 一次，建议 3~5
	option check_interval '3'

	# 故障判定次数：连续失败多少次触发切换至 LTE，建议 3
	option fail_threshold '3'

	# 恢复判定次数：连续成功多少次触发切回 WAN，建议 5（防抖）
	option success_threshold '5'

	# Ping 超时（秒）：单次 Ping 等待时间，建议 2
	option ping_timeout '2'

	# WAN 路由 metric（越小越优先）
	option metric_wan '10'

	# LTE 路由 metric（备用时）
	option metric_lte '100'

# Ping 检测目标列表（任意一个 Ping 成功即认为 WAN 正常）
config check_hosts 'hosts'
	list host '223.5.5.5'
	list host '8.8.8.8'
	list host '114.114.114.114'

# 通知配置（可选，不填则只记系统日志）
config notification 'notify'
	# 启用通知 (0=禁用, 1=启用)
	option enabled '0'

	# Webhook 类型: dingtalk | wecom | feishu | custom
	option webhook_type 'dingtalk'

	# Webhook URL（在对应平台创建机器人后获得）
	option webhook_url ''

