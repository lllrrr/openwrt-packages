
config komari 'global'
	option enabled '0'
	option interval '1'
	option info_report_interval '5'

config komari 'connection'
	option endpoint ''
	option token ''
	option ignore_unsafe_cert '0'

config komari 'monitor'
	option enable_gpu '0'
	option memory_include_cache '0'
	option month_rotate '0'

config komari 'advanced'
	option disable_web_ssh '1'
	option disable_auto_update '1'
	option max_retries '3'
	option reconnect_interval '5'

config komari 'cloudflare'
	option cf_access_client_id ''
	option cf_access_client_secret ''
