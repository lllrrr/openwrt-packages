#!/bin/sh
# /etc/uci-defaults/99-panda
# Panda 首次启动初始化

# 确保 panda UCI 全局配置存在
uci -q get panda.global > /dev/null 2>&1 || {
	uci set panda.global='panda'
	uci set panda.global.ddns_enabled='0'
	uci set panda.global.ddns_interval='300'
}

# 确保 IP 检测配置存在
uci -q get panda.ip_detect > /dev/null 2>&1 || {
	uci set panda.ip_detect='panda'
	uci add_list panda.ip_detect.ipv4_urls='https://api.ipify.org'
	uci add_list panda.ip_detect.ipv6_urls='https://api6.ipify.org'
}

uci commit panda
exit 0
