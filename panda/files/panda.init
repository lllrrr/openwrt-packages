#!/bin/sh /etc/rc.common
# /etc/init.d/panda — Panda DDNS 守护进程

USE_PROCD=1
START=90
STOP=10

NAME="panda"
DDNS_BIN="/usr/bin/panda-ddns"

_ensure_logs() {
	mkdir -p /var/log
	[ -f /var/log/ddns.log ] || touch /var/log/ddns.log
}

_start_ddns() {
	config_load panda
	config_get DDNS_ENABLED  global ddns_enabled  '0'
	config_get DDNS_INTERVAL global ddns_interval '300'

	[ "$DDNS_ENABLED" = "1" ] || {
		logger -t "$NAME" "DDNS 已禁用 — 跳过启动"
		return 0
	}
	[ -x "$DDNS_BIN" ] || {
		logger -t "$NAME" "错误：DDNS 二进制文件未找到：$DDNS_BIN"
		return 1
	}

	procd_open_instance "panda-ddns"
	procd_set_param command "$DDNS_BIN" \
		--config  "/etc/config/panda" \
		--interval "$DDNS_INTERVAL"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 60 5 30
	procd_set_param file /etc/config/panda
	procd_close_instance

	logger -t "$NAME" "DDNS 已启动（更新间隔：${DDNS_INTERVAL} 秒）"
}

start_service() {
	_ensure_logs
	_start_ddns
}

stop_service() {
	logger -t "$NAME" "正在停止 DDNS"
	killall -q panda-ddns 2>/dev/null || true
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "panda"
}

boot() {
	start
}
