{
	"luci-app-wanip-selector": {
		"description": "Grant access to the WAN IP selector",
		"read": {
			"uci": [ "wanip_selector" ],
			"file": {
				"/usr/sbin/wanip-selector status": [ "exec" ],
				"/usr/sbin/wanip-selector check": [ "exec" ]
			},
			"ubus": {
				"network.interface": [ "status", "dump" ]
			}
		},
		"write": {
			"uci": [ "wanip_selector" ],
			"file": {
				"/usr/sbin/wanip-selector trigger": [ "exec" ],
				"/usr/sbin/wanip-selector trigger force": [ "exec" ],
				"/usr/sbin/wanip-selector trigger run": [ "exec" ],
				"/usr/sbin/wanip-selector force": [ "exec" ],
				"/usr/sbin/wanip-selector stop": [ "exec" ],
				"/etc/init.d/wanip_selector restart": [ "exec" ],
				"/etc/init.d/wanip_selector reload": [ "exec" ]
			}
		}
	}
}
