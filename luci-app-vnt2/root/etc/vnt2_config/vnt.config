# [string] 必填
# zh-cn: 网络编号，相同编号的设备组成同一虚拟局域网
# en: Network code, devices with the same code form a virtual LAN
# 示例: office
network_code = ""

# [array] 必填
# zh-cn: 服务器地址列表，支持 quic/tcp/wss/dynamic 协议
# en: Server address list, supports quic/tcp/wss/dynamic protocols
# 示例: quic://vpn.example.com:29876
server = []

# [array]
# zh-cn: 可直连节点地址列表，支持 ip:端口、tcp://、udp://
# en: Direct peer addresses, supports ip:port, tcp:// and udp://
# 示例: 192.168.1.10:29873
peer_address = []

# [array]
# zh-cn: 指定目标 IP 或网段的优先中转节点，格式：目标,中转虚拟 IP
# en: Preferred TURN peer for a target IP or subnet, format: target,turn IP
# 示例: 10.26.0.0/24,10.26.0.2
turn = []

# [string]
# zh-cn: 自定义虚拟 IP 地址，留空自动分配
# en: Custom virtual IP address, leave empty for auto assignment
# 示例: 10.26.0.10
ip = ""

# [bool]
# zh-cn: 启用 QUIC 优化传输
# en: Enable QUIC optimized transport
rtx = false

# [bool]
# zh-cn: 启用 FEC 前向纠错
# en: Enable FEC forward error correction
fec = false

# [bool]
# zh-cn: 关闭 P2P 打洞
# en: Disable P2P hole punching
no_punch = false

# [bool]
# zh-cn: 关闭 IPv4 广播和组播转发
# en: Disable IPv4 broadcast and multicast forwarding
no_broadcast = false

# [bool]
# zh-cn: 启用 LZ4 数据压缩
# en: Enable LZ4 data compression
compress = false

# [array]
# zh-cn: 入栈监听网段，格式：CIDR,目标虚拟IP
# en: Inbound listening subnet, format: CIDR,target virtual IP
# 示例: 192.168.1.0/24,10.26.0.10
input = []

# [array]
# zh-cn: 出栈允许网段，格式：CIDR
# en: Outbound allowed subnet, format: CIDR
# 示例: 192.168.1.0/24
output = []

# [bool]
# zh-cn: 关闭内置子网 NAT
# en: Disable built-in subnet NAT
no_nat = false

# [select]
# zh-cn: 虚拟网卡模式
# en: Virtual network interface mode
# 选项: no, tun, tap
device_mode = "tun"

# [array]
# zh-cn: 端口映射规则
# en: Port mapping rules
# 示例: tcp://0.0.0.0:8080,10.26.0.10:80
port_mapping = []

# [bool]
# zh-cn: 允许本设备作为端口映射出口
# en: Allow this device as port mapping exit
allow_mapping = false

# [int]
# zh-cn: MTU 值，默认 1400
# en: MTU value, default 1400
# 示例: 1400
mtu = 1400

# [int]
# zh-cn: 控制服务 TCP 端口，设置 0 禁用
# en: Control service TCP port, set 0 to disable
# 示例: 11233
ctrl_port = 11233

# [int]
# zh-cn: 隧道端口，设置 0 自动分配
# en: Tunnel port, 0 means automatic allocation
# 示例: 0
tunnel_port = 0

# [string]
# zh-cn: 设备名称，留空自动读取主机名
# en: Device name, leave empty to use hostname
# 示例: office-pc
device_name = ""

# [string]
# zh-cn: 设备唯一 ID，留空自动生成
# en: Device ID, leave empty to generate automatically
# 示例: device-001
device_id = ""

# [string]
# zh-cn: 虚拟网卡名称
# en: Virtual network interface name
# 示例: vnt-tun0
tun_name = ""

# [string]
# zh-cn: 对外通信 Socket 使用的出口网卡名称
# en: Outbound interface used for communication sockets
# 示例: eth0
outbound_interface = ""

# [string]
# zh-cn: 事件脚本路径或命令，在网卡创建、掉线、重连或 IP 变化时调用
# en: Event script or command invoked on interface and IP events
# 示例: /etc/vnt2/event.sh
event_script = ""

# [string]
# zh-cn: 组网加密密码
# en: Network encryption password
# 示例: your-secret-password
password = ""

# [select]
# zh-cn: 证书校验方式
# en: Certificate verification mode
# 选项: skip, standard, finger
cert_mode = "skip"

# [array]
# zh-cn: 自定义 UDP STUN 服务器地址
# en: Custom UDP STUN server addresses
# 示例: stun.example.com:3478
udp_stun = []

# [array]
# zh-cn: 自定义 TCP STUN 服务器地址
# en: Custom TCP STUN server addresses
# 示例: stun.example.com:3478
tcp_stun = []

# [string]
# zh-cn: Web 管理界面监听地址，填写后使用 vnt2_web 启动
# en: Web management listen address; enables vnt2_web mode
# 示例: 0.0.0.0:29878
web_addr = ""
