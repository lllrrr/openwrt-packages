# [string]
# zh-cn: TCP 监听地址，不填则不启用 TCP 服务
# en: TCP listen address, leave empty to disable TCP service
# 示例: 0.0.0.0:29872
tcp_bind = "0.0.0.0:29872"

# [string]
# zh-cn: QUIC 监听地址，不填则不启用 QUIC 服务
# en: QUIC listen address, leave empty to disable QUIC service
# 示例: 0.0.0.0:29872
quic_bind = "0.0.0.0:29872"

# [string]
# zh-cn: WSS 监听地址，不填则不启用 WSS 服务
# en: WSS listen address, leave empty to disable WSS service
# 示例: 0.0.0.0:29872
ws_bind = "0.0.0.0:29872"

# [string] 必填
# zh-cn: 默认虚拟网段
# en: Default virtual network subnet
# 示例: 10.26.0.0/24
network = "10.26.0.0/24"

# [array]
# zh-cn: 网络编号白名单，留空则不限制
# en: Network code whitelist, leave empty for no restriction
# 示例: admin
white_list = []

# [int]
# zh-cn: IP 租约时长，单位秒，默认 86400 即 24 小时，离线超过这个时间 IP 会被回收
# en: IP lease duration in seconds, default 86400. Offline clients beyond this time are reclaimed
# 示例: 86400
lease_duration = 86400

# [string]
# zh-cn: Web 管理端绑定地址，不写则不启用 Web 服务
# en: Web management bind address, leave empty to disable Web service
# 示例: 0.0.0.0:29871
web_bind = "0.0.0.0:29871"

# [string]
# zh-cn: 管理端登录用户名
# en: Web management login username
# 示例: admin
username = "admin"

# [string]
# zh-cn: 管理端登录用户密码
# en: Web management login password
# 示例: admin
password = "admin"

# [bool]
# zh-cn: 是否启用数据持久化，重启后保留 IP 分配记录
# en: Enable data persistence, retain IP assignment records after restart
persistence = true

# [string]
# zh-cn: 自定义 TLS 证书路径，不填时自动生成
# en: Custom TLS certificate path, auto-generated when empty
# 示例: cert.pem
cert = "cert.pem"

# [string]
# zh-cn: 自定义 TLS 私钥路径，不填时自动生成
# en: Custom TLS private key path, auto-generated when empty
# 示例: key.pem
key = "key.pem"

# [string]
# zh-cn: 服务端之间通信的 UDP 端口，不填则不启用服务端互联
# en: UDP port for server-to-server communication, leave empty to disable server interconnection
# 示例: 0.0.0.0:29873
server_quic_bind = ""

# [array]
# zh-cn: 其他服务器地址列表
# en: Peer server address list
# 示例: server1.example.com:29873
peer_servers = []

# [string]
# zh-cn: 服务器验证码，用于服务器之间的身份验证
# en: Server authentication token for inter-server verification
# 示例: your-secret-token
server_token = ""

# [section]
# zh-cn: IKEv2/IPsec 接入配置（可选；启用后通常需要管理员/root 权限绑定 500/4500）
# en: IKEv2/IPsec access settings, optional. Usually requires root privileges to bind ports 500/4500 when enabled
# [ikev2]
# [bool]
# zh-cn: 是否启用 IKEv2 接入，未启用时本节其他参数不生效
# en: Enable IKEv2 access. Other options in this section take effect only when enabled
# enabled = false
# [string]
# zh-cn: IKE 服务监听地址（UDP 500）
# en: IKE service listen address, UDP 500
# 示例: 0.0.0.0:500
# ike_bind = "0.0.0.0:500"
# [string]
# zh-cn: NAT-T 服务监听地址（UDP 4500），不能与 ike_bind 相同
# en: NAT-T service listen address, UDP 4500, must differ from ike_bind
# 示例: 0.0.0.0:4500
# natt_bind = "0.0.0.0:4500"
# [string]
# zh-cn: 客户端实际连接的服务器地址，启用时必填
# en: Server address clients actually connect to, required when enabled
# 示例: vpn.example.com
# server_address = ""
# [string]
# zh-cn: 客户端校验的远程 ID，域名或 IPv4 地址，启用时必填
# en: Remote ID verified by clients, domain or IPv4 address, required when enabled
# 示例: vpn.example.com
# remote_id = ""
# [string]
# zh-cn: 自定义 IKEv2 TLS 证书路径，不填则自动生成
# en: Custom IKEv2 TLS certificate path, auto-generated when empty
# 示例: ikev2-cert.pem
# cert = "ikev2-cert.pem"
# [string]
# zh-cn: 自定义 IKEv2 TLS 私钥路径，不填则自动生成
# en: Custom IKEv2 TLS private key path, auto-generated when empty
# 示例: ikev2-key.pem
# key = "ikev2-key.pem"
# [array]
# zh-cn: 下发给 IKEv2 客户端的 DNS 服务器地址列表，留空则不下发
# en: DNS server addresses pushed to IKEv2 clients, leave empty to push none
# 示例: 114.114.114.114
# dns = []

# [section]
# zh-cn: WireGuard 接入配置（可选；使用独立 UDP 监听端口）
# en: WireGuard access settings, optional. Uses a dedicated UDP listen port
# [wireguard]
# [bool]
# zh-cn: 是否启用 WireGuard 接入
# en: Enable WireGuard access
# enabled = false
# [string]
# zh-cn: WireGuard UDP 监听地址
# en: WireGuard UDP listen address
# 示例: 0.0.0.0:51820
# bind = "0.0.0.0:51820"
# [string]
# zh-cn: 客户端使用的服务端端点地址
# en: Server endpoint address used by clients
# 示例: vpn.example.com:51820
# endpoint = ""
# [string]
# zh-cn: WireGuard 私钥，留空时首次启用自动生成
# en: WireGuard private key, auto-generated on first enable when empty
# private_key = ""
# [int]
# zh-cn: WireGuard 持久保活间隔，单位秒
# en: WireGuard persistent keepalive interval in seconds
# 示例: 25
# persistent_keepalive = 25

# [section]
# zh-cn: 自定义虚拟网段，每行一条，格式：网络编号 = "网段"
# en: Custom virtual subnets, one per line, format: network_code = "subnet"
# 示例: net1 = "10.25.0.0/24"
[custom_nets]

# net1 = "10.25.0.0/24"
# net2 = "10.27.1.0/24"
