# [string]
# zh-cn: TCP 监听地址，不填则不启用 TCP 服务
# en: TCP listen address, leave empty to disable TCP service
# 示例: 0.0.0.0:29872
tcp_bind = ""

# [string]
# zh-cn: QUIC 监听地址，不填则不启用 QUIC 服务
# en: QUIC listen address, leave empty to disable QUIC service
# 示例: 0.0.0.0:29872
quic_bind = ""

# [string]
# zh-cn: WSS 监听地址，不填则不启用 WSS 服务
# en: WSS listen address, leave empty to disable WSS service
# 示例: 0.0.0.0:29872
ws_bind = ""

# [string] 必填
# zh-cn: 默认虚拟网段
# en: Default virtual network subnet
# 示例: 10.26.0.0/24
network = ""

# [array]
# zh-cn: 网络编号白名单，留空则不限制
# en: Network code whitelist, leave empty for no restriction
# 示例：admin
white_list = []

# [int]
# zh-cn: IP 租约时长，单位秒，默认 86400 即 24 小时
# en: IP lease duration in seconds, default 86400 (24 hours)
lease_duration = 86400

# [string]
# zh-cn: Web 管理端绑定地址，填写后可访问 WebUI
# en: Web management bind address, enables WebUI access when set
# 示例: 0.0.0.0:29871
web_bind = ""

# [string]
# zh-cn: Web 管理登录用户名
# en: Web management login username
username = "admin"

# [string]
# zh-cn: Web 管理登录密码
# en: Web management login password
password = "admin"

# [bool]
# zh-cn: 是否启用数据持久化，重启后保留 IP 分配记录
# en: Enable data persistence, retains IP assignment records after restart
persistence = true

# [string]
# zh-cn: 自定义 TLS 证书路径，不填则自动生成
# en: Custom TLS certificate path, auto-generated if empty
# 示例：/root/cert.pem
cert = ""

# [string]
# zh-cn: 自定义 TLS 私钥路径，不填则自动生成
# en: Custom TLS private key path, auto-generated if empty
# 示例：/root/key.pem
key = ""

# [string]
# zh-cn: 服务端之间通信的UDP端口，不填则不启用服务端互联
# en: UDP port for server-to-server communication, leave empty to disable
# 示例：0.0.0.0:29873
server_quic_bind = ""

# [array]
# zh-cn: 其他服务器地址列表
# en: Peer server address list
# 示例：server1.example.com:29873
peer_servers = []

# [string]
# zh-cn: 服务器验证码，用于服务器之间的身份验证
# en: Server authentication token for server-to-server verification
# 示例：your-secret-token
server_token = ""

# [section]
# zh-cn: IKEv2/IPsec 接入配置（vnts2 2.0.4+），启用后通常需要 root 权限绑定 500/4500 端口；未启用时下方参数不生效
# en: IKEv2/IPsec access settings (vnts2 2.0.4+); requires root to bind ports 500/4500 when enabled; parameters below take effect only when enabled
[ikev2]
# zh-cn: 是否启用 IKEv2 接入，未启用时本节其他参数不生效
# en: Enable IKEv2 access; other parameters in this section take effect only when enabled
# 示例: enabled=false
enabled = false

# zh-cn: IKE 服务监听地址（UDP 500）
# en: IKE service listen address (UDP 500)
# 示例: ike_bind=0.0.0.0:500
ike_bind = "0.0.0.0:500"

# zh-cn: NAT-T 服务监听地址（UDP 4500），不能与 ike_bind 相同
# en: NAT-T service listen address (UDP 4500), must differ from ike_bind
# 示例: natt_bind=0.0.0.0:4500
natt_bind = "0.0.0.0:4500"

# zh-cn: 客户端实际连接的服务器地址（域名或 IP），启用时必填
# en: Server address clients actually connect to (domain or IP), required when enabled
# 示例: server_address=vpn.example.com
server_address = ""

# zh-cn: 客户端校验的远程 ID（域名或 IPv4 地址），启用时必填
# en: Remote ID verified by clients (domain or IPv4 address), required when enabled
# 示例: remote_id=vpn.example.com
remote_id = ""

# zh-cn: 自定义 IKEv2 TLS 证书路径，不填则自动生成
# en: Custom IKEv2 certificate path, auto-generated if empty
# 示例: cert=/root/ikev2-cert.pem
cert = ""

# zh-cn: 自定义 IKEv2 TLS 私钥路径，不填则自动生成（需与证书同时填写）
# en: Custom IKEv2 private key path, auto-generated if empty (must be set together with cert)
# 示例: key=/root/ikev2-key.pem
key = ""

# [array]
# zh-cn: 下发给 IKEv2 客户端的 DNS 服务器地址列表，留空则不下发
# en: DNS server addresses pushed to IKEv2 clients, leave empty to push none
# 示例: dns=114.114.114.114
dns = []

# [section]
# zh-cn: 自定义虚拟网段映射表，每行格式：网络编号=网段
# en: Custom virtual subnet mapping table, one network code=subnet per line
# 示例: 10.25.0.0/24
[custom_nets]