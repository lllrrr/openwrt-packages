START=99
USE_PROCD=1

NAME=sxray
CORE_TYPE=""
VALID_CORE_TYPES="xray sing-box"

CONFIG_FOLDER=/var/etc/$NAME
CONFIG_FOLDER_XRAY=/var/etc/${NAME}_xray
CONFIG_FOLDER_SING_BOX=/var/etc/${NAME}_singbox

FILE_SXRAY_DNSMASQ=/tmp/dnsmasq.d/$NAME
FILE_SXRAY_DNSMASQ_CACHE=/tmp/$NAME.dnsmasq.cache
FILE_SXRAY_DNSMASQ_XRAY=/tmp/dnsmasq.d/${NAME}_xray
FILE_SXRAY_DNSMASQ_SING_BOX=/tmp/dnsmasq.d/${NAME}_singbox
FILE_SXRAY_DNSMASQ_CACHE_XRAY=/tmp/${NAME}_xray.dnsmasq.cache
FILE_SXRAY_DNSMASQ_CACHE_SING_BOX=/tmp/${NAME}_singbox.dnsmasq.cache

IPSET_SRC_IGNORE_V4=sxray_src_ignore_v4
IPSET_SRC_IGNORE_V6=sxray_src_ignore_v6
IPSET_DST_PROXY_V4=sxray_dst_proxy_v4
IPSET_DST_PROXY_V6=sxray_dst_proxy_v6
IPSET_SRC_DIRECT_V4=sxray_src_direct_v4
IPSET_DST_DIRECT_V4=sxray_dst_direct_v4
IPSET_DST_DIRECT_V6=sxray_dst_direct_v6
IPSET_SRC_IGNORE_V4_XRAY=sxray_src_ignore_v4_xray
IPSET_SRC_IGNORE_V6_XRAY=sxray_src_ignore_v6_xray
IPSET_DST_PROXY_V4_XRAY=sxray_dst_proxy_v4_xray
IPSET_DST_PROXY_V6_XRAY=sxray_dst_proxy_v6_xray
IPSET_SRC_DIRECT_V4_XRAY=sxray_src_direct_v4_xray
IPSET_DST_DIRECT_V4_XRAY=sxray_dst_direct_v4_xray
IPSET_DST_DIRECT_V6_XRAY=sxray_dst_direct_v6_xray
IPSET_SRC_IGNORE_V4_SING_BOX=sxray_src_ignore_v4_singbox
IPSET_SRC_IGNORE_V6_SING_BOX=sxray_src_ignore_v6_singbox
IPSET_DST_PROXY_V4_SING_BOX=sxray_dst_proxy_v4_singbox
IPSET_DST_PROXY_V6_SING_BOX=sxray_dst_proxy_v6_singbox
IPSET_SRC_DIRECT_V4_SING_BOX=sxray_src_direct_v4_singbox
IPSET_DST_DIRECT_V4_SING_BOX=sxray_dst_direct_v4_singbox
IPSET_DST_DIRECT_V6_SING_BOX=sxray_dst_direct_v6_singbox

OUTBOUND_SERVERS_V4=
OUTBOUND_SERVERS_V6=

TRANSPARENT_PROXY_EXPECTED=0
TRANSPARENT_PROXY_PORT=
TRANSPARENT_PROXY_USE_TPROXY=
TRANSPARENT_PROXY_ADDITION=

DNSMASQ_RESTART_EXPECTED=0

if [ -r /usr/share/libubox/jshn.sh ] ; then
	. /usr/share/libubox/jshn.sh
elif [ -r /lib/functions/jshn.sh ] ; then
	. /lib/functions/jshn.sh
else
	logger -p daemon.err -t "$NAME" "Package required: jshn."
	echo "[err] Package required: jshn." >&2
	exit 1
fi

_log() {
	local level="$1" ; shift
	local msg="$@"
	local log_tag="$NAME"
	
	if [ -n "$CORE_TYPE" ] ; then
		log_tag="${NAME}_${CORE_TYPE}"
	fi
	
	logger -p "daemon.$level" -t "$log_tag" "$msg"

	echo "[$level] $msg" >&2
}

_info() {
	_log "info" $@
}

_err() {
	_log "err" $@
}

set_core_type() {
	local type="$1"
	
	for valid_type in $VALID_CORE_TYPES ; do
		if [ "x$type" = "x$valid_type" ] ; then
			CORE_TYPE="$type"
			return 0
		fi
	done
	
	_err "Invalid core type: $type. Valid types: $VALID_CORE_TYPES"
	return 1
}

get_core_specific_vars() {
	if [ "x$CORE_TYPE" = "xxray" ] ; then
		CONFIG_FOLDER="$CONFIG_FOLDER_XRAY"
		FILE_SXRAY_DNSMASQ="$FILE_SXRAY_DNSMASQ_XRAY"
		FILE_SXRAY_DNSMASQ_CACHE="$FILE_SXRAY_DNSMASQ_CACHE_XRAY"
		IPSET_SRC_IGNORE_V4="$IPSET_SRC_IGNORE_V4_XRAY"
		IPSET_SRC_IGNORE_V6="$IPSET_SRC_IGNORE_V6_XRAY"
		IPSET_DST_PROXY_V4="$IPSET_DST_PROXY_V4_XRAY"
		IPSET_DST_PROXY_V6="$IPSET_DST_PROXY_V6_XRAY"
		IPSET_SRC_DIRECT_V4="$IPSET_SRC_DIRECT_V4_XRAY"
		IPSET_DST_DIRECT_V4="$IPSET_DST_DIRECT_V4_XRAY"
		IPSET_DST_DIRECT_V6="$IPSET_DST_DIRECT_V6_XRAY"
	elif [ "x$CORE_TYPE" = "xsing-box" ] ; then
		CONFIG_FOLDER="$CONFIG_FOLDER_SING_BOX"
		FILE_SXRAY_DNSMASQ="$FILE_SXRAY_DNSMASQ_SING_BOX"
		FILE_SXRAY_DNSMASQ_CACHE="$FILE_SXRAY_DNSMASQ_CACHE_SING_BOX"
		IPSET_SRC_IGNORE_V4="$IPSET_SRC_IGNORE_V4_SING_BOX"
		IPSET_SRC_IGNORE_V6="$IPSET_SRC_IGNORE_V6_SING_BOX"
		IPSET_DST_PROXY_V4="$IPSET_DST_PROXY_V4_SING_BOX"
		IPSET_DST_PROXY_V6="$IPSET_DST_PROXY_V6_SING_BOX"
		IPSET_SRC_DIRECT_V4="$IPSET_SRC_DIRECT_V4_SING_BOX"
		IPSET_DST_DIRECT_V4="$IPSET_DST_DIRECT_V4_SING_BOX"
		IPSET_DST_DIRECT_V6="$IPSET_DST_DIRECT_V6_SING_BOX"
	fi
}

get_value_from_json() {
	local json="$1"
	local key="$2"

	test -n "$json" || return

	local value=""

	local old_ns
	json_set_namespace "json_key" old_ns
	json_load "$json"
	json_get_var "$key" value
	json_cleanup
	json_set_namespace "$old_ns"

	echo "$value"
}

get_commands_from_json() {
	local json="$1"

	test -n "$json" || return

	jshn -r "$json" 2>/dev/null | grep -v "json_init"
}

get_file_content() {
	local filename="$1"

	test -n "$filename" || return
	test -r "/etc/sxray/${filename}.txt" || return

	cat "/etc/sxray/${filename}.txt" | grep -v "^$" | grep -v "^#"
}

append_server_ipv4() {
	local addr="$1"

	test -n "$addr" || return

	if [ -z "$OUTBOUND_SERVERS_V4" ] ; then
		OUTBOUND_SERVERS_V4="$addr"
	else
		OUTBOUND_SERVERS_V4="$(cat >&1 <<-EOF
			$OUTBOUND_SERVERS_V4
			$addr
		EOF
		)"
	fi
}

append_server_ipv6() {
	local addr="$1"

	test -n "$addr" || return

	if [ -z "$OUTBOUND_SERVERS_V6" ] ; then
		OUTBOUND_SERVERS_V6="$addr"
	else
		OUTBOUND_SERVERS_V6="$(cat >&1 <<-EOF
			$OUTBOUND_SERVERS_V6
			$addr
		EOF
		)"
	fi
}

append_server_address() {
	local addr="$1"

	test -n "$addr" || return

	local ipv4
	for ipv4 in $(resolveip -4 -t 5 "$addr") ; do
		append_server_ipv4 "$ipv4"
	done

	local ipv6
	for ipv6 in $(resolveip -6 -t 5 "$addr") ; do
		append_server_ipv6 "$ipv6"
	done
}

sxray_section_validate() {
	uci_validate_section "$NAME" "sxray" "$1" \
		'enabled:bool:0' \
		'core_type:or("xray", "sing-box"):xray' \
		'xray_file:string:/usr/bin/xray' \
		'sing_box_file:string:/usr/bin/sing-box' \
		'asset_location:directory' \
		'mem_percentage:and(uinteger, max(100)):80' \
		'config_file:file' \
		'loglevel:or("debug", "info", "warning", "error", "none")' \
		'access_log:string' \
		'error_log:string' \
		'stats_enabled:bool:0' \
		'transport_enabled:bool:0' \
		'inbounds:list(uci("sxray", "@inbound"))' \
		'outbounds:list(uci("sxray", "@outbound"))'
}

dns_section_validate() {
	uci_validate_section "$NAME" "dns" "$1" \
		'enabled:bool:0' \
		'tag:string' \
		'client_ip:ipaddr' \
		'hosts:list(string)' \
		'servers:list(uci("sxray", "@dns_server"))'
}

