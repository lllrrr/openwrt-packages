	uci_validate_section "$NAME" "dns_server" "$1" \
		'address:string' \
		'port:port' \
		'domains:list(string)' \
		'tag:string' \
		'strategy:or("prefer_ipv4", "prefer_ipv6", "ipv4_only", "ipv6_only")' \
		'detour:string' \
		'domain_resolver:string' \
		'client_subnet:string' \
		'inet4_range:string' \
		'inet6_range:string'
}

routing_section_validate() {
	uci_validate_section "$NAME" "routing" "$1" \
		'enabled:bool:0' \
		'domain_strategy:or("AsIs", "IPIfNonMatch", "IPOnDemand")' \
		'rules:list(uci("sxray", "@routing_rule"))' \
		'balancers:list(uci("sxray", "@routing_balancer"))'
}

routing_rule_section_validate() {
	uci_validate_section "$NAME" "routing_rule" "$1" \
		'type:"field"' \
		'domain:list(string)' \
		'ip:list(string)' \
		'port:or(port, portrange)' \
		'network:list(or("tcp", "udp"))' \
		'source:list(string)' \
		'user:list(string)' \
		'inbound_tag:list(string)' \
		'protocol:list(or("http", "tls", "bittorrent"))' \
		'attrs:string' \
		'outbound_tag:string' \
		'balancer_tag:string' \
		'action:or("default", "accept", "reject", "reject-dns", "reject-tls", "reject-http", "reject-quic", "sniff", "sniff-dns", "resolve", "resolve-image", "resolve-video", "route", "route4", "route6", "route-domains", "route-image", "route-video", "proxy", "direct", "block")' \
		'rule_set:list(string)' \
		'rule_set_ipcidr_match_source:bool:0' \
		'query_type:list(string)' \
		'strategy:string' \
		'override_address:string' \
		'override_port:port' \
		'default_domain_resolver:string'
}

routing_balancer_section_validate() {
	uci_validate_section "$NAME" "routing_balancer" "$1" \
		'tag:string' \
		'selector:list(string)'
}

