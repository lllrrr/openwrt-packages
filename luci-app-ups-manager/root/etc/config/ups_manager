package ups_manager

config global 'global'
	option enabled '1'
	option poll_interval '3'
	option data_retention_days '7'
	option memory_cache_size '1200'
	option flush_interval '300'
	option log_level 'info'
	option reuse_existing_nut '1'

config ups 'ups'
	option name 'ups'
	option driver 'usbhid-ups'
	option port 'auto'
	option desc 'Primary UPS'
	option vendorid ''
	option productid ''
	option serial ''
	option nominal_power '360'
	option nominal_va '650'
	option power_factor '0.6'
	option power_scale '1.0'
	option mode 'standalone'
	option remote_host '127.0.0.1'
	option remote_port '3493'
	option remote_user 'monuser'
	option remote_password 'monpass'

config nut_service 'nut_service'
	option listen_address '127.0.0.1'
	option listen_port '3493'
	option allow_lan '0'
	option admin_user 'admin'
	option admin_password 'adminpass'
	option mon_user 'monuser'
	option mon_password 'monpass'

config shutdown_policy 'shutdown'
	option enabled '1'
	option battery_low_percent '20'
	option runtime_low_seconds '300'
	option on_battery_delay '600'
	option shutdown_router '1'
	option router_delay '180'
	option poweroff_ups '0'

config quality_policy 'quality'
	option hide_unsupported '0'
	option status_overload_sev 'critical'
	option status_bypass_sev 'warning'
	option status_replace_batt_sev 'warning'
	option status_selftest_fail_sev 'warning'
	option in_volt_low_trig '190'
	option in_volt_low_rec '200'
	option in_volt_low_sev 'warning'
	option in_volt_high_trig '250'
	option in_volt_high_rec '245'
	option in_volt_high_sev 'warning'
	option out_volt_low_trig '190'
	option out_volt_low_rec '200'
	option out_volt_low_sev 'warning'
	option out_volt_high_trig '250'
	option out_volt_high_rec '245'
	option out_volt_high_sev 'warning'
	option in_freq_low_trig '47'
	option in_freq_low_rec '48'
	option in_freq_low_sev 'warning'
	option in_freq_high_trig '53'
	option in_freq_high_rec '52'
	option in_freq_high_sev 'warning'
	option temp_high_trig '50'
	option temp_high_rec '45'
	option temp_high_sev 'warning'
	option load_high_trig '80'
	option load_high_rec '75'
	option load_high_sev 'warning'
	option load_crit_trig '95'
	option load_crit_rec '90'
	option load_crit_sev 'critical'

config notification 'notification'
	option enabled '0'
	option channel 'webhook'
	option webhook_url ''
	option secret ''
	option notify_on_battery '1'
	option notify_on_online '1'
	option notify_on_low_battery '1'
	option notify_on_overload '1'
	option notify_on_comm_lost '1'
	option repeat_interval '600'
