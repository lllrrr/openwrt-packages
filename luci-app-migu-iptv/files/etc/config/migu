config migu 'main'
	# 是否启用服务（1 启用 / 0 关闭）
	option enabled '1'

	# 监听端口与地址。0.0.0.0 表示允许局域网访问
	option port '8788'
	option host '0.0.0.0'

	# 咪咕账号 ID（留空 = 游客模式，最高 540p）
	# 免费账号到 720p；VIP 到蓝光 1080p / 原画 / 4K
	option userId ''

	# 咪咕登录令牌（等同登录态，务必只在自家路由器上保存，勿外传）
	option token ''

	# 画质档位：2=标清 540p, 3=高清 720p, 4=蓝光 1080p(VIP),
	# 7=原画(VIP), 9=4K(VIP)
	# 超出账号权益会自动降级到咪咕愿意给的档位
	option rateType '3'

	# H.265 / HDR（部分设备只有声无画时关闭 H265）
	option enableH265 '1'
	option enableHDR '1'

	# 频道列表缓存时长（分钟）
	option cacheMinutes '360'

	# 调试日志
	option debug '0'

	# ---- 以下为 1.4.0 新增 ----

	# 取流地址缓存时长（秒）。0 = 不缓存。
	# 实测咪咕签发的地址有效期约 3 小时（akiralereal/iptv 实测结论），
	# 直接复用缓存 URL 请求仍是 200；缓得久一点能显著减少切台耗时。
	# 若遇到播放中途失效可调小。上限 10800（3 小时）。默认 1800（30 分钟）。
	option streamTtl '1800'

	# 取流失败结果的缓存时长（秒）。0 = 不缓存失败。
	# 版权盾时段失败是间歇性的，缓太久会把「临时失败」放大成「一直失败」；
	# 但完全不缓存又会让连点重试的用户每次都等一轮完整解析（实测冷 1.28s）。
	# 15 秒是个折中：既挡掉连点，又不会让恢复延迟可见。上限 300。
	option failTtl '15'

	# 最大并发连接数（4~4096）。超出后的新连接直接拒绝，防止
	# 单个客户端刷请求把单线程事件循环占满。默认 64。
	option maxConns '64'

	# 节目单（EPG）来源。生成 M3U 时用它把频道名映射成播放器认识的
	# 标准 tvg-id，否则电视盒的节目单是空的。
	# 注意：UCI 存不下空字符串，所以把这一项清空**不会**关闭 EPG，
	# 只会回落到内置默认源（就是下面这个地址）。要关闭请把
	# epgRefreshHours 设为 0。
	option epgUrl 'https://live.fanmingming.cn/e.xml'

	# EPG 刷新间隔（小时，0~168）。默认 12。设为 0 = 关闭 EPG。
	# 拉取失败时会自动改为 5 分钟后重试，不会傻等一个完整周期。
	option epgRefreshHours '12'

	# 服务启动时预热最近看过的几个频道（0 = 关闭，最多 12 个）。
	# 这些频道的流地址会被提前解析好，开机后首次点开即可秒开。默认 4。
	option warmRecent '4'

	# ---- 以下为 1.5.0 新增 ----

	# 外部源健康检查与分片探测用的 User-Agent（空 = curl 默认）。
	# 部分防盗链源只认播放器 UA（如 "VLC/3.0.18 LibVLC/3.0.18"），
	# 对 curl 默认 UA 返回 403/451；填上播放器 UA 可提高兼容性。
	option extUserAgent ''
